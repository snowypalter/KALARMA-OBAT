            }
            lines {
              text: "    \'\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    \'Aturan Ketat & Batasan Skripsi (Ethical Boundaries):\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
