      thinking_signature: "\022\327\v\n\324\v\001i\024}\023)\016\335e\302\271\267.\236zI\032s\251j\315\247\2323\346|YI\340\303+\304$\201\302\217\325\267\235\226\221l\375\200h\340\3509\330d\336=l\236\211\003\021\037\257\232\245\335\376\005\020JG\210\222\030\037\022$\r\205\345\334\2705\274\247\214(K\327\022\200\023\230\311\016%\370\340\366W\245\350\363J\274\255\204y6\313J\354\236d\242\220\364\267\367\306/%l(\215\375\350\201\340\266\365\250\264\237D\242r?\215\215&s<j\343\360\f\362Q\376m\032\211\224\320O$\254(\236\274\26713W\202\031$h\210<\323_\"q\271\377\367\320\316v\265u\332\200\243\233\217\271\232\001A\357Iy-U\251\254Z%\354f7\221)\332\214P6\342\260(\212\027B\021\356\353\255\f\203lFO\b\335i<.Z\236\001`\371\314\037\330\310t)\340\341\266\205\220&\035\316\354\320\273k\227\330\373\277n\003\241Z\027}M\364\027-\322\220>8\327p\rt\341I\271H\255o\325t]\223\273\260\r\237\244o\300\336\360\2379\254\376\313:\237n\310\036\031\bC\224O\3108\336I1\b}+|kW\374\355\206Me\303?\333s\335\272\250\352\357^\202k}\301\367\306\345\024\331(\032\020\371\226\360\312\331\331RP\230\374\353=\006\274M?1\215Q\374\034\244\352+\017t\000\363\2733\370\316\032\004\262P/l\300\240au.g\306^2\006\320\301;u\255(*\205Z\254o\243:/i\273Zi\233\343\301H\0306\207\2025,\206\037\353u\301qu\276\372gq\276A\300\211:\003\260X\225\334o\310\225hRK\235\343\231\234\027\036\252<\310\220\255$\302\343v\036\334\2753:\350\241\371\344\272\034~\034\"\262x\362\004\342Y\360\273\036\362P\212x\257\001\262\213\255`\343|\201\"\361\317\025z\345pl\365\227`\3714\250x8\314$\352\353R\247\303\205~\205\352\262\361F\313\266\243~\217/\315\360\314\t\312\264V$I\334D\206f\322\311B{\272\245\226\260\272\b\264\v\256\317fC\300ZW\366\270\222\230\302z\211b+\303\026\267\374\324\323\"+\266)\345u\"J\204\v]Shx\241%\244\201 o\225r\313\371\2025\274\236\262\vR&\243\be;\345Z\365\252/\357\254\2309\235\230c\377\202\350\020\'\270\255\204\021\245@\324\260G\342\"T\342$\034#\247i\240\005\340\206k\317*\254\200\f&<\034\347\334@\030\335\344\350za(\343\265\322U\367\'\024N\277\024<,0\030F\311\225\020\246\346\202\314x\3732\256\352\313\031\353Y6a\317y\236&\253Z\313\360\324n\206Kx\000\342d\204\301&\234^\270\341JV\247^\021\236U\305\027\302\005B\2125J%rE\347mj\364k2.V\211\304\351.\356w3\335\210I\236\2645\r-\343\216O\016\331s\374p\220Q\274\022\214\210q\022\tw\350&\202\036\344\212\246D\372\276\232\212\273?\365=\275\\L\023\226\326\206\343\331\261\241Uc\003Z\343\027&\377\203\346y\363\353\331\241\016\351\364\333\r\214\360\033i\033vu\203\320\324\374\264\350\036\341\253\035?\373)\236t8I\"\264\302T^S\b\r\223\207-\202}Sd\327\2650\262c\306E\t\304\303\n\271\363\035<\237\334A\344\252E\024:\323\r\342\022\002\250\215\032\215\ae9l\002!$\226N\314F\221Wp\326/x\324qu5\353\234-&q(\333\213cfN\320\357P\220\246Tq\377\022\323i\344\303/vu_\374\225@\256\364\374k\254=\365\r\325u\234x\347\266\265q\037K*\223\302\033\372\347\320\022{\201F\334f\2338\225#\255st\320)\275\372\246u\272\003,\364\\\004\331\177\274\020\3245\212\360\263\371\f\246\214\217\356\0256\224\217\230\351U,\272\263\346\3029\306\026\252\315\036t\220\234\225\362\303\312\333SZ\205=y!\231m\3150\303\274\353\a\275\006\235\305\372vT5\025\253n\304\265\346\357\246\367\311Pd\3167=t\221$m\021qN\270\207\2116\300\337\377\rtF\bcN\324:\360\226\024\\>$\303\v\3443.H\236\020\377\022\025\224\330\304,\320\342\255\374\216>\311\272\270t\326\373\246+\311\234\202\371a\254\322\357\n\002A\270:\365|\231\034r2\342c\333\373O,3\277\371\341\366Hv\037\fh\310\313\226\206\261\vRlA_\204s\036\025\263\3367\374\\(\346\351\351\363\326\v\346~3w\177\251\276\267\303\265\364\034\nw\274\232e\241(\027\366\332\355\347\244\224\236\251\033\200X\177\270-\363\257\3224\267s\2711\201\3343\377=\036\335\234\341Nx\247\351\374\330\323\301Z\233\26397\206q^C\215\034*\301\233Jr\327\001\252\373\203\'\0303\355g5\226\035t\026\231\315\213|J\'j6\333k\361g\210\233\230\317L\272\335\243\364\260(G\265\t\"\202\312\025Cb\2453\236eTsjF=\017\037}MM\246\t,\364\373\vT!\022Y\020+F\246k\366\350\274S\n\245+\314%\364@\251\1772WJ\234\3741.xpB\003X\263\363\357\243\t\314M\001\202(\002\227\025\r\314\345\375he\266U\003\303{^\214| i\026(B6\365\246\2603\0237)\272\017\036h49\002\271\363\'C\234\226\311\256\316o\001IZ\362\262\311,;F\327\375\335@\341\317\020\256c\036\375|\270\r\256.\2709\177\023\217\221m\253\277\031\006f\314\326\032(\354\3644H\325\204\326\231\2205o\351\356"
