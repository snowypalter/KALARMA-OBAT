      full: "<truncated 22 bytes>\nrand font-semibold\">Bahan Skripsi S1 Farmasi</span>src/components/TinjauDosenModal.tsx:21:  defaultTab?: \'pdf\' | \'link\' | \'dosen\' | \'claude\';src/components/TinjauDosenModal.tsx:29:  const [activeTab, setActiveTab] = useState<\'pdf\' | \'link\' | \'dosen\' | \'claude\'>(src/components/TinjauDosenModal.tsx:33:  const [copiedClaudePrompt, setCopiedClaudePrompt] = useState(false);src/components/TinjauDosenModal.tsx:54:  const claudeReviewPrompt = `# Permohonan Review Media Edukasi Skripsi S1 Farmasi: \"Ruang Obat\"src/components/TinjauDosenModal.tsx:56:Halo Claude, saya mahasiswa S1 Farmasi Klinis dan Komunitas yang sedang menyusun skripsi media edukasi interaktif bernama \"Ruang Obat\" (Tagline: \"Kenali label obatmu, kelola obat di rumahmu\").src/components/TinjauDosenModal.tsx:58:Tautan Web Media Prototipe Aktif:src/components/TinjauDosenModal.tsx:64:Aturan Ketat & Batasan Skripsi (Ethical Safeguards):src/components/TinjauDosenModal.tsx:80:   - Kuis Evaluasi Pre-Test & Post-Test (10 soal terstandar skripsi, kalkulasi skor /100, delta Pre-Post, pembahasan ilmiah).src/components/TinjauDosenModal.tsx:81:7. Tentang & Berkas PDF Skripsi: Lembar penilaian dosen pembimbing dan dokumen akademik A4 siap cetak.src/components/TinjauDosenModal.tsx:84:Pertanyaan untuk Claude AI:src/components/TinjauDosenModal.tsx:87:3. Apakah instrumen kuis Pre-Test dan Post-Test ini sudah representatif untuk mengukur peningkatan literasi obat pada responden penelitian skripsi S1 Farmasi?`;src/components/TinjauDosenModal.tsx:89:  const handleCopyClaudePrompt = () => {src/components/TinjauDosenModal.tsx:90:    navigator.clipboard.writeText(claudeReviewPrompt).then(() => {src/components/TinjauDosenModal.tsx:91:      setCopiedClaudePrompt(true);src/components/TinjauDosenModal.tsx:92:      setTimeout(() => setCopiedClaudePrompt(false), 2500);src/components/TinjauDosenModal.tsx:104:      title=\"Berkas Dokumen & Tinjauan Prototipe\"src/components/TinjauDosenModal.tsx:111:            Ruang Obat \302\267 Skripsi S1 Farmasisrc/components/TinjauDosenModal.tsx:165:            onClick={() => setActiveTab(\'claude\')}src/components/TinjauDosenModal.tsx:167:              activeTab === \'claude\'src/components/TinjauDosenModal.tsx:173:            <span className=\"hidden sm:inline\">Untuk Claude</span>src/components/TinjauDosenModal.tsx:174:            <span className=\"sm:hidden\">Claude</span>src/components/TinjauDosenModal.tsx:183:                Dokumen Prototipe Siap Diberikansrc/components/TinjauDosenModal.tsx:186:                Dokumen PDF Prototipe Skripsi &ldquo;Ruang Obat&rdquo;src/components/TinjauDosenModal.tsx:189:                File PDF ini disusun formal (5 halaman A4 standar akademik) berisi rancangan prototipe, batasan etika farmasi, tabel 6 titik kemasan, lembar validasi dosen, dan prompt peninjauan.src/components/TinjauDosenModal.tsx:200:                    Dokumen_Prototipe_Ruang_Obat.pdfsrc/components/TinjauDosenModal.tsx:203:                    Ukuran ~48 KB \302\267 5 Halaman Lengkap \302\267 Format Cetak A4 Standar Skripsisrc/components/TinjauDosenModal.tsx:241:- Bidang: Farmasi Klinis dan Komunitassrc/components/TinjauDosenModal.tsx:278:2. Apakah batasan etika farmasi dan keamanan pasien sudah kuat untuk skripsi S1?src/components/TinjauDosenModal.tsx:317:                    desc: \'Judul skripsi, tagline, identitas peneliti, tautan web aktif, dan kepatuhan etika.\',src/components/TinjauDosenModal.tsx:326:                    title: \'Bab II: Spesifikasi Prototipe\',src/components/TinjauDosenModal.tsx:336:                    title: \'Bab IV: Panduan Evaluasi Claude AI\',src/components/TinjauDosenModal.tsx:471:                Panduan Validasi &amp; Tinjauan Dosen Skripsisrc/components/TinjauDosenModal.tsx:474:                Gunakan daftar periksa berikut saat asistensi atau bimbingan skripsi bersama Dosen Pembimbing.src/components/TinjauDosenModal.tsx:531:        {/* TAB 4: Untuk Claude AI */}src/components/TinjauDosenModal.tsx:532:        {activeTab === \'claude\' && (src/components/TinjauDosenModal.tsx:539:                Salin seluruh ringkasan teknis, aturan ketat skripsi, daftar fitur, dan pertanyaan evaluasi ke clipboard Anda.src/components/TinjauDosenModal.tsx:545:              onClick={handleCopyClaudePrompt}src/components/TinjauDosenModal.tsx:547:                copiedClaudePromptsrc/components/TinjauDosenModal.tsx:552:              {copiedClaudePrompt ? (src/components/TinjauDosenModal.tsx:560:                  <span>Salin Prompt Ringkasan Skripsi</span>src/components/TinjauDosenModal.tsx:570:                {claudeReviewPrompt}src/components/TentangModal.tsx:16:      subtitle=\"Media Edukasi Skripsi S1 Farmasi Klinis & Komunitas\"src/components/TentangModal.tsx:39:            Ruang Obat dikembangkan sebagai instrumen media edukasi interaktif dalam penelitian skripsi S1 Farmasi Klinis dan Komunitas. Sasaran utamanya adalah mahasiswa non-kesehatan dan masyarakat umum untuk meningkatkan kecakapan literasi membaca label obat serta menumbuhkan kebiasaan pengelolaan obat rumah tangga yang aman (Dagusibu: Dapatkan, Gunakan, Simpan, Buang).src/components/Header.tsx:76:            aria-label=\"Buka berkas dokumen dan tinjauan skripsi\"src/components/FooterDisclaimer.tsx:20:          <span>Ruang Obat \302\267 Media Edukasi Skripsi S1 Farmasi Klinis dan Komunitas</span>src/views/BerandaView.tsx:135:              Media Edukasi Farmasi Klinis &amp; Komunitassrc/views/BerandaView.tsx:535:      {/* Card: Berkas Dokumen Skripsi & Peninjauan */}src/views/BerandaView.tsx:544:                Berkas Skripsi \302\267 Format PDF Resmi A4src/views/BerandaView.tsx:547:                Dokumen Prototipe untuk Dosen &amp; Peninjausrc/views/LatihanView.tsx:34:          Instrumen Skripsi S1 Farmasi \302\267 Modul Latihan &amp; Evaluasisrc/views/LatihanPreviewView.tsx:77:            Satu pertanyaan per layar dengan 2\342\200\2233 pilihan respons realistis, disertai umpan balik singkat setelah memilih, dan selalu berakhir dengan panduan praktis <em>\"Kapan harus bertanya ke apoteker\"</em>. Disimpan dalam struktur JSON terpisah agar mudah disunting untuk instrumen skripsi.src/views/LatihanPreviewView.tsx:133:              Kuis Skripsisrc/utils/generatePdfClient.ts:92:    \'Dokumen prototipe media edukasi interaktif untuk pengenalan informasi etiket/kemasan obat dan pengelolaan obat rumah tangga (Dagusibu). Disiapkan untuk peninjauan Dosen Pembimbing, Dosen Penguji, dan Evaluasi Desain Instruksional menggunakan Claude AI.\';src/utils/generatePdfClient.ts:112:    [\'Bidang Keilmuan\', \': Farmasi Klinis & Komunitas (S1 Farmasi)\'],src/utils/generatePdfClient.ts:117:    [\'Status Prototipe\', \': Tahap 2 Selesai Penuh (Beranda, Cek Label, Lemari, Skenario, Flashcard, Kuis)\'],src/utils/generatePdfClient.ts:182:    \'Aplikasi \"Ruang Obat\" dirancang sebagai instrumen penelitian skripsi untuk menjembatani komunikasi informasi kefarmasian dalam format yang ramah pengguna, interaktif, dan mudah diakses melalui peramban web ponsel pintar (mobile-first). Fokus edukasi diarahkan pada pengenalan 6 titik informasi label kemasan dan penerapan prinsip DAGUSIBU (Dapatkan, Gunakan, Simpan, Buang) di lingkungan rumah tangga.\';src/utils/generatePdfClient.ts:265:  drawHeaderFooter(\'Bab II: Spesifikasi Fitur Prototipe\');src/utils/generatePdfClient.ts:472:  drawHeaderFooter(\'Bab IV: Evaluasi Instruksional Claude AI\');src/utils/generatePdfClient.ts:483:    \'Teks prompt terstruktur di bawah ini dapat di-copy dan ditempelkan ke Claude AI untuk meminta analisis ahli desain instruksional dan kepatuhan farmasi klinis:\',src/utils/generatePdfClient.ts:499:    \'# Permohonan Review Media Edukasi Skripsi S1 Farmasi: \"Ruang Obat\"\',src/utils/generatePdfClient.ts:501:    \'Halo Claude, saya mahasiswa S1 Farmasi Klinis dan Komunitas yang sedang\',src/utils/generatePdfClient.ts:502:    \'menyusun skripsi media edukasi interaktif bernama \"Ruang Obat\"\',src/utils/generatePdfClient.ts:507:    \'Aturan Ketat & Batasan Skripsi (Ethical Boundaries):\',src/utils/generatePdfClient.ts:527:    \'6. Tentang: Tujuan penelitian skripsi, batasan produk, dan kebijakan privasi.\',src/utils/generatePdfClient.ts:529:    \'Pertanyaan untuk Claude AI:\',src/utils/generatePdfClient.ts:542:  doc.save(\'Dokumen_Prototipe_Ruang_Obat.pdf\');"
    }
