              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    Kapsul: {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      ringkasanSingkat:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \'Keluarkan isi/cangkang kapsul, campur dengan ampas kopi/tanah dalam wadah tertutup, dan rusak kemasan.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      langkah: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \'Segera pisahkan dari obat lain yang masih aman dikonsumsi.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \'Buka atau keluarkan kapsul dari kemasan aslinya, lalu campur dengan tanah, pasir, atau ampas kopi dalam kantong plastik terikat rapat.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \'Rusak strip/botol dan lepaskan label etiket sebelum dibuang agar tidak disalahgunakan.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    \'Sirup / Cair\': {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      ringkasanSingkat:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \'Periksa jenis cairan terlebih dahulu: sirup biasa dapat diencerkan, sedangkan antibiotik/obat khusus harus diserahkan ke apotek atau dicampur bahan penyerap.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      langkah: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \'Hentikan pemakaian segera dan jauhkan botol dari jangkauan anak-anak.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        isAntibiotic"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          ? \'Karena terdeteksi sebagai antibiotik, JANGAN tuang ke wastafel/saluran air untuk mencegah pencemaran dan resistensi antimikroba. Campurkan cairan dengan ampas kopi/pasir di plastik tertutup atau kembalikan ke apotek/puskesmas.\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          : \'Untuk sirup non-antibiotik (obat bebas biasa), encerkan dengan air lalu buang perlahan ke saluran pembuangan; atau serap dengan tisu/ampas kopi dalam plastik tertutup.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \'Lepas dan rusak label pada botol, bilas singkat wadah kosong, lalu buang botol tanpa tutup dalam keadaan rusak/penyok.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    \'Salep / Krim / Gel\': {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      ringkasanSingkat:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \'Keluarkan seluruh sisa salep ke plastik berisi tanah/ampas kopi, lalu pipihkan tube dan lepas label.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      langkah: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \'Hentikan pengolesan pada kulit karena sediaan semipadat kedaluwarsa berisiko teroksidasi atau terkontaminasi mikroba.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \'Pencet dan keluarkan seluruh sisa salep/krim dari dalam tube ke kantong plastik berisi tanah atau ampas kopi, lalu ikat rapat.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \'Pipihkan atau gunting ujung tube dan lepaskan label kemasan sebelum membuangnya ke sampah domestik.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    \'Tetes Mata / Telinga\': {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      ringkasanSingkat:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \'Kosongkan botol penetes dengan aman, rusak ujung penetes (dropper), dan buang terpisah dari tutupnya.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      langkah: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \'Segera hentikan penggunaan pada mata atau telinga untuk mencegah infeksi atau iritasi berat.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \'Kosongkan cairan sisa (serap dengan tisu/kapas ke plastik tertutup untuk obat keras/antibiotik, atau buang sesuai petunjuk apoteker).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \'Rusak bagian penetes (dropper) dan lepas label botol, lalu buang terpisah antara botol dan tutupnya.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    \'Inhaler / Semprot\': {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      ringkasanSingkat:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \'Jangan melubangi atau membakar tabung bertekanan; kembalikan ke apotek atau puskesmas terdekat.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      langkah: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \'Hentikan penggunaan segera karena efektivitas dosis semprotan tidak lagi terjamin.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \'JANGAN melubangi, menekan paksa, atau membakar tabung aerosol/inhaler karena berisiko meledak.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \'Simpan di wadah terpisah dan serahkan kepada apotek atau fasilitas kesehatan yang menerima pengembalian limbah farmasi.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    Lainnya: {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      ringkasanSingkat:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \'Pisahkan dari obat aktif, rusak identitas kemasan, dan konsultasikan cara pemusnahan ke apoteker.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      langkah: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \'Keluarkan obat dari tempat penyimpanan harian dan beri tanda agar tidak digunakan anggota keluarga.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \'Pertahankan dalam wadah tertutup sementara hingga siap dimusnahkan atau diserahkan ke apotek terdekat.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \'Lepas atau coret label informasi pada kemasan sekunder sebelum membuang wadah kosong.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  };"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
