              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    - *Segera Kedaluwarsa*: `--status-segera-text` (`#7A4B0C`) di atas `--status-segera-bg` (`#F8EBD3`)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
