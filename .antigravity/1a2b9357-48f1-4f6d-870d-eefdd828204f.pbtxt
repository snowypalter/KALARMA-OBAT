  view_file {
    absolute_path_uri: "file:///src/components/ui/Chip.tsx"
    end_line: 43
    content: "import React from \'react\';\n\nexport interface ChipProps extends React.ButtonHTMLAttributes<HTMLButtonElement> {\n  selected?: boolean;\n  count?: number;\n  icon?: React.ReactNode;\n}\n\nexport const Chip: React.FC<ChipProps> = ({\n  selected = false,\n  count,\n  icon,\n  children,\n  className = \'\',\n  ...props\n}) => {\n  return (\n    <button\n      type=\"button\"\n      className={`min-h-[40px] px-3.5 py-1.5 rounded-xl text-xs sm:text-sm font-semibold transition-all inline-flex items-center gap-1.5 cursor-pointer select-none active:scale-95 ${\n        selected\n          ? \'bg-brand text-on-brand shadow-xs\'\n          : \'bg-surface text-ink hover:bg-surface-muted hover:text-brand border border-line\'\n      } ${className}`}\n      aria-pressed={selected}\n      {...props}\n    >\n      {icon && <span className=\"shrink-0\">{icon}</span>}\n      <span>{children}</span>\n      {count !== undefined && (\n        <span\n          className={`px-1.5 py-0.5 rounded-full text-[10px] font-bold ${\n            selected\n              ? \'bg-on-brand/20 text-on-brand\'\n              : \'bg-surface-muted text-ink-muted\'\n          }`}\n        >\n          {count}\n        </span>\n      )}\n    </button>\n  );\n};\n"
    num_lines: 44
    num_bytes: 1183
    line_range_bytes: 1183
  }
}
