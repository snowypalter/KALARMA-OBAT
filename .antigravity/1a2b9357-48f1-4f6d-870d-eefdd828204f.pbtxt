    end_line: 175
    content: "import React, { useState, useMemo } from \'react\';\nimport { KAMUS_ITEMS } from \'../data/kamusData\';\nimport { Search, X, BookA } from \'lucide-react\';\n\ninterface KamusModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n}\n\nexport const KamusModal: React.FC<KamusModalProps> = ({ isOpen, onClose }) => {\n  const [searchQuery, setSearchQuery] = useState(\'\');\n  const [selectedLetter, setSelectedLetter] = useState<string>(\'Semua\');\n\n  // Collect available first letters\n  const availableLetters = useMemo(() => {\n    const letters = new Set<string>();\n    KAMUS_ITEMS.forEach((item) => {\n      const firstChar = item.term.charAt(0).toUpperCase();\n      if (/[A-Z]/.test(firstChar)) {\n        letters.add(firstChar);\n      }\n    });\n    return [\'Semua\', ...Array.from(letters).sort()];\n  }, []);\n\n  const filteredItems = useMemo(() => {\n    return KAMUS_ITEMS.filter((item) => {\n      const matchesSearch =\n        item.term.toLowerCase().includes(searchQuery.toLowerCase()) ||\n        item.category.toLowerCase().includes(searchQuery.toLowerCase()) ||\n        item.definition.toLowerCase().includes(searchQuery.toLowerCase());\n\n      const matchesLetter =\n        selectedLetter === \'Semua\' ||\n        item.term.toUpperCase().startsWith(selectedLetter);\n\n      return matchesSearch && matchesLetter;\n    });\n  }, [searchQuery, selectedLetter]);\n\n  if (!isOpen) return null;\n\n  return (\n    <div\n      className=\"fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-4 bg-slate-900/60 backdrop-blur-xs animate-in fade-in duration-200\"\n      role=\"dialog\"\n      aria-modal=\"true\"\n      aria-labelledby=\"kamus-title\"\n    >\n      <div className=\"bg-white rounded-2xl max-w-2xl w-full max-h-[92vh] flex flex-col shadow-2xl border border-slate-200 overflow-hidden\">\n        {/* Header */}\n        <div className=\"flex items-center justify-between px-5 py-4 border-b border-slate-100 bg-teal-800 text-white\">\n          <div className=\"flex items-center gap-2\">\n            <BookA className=\"w-5 h-5 text-teal-200\" />\n            <div>\n              <h2 id=\"kamus-title\" className=\"text-base sm:text-lg font-bold\">\n                Kamus Istilah & Simbol Label Obat\n              </h2>\n              <p className=\"text-xs text-teal-100\">\n                Pahami singkatan dan istilah resmi pada kemasan obat\n              </p>\n            </div>\n          </div>\n          <button\n            type=\"button\"\n            onClick={onClose}\n            className=\"min-h-[44px] min-w-[44px] rounded-lg text-teal-100 hover:text-white hover:bg-teal-700/50 flex items-center justify-center transition-colors cursor-pointer\"\n            aria-label=\"Tutup kamus istilah obat\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Search & Letter Filter */}\n        <div className=\"p-4 bg-slate-50 border-b border-slate-200 space-y-3\">\n          {/* Search bar */}\n          <div className=\"relative\">\n            <Search className=\"w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none\" />\n            <input\n              type=\"text\"\n              value={searchQuery}\n              onChange={(e) => setSearchQuery(e.target.value)}\n              placeholder=\"Cari istilah, misalnya \'BUD\', \'Bets\', \'Generik\'...\"\n              className=\"w-full min-h-[44px] pl-10 pr-10 py-2 text-sm bg-white border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-teal-600 focus:border-transparent\"\n              aria-label=\"Cari istilah di kamus label obat\"\n            />\n            {searchQuery && (\n              <button\n                type=\"button\"\n                onClick={() => setSearchQuery(\'\')}\n                className=\"absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 p-1\"\n                aria-label=\"Hapus kata kunci pencarian\"\n              >\n                <X className=\"w-4 h-4\" />\n              </button>\n            )}\n          </div>\n\n          {/* Letter filter chips */}\n          <div className=\"flex items-center gap-1.5 overflow-x-auto pb-1 no-scrollbar text-xs\">\n            {availableLetters.map((letter) => (\n              <button\n                key={letter}\n                type=\"button\"\n                onClick={() => setSelectedLetter(letter)}\n                className={`min-h-[36px] min-w-[36px] px-2.5 py-1 rounded-lg font-semibold transition-colors cursor-pointer ${\n                  selectedLetter === letter\n                    ? \'bg-teal-700 text-white shadow-xs\'\n                    : \'bg-white border border-slate-200 text-slate-700 hover:bg-slate-100\'\n                }`}\n              >\n                {letter}\n              </button>\n            ))}\n          </div>\n        </div>\n\n        {/* Results List */}\n        <div className=\"p-4 sm:p-5 overflow-y-auto space-y-3 flex-1\">\n          {filteredItems.length === 0 ? (\n            <div className=\"py-12 text-center space-y-2\">\n              <p className=\"text-slate-500 font-medium text-sm\">\n                Istilah \"{searchQuery}\" belum ditemukan di kamus.\n              </p>\n              <button\n                type=\"button\"\n                onClick={() => {\n                  setSearchQuery(\'\');\n                  setSelectedLetter(\'Semua\');\n                }}\n                className=\"text-xs font-semibold text-teal-700 underline\"\n              >\n                Reset pencarian\n              </button>\n            </div>\n          ) : (\n            filteredItems.map((item) => (\n              <div\n                key={item.id}\n                className=\"p-4 bg-white rounded-xl border border-slate-200 hover:border-teal-300 transition-colors shadow-2xs space-y-2\"\n              >\n                <div className=\"flex flex-wrap items-baseline justify-between gap-1\">\n                  <h3 className=\"font-bold text-slate-900 text-base\">\n                    {item.term}\n                  </h3>\n                  <span className=\"text-xs font-medium text-teal-800 bg-teal-50 px-2 py-0.5 rounded-md border border-teal-100\">\n                    {item.category}\n                  </span>\n                </div>\n                <p className=\"text-slate-600 text-sm leading-relaxed\">\n                  {item.definition}\n                </p>\n                <div className=\"text-[11px] text-slate-600 pt-1 border-t border-slate-100 flex items-center justify-between\">\n                  <span>Rujukan: {item.referenceSource}</span>\n                </div>\n              </div>\n            ))\n          )}\n        </div>\n\n        {/* Footer */}\n        <div className=\"px-5 py-3 bg-slate-50 border-t border-slate-200 flex items-center justify-between text-xs text-slate-500\">\n          <span>{filteredItems.length} istilah terdaftar</span>\n          <button\n            type=\"button\"\n            onClick={onClose}\n            className=\"min-h-[44px] px-5 py-2 font-semibold text-slate-700 bg-white border border-slate-300 hover:bg-slate-50 rounded-xl transition-colors cursor-pointer\"\n          >\n            Tutup\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    num_lines: 176
    num_bytes: 7080
    line_range_bytes: 7080
  }
}
