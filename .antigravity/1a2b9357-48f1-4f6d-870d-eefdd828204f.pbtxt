      thinking_signature: "\022\313\b\n\310\b\001i\024}\023\2774\363\002\a@\317\244\036\216\240\320\253\035;W\214\005\361q\344\341A\224\277e\347\362*\3641\210\277\265\357\363\372\350v\235\200^\264\276\366)\264\252\300\256\271x\032\341\003k\374\231\230\215H\370@|\273\020f\211\003\222\002\230\366\252x\177\363t\271\2233\352\263\203\232\336\347\217\231\255H\353\206Q\022\352\211\265\347\020\f,\241j\210\220\316\333\251:\235\315O\027t\330\b\350\267|k\211{\"f\023F\352\343\033*p\256\343\371\327\021S[#\264\\`\247\032\020\274\342,\337H\327\352\211c\341\261e\363\277)\017\253lIb\351`\206\212/Q\322[\330\001zN/\257\030r\024c\323\213\342\271\352\267\033\033\315\377LP\267\263(<\365\356\225\"\370\351\332\327\342\354\004\000\334\233T\r\375\310O\331\372\211\230n\351\v\\\006lHC3\340\270\254\267\001\334\320\"}yNQ\374\234oj\177\016\005g1U\035\351}b\027\2522\266,\273\375l\211\272@\"\232l\312\245\222\304\a\n4a\274m\201\276\006\267\323\325\310\243\245\204=\253\3524\3172\246s\2365\213\334\031\v5\353\035\356\026\203\237\313$\232\341E\210\374\026W\260\234\272\004vo\275\256@\200\326(l/F\251\331\365j\305\245(\356\001\341W\247\311)\030\372\326k\375\204\263\373\002\206\324\337\b)\001bfb\200\323n={\231Z \315\205e\300\370\"d\3416\373/\v~\331\362\230\271\322\237#\225\341U\251\b\033V\000|\303\b\251\305\207d\207\255\212%R\367\206\216\366\304)\262o\375g\255\2675\375\323\233\333\216C1FL\203\374\335\t\206\304.\241\252\330\320pje\177\306\353\325\343<g\202\356\336\222\\\233\251)\350~\'c\256=\235?B\006\367L\n\235\265\b\323b\221Z;\020\246\332\266\325B.\227\231<HMS\243\177\316\0031\215\341\3106.3us{~\3752\250\271\024\356\306O\346\263\216\371`6\277A\207\336\327\376\375!\206\213\240U\036\277Q\024\224RL\034\265\307\233*i\253\365\206\304S\026a\311\314\363\005k+\2424\231F\333\v\277\250\206\340VH\343l\020\374\003\022~  \374\200M\277\351z\246c\340\352\256t\v~[-\277\323\260\220\177z\262V\0360\2340\212\356[5\230Z\r\031X`\254\237}\204<\372\005U\345\031+@\224\336t3#\320\341\205\025\341\003\201\360CF\261\227\234\210\030\3165\376\030o\005\216U\2731{5\036\242M\263\200#5\26777\216\247\2016)\376\017\210\302\356\a\302?<\261}\2075+@\235\333\203\250k\320A\252\307\326;\027\304\000\233i||\r\247W\022\215\215\a\376{\252\203.\252\270\023T\316\326\354\206\305\275\201\211k\325b\277\335\331\237\025\270\247#\321\374\275\ak\300\351\342\307\323@\270\260\307;\177=\266#\'m}\214SD\267\3164\201\020\260m\303\266\357\002\036\264\250i\370\252*\022*\322\244\211\330\004N\323\231}\276\r\001D\237\247\305\322\240\262\340E\240\'Do\n\024\212\b\372\355\321\257\227\374\274>pL\257g\253\350\347\3261\344\341\246-\263U\343\006kC6\320\240\344c\311\351i\b\202\337\363\370d\333\244&\335o\237\207C^\241z\316\031*tCK8ZGy\333\33221\313q\331M\3118_\257\241\371\330\271\366\360\321\b7u\2166\n\037\325L\321\254\004\026\267\210\262\245lA]\340\300rM\241\362\354\177\354\230\377Bh\324\227w\n\224\310@\333\365.\030&K\334\320\222ov^9W\212T\303\bb\260x\214\334[\331\372\262\'V\336\247\310u\317*)\027A`uy-\335\374=\aX\271\256\253\201\224\256\001\357o[r\314\354v}\235\260\367$\221{\177\bR\352p\n\207\025\271_3x`#\224;\034\205\201l\330t\022=2\267tb\f!\236n\253\307\001\005\262\247\224\224B\313\267$\316$1\326B\327\204\213Q\277\320\222V1\202\251\354^l\227Uw\227,yP\264\3440"
