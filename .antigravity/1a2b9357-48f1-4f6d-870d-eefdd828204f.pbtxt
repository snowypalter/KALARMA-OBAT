  view_file {
    absolute_path_uri: "file:///src/components/Header.tsx"
    end_line: 122
    content: "import React from \'react\';\nimport { TabType } from \'../types\';\nimport { Pill, Info } from \'lucide-react\';\n\ninterface HeaderProps {\n  currentTab: TabType;\n  onNavigate: (tab: TabType) => void;\n  onOpenAbout: () => void;\n  onOpenTinjau: () => void;\n}\n\nexport const Header: React.FC<HeaderProps> = ({\n  currentTab,\n  onNavigate,\n  onOpenAbout,\n  onOpenTinjau,\n}) => {\n  return (\n    <header className=\"sticky top-0 z-30 bg-white/95 backdrop-blur-md border-b border-slate-200\">\n      <div className=\"max-w-5xl mx-auto px-4 h-14 md:h-16 flex items-center justify-between gap-3\">\n        {/* Zone 1: Wordmark */}\n        <button\n          type=\"button\"\n          onClick={() => onNavigate(\'beranda\')}\n          className=\"flex items-center gap-2 group text-left cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-teal-600 rounded-lg p-1\"\n          aria-label=\"Kembali ke Beranda Ruang Obat\"\n        >\n          <div className=\"w-8 h-8 rounded-lg bg-teal-700 text-white flex items-center justify-center shadow-sm\">\n            <Pill className=\"w-5 h-5 text-white transform -rotate-45\" />\n          </div>\n          <div className=\"flex flex-col\">\n            <span className=\"text-lg font-bold tracking-tight text-teal-900 leading-tight\">\n              Ruang Obat\n            </span>\n          </div>\n        </button>\n\n        {/* Zone 2: Desktop Nav Links */}\n        <nav className=\"hidden md:flex items-center gap-6 text-sm font-medium\">\n          <button\n            type=\"button\"\n            onClick={() => onNavigate(\'beranda\')}\n            className={`whitespace-nowrap py-1 transition-colors ${\n              currentTab === \'beranda\'\n                ? \'text-teal-800 font-semibold border-b-2 border-teal-700\'\n                : \'text-slate-600 hover:text-teal-700\'\n            }`}\n          >\n            Beranda\n          </button>\n          <button\n            type=\"button\"\n            onClick={() => onNavigate(\'cek-label\')}\n            className={`whitespace-nowrap py-1 transition-colors ${\n              currentTab === \'cek-label\'\n                ? \'text-teal-800 font-semibold border-b-2 border-teal-700\'\n                : \'text-slate-600 hover:text-teal-700\'\n            }`}\n          >\n            Cek Label\n          </button>\n          <button\n            type=\"button\"\n            onClick={() => onNavigate(\'lemari\')}\n            className={`whitespace-nowrap py-1 transition-colors ${\n              currentTab === \'lemari\'\n                ? \'text-teal-800 font-semibold border-b-2 border-teal-700\'\n                : \'text-slate-600 hover:text-teal-700\'\n            }`}\n          >\n            Lemari Obat\n          </button>\n          <button\n            type=\"button\"\n            onClick={() => onNavigate(\'latihan\')}\n            className={`whitespace-nowrap py-1 transition-colors ${\n              currentTab === \'latihan\'\n                ? \'text-teal-800 font-semibold border-b-2 border-teal-700\'\n                : \'text-slate-600 hover:text-teal-700\'\n            }`}\n          >\n            Latihan\n          </button>\n          <button\n            type=\"button\"\n            onClick={() => onNavigate(\'pustaka\')}\n            className={`whitespace-nowrap py-1 transition-colors ${\n              currentTab === \'pustaka\'\n                ? \'text-teal-800 font-semibold border-b-2 border-teal-700\'\n                : \'text-slate-600 hover:text-teal-700\'\n            }`}\n          >\n            Pustaka\n          </button>\n        </nav>\n\n        {/* Zone 3: Primary Actions */}\n        <div className=\"flex items-center gap-2\">\n          <button\n            type=\"button\"\n            onClick={onOpenTinjau}\n            className=\"min-h-[44px] px-3 py-2 text-xs font-bold text-white bg-teal-700 hover:bg-teal-800 rounded-xl flex items-center gap-1.5 transition-all shadow-xs cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-teal-600\"\n            aria-label=\"Buka tautan untuk dosen atau Claude AI\"\n          >\n            <span className=\"hidden sm:inline\">Tinjau / Bagikan</span>\n            <span className=\"sm:hidden\">Tinjau</span>\n          </button>\n\n          <button\n            type=\"button\"\n            onClick={onOpenAbout}\n            className=\"min-h-[44px] min-w-[44px] px-2.5 py-2 text-xs font-semibold text-slate-700 hover:text-teal-800 bg-slate-100 hover:bg-teal-50 border border-slate-200 rounded-xl flex items-center justify-center gap-1.5 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-teal-600 cursor-pointer\"\n            aria-label=\"Tentang Ruang Obat dan Pengembang\"\n          >\n            <Info className=\"w-4 h-4 text-slate-600 hover:text-teal-700\" />\n            <span className=\"hidden md:inline\">Tentang</span>\n          </button>\n        </div>\n      </div>\n    </header>\n  );\n};\n"
    num_lines: 123
    num_bytes: 4802
    line_range_bytes: 4802
  }
}
