  view_file {
    absolute_path_uri: "file:///src/utils/generatePdfClient.ts"
    end_line: 119
    content: "import { jsPDF } from \'jspdf\';\n\nexport const generateAndDownloadPdf = (options?: {\n  researcherName?: string;\n  nim?: string;\n  university?: string;\n}) => {\n  const doc = new jsPDF({\n    orientation: \'portrait\',\n    unit: \'mm\',\n    format: \'a4\',\n  });\n\n  const TEAL_DARK: [number, number, number] = [15, 118, 110]; // #0f766e\n  const TEAL_LIGHT: [number, number, number] = [240, 253, 250]; // #f0fdfa\n  const SLATE_DARK: [number, number, number] = [30, 41, 59]; // #1e293b\n  const SLATE_MUTED: [number, number, number] = [100, 116, 139]; // #64748b\n  const AMBER_DARK: [number, number, number] = [180, 83, 9]; // #b45309\n  const BORDER_COLOR: [number, number, number] = [226, 232, 240]; // #e2e8f0\n\n  let pageNum = 1;\n\n  function drawHeaderFooter(title: string) {\n    // Top Header Line\n    doc.setDrawColor(...BORDER_COLOR);\n    doc.setLineWidth(0.3);\n    doc.line(15, 14, 195, 14);\n\n    doc.setFont(\'helvetica\', \'normal\');\n    doc.setFontSize(8);\n    doc.setTextColor(...SLATE_MUTED);\n    doc.text(\'RUANG OBAT \302\267 PROTOTIPE MEDIA EDUKASI SKRIPSI S1 FARMASI\', 15, 11);\n    doc.text(title, 195, 11, { align: \'right\' });\n\n    // Bottom Footer Line\n    doc.line(15, 282, 195, 282);\n    doc.text(\n      \'Edukasi umum, bukan diagnosis atau saran dosis pribadi. Tanyakan ke apoteker atau dokter.\',\n      15,\n      286\n    );\n    doc.text(`Halaman ${pageNum}`, 195, 286, { align: \'right\' });\n  }\n\n  // ==========================================\n  // HALAMAN 1: COVER / HALAMAN JUDUL\n  // ==========================================\n  doc.setFillColor(...TEAL_DARK);\n  doc.rect(0, 0, 210, 22, \'F\');\n\n  doc.setFont(\'helvetica\', \'bold\');\n  doc.setFontSize(11);\n  doc.setTextColor(255, 255, 255);\n  doc.text(\'INSTRUMEN PENELITIAN SKRIPSI S1 FARMASI KLINIS & KOMUNITAS\', 105, 14, { align: \'center\' });\n\n  // Main Card Box\n  doc.setFillColor(248, 250, 252);\n  doc.setDrawColor(...TEAL_DARK);\n  doc.setLineWidth(0.8);\n  doc.roundedRect(15, 35, 180, 115, 4, 4, \'FD\');\n\n  // Subtitle pill\n  doc.setFillColor(...TEAL_LIGHT);\n  doc.setDrawColor(153, 246, 228);\n  doc.roundedRect(25, 44, 160, 10, 2, 2, \'FD\');\n  doc.setFont(\'helvetica\', \'bold\');\n  doc.setFontSize(9);\n  doc.setTextColor(...TEAL_DARK);\n  doc.text(\'DOKUMEN SPESIFIKASI PROTOTIPE MEDIA EDUKASI DIGITAL\', 105, 50.5, { align: \'center\' });\n\n  // Big Title\n  doc.setFont(\'helvetica\', \'bold\');\n  doc.setFontSize(26);\n  doc.setTextColor(...SLATE_DARK);\n  doc.text(\'RUANG OBAT\', 105, 70, { align: \'center\' });\n\n  // Tagline\n  doc.setFont(\'helvetica\', \'normal\');\n  doc.setFontSize(13);\n  doc.setTextColor(...TEAL_DARK);\n  doc.text(\'\"Kenali label obatmu, kelola obat di rumahmu\"\', 105, 80, { align: \'center\' });\n\n  doc.setDrawColor(...BORDER_COLOR);\n  doc.setLineWidth(0.4);\n  doc.line(40, 88, 170, 88);\n\n  // Description paragraph\n  doc.setFont(\'helvetica\', \'normal\');\n  doc.setFontSize(10);\n  doc.setTextColor(...SLATE_MUTED);\n  const coverDesc =\n    \'Dokumen prototipe media edukasi interaktif untuk pengenalan informasi etiket/kemasan obat dan pengelolaan obat rumah tangga (Dagusibu). Disiapkan untuk peninjauan Dosen Pembimbing, Dosen Penguji, dan Evaluasi Desain Instruksional menggunakan Claude AI.\';\n  const splitCoverDesc = doc.splitTextToSize(coverDesc, 150);\n  doc.text(splitCoverDesc, 105, 96, { align: \'center\' });\n\n  // Information Grid Box\n  doc.setFillColor(255, 255, 255);\n  doc.setDrawColor(...BORDER_COLOR);\n  doc.roundedRect(15, 160, 180, 80, 3, 3, \'FD\');\n\n  doc.setFont(\'helvetica\', \'bold\');\n  doc.setFontSize(11);\n  doc.setTextColor(...SLATE_DARK);\n  doc.text(\'INFORMASI IDENTITAS PENELITIAN\', 22, 172);\n\n  doc.setFont(\'helvetica\', \'normal\');\n  doc.setFontSize(9.5);\n  doc.setTextColor(...SLATE_DARK);\n\n  const metaRows = [\n    [\'Nama Aplikasi Web\', \': Ruang Obat (Mobile-First Progressive Web App)\'],\n    [\'Bidang Keilmuan\', \': Farmasi Klinis & Komunitas (S1 Farmasi)\'],\n    [\'Sasaran Edukasi\', \': Mahasiswa Non-Kesehatan dan Masyarakat Umum\'],\n    [\'Peneliti / Penyusun\', `: ${options?.researcherName || \'[ISI NAMA PENGEMBANG / PENELITI SKRIPSI]\'}`],\n    [\'NIM & Institusi\', `: ${options?.nim || \'[ISI NIM]\'} - ${options?.university || \'[ISI PROGRAM STUDI & UNIVERSITAS]\'}`],\n    [\'Tahun Penyusunan\', \': 2026\'],\n    [\'Status Prototipe\', \': Tahap 1 Selesai (Beranda, Cek Label 3 Sediaan, Lemari Obat, Kamus)\'],\n    [\'Aksesibilitas\', \': Tersedia Mode Baca Lengkap & File PDF Offline\'],\n  ];\n"
    num_lines: 544
    num_bytes: 22248
    line_range_bytes: 4349
  }
}
