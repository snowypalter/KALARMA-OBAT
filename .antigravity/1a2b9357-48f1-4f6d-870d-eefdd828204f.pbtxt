       <span>Ulangi Uji Ini</span>\\n              </button>\\n            </div>\\n          </div>\\n\\n          {/* Research Questionnaire Card */}\\n          <div className=\\\"p-5 rounded-2xl bg-status-segera-bg/65 border border-status-segera-text/20 text-ink space-y-3 text-xs sm:text-sm\\\">\\n            <div className=\\\"flex flex-col sm:flex-row sm:items-center justify-between gap-3\\\">\\n              <div className=\\\"space-y-0.5\\\">\\n                <div className=\\\"font-bold text-status-segera-text\\\">\\n                  Integrasi Kuesioner Responden Penelitian\\n                </div>\\n                <p className=\\\"text-ink-muted text-xs\\\">\\n                  Apakah Anda responden penelitian skripsi ini? Masukkan skor Anda ke formulir evaluasi resmi.\\n                </p>\\n              </div>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => setShowFormHint((prev) => !prev)}\\n                className=\\\"min-h-[42px] px-4 py-2 rounded-xl bg-status-segera-text hover:opacity-90 text-white font-semibold text-xs flex items-center justify-center gap-1.5 shrink-0 transition-opacity cursor-pointer\\\"\\n              >\\n                <span>Isi Kuesioner Google Form</span>\\n                <ExternalLink className=\\\"w-3.5 h-3.5\\\" />\\n              </button>\"}], \"TargetFile\":\"/src/components/latihan/KuisModule.tsx\", \"toolAction\":\"Updating KuisModule.tsx\", \"toolSummary\":\"Update KuisModule.tsx\"}"
