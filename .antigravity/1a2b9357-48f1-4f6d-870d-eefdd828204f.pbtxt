    content: "import { PackagingData } from \'../types\';\n\nexport const PACKAGING_ITEMS: Record<string, PackagingData> = {\n  tablet: {\n    type: \'tablet\',\n    title: \'Strip / Blister Tablet\',\n    subtitle: \'Simulasi kemasan primer & sekunder sediaan padat\',\n    hotspots: [\n      {\n        id: 1,\n        number: 1,\n        title: \'Logo Golongan Obat\',\n        shortDescription: \'Tanda lingkaran penanda tingkat keamanan dan izin perolehan obat.\',\n        xPercent: 18,\n        yPercent: 18,\n        content: {\n          meaning: \'[ISI DARI RUJUKAN: BPOM - Pedoman Tanda Khusus Obat Jadi]\',\n          tips: \'[ISI DARI RUJUKAN: Kemenkes RI - Mengenali Lingkaran Hijau, Biru, dan Merah Huruf K]\',\n          warning: \'[ISI DARI RUJUKAN: BPOM - Bahaya Membeli Obat Keras Tanpa Resep Dokter]\'\n        }\n      },\n      {\n        id: 2,\n        number: 2,\n        title: \'Nama & Komposisi Zat Aktif\',\n        shortDescription: \'Nama dagang/generik dan jumlah zat aktif per tablet.\',\n        xPercent: 50,\n        yPercent: 28,\n        content: {\n          meaning: \'[ISI DARI RUJUKAN: BPOM - Ketentuan Informasi Nama Zat Berkhasiat]\',\n          tips: \'[ISI DARI RUJUKAN: Farmakope Indonesia - Membedakan Nama Dagang dan Nama Generik]\',\n          warning: \'[ISI DARI RUJUKAN: Kemenkes RI - Waspada Mengonsumsi Obat Berbeda Merk dengan Zat Aktif yang Sama (Duplikasi Dosis)]\'\n        }\n      },\n      {\n        id: 3,\n        number: 3,\n        title: \'Indikasi (Kegunaan)\',\n        shortDescription: \'Kondisi atau gejala medis yang telah disetujui untuk diobati.\',\n        xPercent: 50,\n        yPercent: 46,\n        content: {\n          meaning: \'[ISI DARI RUJUKAN: BPOM - Definisi dan Ruang Lingkup Indikasi Terdaftar]\',\n          tips: \'[ISI DARI RUJUKAN: Kemenkes RI - Cara Membaca Gejala yang Cocok dengan Indikasi Obat]\',\n          warning: \'[ISI DARI RUJUKAN: BPOM - Hindari Menggunakan Obat di Luar Indikasi Resmi Tanpa Arahan Dokter]\'\n        }\n      },\n      {\n        id: 4,\n        number: 4,\n        title: \'Aturan Pakai & Peringatan\',\n        shortDescription: \'Frekuensi minum, hubungan dengan waktu makan, dan kontraindikasi.\',\n        xPercent: 50,\n        yPercent: 64,\n        content: {\n          meaning: \'[ISI DARI RUJUKAN: BPOM - Informasi Posologi dan Cara Penggunaan Sediaan]\',\n          tips: \'[ISI DARI RUJUKAN: Kemenkes RI - Mengartikan Frekuensi Minum Obat (Misal: 3x1 hari = setiap 8 jam)]\',\n          warning: \'[ISI DARI RUJUKAN: Farmakologi Klinis - Peringatan Khusus untuk Pasien Maag, Ibu Hamil, atau Gangguan Ginjal]\'\n        }\n      },\n      {\n        id: 5,\n        number: 5,\n        title: \'Tanggal Kedaluwarsa & No. Bets\',\n        shortDescription: \'Batas akhir obat dijamin mutu dan keamanannya (Exp. Date).\',\n        xPercent: 82,\n        yPercent: 82,\n        content: {\n          meaning: \'[ISI DARI RUJUKAN: BPOM - Batas Waktu Expired Date dan Nomor Batch]\',\n          tips: \'[ISI DARI RUJUKAN: Kemenkes RI - Cara Menemukan Tanggal Cetak Emboss pada Ujung Strip Tablet]\',\n          warning: \'[ISI DARI RUJUKAN: BPOM - Larangan Mengonsumsi Obat yang Telah Melewati Tanggal Kedaluwarsa]\'\n        }\n      },\n      {\n        id: 6,\n        number: 6,\n        title: \'Nomor Izin Edar (NIE BPOM)\',\n        shortDescription: \'Kode resmi 15 digit bukti obat terdaftar di BPOM RI.\',\n        xPercent: 25,\n        yPercent: 82,\n        content: {\n          meaning: \'[ISI DARI RUJUKAN: BPOM - Struktur Arti Huruf dan Digit Nomor Izin Edar]\',\n          tips: \'[ISI DARI RUJUKAN: BPOM - Cara Cek Keaslian Produk melalui Aplikasi BPOM Mobile]\',\n          warning: \'[ISI DARI RUJUKAN: BPOM - Bahaya Membeli Obat Tanpa Nomor Izin Edar Resmi]\'\n        }\n      }\n    ]\n  },\n  sirup: {\n    type: \'sirup\',\n    title: \'Botol Sirup / Suspensi\',\n    subtitle: \'Simulasi kemasan sediaan cair obat minum\',\n    hotspots: [\n      {\n        id: 1,\n        number: 1,\n        title: \'Logo Golongan Obat\',\n        shortDescription: \'Tanda lingkaran golongan obat pada label badan botol.\',\n        xPercent: 28,\n        yPercent: 32,\n        content: {\n          meaning: \'[ISI DARI RUJUKAN: BPOM - Tanda Khusus pada Label Kemasan Sirup]\',\n          tips: \'[ISI DARI RUJUKAN: Kemenkes RI - Cara Mengenali Obat Bebas Terbatas pada Sirup Batuk/Flu]\',\n          warning: \'[ISI DARI RUJUKAN: BPOM - Pengawasan Ketat Sirup Anak dan Bahan Pelarut Aman]\'\n        }\n      },\n      {\n        id: 2,\n        number: 2,\n        title: \'Nama & Konsentrasi per Sendok (5 mL)\',\n        shortDescription: \'Contoh: Tiap 5 mL mengandung zat aktif ... mg.\',\n        xPercent: 52,\n        yPercent: 42,\n        content: {\n          meaning: \'[ISI DARI RUJUKAN: BPOM - Standar Penulisan Kekuatan Sediaan Cair]\',\n          tips: \'[ISI DARI RUJUKAN: Kemenkes RI - Wajib Menggunakan Sendok Takar Resmi Bawaan Obat, Bukan Sendok Makan Dapur]\',\n          warning: \'[ISI DARI RUJUKAN: Farmasi Klinis - Risiko Ketidaktepatan Volume jika Menggunakan Sendok Makan Biasa]\'\n        }\n      },\n      {\n        id: 3,\n        number: 3,\n        title: \'Indikasi & Peruntukan Usia\',\n        shortDescription: \'Kegunaan obat dan batasan usia yang diperbolehkan.\',\n        xPercent: 52,\n        yPercent: 54,\n        content: {\n          meaning: \'[ISI DARI RUJUKAN: BPOM - Indikasi dan Batas Usia Konsumsi Sirup]\',\n          tips: \'[ISI DARI RUJUKAN: Kemenkes RI - Menyesuaikan Dosis dengan Kelompok Umur atau Berat Badan]\',\n          warning: \'[ISI DARI RUJUKAN: IDAI / BPOM - Larangan Memberikan Sirup Tertentu pada Bayi di Bawah Umur Tanpa Resep]\'\n        }\n      },\n      {\n        id: 4,\n        number: 4,\n        title: \'Instruksi Khusus: \"Kocok Dahulu\"\',\n        shortDescription: \'Pentingnya homogenisasi larutan sebelum diminum.\',\n        xPercent: 52,\n        yPercent: 66,\n        content: {\n          meaning: \'[ISI DARI RUJUKAN: Farmakope Indonesia - Prinsip Homogenitas Sediaan Suspensi]\',\n          tips: \'[ISI DARI RUJUKAN: Kemenkes RI - Cara Mengocok Botol dengan Benar Sebelum Dituang]\',\n          warning: \'[ISI DARI RUJUKAN: Farmakologi - Risiko Mengendapnya Zat Aktif jika Tidak Dikocok]\'\n        }\n      },\n      {\n        id: 5,\n        number: 5,\n        title: \'Batas Simpan Setelah Dibuka (BUD)\',\n        shortDescription: \'Beyond Use Date: batas waktu pakai setelah segel botol dibuka.\',\n        xPercent: 72,\n        yPercent: 78,\n        content: {\n          meaning: \'[ISI DARI RUJUKAN: USP / Kemenkes RI - Perbedaan Expired Date Pabrik vs Beyond Use Date]\',\n          tips: \'[ISI DARI RUJUKAN: Kemenkes RI - Kebiasaan Menulis Tanggal Pertama Buka Botol pada Label]\',\n          warning: \'[ISI DARI RUJUKAN: BPOM - Tanda Kerusakan Sirup: Berubah Warna, Keruh, Berbau Asam, atau Ada Kristal]\'\n        }\n      },\n      {\n        id: 6,\n        number: 6,\n        title: \'Nomor Izin Edar (NIE BPOM)\',\n        shortDescription: \'Kode registrasi resmi izin edar cairan obat dalam negeri.\',\n        xPercent: 32,\n        yPercent: 78,\n        content: {\n          meaning: \'[ISI DARI RUJUKAN: BPOM - Ketentuan NIE pada Label Botol Kaca atau Plastik]\',\n          tips: \'[ISI DARI RUJUKAN: BPOM - Verifikasi NIE Kemasan Cair Melalui Aplikasi Cek BPOM]\',\n          warning: \'[ISI DARI RUJUKAN: BPOM - Kewaspadaan Terhadap Kemasan Sirup Tanpa Segel atau Tanpa NIE]\'\n        }\n      }\n    ]\n  },\n  salep: {\n    type: \'salep\',\n    title: \'Tube Salep / Krim\',\n    subtitle: \'Simulasi kemasan sediaan semipadat obat luar\',\n    hotspots: [\n      {\n        id: 1,\n        number: 1,\n        title: \'Peringatan: \"Obat Luar - Tidak Untuk Ditelan\"\',\n        shortDescription: \'Tanda khusus dan rute pemberian topikal/kulit.\',\n        xPercent: 20,\n        yPercent: 42,\n        content: {\n          meaning: \'[ISI DARI RUJUKAN: BPOM - Ketentuan Tanda Peringatan Sediaan Topikal/Luar]\',\n          tips: \'[ISI DARI RUJUKAN: Kemenkes RI - Mengidentifikasi Label Biru Obat Luar pada Kemasan]\',\n          warning: \'[ISI DARI RUJUKAN: BPOM - Bahaya Menelan atau Mengoleskan Dekat Selaput Lendir jika Tidak Diindikasikan]\'\n        }\n      },\n      {\n        id: 2,\n        number: 2,\n        title: \'Nama Zat Aktif & Persentase (%)\',\n        shortDescription: \'Contoh: Hidrokortison 1% atau Ketokonazol 2%.\',\n        xPercent: 44,\n        yPercent: 42,\n        content: {\n          meaning: \'[ISI DARI RUJUKAN: Farmakope Indonesia - Kadar Zat Aktif Sediaan Semisolida]\',\n          tips: \'[ISI DARI RUJUKAN: Kemenkes RI - Memahami Kadar Persentase Kekuatan Krim/Salep]\',\n          warning: \'[ISI DARI RUJUKAN: BPOM - Peringatan Pemakaian Salep Kortikosteroid Tanpa Pengawasan Dokter]\'\n        }\n      },\n      {\n        id: 3,\n        number: 3,\n        title: \'Indikasi Masalah Kulit\',\n        shortDescription: \'Kondisi kulit spesifik: gatal alergi, infeksi jamur, atau luka luar.\',\n        xPercent: 62,\n        yPercent: 42,\n        content: {\n          meaning: \'[ISI DARI RUJUKAN: BPOM - Indikasi Resmi Terdaftar untuk Salep/Krim Kulit]\',\n          tips: \'[ISI DARI RUJUKAN: Kemenkes RI - Membedakan Salep Jamur vs Salep Alergi]\',\n          warning: \'[ISI DARI RUJUKAN: Dermatologi / Farmakologi - Efek Samping Penipisan Kulit Akibat Salah Salep]\'\n        }\n      },\n      {\n        id: 4,\n        number: 4,\n        title: \'Cara Pengolesan & Higienitas\',\n        shortDescription: \'Cuci tangan sebelum & sesudah, oleskan tipis merata.\',\n        xPercent: 78,\n        yPercent: 42,\n        content: {\n          meaning: \'[ISI DARI RUJUKAN: Kemenkes RI - Prosedur Higienis Aplikasi Obat Topikal Kulit]\',\n          tips: \'[ISI DARI RUJUKAN: Kemenkes RI - Bersihkan Area yang Akan Diobati dan Keringkan Dahulu]\',\n          warning: \'[ISI DARI RUJUKAN: Farmasi Komunitas - Hindari Menyentuhkan Ujung Tube Langsung ke Luka Bernanah]\'\n        }\n      },\n      {\n        id: 5,\n        number: 5,\n        title: \'Kedaluwarsa & Segel Lipatan Tube\',\n        shortDescription: \'Tanggal kedaluwarsa sering dicetak tekan pada lipatan belakang tube.\',\n        xPercent: 92,\n        yPercent: 42,\n        content: {\n          meaning: \'[ISI DARI RUJUKAN: BPOM - Standar Pencetakan Kedaluwarsa pada Tube Logam/Aluminium/Plastik]\',\n          tips: \'[ISI DARI RUJUKAN: Kemenkes RI - Menemukan Angka Cetak Timbul pada Ujung Lipatan Salep]\',\n          warning: \'[ISI DARI RUJUKAN: BPOM - Jangan Gunakan Salep jika Minyak Terpisah dari Dasar Krim atau Berbau Tengik]\'\n        }\n      },\n      {\n        id: 6,\n        number: 6,\n        title: \'Nomor Izin Edar & Logo Golongan\',\n        shortDescription: \'Kode NIE dan tanda lingkaran (Hijau, Biru, atau Merah K).\',\n        xPercent: 32,\n        yPercent: 65,\n        content: {\n          meaning: \'[ISI DARI RUJUKAN: BPOM - Registrasi NIE Salep Obat Bebas vs Keras]\',\n          tips: \'[ISI DARI RUJUKAN: BPOM - Memastikan Keaslian Nomor Registrasi Salep di Cek BPOM]\',\n          warning: \'[ISI DARI RUJUKAN: BPOM - Waspada Krim/Salep Racikan Ilegal yang Beredar Tanpa NIE]\'\n        }\n      }\n    ]\n  }\n};\n"
