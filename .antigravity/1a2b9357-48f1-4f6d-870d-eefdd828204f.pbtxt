              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        onPrev={() => setWalkthroughStepIndex((prev) => Math.max(prev - 1, 0))}"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        onSelectStep={(idx) => {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
