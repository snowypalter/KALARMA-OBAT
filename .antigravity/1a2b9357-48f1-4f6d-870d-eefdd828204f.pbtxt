            lines {
              text: "    - `--brand`: `#4A6D62` & `--primary`: `#64877D` (Sage utama untuk tombol aksi primer, indikator aktif, dan batas fokus)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    - `--sand`: `#D8B99A` (Pasir hangat untuk aksen editorial halus, pembatas, dan detail kartu gelap)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
