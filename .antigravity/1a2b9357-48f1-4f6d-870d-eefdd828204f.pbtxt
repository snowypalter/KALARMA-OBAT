      thinking_signature: "\022\303\022\n\300\022\001i\024}\023x\3603\344\346\245\365\3511\333q>}\252\230\362_u\244\307j\f\245z\312]<\361I\3129{\177\375Q\372\270\002\336\353S\201\206\3745\265\376\357jxe\001\223\236\034/q|D\312\373\024\257t\303\221\330\030\314\'\207/5\226\227]\332:\224\tb\325\206\352O\257R\001\304\211\364\037z)70\361\313@\264\350K\236z\353`\035q\274\317\260\250OH}u\342\305\030w\023\240Ic\366\355\302\350\022ZE4fh\"\354r\275d\336>\347E\206\204c\331\276\224\372.\3740\335]?\243\267h\022\375\352\245i\346d217\235\201\220\300{\262bj\205P\225m\310\235&\340Ws-<\005L)H\335\222X\"\263\227\221\261<\366\326\203\202d\020\266\035\362\275\t\033NZ=\206J\032\006\342h|\374\224\3525\031\223X\032\026\024\272ar?\251\003YvC\201\327\342\v\340\301\360E\312M\232\005r0\002/\251\374\324]\247Q\212\337\216\372\a(-A\317\241\325\016\273\0003i\362\335?\377\002\004\306|#\220\354&\373,O\252\036nvzk\277,Y\t\245\330\255S\353\177\244\327]\364\222\370\003\244g\267\257\361\263\354 \306\032\204\217j\277\241\304\2740\215T\221R\257Za_\032:\301\241\034}g\207\036\257\023\371/\342\223\377\316d?\357]&\375\3315\002\270\346s\214\304\332\343\023G\336\374(\237\243\377#\323\245H\a\242GHtJ\255\241^p\324\201\240b\025\362\323\274d\211@=\307}pe\306\237\341\241]\257\177\304\364\027\310\377{\243\312+V\326\312\222>\271~\312z\033\004\302\365\273t\342\375\240\310\3477\377\366@\373\302\214\346\206\365\352\216\241\357?\231\037l\260f\315j(\342\222\030\3040\026\360\276XF\371E\236\360&\306\340W\222\367\031|\313\326\021\244\267 i\374\036I\241\365\240\374\325sR\252?\b\2716\234U\236\263v.\355N\256\217\tb\177=WRtw\240Y\343\334\342\370fv-\231\032\213\261V\375\r\241\302\016M^Z\323q\273\273j~\261\347\244\344\212\237\301\354\021}\336S;\311\034\037N\337\327z\241\027\301\306\260)<\265\3651\256m\ar\271\345\t\317\021T\036\n\222\366\300Y>\340\304\243\367(~\001J\361C\3250#\356!o+d\fHj\031R\355\252\244P\264\3477\000\254\240\330\330\227\321\213es1\331\006\357\030\364\211<\255\n\300\254\332,\177\020s\f;oXV\315\375\344\351i\330\027\