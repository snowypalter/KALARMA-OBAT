  view_file {
    absolute_path_uri: "file:///src/components/PackagingSvg.tsx"
    end_line: 288
    content: "import React from \'react\';\nimport { PackagingType, LabelHotspot } from \'../types\';\n\ninterface PackagingSvgProps {\n  type: PackagingType;\n  hotspots: LabelHotspot[];\n  activeHotspotId: number | null;\n  onSelectHotspot: (id: number) => void;\n}\n\nexport const PackagingSvg: React.FC<PackagingSvgProps> = ({\n  type,\n  hotspots,\n  activeHotspotId,\n  onSelectHotspot,\n}) => {\n  return (\n    <div className=\"relative w-full max-w-md mx-auto aspect-[4/3] bg-gradient-to-b from-slate-100/90 to-slate-200/80 rounded-2xl p-4 flex items-center justify-center border border-slate-200 shadow-sm overflow-hidden select-none\">\n      {/* Background grid texture */}\n      <div \n        className=\"absolute inset-0 opacity-20 pointer-events-none\"\n        style={{\n          backgroundImage: \'radial-gradient(#0f766e 0.75px, transparent 0.75px)\',\n          backgroundSize: \'16px 16px\'\n        }}\n      />\n\n      {/* Packaging Illustration */}\n      {type === \'tablet\' && (\n        <svg\n          viewBox=\"0 0 380 270\"\n          className=\"w-full h-full max-h-[250px] drop-shadow-md\"\n          fill=\"none\"\n          xmlns=\"http://www.w3.org/2000/svg\"\n        >\n          {/* Outer Blister Foil */}\n          <rect x=\"25\" y=\"20\" width=\"330\" height=\"230\" rx=\"14\" fill=\"#E2E8F0\" stroke=\"#94A3B8\" strokeWidth=\"2.5\" />\n          <rect x=\"30\" y=\"25\" width=\"320\" height=\"220\" rx=\"10\" fill=\"#F8FAFC\" stroke=\"#CBD5E1\" strokeWidth=\"1\" />\n\n          {/* Grid of blister cavities (tablets) */}\n          <g opacity=\"0.85\">\n            {[0, 1, 2, 3].map((col) =>\n              [0, 1].map((row) => (\n                <g key={`blister-${col}-${row}`} transform={`translate(${55 + col * 75}, ${42 + row * 80})`}>\n                  <circle cx=\"25\" cy=\"25\" r=\"23\" fill=\"#E2E8F0\" stroke=\"#94A3B8\" strokeWidth=\"1.5\" />\n                  <circle cx=\"24\" cy=\"24\" r=\"19\" fill=\"#FFFFFF\" />\n                  {/* Tablet score line */}\n                  <line x1=\"24\" y1=\"9\" x2=\"24\" y2=\"39\" stroke=\"#E2E8F0\" strokeWidth=\"1.5\" strokeLinecap=\"round\" />\n                  <ellipse cx=\"20\" cy=\"19\" rx=\"8\" ry=\"4\" fill=\"#FFFFFF\" fillOpacity=\"0.8\" />\n                </g>\n              ))\n            )}\n          </g>\n\n          {/* Foil Print / Overlay Simulation */}\n          <rect x=\"35\" y=\"30\" width=\"310\" height=\"210\" rx=\"8\" fill=\"#FFFFFF\" fillOpacity=\"0.75\" />\n\n          {/* Hotspot 1: Logo Golongan Obat */}\n          <circle cx=\"70\" cy=\"52\" r=\"15\" fill=\"#22C55E\" stroke=\"#166534\" strokeWidth=\"2\" />\n          <text x=\"70\" y=\"55\" fontSize=\"8\" fontWeight=\"bold\" fill=\"#FFFFFF\" textAnchor=\"middle\">BEBAS</text>\n\n          {/* Hotspot 2: Nama Obat */}\n          <text x=\"190\" y=\"68\" fontSize=\"16\" fontWeight=\"800\" fill=\"#0F766E\" textAnchor=\"middle\" letterSpacing=\"0.5\">\n            PARASETAMOL 500 mg\n          </text>\n          <text x=\"190\" y=\"84\" fontSize=\"10\" fontWeight=\"600\" fill=\"#475569\" textAnchor=\"middle\">\n            Kaplet / Tablet Analgesik-Antipiretik\n          </text>\n\n          {/* Divider */}\n          <line x1=\"60\" y1=\"96\" x2=\"320\" y2=\"96\" stroke=\"#E2E8F0\" strokeWidth=\"1\" strokeDasharray=\"3 3\" />\n\n          {/* Hotspot 3: Indikasi */}\n          <text x=\"190\" y=\"118\" fontSize=\"9.5\" fontWeight=\"600\" fill=\"#1E293B\" textAnchor=\"middle\">\n            Indikasi: Meringankan sakit kepala, sakit gigi & demam\n          </text>\n\n          {/* Hotspot 4: Aturan Pakai */}\n          <text x=\"190\" y=\"152\" fontSize=\"9\" fontWeight=\"600\" fill=\"#334155\" textAnchor=\"middle\">\n            Dewasa: 1 kaplet 3-4 kali sehari setelah makan\n          </text>\n          <text x=\"190\" y=\"167\" fontSize=\"8\" fill=\"#64748B\" textAnchor=\"middle\">\n            Bila gejala berlanjut segera hubungi dokter\n          </text>\n\n          {/* Hotspot 6: NIE BPOM */}\n          <rect x=\"48\" y=\"200\" width=\"135\" height=\"24\" rx=\"4\" fill=\"#F1F5F9\" stroke=\"#CBD5E1\" strokeWidth=\"1\" />\n          <text x=\"115\" y=\"215\" fontSize=\"8.5\" fontWeight=\"700\" fill=\"#334155\" textAnchor=\"middle\">\n            No. Reg: DBL 2112345604 A1\n          </text>\n\n          {/* Hotspot 5: Exp Date & No. Bets */}\n          <rect x=\"195\" y=\"200\" width=\"145\" height=\"24\" rx=\"4\" fill=\"#FEF2F2\" stroke=\"#FECDD3\" strokeWidth=\"1\" />\n          <text x=\"267\" y=\"211\" fontSize=\"8\" fontWeight=\"700\" fill=\"#991B1B\" textAnchor=\"middle\">\n            EXP: 10/2028 \302\267 BETS: B84092\n          </text>\n          <text x=\"267\" y=\"220\" fontSize=\"7\" fill=\"#B91C1C\" textAnchor=\"middle\">\n            Jangan digunakan bila segel rusak\n          </text>\n        </svg>\n      )}\n\n      {type === \'sirup\' && (\n        <svg\n          viewBox=\"0 0 380 270\"\n          className=\"w-full h-full max-h-[250px] drop-shadow-md\"\n          fill=\"none\"\n          xmlns=\"http://www.w3.org/2000/svg\"\n        >\n          {/* Bottle silhouette */}\n          {/* Cap */}\n          <rect x=\"160\" y=\"12\" width=\"60\" height=\"26\" rx=\"4\" fill=\"#FFFFFF\" stroke=\"#64748B\" strokeWidth=\"2\" />\n          <line x1=\"168\" y1=\"18\" x2=\"168\" y2=\"32\" stroke=\"#CBD5E1\" strokeWidth=\"1.5\" />\n          <line x1=\"178\" y1=\"18\" x2=\"178\" y2=\"32\" stroke=\"#CBD5E1\" strokeWidth=\"1.5\" />\n          <line x1=\"190\" y1=\"18\" x2=\"190\" y2=\"32\" stroke=\"#CBD5E1\" strokeWidth=\"1.5\" />\n          <line x1=\"202\" y1=\"18\" x2=\"202\" y2=\"32\" stroke=\"#CBD5E1\" strokeWidth=\"1.5\" />\n          <line x1=\"212\" y1=\"18\" x2=\"212\" y2=\"32\" stroke=\"#CBD5E1\" strokeWidth=\"1.5\" />\n\n          {/* Neck */}\n          <rect x=\"168\" y=\"38\" width=\"44\" height=\"18\" fill=\"#CBD5E1\" stroke=\"#64748B\" strokeWidth=\"1.5\" />\n\n          {/* Bottle Body */}\n          <rect x=\"110\" y=\"56\" width=\"160\" height=\"195\" rx=\"16\" fill=\"#F8FAFC\" stroke=\"#64748B\" strokeWidth=\"2.5\" />\n          {/* Amber glass tint edge */}\n          <rect x=\"115\" y=\"60\" width=\"150\" height=\"187\" rx=\"12\" fill=\"#FEF3C7\" fillOpacity=\"0.4\" stroke=\"#F59E0B\" strokeWidth=\"0.5\" />\n\n          {/* Label Container */}\n          <rect x=\"122\" y=\"68\" width=\"136\" height=\"170\" rx=\"8\" fill=\"#FFFFFF\" stroke=\"#E2E8F0\" strokeWidth=\"1\" />\n\n          {/* Hotspot 1: Logo Golongan Obat (Bebas Terbatas Biru) */}\n          <circle cx=\"145\" cy=\"88\" r=\"11\" fill=\"#3B82F6\" stroke=\"#1D4ED8\" strokeWidth=\"1.5\" />\n          <circle cx=\"145\" cy=\"88\" r=\"9\" fill=\"#3B82F6\" stroke=\"#FFFFFF\" strokeWidth=\"1\" />\n\n          {/* Hotspot 2: Nama & Komposisi per 5 mL */}\n          <text x=\"190\" y=\"90\" fontSize=\"11\" fontWeight=\"800\" fill=\"#0F766E\" textAnchor=\"middle\">\n            SIRUP COUGH & FLU\n          </text>\n          <text x=\"190\" y=\"103\" fontSize=\"8\" fontWeight=\"600\" fill=\"#64748B\" textAnchor=\"middle\">\n            Tiap 5 mL mengandung 120 mg\n          </text>\n\n          {/* Hotspot 3: Indikasi & Usia */}\n          <rect x=\"130\" y=\"118\" width=\"120\" height=\"22\" rx=\"4\" fill=\"#F0FDFA\" stroke=\"#99F6E4\" strokeWidth=\"0.75\" />\n          <text x=\"190\" y=\"128\" fontSize=\"8\" fontWeight=\"700\" fill=\"#0F766E\" textAnchor=\"middle\">\n            Meringankan batuk & pilek\n          </text>\n          <text x=\"190\" y=\"137\" fontSize=\"7\" fill=\"#0D9488\" textAnchor=\"middle\">\n            Gunakan sendok takar obat\n          </text>\n\n          {/* Hotspot 4: Kocok Dahulu */}\n          <rect x=\"130\" y=\"148\" width=\"120\" height=\"20\" rx=\"4\" fill=\"#FEF3C7\" stroke=\"#FDE68A\" strokeWidth=\"0.75\" />\n          <text x=\"190\" y=\"161\" fontSize=\"8.5\" fontWeight=\"800\" fill=\"#92400E\" textAnchor=\"middle\">\n            ! KOCOK DAHULU !\n          </text>\n\n          {/* Hotspot 5: BUD & Expiry */}\n          <rect x=\"130\" y=\"174\" width=\"120\" height=\"30\" rx=\"4\" fill=\"#FFF1F2\" stroke=\"#FECDD3\" strokeWidth=\"0.75\" />\n          <text x=\"190\" y=\"185\" fontSize=\"7.5\" fontWeight=\"700\" fill=\"#991B1B\" textAnchor=\"middle\">\n            EXP: 07/2027 \302\267 BUD: 14-28 hari\n          </text>\n          <text x=\"190\" y=\"196\" fontSize=\"7\" fill=\"#B91C1C\" textAnchor=\"middle\">\n            Tulis tanggal saat pertama dibuka\n          </text>\n\n          {/* Hotspot 6: NIE BPOM */}\n          <text x=\"190\" y=\"222\" fontSize=\"7\" fontWeight=\"600\" fill=\"#64748B\" textAnchor=\"middle\">\n            No. Reg: DTL 1912345637 A1\n          </text>\n\n          {/* Measuring cup accessory beside bottle */}\n          <path d=\"M 290 160 L 330 160 L 325 240 L 295 240 Z\" fill=\"#E2E8F0\" fillOpacity=\"0.8\" stroke=\"#94A3B8\" strokeWidth=\"1.5\" />\n          <line x1=\"298\" y1=\"180\" x2=\"315\" y2=\"180\" stroke=\"#0F766E\" strokeWidth=\"1.5\" />\n          <text x=\"325\" y=\"183\" fontSize=\"8\" fill=\"#0F766E\" fontWeight=\"bold\">5 mL</text>\n          <line x1=\"297\" y1=\"205\" x2=\"312\" y2=\"205\" stroke=\"#64748B\" strokeWidth=\"1\" />\n          <text x=\"323\" y=\"208\" fontSize=\"7\" fill=\"#64748B\">2.5 mL</text>\n        </svg>\n      )}\n\n      {type === \'salep\' && (\n        <svg\n          viewBox=\"0 0 380 270\"\n          className=\"w-full h-full max-h-[250px] drop-shadow-md\"\n          fill=\"none\"\n          xmlns=\"http://www.w3.org/2000/svg\"\n        >\n          {/* Salep Tube Body (Horizontal Tube) */}\n          {/* Cap on left */}\n          <path d=\"M 50 100 L 70 100 L 70 150 L 50 150 Z\" fill=\"#FFFFFF\" stroke=\"#64748B\" strokeWidth=\"2\" />\n          <line x1=\"56\" y1=\"105\" x2=\"56\" y2=\"145\" stroke=\"#CBD5E1\" strokeWidth=\"1.5\" />\n          <line x1=\"64\" y1=\"105\" x2=\"64\" y2=\"145\" stroke=\"#CBD5E1\" strokeWidth=\"1.5\" />\n\n          {/* Neck nozzle */}\n          <rect x=\"70\" y=\"112\" width=\"16\" height=\"26\" fill=\"#94A3B8\" stroke=\"#64748B\" strokeWidth=\"1.5\" />\n\n          {/* Tube Aluminum Body */}\n          <path\n            d=\"M 86 100 L 310 88 L 340 86 L 340 164 L 310 162 L 86 150 Z\"\n            fill=\"#F8FAFC\"\n            stroke=\"#64748B\"\n            strokeWidth=\"2.5\"\n          />\n\n          {/* Shading/Sheen */}\n          <path\n            d=\"M 86 102 L 310 92 L 340 90 L 340 105 L 310 107 L 86 112 Z\"\n            fill=\"#FFFFFF\"\n            fillOpacity=\"0.9\"\n          />\n\n          {/* Crimped Edge on Right (Hotspot 5) */}\n          <rect x=\"325\" y=\"84\" width=\"22\" height=\"82\" rx=\"2\" fill=\"#E2E8F0\" stroke=\"#64748B\" strokeWidth=\"1.5\" />\n          <line x1=\"332\" y1=\"88\" x2=\"332\" y2=\"162\" stroke=\"#94A3B8\" strokeWidth=\"1\" strokeDasharray=\"2 2\" />\n          <text x=\"336\" y=\"128\" fontSize=\"7\" fontWeight=\"bold\" fill=\"#B91C1C\" transform=\"rotate(90 336 128)\" textAnchor=\"middle\">\n            EXP 09/27 B89\n          </text>\n\n          {/* Hotspot 1: Obat Luar Peringatan */}\n          <rect x=\"94\" y=\"116\" width=\"68\" height=\"18\" rx=\"3\" fill=\"#1D4ED8\" />\n          <text x=\"128\" y=\"128\" fontSize=\"6.5\" fontWeight=\"bold\" fill=\"#FFFFFF\" textAnchor=\"middle\">\n            OBAT LUAR\n          </text>\n\n          {/* Hotspot 2: Nama & Persentase */}\n          <text x=\"210\" y=\"116\" fontSize=\"13\" fontWeight=\"800\" fill=\"#0F766E\" textAnchor=\"middle\">\n            HIDROKORTISON 1%\n          </text>\n          <text x=\"210\" y=\"127\" fontSize=\"7.5\" fontWeight=\"600\" fill=\"#475569\" textAnchor=\"middle\">\n            Krim Kulit Anti-inflamasi 5 gram\n          </text>\n\n          {/* Hotspot 3: Indikasi */}\n          <text x=\"210\" y=\"139\" fontSize=\"7\" fontWeight=\"600\" fill=\"#334155\" textAnchor=\"middle\">\n            Indikasi: Meredakan kemerahan & gatal alergi kulit\n          </text>\n\n          {/* Hotspot 4: Cara Pengolesan */}\n          <text x=\"210\" y=\"149\" fontSize=\"6.5\" fill=\"#64748B\" textAnchor=\"middle\">\n            Oleskan tipis 2-3 kali sehari pada area yang bersih\n          </text>\n\n          {/* Hotspot 6: Logo & NIE */}\n          <circle cx=\"106\" cy=\"178\" r=\"10\" fill=\"#DC2626\" stroke=\"#991B1B\" strokeWidth=\"1.5\" />\n          <text x=\"106\" y=\"182\" fontSize=\"9\" fontWeight=\"bold\" fill=\"#FFFFFF\" textAnchor=\"middle\">K</text>\n          <text x=\"180\" y=\"181\" fontSize=\"8\" fontWeight=\"600\" fill=\"#334155\">\n            No. Reg: DKL 1812345629 A1\n          </text>\n        </svg>\n      )}\n\n      {/* Interactive Hotspot Tap Pins */}\n      {hotspots.map((hs) => {\n        const isActive = activeHotspotId === hs.id;\n        return (\n          <button\n            key={hs.id}\n            type=\"button\"\n            onClick={() => onSelectHotspot(hs.id)}\n            aria-label={`Titik ${hs.number}: ${hs.title}`}\n            aria-pressed={isActive}\n            style={{\n              left: `${hs.xPercent}%`,\n              top: `${hs.yPercent}%`,\n              transform: \'translate(-50%, -50%)\',\n            }}\n            className={`absolute z-20 group min-w-[44px] min-h-[44px] flex items-center justify-center focus:outline-none focus-visible:ring-2 focus-visible:ring-teal-600 focus-visible:ring-offset-2 rounded-full cursor-pointer transition-transform active:scale-95`}\n          >\n            {/* Pulsing ring on active */}\n            {isActive && (\n              <span className=\"absolute w-8 h-8 rounded-full bg-teal-500/30 animate-ping pointer-events-none\" />\n            )}\n            \n            {/* Circle badge */}\n            <span\n              className={`w-7 h-7 rounded-full flex items-center justify-center text-xs font-extrabold shadow-md transition-all ${\n                isActive\n                  ? \'bg-teal-700 text-white ring-4 ring-teal-200 scale-110\'\n                  : \'bg-white text-teal-800 border-2 border-teal-700 hover:bg-teal-50 hover:scale-105\'\n              }`}\n            >\n              {hs.number}\n            </span>\n          </button>\n        );\n      })}\n    </div>\n  );\n};\n"
    num_lines: 289
    num_bytes: 13076
    line_range_bytes: 13076
  }
}
