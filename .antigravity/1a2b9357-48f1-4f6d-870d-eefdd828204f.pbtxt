    content: "@import \"tailwindcss\";\n\n:root {\n  --bg: #F7F6F2;\n  --surface: #FFFFFF;\n  --surface-muted: #EFEEE8;\n  --surface-warm: #FBF9F5;\n  --elevated: #FFFFFF;\n  --line: #E2E4DC;\n  --line-strong: #5E7E74;\n  --ink: #22312C;\n  --ink-muted: #53645E;\n  --primary: #5E7E74;\n  --brand: #44665B;\n  --on-brand: #FFFFFF;\n  --secondary: #DCEAE5;\n  --forest: #243C36;\n  --sand: #D8B99A;\n  --sand-soft: #F3EAE0;\n  --focus: #44665B;\n\n  --status-aman-text: #275E45;\n  --status-aman-bg: #E3F0E9;\n  --status-segera-text: #7C4B0C;\n  --status-segera-bg: #F7EAD2;\n  --status-kedaluwarsa-text: #8C2D2D;\n  --status-kedaluwarsa-bg: #F6E0DD;\n}\n\n@theme inline {\n  --color-bg: var(--bg);\n  --color-surface: var(--surface);\n  --color-surface-muted: var(--surface-muted);\n  --color-surface-warm: var(--surface-warm);\n  --color-elevated: var(--elevated);\n  --color-line: var(--line);\n  --color-line-strong: var(--line-strong);\n  --color-ink: var(--ink);\n  --color-ink-muted: var(--ink-muted);\n  --color-primary: var(--primary);\n  --color-brand: var(--brand);\n  --color-on-brand: var(--on-brand);\n  --color-secondary: var(--secondary);\n  --color-forest: var(--forest);\n  --color-sand: var(--sand);\n  --color-sand-soft: var(--sand-soft);\n  --color-focus: var(--focus);\n\n  --color-status-aman-text: var(--status-aman-text);\n  --color-status-aman-bg: var(--status-aman-bg);\n  --color-status-segera-text: var(--status-segera-text);\n  --color-status-segera-bg: var(--status-segera-bg);\n  --color-status-kedaluwarsa-text: var(--status-kedaluwarsa-text);\n  --color-status-kedaluwarsa-bg: var(--status-kedaluwarsa-bg);\n\n  --font-display: \'Plus Jakarta Sans\', system-ui, sans-serif;\n  --font-heading: \'Plus Jakarta Sans\', system-ui, sans-serif;\n  --font-body: \'Plus Jakarta Sans\', system-ui, sans-serif;\n  --font-mono: \'DM Mono\', monospace;\n}\n\n@layer base {\n  body {\n    font-family: var(--font-body);\n    font-size: clamp(16px, 1.05vw, 17px);\n    line-height: 1.65;\n    color: var(--ink);\n    background-color: var(--bg);\n    -webkit-tap-highlight-color: transparent;\n    text-rendering: optimizeLegibility;\n  }\n\n  h1, h2, h3, h4, h5, h6 {\n    font-family: var(--font-heading);\n    color: var(--ink);\n    text-wrap: balance;\n  }\n\n  *:focus-visible {\n    outline: 2px solid var(--focus);\n    outline-offset: 2px;\n  }\n}\n\n.font-display {\n  font-family: var(--font-display);\n  letter-spacing: -0.02em;\n}\n\n.tabular-nums {\n  font-variant-numeric: tabular-nums;\n}\n\n/* Scrollbar hiding helper */\n.no-scrollbar::-webkit-scrollbar {\n  display: none;\n}\n.no-scrollbar {\n  -ms-overflow-style: none;\n  scrollbar-width: none;\n}\n\n/* Utilitas Animasi Compositor-Only (<= 200ms) */\n@keyframes roFadeIn {\n  from {\n    opacity: 0;\n    transform: translateY(5px);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n\n@keyframes roSheetIn {\n  from {\n    opacity: 0;\n    transform: translateY(14px);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n\n.ro-fade-in {\n  animation: roFadeIn 190ms cubic-bezier(0.16, 1, 0.3, 1) forwards;\n}\n\n.ro-sheet-in {\n  animation: roSheetIn 200ms cubic-bezier(0.16, 1, 0.3, 1) forwards;\n}\n\n/* Safe area inset untuk bottom bar mobile */\n.pb-safe {\n  padding-bottom: env(safe-area-inset-bottom, 0px);\n}\n\n/* 3D Flip Card Utilities */\n.perspective-1000 {\n  perspective: 1000px;\n}\n.transform-style-3d {\n  transform-style: preserve-3d;\n}\n.backface-hidden {\n  backface-visibility: hidden;\n  -webkit-backface-visibility: hidden;\n}\n.rotate-y-180 {\n  transform: rotateY(180deg);\n}\n\n/* Aturan reduced-motion */\n@media (prefers-reduced-motion: reduce) {\n  *,\n  *::before,\n  *::after {\n    animation-duration: 0.01ms !important;\n    animation-iteration-count: 1 !important;\n    transition-duration: 0.01ms !important;\n    scroll-behavior: auto !important;\n  }\n}\n\n/* Mode Print */\n@media print {\n  :root {\n    --bg: #FFFFFF !important;\n    --surface: #FFFFFF !important;\n    --ink: #000000 !important;\n    --line: #CCCCCC !important;\n  }\n\n  body {\n    background: #FFFFFF !important;\n    color: #000000 !important;\n  }\n\n  header,\n  nav[aria-label=\"Navigasi Utama\"],\n  .no-print {\n    display: none !important;\n  }\n}\n"
