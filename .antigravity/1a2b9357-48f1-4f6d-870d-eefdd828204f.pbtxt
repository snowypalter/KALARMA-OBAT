            lines {
              text: "Sasaran Pengguna:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "Mahasiswa non-kesehatan dan masyarakat umum."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "Aturan Ketat & Batasan Skripsi (Ethical Safeguards):"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "1. Murni edukasi umum; TIDAK ADA kalkulator dosis, diagnosis mandiri, atau rekomendasi obat/dosis tertentu."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "2. Tidak mencantumkan klaim \"ditinjau apoteker\", \"terverifikasi\", atau testimoni apa pun."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "3. Seluruh konten edukasi menggunakan acuan resmi BPOM RI, Kemenkes RI (Dagusibu), dan Farmakope Indonesia."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
