    end_line: 166
    content: "import React, { useState } from \'react\';\nimport { PANDUAN_SIMPAN_BUANG } from \'../data/panduanSimpanBuang\';\nimport { X, Trash2, ShieldAlert, Sparkles, Check } from \'lucide-react\';\n\ninterface PanduanSimpanBuangModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  initialTab?: \'simpan\' | \'buang\';\n}\n\nexport const PanduanSimpanBuangModal: React.FC<PanduanSimpanBuangModalProps> = ({\n  isOpen,\n  onClose,\n  initialTab = \'simpan\',\n}) => {\n  const [activeMode, setActiveMode] = useState<\'simpan\' | \'buang\'>(initialTab);\n  const [selectedSediaanIndex, setSelectedSediaanIndex] = useState<number>(0);\n\n  if (!isOpen) return null;\n\n  const currentItem = PANDUAN_SIMPAN_BUANG[selectedSediaanIndex] || PANDUAN_SIMPAN_BUANG[0];\n\n  return (\n    <div\n      className=\"fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-4 bg-slate-900/60 backdrop-blur-xs animate-in fade-in duration-200\"\n      role=\"dialog\"\n      aria-modal=\"true\"\n      aria-labelledby=\"panduan-title\"\n    >\n      <div className=\"bg-white rounded-2xl max-w-xl w-full max-h-[92vh] flex flex-col shadow-2xl border border-slate-200 overflow-hidden\">\n        {/* Header */}\n        <div className=\"flex items-center justify-between px-5 py-4 border-b border-slate-100 bg-teal-800 text-white\">\n          <div>\n            <h2 id=\"panduan-title\" className=\"text-base sm:text-lg font-bold\">\n              Panduan Simpan & Buang Obat\n            </h2>\n            <p className=\"text-xs text-teal-100\">\n              Prinsip Dagusibu (Kelola Obat Rumah Tangga dengan Benar)\n            </p>\n          </div>\n          <button\n            type=\"button\"\n            onClick={onClose}\n            className=\"min-h-[44px] min-w-[44px] rounded-lg text-teal-100 hover:text-white hover:bg-teal-700/50 flex items-center justify-center transition-colors cursor-pointer\"\n            aria-label=\"Tutup panduan simpan dan buang\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Tab Switcher: Simpan vs Buang */}\n        <div className=\"p-3 bg-slate-100 border-b border-slate-200\">\n          <div className=\"grid grid-cols-2 gap-2 bg-slate-200/80 p-1 rounded-xl\">\n            <button\n              type=\"button\"\n              onClick={() => setActiveMode(\'simpan\')}\n              className={`min-h-[44px] flex items-center justify-center gap-2 rounded-lg text-sm font-bold transition-all cursor-pointer ${\n                activeMode === \'simpan\'\n                  ? \'bg-white text-teal-900 shadow-xs\'\n                  : \'text-slate-600 hover:text-slate-900\'\n              }`}\n            >\n              <Sparkles className=\"w-4 h-4 text-teal-700\" />\n              <span>Cara Menyimpan</span>\n            </button>\n            <button\n              type=\"button\"\n              onClick={() => setActiveMode(\'buang\')}\n              className={`min-h-[44px] flex items-center justify-center gap-2 rounded-lg text-sm font-bold transition-all cursor-pointer ${\n                activeMode === \'buang\'\n                  ? \'bg-white text-rose-900 shadow-xs\'\n                  : \'text-slate-600 hover:text-slate-900\'\n              }`}\n            >\n              <Trash2 className=\"w-4 h-4 text-rose-600\" />\n              <span>Cara Membuang (Rusak)</span>\n            </button>\n          </div>\n        </div>\n\n        {/* Form Selector (Horizontal scroll chips) */}\n        <div className=\"px-4 py-2 border-b border-slate-100 flex items-center gap-2 overflow-x-auto no-scrollbar\">\n          <span className=\"text-xs font-semibold text-slate-500 whitespace-nowrap\">Bentuk:</span>\n          {PANDUAN_SIMPAN_BUANG.map((item, idx) => (\n            <button\n              key={item.title}\n              type=\"button\"\n              onClick={() => setSelectedSediaanIndex(idx)}\n              className={`min-h-[38px] px-3 py-1.5 rounded-lg text-xs font-medium whitespace-nowrap transition-colors cursor-pointer ${\n                selectedSediaanIndex === idx\n                  ? \'bg-teal-700 text-white font-semibold\'\n                  : \'bg-slate-100 text-slate-700 hover:bg-slate-200\'\n              }`}\n            >\n              {item.title}\n            </button>\n          ))}\n        </div>\n\n        {/* Content Body */}\n        <div className=\"p-5 overflow-y-auto space-y-4\">\n          <div className=\"flex items-center justify-between pb-2 border-b border-slate-100\">\n            <h3 className=\"text-base font-bold text-slate-900\">\n              {currentItem.title}\n            </h3>\n            <span className=\"text-xs text-slate-500 font-medium\">\n              Mode: {activeMode === \'simpan\' ? \'Penyimpanan yang Tepat\' : \'Pemusnahan & Pembuangan\'}\n            </span>\n          </div>\n\n          {/* List of rules */}\n          <div className=\"space-y-3\">\n            <h4 className=\"text-xs font-bold uppercase tracking-wider text-slate-500\">\n              {activeMode === \'simpan\' ? \'Langkah Penyimpanan Aman:\' : \'Langkah Membuang Obat Agar Tidak Disalahgunakan:\'}\n            </h4>\n\n            <ul className=\"space-y-2.5\">\n              {(activeMode === \'simpan\' ? currentItem.simpanRules : currentItem.buangRules).map((rule, idx) => (\n                <li\n                  key={idx}\n                  className=\"flex items-start gap-3 p-3 bg-slate-50 rounded-xl border border-slate-200/80 text-sm\"\n                >\n                  <div\n                    className={`w-6 h-6 rounded-full flex items-center justify-center shrink-0 mt-0.5 ${\n                      activeMode === \'simpan\'\n                        ? \'bg-teal-100 text-teal-800\'\n                        : \'bg-rose-100 text-rose-800\'\n                    }`}\n                  >\n                    {activeMode === \'simpan\' ? (\n                      <Check className=\"w-3.5 h-3.5 stroke-[2.5]\" />\n                    ) : (\n                      <span className=\"text-xs font-bold\">{idx + 1}</span>\n                    )}\n                  </div>\n                  <span className=\"text-slate-700 leading-snug\">{rule}</span>\n                </li>\n              ))}\n            </ul>\n          </div>\n\n          {/* Important note */}\n          <div className=\"p-3.5 bg-amber-50 rounded-xl border border-amber-200 flex items-start gap-3\">\n            <ShieldAlert className=\"w-5 h-5 text-amber-700 shrink-0 mt-0.5\" />\n            <div className=\"text-xs text-amber-900 space-y-1\">\n              <span className=\"font-bold block\">Tanda Kerusakan Fisik Obat:</span>\n              <p className=\"leading-relaxed\">{currentItem.catatanPenting}</p>\n            </div>\n          </div>\n        </div>\n\n        {/* Footer */}\n        <div className=\"px-5 py-3 bg-slate-50 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500\">\n          <span>Rujukan: Dagusibu Kemenkes & BPOM RI</span>\n          <button\n            type=\"button\"\n            onClick={onClose}\n            className=\"min-h-[44px] px-4 py-2 font-semibold text-slate-700 bg-white border border-slate-300 hover:bg-slate-50 rounded-xl transition-colors cursor-pointer\"\n          >\n            Tutup\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    num_lines: 167
    num_bytes: 7106
    line_range_bytes: 7106
  }
}
