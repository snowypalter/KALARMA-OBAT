      original_chunk {
        target_content: "  const handleNavigateLemariWithFilter = (filter: \'segera\' | \'kedaluwarsa\' | \'semua\') => {\n    setLemariFilter(filter);\n    setCurrentTab(\'lemari\');\n    window.scrollTo({ top: 0, behavior: \'smooth\' });\n  };\n\n  // Count expiring medicines for bottom nav badge\n  const expiringCount = medicines.filter((m) => {\n    const days = calculateDaysRemaining(m.expiryDate);\n    return days <= 30;\n  }).length;\n\n  return (\n    <div className=\"min-h-screen flex flex-col bg-slate-50 text-slate-800\">\n      {/* Top Header */}\n      <Header\n        currentTab={currentTab}\n        onNavigate={(tab) => {\n          setCurrentTab(tab);\n          window.scrollTo({ top: 0, behavior: \'smooth\' });\n        }}\n        onOpenAbout={() => setIsAboutOpen(true)}\n        onOpenTinjau={() => setIsTinjauOpen(true)}\n      />\n\n      {/* Main Content Area */}\n      <main className=\"flex-1 max-w-4xl w-full mx-auto px-4 py-4 sm:py-6 md:py-8\">\n        {currentTab === \'beranda\' && (\n          <BerandaView\n            onNavigate={(tab) => {\n              setCurrentTab(tab);\n              window.scrollTo({ top: 0, behavior: \'smooth\' });\n            }}\n            onNavigateLemariWithFilter={handleNavigateLemariWithFilter}\n            medicines={medicines}\n            onOpenKamus={() => setIsKamusOpen(true)}\n            onOpenTinjau={() => setIsTinjauOpen(true)}\n          />\n        )}\n\n        {currentTab === \'cek-label\' && (\n          <CekLabelView onOpenKamus={() => setIsKamusOpen(true)} />\n        )}\n\n        {currentTab === \'lemari\' && (\n          <LemariView\n            medicines={medicines}\n            onAddMedicine={handleAddMedicine}\n            onEditMedicine={handleEditMedicine}\n            onDeleteMedicine={handleDeleteMedicine}\n            initialFilter={lemariFilter}\n            onOpenPanduan={(mode = \'simpan\') =>\n              setPanduanState({ isOpen: true, mode })\n            }\n          />\n        )}\n\n        {currentTab === \'latihan\' && (\n          <LatihanPreviewView\n            onNavigate={(tab) => {\n              setCurrentTab(tab);\n              window.scrollTo({ top: 0, behavior: \'smooth\' });\n            }}\n          />\n        )}\n\n        {currentTab === \'pustaka\' && <PustakaView />}\n      </main>"
        replacement_content: "  const handleNavigateLemariWithFilter = (filter: \'segera\' | \'kedaluwarsa\' | \'semua\') => {\n    setLemariFilter(filter);\n    setCurrentTab(\'lemari\');\n    window.scrollTo({ top: 0, behavior: \'smooth\' });\n  };\n\n  // Quick navigation to Latihan with specific sub-module\n  const handleNavigateLatihan = (subTab: LatihanSubTab = \'skenario\') => {\n    setLatihanSubTab(subTab);\n    setCurrentTab(\'latihan\');\n    window.scrollTo({ top: 0, behavior: \'smooth\' });\n  };\n\n  // Count expiring medicines for bottom nav badge\n  const expiringCount = medicines.filter((m) => {\n    const days = calculateDaysRemaining(m.expiryDate);\n    return days <= 30;\n  }).length;\n\n  return (\n    <div className=\"min-h-screen flex flex-col bg-slate-50 text-slate-800\">\n      {/* Top Header */}\n      <Header\n        currentTab={currentTab}\n        onNavigate={(tab) => {\n          setCurrentTab(tab);\n          window.scrollTo({ top: 0, behavior: \'smooth\' });\n        }}\n        onOpenAbout={() => setIsAboutOpen(true)}\n        onOpenTinjau={() => setIsTinjauOpen(true)}\n      />\n\n      {/* Main Content Area */}\n      <main className=\"flex-1 max-w-4xl w-full mx-auto px-4 py-4 sm:py-6 md:py-8\">\n        {currentTab === \'beranda\' && (\n          <BerandaView\n            onNavigate={(tab) => {\n              setCurrentTab(tab);\n              window.scrollTo({ top: 0, behavior: \'smooth\' });\n            }}\n            onNavigateLemariWithFilter={handleNavigateLemariWithFilter}\n            onNavigateLatihan={handleNavigateLatihan}\n            medicines={medicines}\n            onOpenKamus={() => setIsKamusOpen(true)}\n            onOpenTinjau={() => setIsTinjauOpen(true)}\n          />\n        )}\n\n        {currentTab === \'cek-label\' && (\n          <CekLabelView onOpenKamus={() => setIsKamusOpen(true)} />\n        )}\n\n        {currentTab === \'lemari\' && (\n          <LemariView\n            medicines={medicines}\n            onAddMedicine={handleAddMedicine}\n            onEditMedicine={handleEditMedicine}\n            onDeleteMedicine={handleDeleteMedicine}\n            initialFilter={lemariFilter}\n            onOpenPanduan={(mode = \'simpan\') =>\n              setPanduanState({ isOpen: true, mode })\n            }\n          />\n        )}\n\n        {currentTab === \'latihan\' && (\n          <LatihanView\n            onNavigate={(tab) => {\n              setCurrentTab(tab);\n              window.scrollTo({ top: 0, behavior: \'smooth\' });\n            }}\n            initialSubTab={latihanSubTab}\n          />\n        )}\n\n        {currentTab === \'pustaka\' && <PustakaView />}\n      </main>"
        start_line: 80
