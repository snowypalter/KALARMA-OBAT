  view_file {
    absolute_path_uri: "file:///src/views/PustakaView.tsx"
    end_line: 83
    content: "import React, { useState } from \'react\';\nimport { PUSTAKA_ITEMS } from \'../data/pustakaData\';\nimport { Search, BookOpen, ExternalLink, BookmarkCheck } from \'lucide-react\';\n\nexport const PustakaView: React.FC = () => {\n  const [searchQuery, setSearchQuery] = useState(\'\');\n\n  const filteredReferences = PUSTAKA_ITEMS.filter((item) => {\n    const q = searchQuery.toLowerCase();\n    return (\n      item.penulis.toLowerCase().includes(q) ||\n      item.judul.toLowerCase().includes(q) ||\n      item.penerbit.toLowerCase().includes(q) ||\n      item.kategori.toLowerCase().includes(q)\n    );\n  });\n\n  return (\n    <div className=\"space-y-5 pb-12 animate-in fade-in duration-150\">\n      {/* Title */}\n      <div className=\"space-y-1\">\n        <h1 className=\"text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight\">\n          Pustaka Rujukan Farmasi\n        </h1>\n        <p className=\"text-slate-600 text-sm sm:text-base leading-relaxed\">\n          Daftar dokumen rujukan resmi dari Kementerian Kesehatan, BPOM, Farmakope, dan pedoman internasional.\n        </p>\n      </div>\n\n      {/* Search Input */}\n      <div className=\"relative\">\n        <Search className=\"w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none\" />\n        <input\n          type=\"text\"\n          value={searchQuery}\n          onChange={(e) => setSearchQuery(e.target.value)}\n          placeholder=\"Cari penulis, regulasi, BPOM, Kemenkes, Dagusibu...\"\n          className=\"w-full min-h-[44px] pl-10 pr-4 py-2 text-sm bg-white border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-teal-600 focus:border-transparent\"\n        />\n      </div>\n\n      {/* Rujukan Cards */}\n      <div className=\"space-y-3.5\">\n        {filteredReferences.map((ref) => (\n          <div\n            key={ref.id}\n            className=\"p-5 bg-white rounded-2xl border border-slate-200 hover:border-teal-300 shadow-2xs space-y-3 transition-colors\"\n          >\n            <div className=\"flex items-start justify-between gap-2\">\n              <span className=\"text-xs font-semibold px-2.5 py-0.5 rounded-full bg-teal-50 text-teal-800 border border-teal-200/60\">\n                {ref.kategori}\n              </span>\n              <span className=\"text-xs text-slate-500 font-medium\">Tahun {ref.tahun}</span>\n            </div>\n\n            <div className=\"space-y-1\">\n              <h2 className=\"text-sm sm:text-base font-bold text-slate-900 leading-snug\">\n                {ref.judul}\n              </h2>\n              <div className=\"text-xs text-slate-600\">\n                <span className=\"font-semibold text-slate-700\">Penulis:</span> {ref.penulis}\n              </div>\n              <div className=\"text-xs text-slate-600\">\n                <span className=\"font-semibold text-slate-700\">Penerbit:</span> {ref.penerbit}\n              </div>\n            </div>\n\n            <p className=\"text-xs text-slate-500 italic bg-slate-50 p-2.5 rounded-xl border border-slate-100\">\n              {ref.catatan}\n            </p>\n\n            <div className=\"pt-2 border-t border-slate-100 flex items-center justify-between text-xs text-teal-700 font-mono\">\n              <span className=\"truncate max-w-[280px] sm:max-w-md\">\n                Tautan: {ref.tautanPlaceholder}\n              </span>\n              <BookmarkCheck className=\"w-4 h-4 text-teal-600 shrink-0\" />\n            </div>\n          </div>\n        ))}\n      </div>\n    </div>\n  );\n};\n"
    num_lines: 84
