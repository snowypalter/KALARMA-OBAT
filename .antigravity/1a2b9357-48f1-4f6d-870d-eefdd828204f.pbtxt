  planner_response {
    thinking: "**Refining The Design**\n\nI\'m now focusing on implementing the desired \"Nuansa\" for the homepage. I\'m upgrading `src/views/BerandaView.tsx` to achieve a more compelling opening atmosphere. The goal is to channel a serene, warm, and editorial vibe, inspired by those 4 reference websites. I\'m starting with a warm-framed \"Editorial Hero Canvas\" using rounded corners and a background gradient.\n\n\n**Constructing Editorial Components**\n\nI\'m now building out the detailed editorial components for the homepage hero section. I\'ve integrated a warm-framed hero canvas with editorial elements, including a kicker, a two-tone display headline in `Fraunces`, and a calm lead paragraph in `DM Sans`. Primary and secondary buttons are now in place, directing users. Below the hero, I\'m integrating a three-column trust strip with editorial content, plus a framed pharmacy shelf illustration on the right with a corresponding caption.\n\n\n**Developing Interactive Elements**\n\nI\'m now integrating interactive elements for the homepage. I\'ve created four distinct interactive tiles that open specific sections within the \'Lemari Obat\' (Medicine Cabinet), each with a clear label, tabular numbers, and hover effects for better user interaction. I\'ve designed editorial section headers inspired by the \"TRODEO\" design and implemented a \"Skenario Swamedikasi\" (Self-Medication Scenario) card with a dark, warm color scheme, and a CTA for a quiz. I\'m also maintaining the access to \"Tentang Ruang Obat\" (About Medicine Space) and existing gating mechanisms.\n\n\n"
    message_id: "8bIBa-ChJb_s3LUPpvyiiAU"
    tool_calls {
      id: "call_3677646797493037656"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState, useEffect, useRef } from \'react\';\\nimport { TabType, MedicineItem } from \'../types\';\\nimport { calculateDaysRemaining } from \'../utils/medicineUtils\';\\nimport { SHOW_REVIEWER_TOOLS } from \'../config/appConfig\';\\nimport { IDENTITAS_PROYEK } from \'../data/identitasProyek\';\\nimport {\\n  ScanSearch,\\n  Archive,\\n  AlertTriangle,\\n  ChevronRight,\\n  BookA,\\n  Layers,\\n  HelpCircle,\\n  Share2,\\n  FileDown,\\n  FileText,\\n  Compass,\\n  ShieldCheck,\\n  CheckCircle2,\\n  Sparkles,\\n  BookOpenCheck,\\n} from \'lucide-react\';\\nimport { generateAndDownloadPdf } from \'../utils/generatePdfClient\';\\nimport { RingkasanStokObatChart } from \'../components/RingkasanStokObatChart\';\\nimport {\\n  BerandaWalkthrough,\\n  FeatureTooltip,\\n  WALKTHROUGH_STEPS,\\n  WalkthroughStep,\\n} from \'../components/BerandaWalkthrough\';\\nimport heroIllustration from \'../assets/images/hero_ruang_obat_1795269701609.jpg\';\\nimport homeCareIllustration from \'../assets/images/dagusibu_home_care_1795269733833.jpg\';\\n\\nconst WALKTHROUGH_STORAGE_KEY = \'ruang_obat_walkthrough_done_v1\';\\n\\ninterface BerandaViewProps {\\n  onNavigate: (tab: TabType) => void;\\n  onNavigateLemariWithFilter?: (filter: \'segera\' | \'kedaluwarsa\' | \'semua\') => void;\\n  onNavigateLatihan?: (subTab: \'skenario\' | \'flashcard\' | \'kuis\') => void;\\n  medicines: MedicineItem[];\\n  onOpenKamus: () => void;\\n  onOpenTinjau?: () => void;\\n  onOpenAbout?: () => void;\\n}\\n\\nexport const BerandaView: React.FC<BerandaViewProps> = ({\\n  onNavigate,\\n  onNavigateLemariWithFilter,\\n  onNavigateLatihan,\\n  medicines,\\n  onOpenKamus,\\n  onOpenTinjau,\\n  onOpenAbout,\\n}) => {\\n  const [isWalkthroughOpen, setIsWalkthroughOpen] = useState<boolean>(() => {\\n    try {\\n      return localStorage.getItem(WALKTHROUGH_STORAGE_KEY) !== \'true\';\\n    } catch {\\n      return true;\\n    }\\n  });\\n  const [walkthroughStepIndex, setWalkthroughStepIndex] = useState(0);\\n  const [heroImgError, setHeroImgError] = useState(false);\\n  const [careImgError, setCareImgError] = useState(false);\\n\\n  const cekLabelRef = useRef<HTMLDivElement>(null);\\n  const lemariStokRef = useRef<HTMLDivElement>(null);\\n  const latihanRef = useRef<HTMLDivElement>(null);\\n  const belajarCepatRef = useRef<HTMLDivElement>(null);\\n\\n  const activeStepId = isWalkthroughOpen\\n    ? WALKTHROUGH_STEPS[walkthroughStepIndex]?.id\\n    : null;\\n\\n  const scrollToStepTarget = (stepId: WalkthroughStep[\'id\']) => {\\n    const refMap: Record<WalkthroughStep[\'id\'], React.RefObject<HTMLDivElement | null>> = {\\n      \'cek-label\': cekLabelRef,\\n      \'lemari-stok\': lemariStokRef,\\n      \'latihan\': latihanRef,\\n      \'belajar-cepat\': belajarCepatRef,\\n    };\\n    const target = refMap[stepId]?.current;\\n    if (target) {\\n      target.scrollIntoView({ behavior: \'smooth\', block: \'center\' });\\n    }\\n  };\\n\\n  useEffect(() => {\\n    if (!isWalkthroughOpen) return;\\n    if (walkthroughStepIndex > 0) {\\n      scrollToStepTarget(WALKTHROUGH_STEPS[walkthroughStepIndex].id);\\n    }\\n  }, [walkthroughStepIndex, isWalkthroughOpen]);\\n\\n  const handleCloseWalkthrough = () => {\\n    setIsWalkthroughOpen(false);\\n    try {\\n      localStorage.setItem(WALKTHROUGH_STORAGE_KEY, \'true\');\\n    } catch {\\n      // ignore storage errors\\n    }\\n  };\\n\\n  const handleOpenWalkthrough = () => {\\n    setWalkthroughStepIndex(0);\\n    setIsWalkthroughOpen(true);\\n  };\\n\\n  const handleJumpToFeature = (stepId: WalkthroughStep[\'id\']) => {\\n    handleCloseWalkthrough();\\n    if (stepId === \'cek-label\') {\\n      onNavigate(\'cek-label\');\\n    } else if (stepId === \'lemari-stok\') {\\n      onNavigate(\'lemari\');\\n    } else if (stepId === \'latihan\') {\\n      if (onNavigateLatihan) {\\n        onNavigateLatihan(\'skenario\');\\n      } else {\\n        onNavigate(\'latihan\');\\n      }\\n    } else if (stepId === \'belajar-cepat\') {\\n      onOpenKamus();\\n    }\\n  };\\n\\n  const expiringOrExpired = medicines.filter((m) => {\\n    const days = calculateDaysRemaining(m.expiryDate);\\n    return days <= 30;\\n  });\\n\\n  const warningCount = expiringOrExpired.length;\\n  const amanCount = medicines.length - warningCount;\\n\\n  return (\\n    <div className=\\\"space-y-9 sm:space-y-12 pb-12 ro-fade-in\\\">\\n      {/* Warm Editorial Hero Showcase */}\\n      <section className=\\\"rounded-3xl bg-gradient-to-br from-surface-warm via-surface to-secondary/35 border border-line p-5 sm:p-8 lg:p-10 shadow-xs space-y-7\\\">\\n        {/* Editorial Kicker + Walkthrough Trigger */}\\n        <div className=\\\"flex flex-wrap items-center justify-between gap-3\\\">\\n          <div className=\\\"flex items-center gap-2.5 min-w-0\\\">\\n            <span className=\\\"hidden xs:inline-block w-7 h-px bg-brand/60 shrink-0\\\" aria-hidden=\\\"true\\\" />\\n            <p className=\\\"text-xs font-semibold uppercase tracking-[0.12em] text-brand leading-snug\\\">\\n              {IDENTITAS_PROYEK.badgeBeranda}\\n            </p>\\n          </div>\\n\\n          <button\\n            type=\\\"button\\\"\\n            onClick={isWalkthroughOpen ? handleCloseWalkthrough : handleOpenWalkthrough}\\n            className=\\\"min-h-[44px] inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-surface/90 border border-line hover:border-line-strong text-ink hover:text-forest text-xs font-semibold transition-colors cursor-pointer shrink-0\\\"\\n          >\\n            <Compass className=\\\"w-3.5 h-3.5 text-brand\\\" />\\n            <span>{isWalkthroughOpen ? \'Tutup Panduan\' : \'Panduan Fitur\'}</span>\\n          </button>\\n        </div>\\n\\n        {/* Hero Split Canvas */}\\n        <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-7 lg:gap-10 items-center\\\">\\n          <div className=\\\"lg:col-span-7 space-y-5 text-left\\\">\\n            <h1 className=\\\"font-display text-3xl sm:text-4xl lg:text-[2.95rem] font-semibold text-forest leading-[1.12] tracking-tight text-balance\\\">\\n              Kenali label obatmu,{\' \'}\\n              <span className=\\\"italic font-normal text-brand\\\">\\n                kelola obat di rumahmu.\\n              </span>\\n            </h1>\\n\\n            <p className=\\\"text-ink-muted text-base max-w-xl leading-relaxed\\\">\\n              Pelajari simbol golongan obat resmi, aturan pakai, serta batas masa simpan secara mandiri dan tenang untuk menjaga keselamatan keluarga di rumah.\\n            </p>\\n\\n            <div className=\\\"flex flex-wrap items-center gap-3 pt-1\\\">\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => onNavigate(\'cek-label\')}\\n                className=\\\"min-h-[46px] px-5 py-2.5 rounded-xl bg-brand hover:bg-forest text-on-brand text-sm font-semibold inline-flex items-center gap-2 transition-colors cursor-pointer\\\"\\n              >\\n                <ScanSearch className=\\\"w-4 h-4 text-sand\\\" />\\n                <span>Mulai Cek Label</span>\\n              </button>\\n\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => onNavigate(\'lemari\')}\\n                className=\\\"min-h-[46px] px-5 py-2.5 rounded-xl bg-surface hover:bg-surface-muted border border-line hover:border-line-strong text-forest text-sm font-semibold inline-flex items-center gap-2 transition-colors cursor-pointer\\\"\\n              >\\n                <Archive className=\\\"w-4 h-4 text-brand\\\" />\\n                <span>Buka Lemari Obat</span>\\n              </button>\\n            </div>\\n          </div>\\n\\n          {/* Framed Warm Botanical Illustration */}\\n          <div className=\\\"lg:col-span-5\\\">\\n            <figure className=\\\"rounded-2xl overflow-hidden border border-line bg-surface-warm shadow-sm\\\">\\n              <div className=\\\"aspect-[4/3] overflow-hidden\\\">\\n                {!heroImgError ? (\\n                  <img\\n                    src={heroIllustration}\\n                    alt=\\\"Ilustrasi rak apotek rumah tangga berisi botol sirup kaca amber, strip tablet, salep, dan daun eukaliptus\\\"\\n                    referrerPolicy=\\\"no-referrer\\\"\\n                    onError={() => setHeroImgError(true)}\\n                    className=\\\"w-full h-full object-cover\\\"\\n                  />\\n                ) : (\\n                  <div className=\\\"w-full h-full flex flex-col items-center justify-center p-6 text-center bg-gradient-to-br from-surface-warm via-secondary/40 to-sand-soft/50\\\">\\n                    <div className=\\\"w-16 h-16 rounded-2xl bg-forest text-sand flex items-center justify-center mb-3\\\">\\n                      <ScanSearch className=\\\"w-8 h-8\\\" />\\n                    </div>\\n                    <p className=\\\"font-display text-lg text-forest font-semibold\\\">\\n                      Ruang Edukasi Obat Keluarga\\n                    </p>\\n                    <p className=\\\"text-xs text-ink-muted mt-1 max-w-xs\\\">\\n                      Simulasi 6 titik kemasan resmi &amp; pantauan masa simpan obat rumah tangga.\\n                    </p>\\n                  </div>\\n                )}\\n              </div>\\n              <figcaption className=\\\"px-4 py-2.5 bg-surface/90 border-t border-line flex items-center justify-between gap-2 text-xs text-ink-muted\\\">\\n                <span className=\\\"font-medium text-forest\\\">Edukasi Label &amp; DAGUSIBU</span>\\n                <span className=\\\"font-mono text-[11px]\\\">Tablet \302\267 Sirup \302\267 Salep</span>\\n              </figcaption>\\n            </figure>\\n          </div>\\n        </div>\\n\\n        {/* 3-Column Trust & Pillar Strip along Hero Base */}\\n        <div className=\\\"pt-5 border-t border-line/80 grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs sm:text-sm\\\">\\n          <div className=\\\"flex items-start gap-2.5\\\">\\n            <div className=\\\"w-8 h-8 rounded-lg bg-secondary/70 text-forest flex items-center justify-center shrink-0 mt-0.5\\\">\\n              <BookOpenCheck className=\\\"w-4 h-4 text-brand\\\" />\\n            </div>\\n            <div>\\n              <p className=\\\"font-semibold text-forest\\\">6 Titik Label Resmi</p>\\n              <p className=\\\"text-xs text-ink-muted leading-snug\\\">Logo golongan, dosis, ED/BUD, &amp; NIE BPOM</p>\\n            </div>\\n          </div>\\n\\n          <div className=\\\"flex items-start gap-2.5\\\">\\n            <div className=\\\"w-8 h-8 rounded-lg bg-sand-soft text-forest flex items-center justify-center shrink-0 mt-0.5\\\">\\n              <Sparkles className=\\\"w-4 h-4 text-brand\\\" />\\n            </div>\\n            <div>\\n              <p className=\\\"font-semibold text-forest\\\">Prinsip DAGUSIBU</p>\\n              <p className=\\\"text-xs text-ink-muted leading-snug\\\">Dapatkan, Gunakan, Simpan, dan Buang dengan aman</p>\\n            </div>\\n          </div>\\n\\n          <div className=\\\"flex items-start gap-2.5\\\">\\n            <div className=\\\"w-8 h-8 rounded-lg bg-status-aman-bg text-status-aman-text flex items-center justify-center shrink-0 mt-0.5\\\">\\n              <ShieldCheck className=\\\"w-4 h-4\\\" />\\n            </div>\\n            <div>\\n              <p className=\\\"font-semibold text-forest\\\">Rujukan BPOM &amp; Kemenkes</p>\\n              <p className=\\\"text-xs text-ink-muted leading-snug\\\">Catatan lemari tersimpan privat di perangkat Anda</p>\\n            </div>\\n          </div>\\n        </div>\\n      </section>\\n\\n      {/* 4-Tile Serene Quick Overview Strip */}\\n      <section aria-label=\\\"Ringkasan Cepat Lemari dan Edukasi\\\" className=\\\"grid grid-cols-2 lg:grid-cols-4 gap-3.5 sm:gap-4\\\">\\n        <button\\n          type=\\\"button\\\"\\n          onClick={() => onNavigate(\'lemari\')}\\n          className=\\\"min-h-[44px] p-4 sm:p-5 rounded-2xl bg-surface-warm border border-line hover:border-line-strong hover:-translate-y-0.5 transition-all text-left flex flex-col justify-between gap-2 cursor-pointer group\\\"\\n        >\\n          <div className=\\\"flex items-center justify-between gap-2 text-xs text-ink-muted font-medium\\\">\\n            <span>Obat Tercatat</span>\\n            <Archive className=\\\"w-4 h-4 text-brand shrink-0\\\" />\\n          </div>\\n          <div className=\\\"flex items-baseline justify-between gap-2\\\">\\n            <span className=\\\"font-display text-2xl sm:text-3xl font-semibold text-forest tabular-nums leading-none\\\">\\n              {medicines.length}\\n            </span>\\n            <span className=\\\"text-[11px] text-ink-muted group-hover:text-forest transition-colors\\\">\\n              Lihat stok \342\206\222\\n            </span>\\n          </div>\\n        </button>\\n\\n        <button\\n          type=\\\"button\\\"\\n          onClick={() => onNavigate(\'lemari\')}\\n          className=\\\"min-h-[44px] p-4 sm:p-5 rounded-2xl bg-status-aman-bg/45 border border-status-aman-text/20 hover:border-status-aman-text/45 hover:-translate-y-0.5 transition-all text-left flex flex-col justify-between gap-2 cursor-pointer group\\\"\\n        >\\n          <div className=\\\"flex items-center justify-between gap-2 text-xs text-status-aman-text font-semibold\\\">\\n            <span>Status Aman</span>\\n            <CheckCircle2 className=\\\"w-4 h-4 shrink-0\\\" />\\n          </div>\\n          <div className=\\\"flex items-baseline justify-between gap-2\\\">\\n            <span className=\\\"font-display text-2xl sm:text-3xl font-semibold text-forest tabular-nums leading-none\\\">\\n              {amanCount}\\n            </span>\\n            <span className=\\\"text-[11px] text-ink-muted\\\">\\n              &gt; 30 hari\\n            </span>\\n          </div>\\n        </button>\\n\\n        <button\\n          type=\\\"button\\\"\\n          onClick={() => {\\n            if (onNavigateLemariWithFilter) {\\n              onNavigateLemariWithFilter(\'segera\');\\n            } else {\\n              onNavigate(\'lemari\');\\n            }\\n          }}\\n          className={`min-h-[44px] p-4 sm:p-5 rounded-2xl border hover:-translate-y-0.5 transition-all text-left flex flex-col justify-between gap-2 cursor-pointer group ${\\n            warningCount > 0\\n              ? \'bg-status-segera-bg/65 border-status-segera-text/25 hover:border-status-segera-text/50\'\\n              : \'bg-sand-soft/50 border-line hover:border-line-strong\'\\n          }`}\\n        >\\n          <div className={`flex items-center justify-between gap-2 text-xs font-semibold ${\\n            warningCount > 0 ? \'text-status-segera-text\' : \'text-ink-muted\'\\n          }`}>\\n            <span>Perlu Dicek</span>\\n            <AlertTriangle className=\\\"w-4 h-4 shrink-0\\\" />\\n          </div>\\n          <div className=\\\"flex items-baseline justify-between gap-2\\\">\\n            <span className=\\\"font-display text-2xl sm:text-3xl font-semibold text-forest tabular-nums leading-none\\\">\\n              {warningCount}\\n            </span>\\n            <span className=\\\"text-[11px] text-ink-muted\\\">\\n              \342\211\244 30 hari / ED\\n            </span>\\n          </div>\\n        </button>\\n\\n        <button\\n          type=\\\"button\\\"\\n          onClick={() => onNavigate(\'cek-label\')}\\n          className=\\\"min-h-[44px] p-4 sm:p-5 rounded-2xl bg-secondary/45 border border-line hover:border-line-strong hover:-translate-y-0.5 transition-all text-left flex flex-col justify-between gap-2 cursor-pointer group\\\"\\n        >\\n          <div className=\\\"flex items-center justify-between gap-2 text-xs text-forest font-semibold\\\">\\n            <span>Simulasi Sediaan</span>\\n            <ScanSearch className=\\\"w-4 h-4 text-brand shrink-0\\\" />\\n          </div>\\n          <div className=\\\"flex items-baseline justify-between gap-2\\\">\\n            <span className=\\\"font-display text-2xl sm:text-3xl font-semibold text-forest tabular-nums leading-none\\\">\\n              3\\n            </span>\\n            <span className=\\\"text-[11px] text-ink-muted\\\">\\n              Tablet \302\267 Sirup \302\267 Salep\\n            </span>\\n          </div>\\n        </button>\\n      </section>\\n\\n      {/* Interactive New-User Walkthrough */}\\n      <BerandaWalkthrough\\n        isActive={isWalkthroughOpen}\\n        currentStepIndex={walkthroughStepIndex}\\n        onNext={() =>\\n          setWalkthroughStepIndex((prev) =>\\n            Math.min(prev + 1, WALKTHROUGH_STEPS.length - 1)\\n          )\\n        }\\n        onPrev={() => setWalkthroughStepIndex((prev) => Math.max(prev - 1, 0))}\\n        onSelectStep={(idx) => {\\n          setWalkthroughStepIndex(idx);\\n          scrollToStepTarget(WALKTHROUGH_STEPS[idx].id);\\n        }}\\n        onClose={handleCloseWalkthrough}\\n        onJumpToFeature={handleJumpToFeature}\\n      />\\n\\n      {/* Warning Banner: Hanya muncul bila ada data obat <= 30 hari atau sudah kedaluwarsa */}\\n      {warningCount > 0 && (\\n        <button\\n          type=\\\"button\\\"\\n          onClick={() => {\\n            if (onNavigateLemariWithFilter) {\\n              onNavigateLemariWithFilter(\'segera\');\\n            } else {\\n              onNavigate(\'lemari\');\\n            }\\n          }}\\n          className=\\\"w-full min-h-[44px] p-4 sm:p-5 rounded-2xl bg-status-segera-bg/85 border border-status-segera-text/25 flex items-center justify-between gap-4 text-left transition-all hover:bg-status-segera-bg cursor-pointer group\\\"\\n          aria-label={`Peringatan: ada ${warningCount} obat yang hampir atau telah kedaluwarsa. Ketuk untuk membuka lemari obat.`}\\n        >\\n          <div className=\\\"flex items-center gap-3.5 min-w-0\\\">\\n            <div className=\\\"w-11 h-11 rounded-xl bg-surface text-status-segera-text border border-status-segera-text/20 flex items-center justify-center shrink-0\\\">\\n              <AlertTriangle className=\\\"w-5 h-5\\\" />\\n            </div>\\n            <div className=\\\"min-w-0\\\">\\n              <div className=\\\"flex flex-wrap items-center gap-2\\\">\\n                <span className=\\\"font-bold text-ink text-sm sm:text-base\\\">\\n                  Perhatian Masa Simpan Obat\\n                </span>\\n                <span className=\\\"text-xs font-mono font-semibold tabular-nums text-status-segera-text\\\">\\n                  \302\267 {warningCount} Obat perlu dicek\\n                </span>\\n              </div>\\n              <p className=\\\"text-xs sm:text-sm text-ink-muted mt-0.5 leading-relaxed\\\">\\n                Terdapat {warningCount} persediaan obat di lemarimu yang mendekati atau melewati batas kedaluwarsa.\\n              </p>\\n            </div>\\n          </div>\\n          <div className=\\\"flex items-center text-status-segera-text font-semibold text-xs sm:text-sm shrink-0 group-hover:translate-x-1 transition-transform\\\">\\n            <span className=\\\"hidden sm:inline mr-1\\\">Periksa Lemari</span>\\n            <ChevronRight className=\\\"w-5 h-5\\\" />\\n          </div>\\n        </button>\\n      )}\\n\\n      {/* Editorial Section 1: 2 Kartu Aksi Utama */}\\n      <section aria-label=\\\"Fitur Utama\\\" className=\\\"space-y-5\\\">\\n        <div className=\\\"flex flex-col sm:flex-row sm:items-end justify-between gap-2\\\">\\n          <div className=\\\"space-y-1\\\">\\n            <div className=\\\"flex items-center gap-2\\\">\\n              <span className=\\\"w-6 h-px bg-brand/60\\\" aria-hidden=\\\"true\\\" />\\n              <span className=\\\"text-xs font-semibold uppercase tracking-[0.12em] text-brand\\\">\\n                Eksplorasi Utama\\n              </span>\\n            </div>\\n            <h2 className=\\\"font-display text-2xl sm:text-3xl font-semibold text-forest tracking-tight\\\">\\n              Kenali kemasan, jaga persediaan.\\n            </h2>\\n          </div>\\n          <p className=\\\"text-xs sm:text-sm text-ink-muted max-w-md leading-relaxed\\\">\\n            Pilih simulasi label kemasan untuk belajar membaca informasi penting atau kelola daftar obat keluarga di rumah.\\n          </p>\\n        </div>\\n\\n        <div className=\\\"grid grid-cols-1 md:grid-cols-2 gap-5\\\">\\n          {/* Card 1: Cek Label */}\\n          <div\\n            ref={cekLabelRef}\\n            className={`relative rounded-2xl transition-all ${\\n              activeStepId === \'cek-label\'\\n                ? \'ring-2 ring-brand ring-offset-4 ring-offset-bg\'\\n                : \'\'\\n            }`}\\n          >\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => onNavigate(\'cek-label\')}\\n              className=\\\"w-full h-full p-6 sm:p-7 rounded-2xl bg-surface border border-line hover:border-line-strong hover:-translate-y-0.5 hover:shadow-sm transition-all text-left flex flex-col justify-between group cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-focus\\\"\\n            >\\n              <div className=\\\"space-y-4\\\">\\n                <div className=\\\"flex items-center justify-between pr-12\\\">\\n                  <div className=\\\"w-12 h-12 rounded-xl bg-secondary text-forest flex items-center justify-center group-hover:bg-brand group-hover:text-on-brand transition-colors\\\">\\n                    <ScanSearch className=\\\"w-6 h-6\\\" />\\n                  </div>\\n                  <span className=\\\"text-xs font-mono text-ink-muted\\\">\\n                    6 Titik Kemasan\\n                  </span>\\n                </div>\\n\\n                <div className=\\\"space-y-1.5\\\">\\n                  <h3 className=\\\"font-display text-xl sm:text-2xl font-semibold text-forest\\\">\\n                    Cek Label Obat\\n                  </h3>\\n                  <p className=\\\"text-ink-muted text-sm leading-relaxed\\\">\\n                    Simulasi interaktif kemasan Tablet, Sirup, dan Salep. Ketuk 6 titik kritis untuk memahami logo golongan, aturan pakai, hingga nomor izin edar.\\n                  </p>\\n                </div>\\n              </div>\\n\\n              <div className=\\\"pt-5 mt-5 border-t border-line/70 flex items-center text-brand group-hover:text-forest font-semibold text-sm\\\">\\n                <span>Mulai Simulasi Kemasan</span>\\n                <ChevronRight className=\\\"w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform\\\" />\\n              </div>\\n            </button>\\n            <div className=\\\"absolute top-5 right-4 z-10\\\">\\n              <FeatureTooltip\\n                title=\\\"Cek Label Obat (6 Titik)\\\"\\n                content=\\\"Ketuk nomor 1\342\200\2236 pada kemasan Tablet, Sirup, atau Salep untuk memahami arti logo golongan, dosis zat aktif, batas kedaluwarsa (ED/BUD), dan nomor NIE BPOM.\\\"\\n              />\\n            </div>\\n          </div>\\n\\n          {/* Card 2: Lemari Obat */}\\n          <div className=\\\"relative rounded-2xl\\\">\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => onNavigate(\'lemari\')}\\n              className=\\\"w-full h-full p-6 sm:p-7 rounded-2xl bg-surface border border-line hover:border-line-strong hover:-translate-y-0.5 hover:shadow-sm transition-all text-left flex flex-col justify-between group cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-focus\\\"\\n            >\\n              <div className=\\\"space-y-4\\\">\\n                <div className=\\\"flex items-center justify-between pr-12\\\">\\n                  <div className=\\\"w-12 h-12 rounded-xl bg-status-aman-bg text-status-aman-text flex items-center justify-center group-hover:bg-brand group-hover:text-on-brand transition-colors\\\">\\n                    <Archive className=\\\"w-6 h-6\\\" />\\n                  </div>\\n                  <span className=\\\"text-xs font-mono tabular-nums text-ink-muted\\\">\\n                    {medicines.length} Obat Tercatat\\n                  </span>\\n                </div>\\n\\n                <div className=\\\"space-y-1.5\\\">\\n                  <h3 className=\\\"font-display text-xl sm:text-2xl font-semibold text-forest\\\">\\n                    Lemari Obat Saya\\n                  </h3>\\n                  <p className=\\\"text-ink-muted text-sm leading-relaxed\\\">\\n                    Catat dan pantau tanggal kedaluwarsa obat rumah tangga secara otomatis dalam tiga status keselamatan. Tersimpan aman di perangkatmu.\\n                  </p>\\n                </div>\\n              </div>\\n\\n              <div className=\\\"pt-5 mt-5 border-t border-line/70 flex items-center text-brand group-hover:text-forest font-semibold text-sm\\\">\\n                <span>Kelola Lemari Obat</span>\\n                <ChevronRight className=\\\"w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform\\\" />\\n              </div>\\n            </button>\\n            <div className=\\\"absolute top-5 right-4 z-10\\\">\\n              <FeatureTooltip\\n                title=\\\"Lemari Obat Saya (Lokal)\\\"\\n                content=\\\"Data persediaan obat Anda hanya tersimpan di memori perangkat ini (localStorage) tanpa dikirim ke server. Tersedia pula panduan cara memusnahkan obat kedaluwarsa.\\\"\\n              />\\n            </div>\\n          </div>\\n        </div>\\n      </section>\\n\\n      {/* Editorial Section 2: Visualisasi Stok Obat + Sorotan Skenario */}\\n      <section className=\\\"space-y-5\\\">\\n        <div className=\\\"flex flex-col sm:flex-row sm:items-end justify-between gap-2\\\">\\n          <div className=\\\"space-y-1\\\">\\n            <div className=\\\"flex items-center gap-2\\\">\\n              <span className=\\\"w-6 h-px bg-brand/60\\\" aria-hidden=\\\"true\\\" />\\n              <span className=\\\"text-xs font-semibold uppercase tracking-[0.12em] text-brand\\\">\\n                Pantauan &amp; Latihan\\n              </span>\\n            </div>\\n            <h2 className=\\\"font-display text-2xl sm:text-3xl font-semibold text-forest tracking-tight\\\">\\n              Kondisi stok &amp; studi kasus.\\n            </h2>\\n          </div>\\n          <p className=\\\"text-xs sm:text-sm text-ink-muted max-w-md leading-relaxed\\\">\\n            Pantau rasio status kedaluwarsa secara visual dan latih keputusan aman pada skenario swamedikasi harian.\\n          </p>\\n        </div>\\n\\n        <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch\\\">\\n          <div\\n            ref={lemariStokRef}\\n            className={`lg:col-span-7 rounded-2xl transition-all flex ${\\n              activeStepId === \'lemari-stok\'\\n                ? \'ring-2 ring-brand ring-offset-4 ring-offset-bg\'\\n                : \'\'\\n            }`}\\n          >\\n            <div className=\\\"w-full\\\">\\n              <RingkasanStokObatChart\\n                medicines={medicines}\\n                onNavigateLemariWithFilter={onNavigateLemariWithFilter}\\n                onNavigateToLemari={() => onNavigate(\'lemari\')}\\n              />\\n            </div>\\n          </div>\\n\\n          {/* Kartu Sorotan Skenario Swamedikasi Hari Ini (Mountain Meadow Forest Card) */}\\n          <div\\n            ref={latihanRef}\\n            className={`lg:col-span-5 p-6 sm:p-7 rounded-2xl bg-gradient-to-br from-forest via-forest to-[#1B2E29] text-white flex flex-col justify-between space-y-5 transition-all ${\\n              activeStepId === \'latihan\'\\n                ? \'ring-2 ring-brand ring-offset-4 ring-offset-bg\'\\n                : \'\'\\n            }`}\\n          >\\n            <div className=\\\"space-y-4\\\">\\n              <div className=\\\"flex items-center justify-between gap-2 text-xs text-sand font-semibold uppercase tracking-[0.1em]\\\">\\n                <span>Skenario Swamedikasi</span>\\n                <span className=\\\"text-secondary/80 font-mono normal-case tracking-normal\\\">\\n                  Kasus Nyata\\n                </span>\\n              </div>\\n\\n              <blockquote className=\\\"font-display italic text-xl sm:text-2xl text-white leading-snug\\\">\\n                &ldquo;Demam, ada sisa antibiotik teman...&rdquo;\\n              </blockquote>\\n\\n              <p className=\\\"text-sm text-secondary/85 leading-relaxed\\\">\\n                Teman sekamarmu memiliki sisa kapsul antibiotik dari resep bulan lalu dan menawarinya saat kamu demam tinggi. Apakah tindakan tersebut aman dilakukan?\\n              </p>\\n            </div>\\n\\n            <div className=\\\"pt-4 border-t border-white/15 space-y-4\\\">\\n              <div className=\\\"flex items-center gap-2 text-xs text-sand\\\">\\n                <HelpCircle className=\\\"w-4 h-4 shrink-0\\\" />\\n                <span>Ketahui kapan saat tepat bertanya ke apoteker</span>\\n              </div>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => {\\n                  if (onNavigateLatihan) {\\n                    onNavigateLatihan(\'skenario\');\\n                  } else {\\n                    onNavigate(\'latihan\');\\n                  }\\n                }}\\n                className=\\\"w-full min-h-[46px] px-4 py-2.5 rounded-xl bg-sand hover:bg-sand-soft text-forest font-bold text-sm flex items-center justify-center gap-2 transition-colors cursor-pointer\\\"\\n              >\\n                <span>Uji Pilihanmu di Latihan</span>\\n                <ChevronRight className=\\\"w-4 h-4\\\" />\\n              </button>\\n            </div>\\n          </div>\\n        </div>\\n      </section>\\n\\n      {/* Belajar Cepat & Edukasi Rumah Tangga */}\\n      <section\\n        ref={belajarCepatRef}\\n        className={`p-6 sm:p-8 rounded-3xl bg-surface-warm border border-line transition-all ${\\n          activeStepId === \'belajar-cepat\'\\n            ? \'ring-2 ring-brand ring-offset-4 ring-offset-bg\'\\n            : \'\'\\n        }`}\\n      >\\n        <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-center\\\">\\n          {/* Editorial Illustration Accent */}\\n          <div className=\\\"lg:col-span-4\\\">\\n            <figure className=\\\"rounded-2xl overflow-hidden border border-line bg-bg aspect-[4/3]\\\">\\n              {!careImgError ? (\\n                <img\\n                  src={homeCareIllustration}\\n                  alt=\\\"Ilustrasi kotak penyimpanan obat keluarga yang rapi lengkap dengan gelas takar\\\"\\n                  referrerPolicy=\\\"no-referrer\\\"\\n                  onError={() => setCareImgError(true)}\\n                  className=\\\"w-full h-full object-cover\\\"\\n                />\\n              ) : (\\n                <div className=\\\"w-full h-full flex items-center justify-center bg-secondary/40 text-forest p-6 text-center\\\">\\n                  <span className=\\\"font-display text-base font-semibold\\\">\\n                    Prinsip DAGUSIBU Rumah Tangga\\n                  </span>\\n                </div>\\n              )}\\n            </figure>\\n          </div>\\n\\n          {/* Learning Modules List */}\\n          <div className=\\\"lg:col-span-8 space-y-4\\\">\\n            <div className=\\\"flex items-center justify-between gap-2\\\">\\n              <div className=\\\"space-y-0.5\\\">\\n                <div className=\\\"flex items-center gap-2\\\">\\n                  <span className=\\\"w-5 h-px bg-brand/60\\\" aria-hidden=\\\"true\\\" />\\n                  <span className=\\\"text-xs font-semibold uppercase tracking-[0.12em] text-brand\\\">\\n                    Belajar Cepat\\n                  </span>\\n                </div>\\n                <h2 className=\\\"font-display text-xl sm:text-2xl font-semibold text-forest\\\">\\n                  Perkuat Pemahaman Istilah &amp; Simbol\\n                </h2>\\n              </div>\\n              <FeatureTooltip\\n                title=\\\"Akses Cepat Belajar\\\"\\n                content=\\\"Buka Kamus Label Obat untuk mencari istilah medis resmi, atau gunakan Flashcard 3D untuk mengulang hafalan simbol dan aturan Dagusibu.\\\"\\n              />\\n            </div>\\n\\n            <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-3.5\\\">\\n              <button\\n                type=\\\"button\\\"\\n                onClick={onOpenKamus}\\n                className=\\\"min-h-[44px] p-4 rounded-2xl bg-surface border border-line hover:border-line-strong hover:-translate-y-0.5 flex items-start gap-3.5 text-left transition-all cursor-pointer group\\\"\\n              >\\n                <div className=\\\"w-11 h-11 rounded-xl bg-secondary text-forest flex items-center justify-center shrink-0 group-hover:bg-brand group-hover:text-on-brand transition-colors\\\">\\n                  <BookA className=\\\"w-5 h-5\\\" />\\n                </div>\\n                <div className=\\\"space-y-0.5\\\">\\n                  <h3 className=\\\"text-sm sm:text-base font-bold text-forest\\\">\\n                    Kamus Label Obat\\n                  </h3>\\n                  <p className=\\\"text-xs text-ink-muted leading-relaxed\\\">\\n                    Cari arti NIE, BUD, Exp. Date, serta simbol lingkaran obat resmi\\n                  </p>\\n                </div>\\n              </button>\\n\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => {\\n                  if (onNavigateLatihan) {\\n                    onNavigateLatihan(\'flashcard\');\\n                  } else {\\n                    onNavigate(\'latihan\');\\n                  }\\n                }}\\n                className=\\\"min-h-[44px] p-4 rounded-2xl bg-surface border border-line hover:border-line-strong hover:-translate-y-0.5 flex items-start gap-3.5 text-left transition-all cursor-pointer group\\\"\\n              >\\n                <div className=\\\"w-11 h-11 rounded-xl bg-sand-soft text-forest flex items-center justify-center shrink-0 group-hover:bg-brand group-hover:text-on-brand transition-colors\\\">\\n                  <Layers className=\\\"w-5 h-5\\\" />\\n                </div>\\n                <div className=\\\"space-y-0.5\\\">\\n                  <h3 className=\\\"text-sm sm:text-base font-bold text-forest\\\">\\n                    Flashcard 3D Cepat\\n                  </h3>\\n                  <p className=\\\"text-xs text-ink-muted leading-relaxed\\\">\\n                    Latih daya ingat tanda peringatan P.No 1\342\200\2236 dan aturan Dagusibu\\n                  </p>\\n                </div>\\n              </button>\\n            </div>\\n\\n            {onOpenAbout && (\\n              <div className=\\\"pt-1 flex flex-wrap items-center justify-between gap-2 text-xs text-ink-muted\\\">\\n                <span>Ingin mengenal profil pengembang &amp; batasan etika?</span>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={onOpenAbout}\\n                  className=\\\"min-h-[44px] inline-flex items-center px-2 font-semibold text-brand hover:text-forest underline underline-offset-4 cursor-pointer\\\"\\n                >\\n                  Tentang Ruang Obat\\n                </button>\\n              </div>\\n            )}\\n          </div>\\n        </div>\\n      </section>\\n\\n      {/* Card: Berkas Dokumen Tugas Akhir Berbasis Proyek & Peninjauan (tersembunyi bila SHOW_REVIEWER_TOOLS = false) */}\\n      {SHOW_REVIEWER_TOOLS && onOpenTinjau && (\\n        <section className=\\\"p-5 sm:p-6 rounded-2xl bg-surface border border-line flex flex-col md:flex-row md:items-center justify-between gap-5\\\">\\n          <div className=\\\"flex items-start gap-4\\\">\\n            <div className=\\\"w-12 h-12 rounded-xl bg-forest text-sand flex items-center justify-center shrink-0\\\">\\n              <FileText className=\\\"w-6 h-6\\\" />\\n            </div>\\n            <div className=\\\"space-y-1\\\">\\n              <p className=\\\"text-xs font-semibold uppercase tracking-wider text-brand\\\">\\n                Berkas {IDENTITAS_PROYEK.jenisKarya} \302\267 Format PDF Resmi A4\\n              </p>\\n              <h3 className=\\\"font-display text-lg font-semibold text-forest\\\">\\n                Dokumen Pengembangan untuk Dosen Pembimbing dan Penguji\\n              </h3>\\n              <p className=\\\"text-xs sm:text-sm text-ink-muted max-w-2xl leading-relaxed\\\">\\n                Tersedia berkas PDF 4 halaman berisi identitas proyek, spesifikasi 6 titik kemasan, batasan etika farmasi, dan lembar penilaian dosen pembimbing dan penguji.\\n              </p>\\n            </div>\\n          </div>\\n\\n          <div className=\\\"flex flex-wrap items-center gap-2.5 shrink-0\\\">\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => generateAndDownloadPdf()}\\n              className=\\\"min-h-[44px] px-4 py-2 rounded-xl bg-brand hover:bg-forest text-on-brand font-semibold text-xs sm:text-sm flex items-center justify-center gap-2 transition-colors cursor-pointer\\\"\\n            >\\n              <FileDown className=\\\"w-4 h-4 text-sand\\\" />\\n              <span>Unduh PDF</span>\\n            </button>\\n\\n            <button\\n              type=\\\"button\\\"\\n              onClick={onOpenTinjau}\\n              className=\\\"min-h-[44px] px-4 py-2 rounded-xl bg-surface-muted hover:bg-secondary/60 border border-line text-forest font-semibold text-xs sm:text-sm flex items-center justify-center gap-2 transition-colors cursor-pointer\\\"\\n            >\\n              <Share2 className=\\\"w-4 h-4 text-brand\\\" />\\n              <span>Buka Dokumen</span>\\n            </button>\\n          </div>\\n        </section>\\n      )}\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Elevate BerandaView opening hero, 3-pillar trust strip, 4-tile summary strip, and editorial section headers inspired by user design references\", \"Overwrite\":true, \"TargetFile\":\"/src/views/BerandaView.tsx\", \"toolAction\":\"Updating BerandaView editorial hero and overview strip\", \"toolSummary\":\"Update BerandaView layout\"}"
