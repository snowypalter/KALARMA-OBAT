  view_file {
    absolute_path_uri: "file:///src/components/BottomNav.tsx"
    end_line: 70
    content: "import React from \'react\';\nimport { TabType } from \'../types\';\nimport { Home, ScanSearch, Archive, Dumbbell, BookOpen } from \'lucide-react\';\n\ninterface BottomNavProps {\n  currentTab: TabType;\n  onNavigate: (tab: TabType) => void;\n  expiringCount: number;\n}\n\nexport const BottomNav: React.FC<BottomNavProps> = ({\n  currentTab,\n  onNavigate,\n  expiringCount,\n}) => {\n  const tabs = [\n    { id: \'beranda\' as TabType, label: \'Beranda\', icon: Home },\n    { id: \'cek-label\' as TabType, label: \'Cek Label\', icon: ScanSearch },\n    { id: \'lemari\' as TabType, label: \'Lemari\', icon: Archive, badge: expiringCount > 0 ? expiringCount : undefined },\n    { id: \'latihan\' as TabType, label: \'Latihan\', icon: Dumbbell },\n    { id: \'pustaka\' as TabType, label: \'Pustaka\', icon: BookOpen },\n  ];\n\n  return (\n    <nav \n      aria-label=\"Navigasi Utama\"\n      className=\"md:hidden fixed bottom-0 left-0 right-0 z-40 bg-white/95 backdrop-blur-md border-t border-slate-200 shadow-lg pb-safe\"\n    >\n      <div className=\"grid grid-cols-5 items-center h-16 max-w-lg mx-auto px-1\">\n        {tabs.map((tab) => {\n          const Icon = tab.icon;\n          const isActive = currentTab === tab.id;\n          return (\n            <button\n              key={tab.id}\n              type=\"button\"\n              onClick={() => onNavigate(tab.id)}\n              className={`relative min-h-[44px] flex flex-col items-center justify-center py-1 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-teal-600 rounded-lg ${\n                isActive\n                  ? \'text-teal-800 font-bold\'\n                  : \'text-slate-500 hover:text-slate-900 font-medium\'\n              }`}\n              aria-label={tab.label}\n              aria-current={isActive ? \'page\' : undefined}\n            >\n              <div className=\"relative\">\n                <Icon\n                  className={`w-5 h-5 transition-transform ${\n                    isActive ? \'scale-110 text-teal-700 stroke-[2.4]\' : \'stroke-[1.8]\'\n                  }`}\n                />\n                {tab.badge && (\n                  <span className=\"absolute -top-1.5 -right-2 min-w-4 h-4 px-1 rounded-full bg-amber-500 text-white text-[10px] font-bold flex items-center justify-center leading-none shadow-xs\">\n                    {tab.badge}\n                  </span>\n                )}\n              </div>\n              <span className={`text-[11px] tracking-tight mt-1 truncate max-w-full ${isActive ? \'text-teal-800 font-semibold\' : \'text-slate-500\'}`}>\n                {tab.label}\n              </span>\n              {isActive && (\n                <span className=\"absolute bottom-1 w-6 h-0.5 bg-teal-700 rounded-full\" />\n              )}\n            </button>\n          );\n        })}\n      </div>\n    </nav>\n  );\n};\n"
    num_lines: 71
    num_bytes: 2772
    line_range_bytes: 2772
  }
}
