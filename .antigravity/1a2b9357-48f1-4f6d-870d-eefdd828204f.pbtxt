        target_content: "  const handleCategoryClick = (categoryKey: \'aman\' | \'segera\' | \'kedaluwarsa\') => {\n    if (onNavigateLemariWithFilter) {\n      onNavigateLemariWithFilter(categoryKey === \'aman\' ? \'semua\' : categoryKey);\n    } else {\n      onNavigateToLemari();\n    }\n  };"
        replacement_content: "  const handleCategoryClick = (categoryKey?: string) => {\n    if (!categoryKey) return;\n    if (onNavigateLemariWithFilter) {\n      if (categoryKey === \'segera\' || categoryKey === \'kedaluwarsa\') {\n        onNavigateLemariWithFilter(categoryKey);\n      } else {\n        onNavigateLemariWithFilter(\'semua\');\n      }\n    } else {\n      onNavigateToLemari();\n    }\n  };"
        start_line: 90
        end_line: 100
      }
