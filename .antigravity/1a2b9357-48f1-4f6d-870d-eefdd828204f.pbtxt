    content: "                    }}\n                  />\n                  <Pie\n                    data={data}\n                    cx=\"50%\"\n                    cy=\"50%\"\n                    innerRadius={50}\n                    outerRadius={78}\n                    paddingAngle={4}\n                    dataKey=\"value\"\n                    onClick={(entry) => handleCategoryClick(entry.key)}\n                    cursor=\"pointer\"\n                  >\n                    {data.map((entry, index) => (\n                      <Cell\n                        key={`cell-${index}`}\n                        fill={entry.color}\n                        stroke=\"#ffffff\"\n                        strokeWidth={2}\n                      />\n                    ))}\n                  </Pie>\n                </PieChart>\n              </ResponsiveContainer>\n              {/* Central counter label inside donut */}\n              <div className=\"absolute inset-0 flex flex-col items-center justify-center pointer-events-none\">\n                <span className=\"text-2xl font-black text-slate-800 leading-none\">\n                  {totalCount}\n                </span>\n                <span className=\"text-[10px] uppercase font-bold text-slate-400 tracking-wider mt-0.5\">\n                  Obat\n                </span>\n              </div>\n            </>\n          ) : (\n            <ResponsiveContainer width=\"100%\" height={200}>\n              <BarChart\n                data={data}\n                margin={{ top: 15, right: 10, left: -20, bottom: 5 }}\n              >\n                <CartesianGrid strokeDasharray=\"3 3\" vertical={false} stroke=\"#E2E8F0\" />\n                <XAxis\n                  dataKey=\"name\"\n                  tick={{ fontSize: 10, fill: \'#64748B\' }}\n                  interval={0}\n                  tickLine={false}\n                  axisLine={{ stroke: \'#CBD5E1\' }}\n                />\n                <YAxis\n                  allowDecimals={false}\n                  tick={{ fontSize: 10, fill: \'#64748B\' }}\n                  tickLine={false}\n                  axisLine={{ stroke: \'#CBD5E1\' }}\n                />\n                <Tooltip\n                  content={({ active, payload }) => {\n                    if (active && payload && payload.length) {\n                      const item = payload[0].payload;\n                      const pct = Math.round((item.value / totalCount) * 100);\n                      return (\n                        <div className=\"p-2.5 bg-slate-900 text-white text-xs rounded-xl shadow-lg border border-slate-700 space-y-0.5\">\n                          <div className=\"font-bold flex items-center gap-1.5\">\n                            <span\n                              className=\"w-2.5 h-2.5 rounded-full\"\n                              style={{ backgroundColor: item.color }}\n                            />\n                            <span>{item.name}</span>\n                          </div>\n                          <div className=\"text-slate-200\">\n                            Jumlah: <strong>{item.value} obat</strong> ({pct}%)\n                          </div>\n                        </div>\n                      );\n                    }\n                    return null;\n                  }}\n                />\n                <Bar\n                  dataKey=\"value\"\n                  radius={[6, 6, 0, 0]}\n                  onClick={(entry) => handleCategoryClick(entry.key)}\n                  cursor=\"pointer\"\n                >\n                  {data.map((entry, index) => (\n                    <Cell key={`bar-${index}`} fill={entry.color} />\n                  ))}\n                </Bar>\n              </BarChart>\n            </ResponsiveContainer>"
    num_lines: 383
    num_bytes: 14741
    line_range_bytes: 3671
  }
}
