  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\nimport { MedicineItem } from \'../types\';\nimport { getMedicineStatus } from \'../utils/medicineUtils\';\nimport { \n  PieChart, \n  Pie, \n  Cell, \n  ResponsiveContainer, \n  Tooltip, \n  BarChart, \n  Bar, \n  XAxis, \n  YAxis, \n  CartesianGrid \n} from \'recharts\';\nimport { \n  CheckCircle2, \n  AlertTriangle, \n  AlertOctagon, \n  BarChart3, \n  PieChart as PieIcon, \n  ChevronRight, \n  PlusCircle,\n  Archive\n} from \'lucide-react\';\n\ninterface RingkasanStokObatChartProps {\n  medicines: MedicineItem[];\n  onNavigateLemariWithFilter?: (filter: \'segera\' | \'kedaluwarsa\' | \'semua\') => void;\n  onNavigateToLemari: () => void;\n}\n\nexport const RingkasanStokObatChart: React.FC<RingkasanStokObatChartProps> = ({\n  medicines,\n  onNavigateLemariWithFilter,\n  onNavigateToLemari,\n}) => {\n  const [chartType, setChartType] = useState<\'donut\' | \'bar\'>(\'donut\');\n  const [activeIndex, setActiveIndex] = useState<number | null>(null);\n\n  // Compute breakdown\n  let amanCount = 0;\n  let segeraCount = 0;\n  let kedaluwarsaCount = 0;\n\n  medicines.forEach((med) => {\n    const status = getMedicineStatus(med.expiryDate);\n    if (status === \'kedaluwarsa\') kedaluwarsaCount++;\n    else if (status === \'segera\') segeraCount++;\n    else amanCount++;\n  });\n\n  const totalCount = medicines.length;\n\n  const data = [\n    {\n      name: \'Aman\',\n      key: \'aman\' as const,\n      value: amanCount,\n      color: \'#059669\', // Emerald 600\n      lightBg: \'bg-emerald-50\',\n      border: \'border-emerald-200\',\n      text: \'text-emerald-800\',\n      icon: CheckCircle2,\n      desc: \'Masa simpan > 30 hari\',\n    },\n    {\n      name: \'Segera Kedaluwarsa\',\n      key: \'segera\' as const,\n      value: segeraCount,\n      color: \'#D97706\', // Amber 600\n      lightBg: \'bg-amber-50\',\n      border: \'border-amber-200\',\n      text: \'text-amber-800\',\n      icon: AlertTriangle,\n      desc: \'Kritis (<= 30 hari)\',\n    },\n    {\n      name: \'Kedaluwarsa\',\n      key: \'kedaluwarsa\' as const,\n      value: kedaluwarsaCount,\n      color: \'#DC2626\', // Red 600\n      lightBg: \'bg-rose-50\',\n      border: \'border-rose-200\',\n      text: \'text-rose-800\',\n      icon: AlertOctagon,\n      desc: \'Lewat batas aman\',\n    },\n  ];\n\n  const handleCategoryClick = (categoryKey: \'aman\' | \'segera\' | \'kedaluwarsa\') => {\n    if (onNavigateLemariWithFilter) {\n      onNavigateLemariWithFilter(categoryKey === \'aman\' ? \'semua\' : categoryKey);\n    } else {\n      onNavigateToLemari();\n    }\n  };\n\n  // If there are no medicines at all\n  if (totalCount === 0) {\n    return (\n      <div className=\"p-5 rounded-2xl bg-white border border-slate-200 shadow-2xs space-y-3 text-center\">\n        <div className=\"w-12 h-12 mx-auto rounded-xl bg-slate-100 text-slate-500 flex items-center justify-center\">\n          <Archive className=\"w-6 h-6\" />\n        </div>\n        <div>\n          <h3 className=\"text-base font-bold text-slate-900\">Lemari Obat Masih Kosong</h3>\n          <p className=\"text-xs sm:text-sm text-slate-500 mt-1\">\n            Tambahkan persediaan obat rumah tangga Anda untuk memantau status kadaluwarsa secara visual.\n          </p>\n        </div>\n        <button\n          type=\"button\"\n          onClick={onNavigateToLemari}\n          className=\"inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-teal-700 hover:bg-teal-800 text-white text-xs font-bold cursor-pointer transition-colors shadow-xs\"\n        >\n          <PlusCircle className=\"w-4 h-4\" />\n          <span>Kelola Lemari Obat</span>\n        </button>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"p-5 rounded-2xl bg-white border border-slate-200 shadow-2xs space-y-4\">\n      {/* Header & Chart Type Toggle */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n        <div className=\"space-y-0.5\">\n          <div className=\"flex items-center gap-2\">\n            <span className=\"text-xs font-bold uppercase tracking-wider text-teal-800\">\n              Visualisasi Stok\n            </span>\n            <span className=\"text-[11px] px-2 py-0.5 rounded-full bg-teal-50 border border-teal-200/80 text-teal-900 font-bold font-mono\">\n              Total {totalCount} Obat\n            </span>\n          </div>\n          <h2 className=\"text-base sm:text-lg font-bold text-slate-900\">\n            Ringkasan Status Masa Simpan Obat\n          </h2>\n        </div>\n\n        {/* Chart type toggle */}\n        <div className=\"flex items-center gap-1 p-1 bg-slate-100 rounded-xl border border-slate-200 self-start sm:self-auto\">\n          <button\n            type=\"button\"\n            onClick={() => setChartType(\'donut\')}\n            className={`px-2.5 py-1.5 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition-all cursor-pointer ${\n              chartType === \'donut\'\n                ? \'bg-white text-teal-900 shadow-xs\'\n                : \'text-slate-600 hover:text-slate-900\'\n            }`}\n            title=\"Tampilkan Diagram Lingkaran\"\n          >\n            <PieIcon className=\"w-3.5 h-3.5\" />\n            <span className=\"hidden xs:inline\">Lingkaran</span>\n          </button>\n          <button\n            type=\"button\"\n            onClick={() => setChartType(\'bar\')}\n            className={`px-2.5 py-1.5 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition-all cursor-pointer ${\n              chartType === \'bar\'\n                ? \'bg-white text-teal-900 shadow-xs\'\n                : \'text-slate-600 hover:text-slate-900\'\n            }`}\n            title=\"Tampilkan Diagram Batang\"\n          >\n            <BarChart3 className=\"w-3.5 h-3.5\" />\n            <span className=\"hidden xs:inline\">Batang</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Main Content: Chart + Interactive Stat Badges */}\n      <div className=\"grid grid-cols-1 md:grid-cols-12 gap-5 items-center pt-1\">\n        {/* Chart Canvas Area */}\n        <div className=\"md:col-span-5 h-[200px] w-full flex items-center justify-center relative\">\n          {chartType === \'donut\' ? (\n            <>\n              <ResponsiveContainer width=\"100%\" height={200}>\n                <PieChart>\n                  <Tooltip\n                    content={({ active, payload }) => {\n                      if (active && payload && payload.length) {\n                        const item = payload[0].payload;\n                        const pct = Math.round((item.value / totalCount) * 100);\n                        return (\n                          <div className=\"p-2.5 bg-slate-900 text-white text-xs rounded-xl shadow-lg border border-slate-700 space-y-0.5\">\n                            <div className=\"font-bold flex items-center gap-1.5\">\n                              <span\n                                className=\"w-2.5 h-2.5 rounded-full\"\n                                style={{ backgroundColor: item.color }}\n                              />\n                              <span>{item.name}</span>\n                            </div>\n                            <div className=\"text-slate-200\">\n                              Jumlah: <strong>{item.value} obat</strong> ({pct}%)\n                            </div>\n                            <div className=\"text-[10px] text-teal-300\">\n                              Ketuk untuk buka lemari\n                            </div>\n                          </div>\n                        );\n                      }\n                      return null;\n                    }}\n                  />\n                  <Pie\n                    data={data}\n                    cx=\"50%\"\n                    cy=\"50%\"\n                    innerRadius={50}\n                    outerRadius={78}\n                    paddingAngle={4}\n                    dataKey=\"value\"\n                    onClick={(entry) => handleCategoryClick(entry.key)}\n                    cursor=\"pointer\"\n                  >\n                    {data.map((entry, index) => (\n                      <Cell\n                        key={`cell-${index}`}\n                        fill={entry.color}\n                        stroke=\"#ffffff\"\n                        strokeWidth={2}\n                      />\n                    ))}\n                  </Pie>\n                </PieChart>\n              </ResponsiveContainer>\n              {/* Central counter label inside donut */}\n              <div className=\"absolute inset-0 flex flex-col items-center justify-center pointer-events-none\">\n                <span className=\"text-2xl font-black text-slate-800 leading-none\">\n                  {totalCount}\n                </span>\n                <span className=\"text-[10px] uppercase font-bold text-slate-400 tracking-wider mt-0.5\">\n                  Obat\n                </span>\n              </div>\n            </>\n          ) : (\n            <ResponsiveContainer width=\"100%\" height={200}>\n              <BarChart\n                data={data}\n                margin={{ top: 15, right: 10, left: -20, bottom: 5 }}\n              >\n                <CartesianGrid strokeDasharray=\"3 3\" vertical={false} stroke=\"#E2E8F0\" />\n                <XAxis\n                  dataKey=\"name\"\n                  tick={{ fontSize: 10, fill: \'#64748B\' }}\n                  interval={0}\n                  tickLine={false}\n                  axisLine={{ stroke: \'#CBD5E1\' }}\n                />\n                <YAxis\n                  allowDecimals={false}\n                  tick={{ fontSize: 10, fill: \'#64748B\' }}\n                  tickLine={false}\n                  axisLine={{ stroke: \'#CBD5E1\' }}\n                />\n                <Tooltip\n                  content={({ active, payload }) => {\n                    if (active && payload && payload.length) {\n                      const item = payload[0].payload;\n                      const pct = Math.round((item.value / totalCount) * 100);\n                      return (\n                        <div className=\"p-2.5 bg-slate-900 text-white text-xs rounded-xl shadow-lg border border-slate-700 space-y-0.5\">\n                          <div className=\"font-bold flex items-center gap-1.5\">\n                            <span\n                              className=\"w-2.5 h-2.5 rounded-full\"\n                              style={{ backgroundColor: item.color }}\n                            />\n                            <span>{item.name}</span>\n                          </div>\n                          <div className=\"text-slate-200\">\n                            Jumlah: <strong>{item.value} obat</strong> ({pct}%)\n                          </div>\n                        </div>\n                      );\n                    }\n                    return null;\n                  }}\n                />\n                <Bar\n                  dataKey=\"value\"\n                  radius={[6, 6, 0, 0]}\n                  onClick={(entry) => handleCategoryClick(entry.key)}\n                  cursor=\"pointer\"\n                >\n                  {data.map((entry, index) => (\n                    <Cell key={`bar-${index}`} fill={entry.color} />\n                  ))}\n                </Bar>\n              </BarChart>\n            </ResponsiveContainer>\n          )}\n        </div>\n\n        {/* 3 Clickable Metric Cards */}\n        <div className=\"md:col-span-7 space-y-2.5\">\n          {data.map((item) => {\n            const Icon = item.icon;\n            const pct = Math.round((item.value / totalCount) * 100) || 0;\n            return (\n              <button\n                key={item.key}\n                type=\"button\"\n                onClick={() => handleCategoryClick(item.key)}\n                className={`w-full p-3 rounded-xl border transition-all text-left flex items-center justify-between gap-3 group cursor-pointer hover:shadow-xs ${\n                  item.lightBg\n                } ${item.border}`}\n              >\n                <div className=\"flex items-center gap-3 min-w-0\">\n                  <div\n                    className=\"w-8 h-8 rounded-lg flex items-center justify-center shrink-0 text-white shadow-2xs\"\n                    style={{ backgroundColor: item.color }}\n                  >\n                    <Icon className=\"w-4 h-4\" />\n                  </div>\n                  <div className=\"min-w-0\">\n                    <div className=\"flex items-center gap-2\">\n                      <span className=\"font-bold text-slate-900 text-xs sm:text-sm\">\n                        {item.name}\n                      </span>\n                      <span className=\"text-[10px] font-mono font-semibold px-1.5 py-0.2 rounded bg-white/80 text-slate-600 border border-current/10\">\n                        {pct}%\n                      </span>\n                    </div>\n                    <p className=\"text-[11px] text-slate-500 truncate\">\n                      {item.desc}\n                    </p>\n                  </div>\n                </div>\n\n                <div className=\"flex items-center gap-2 shrink-0\">\n                  <span className={`text-base sm:text-lg font-black ${item.text}`}>\n                    {item.value}\n                  </span>\n                  <ChevronRight className=\"w-4 h-4 text-slate-400 group-hover:translate-x-0.5 group-hover:text-slate-700 transition-all\" />\n                </div>\n              </button>\n            );\n          })}\n        </div>\n      </div>\n\n      {/* Action Footer Callout */}\n      <div className=\"pt-2 border-t border-slate-100 flex flex-col xs:flex-row xs:items-center justify-between gap-2 text-xs\">\n        <span className=\"text-slate-500\">\n          {kedaluwarsaCount > 0 ? (\n            <span className=\"text-rose-700 font-semibold flex items-center gap-1\">\n              <AlertOctagon className=\"w-3.5 h-3.5 shrink-0\" />\n              Segera pisahkan {kedaluwarsaCount} obat yang telah kedaluwarsa.\n            </span>\n          ) : segeraCount > 0 ? (\n            <span className=\"text-amber-700 font-semibold flex items-center gap-1\">\n              <AlertTriangle className=\"w-3.5 h-3.5 shrink-0\" />\n              {segeraCount} obat mendekati kedaluwarsa dalam 30 hari.\n            </span>\n          ) : (\n            <span className=\"text-emerald-700 font-medium flex items-center gap-1\">\n              <CheckCircle2 className=\"w-3.5 h-3.5 shrink-0\" />\n              Semua persediaan obat saat ini dalam status aman.\n            </span>\n          )}\n        </span>\n\n        <button\n          type=\"button\"\n          onClick={onNavigateToLemari}\n          className=\"text-teal-800 hover:text-teal-900 font-bold inline-flex items-center gap-1 cursor-pointer self-end xs:self-auto\"\n        >\n          <span>Buka Semua di Lemari Obat</span>\n          <ChevronRight className=\"w-3.5 h-3.5\" />\n        </button>\n      </div>\n    </div>\n  );\n};\n"
