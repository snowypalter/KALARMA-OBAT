  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState, useEffect, useRef } from \'react\';\nimport {\n  Compass,\n  X,\n  ChevronLeft,\n  ChevronRight,\n  CheckCircle2,\n  HelpCircle,\n  ScanSearch,\n  Archive,\n  Dumbbell,\n  BookOpen,\n} from \'lucide-react\';\n\nexport interface WalkthroughStep {\n  id: \'cek-label\' | \'lemari-stok\' | \'latihan\' | \'belajar-cepat\';\n  stepNumber: number;\n  title: string;\n  description: string;\n  tip: string;\n  icon: React.ElementType;\n  accentBg: string;\n  accentText: string;\n}\n\nexport const WALKTHROUGH_STEPS: WalkthroughStep[] = [\n  {\n    id: \'cek-label\',\n    stepNumber: 1,\n    title: \'Simulasi Cek Label Obat\',\n    description:\n      \'Ketuk 6 titik kritis pada kemasan Tablet, Sirup, dan Salep untuk mengenali arti logo golongan, aturan pakai, tanggal kedaluwarsa, hingga kode NIE BPOM.\',\n    tip: \'Mulai dari sini jika Anda belum terbiasa membaca etiket obat kemasan.\',\n    icon: ScanSearch,\n    accentBg: \'bg-secondary\',\n    accentText: \'text-forest\',\n  },\n  {\n    id: \'lemari-stok\',\n    stepNumber: 2,\n    title: \'Lemari Obat & Grafik Stok\',\n    description:\n      \'Catat obat yang tersimpan di rumah. Grafik otomatis mengelompokkan status Aman, Segera Kedaluwarsa (\342\211\244 30 hari), dan Kedaluwarsa agar mudah dipantau.\',\n    tip: \'Klik salah satu kategori pada grafik untuk langsung menyaring daftar obat.\',\n    icon: Archive,\n    accentBg: \'bg-status-aman-bg\',\n    accentText: \'text-status-aman-text\',\n  },\n  {\n    id: \'latihan\',\n    stepNumber: 3,\n    title: \'Skenario Kasus, Flashcard & Kuis\',\n    description:\n      \'Latih pengambilan keputusan swamedikasi lewat cerita bercabang, hafalkan istilah dengan Flashcard 3D, dan ukur pemahaman lewat Kuis Pre/Post-Test.\',\n    tip: \'Semua jawaban kuis disertai alasan ilmiah dari pedoman resmi.\',\n    icon: Dumbbell,\n    accentBg: \'bg-sand-soft\',\n    accentText: \'text-forest\',\n  },\n  {\n    id: \'belajar-cepat\',\n    stepNumber: 4,\n    title: \'Kamus Istilah & Pustaka Resmi\',\n    description:\n      \'Temukan arti istilah seperti BUD, Exp. Date, dan P.No 1\342\200\2236 di Kamus Label Obat, serta lihat sumber rujukan Kemenkes RI & BPOM di tab Pustaka.\',\n    tip: \'Gunakan tombol \"Panduan Fitur\" di atas kapan saja untuk memutar ulang tur ini.\',\n    icon: BookOpen,\n    accentBg: \'bg-status-segera-bg\',\n    accentText: \'text-status-segera-text\',\n  },\n];\n\ninterface BerandaWalkthroughProps {\n  isActive: boolean;\n  currentStepIndex: number;\n  onNext: () => void;\n  onPrev: () => void;\n  onSelectStep: (index: number) => void;\n  onClose: () => void;\n  onJumpToFeature?: (stepId: WalkthroughStep[\'id\']) => void;\n}\n\nexport const BerandaWalkthrough: React.FC<BerandaWalkthroughProps> = ({\n  isActive,\n  currentStepIndex,\n  onNext,\n  onPrev,\n  onSelectStep,\n  onClose,\n  onJumpToFeature,\n}) => {\n  if (!isActive) return null;\n\n  const step = WALKTHROUGH_STEPS[currentStepIndex];\n  const Icon = step.icon;\n  const isFirst = currentStepIndex === 0;\n  const isLast = currentStepIndex === WALKTHROUGH_STEPS.length - 1;\n\n  return (\n    <section\n      aria-label=\"Panduan Interaktif Fitur Beranda\"\n      className=\"ro-fade-in rounded-2xl bg-surface border border-line-strong/60 shadow-sm p-5 sm:p-6 space-y-4 relative overflow-hidden\"\n    >\n      {/* Top Progress Strip */}\n      <div className=\"flex items-center justify-between gap-2\">\n        <div className=\"flex items-center gap-3\">\n          <div className=\"w-9 h-9 rounded-xl bg-forest text-sand flex items-center justify-center shrink-0\">\n            <Compass className=\"w-4 h-4\" />\n          </div>\n          <div>\n            <span className=\"text-[11px] font-semibold uppercase tracking-[0.1em] text-brand block leading-none\">\n              Panduan Pengguna Baru\n            </span>\n            <span className=\"text-xs text-ink-muted font-mono tabular-nums mt-1 block\">\n              Langkah {step.stepNumber} dari {WALKTHROUGH_STEPS.length}\n            </span>\n          </div>\n        </div>\n\n        <button\n          type=\"button\"\n          onClick={onClose}\n          className=\"min-h-[40px] px-3 py-1.5 rounded-xl text-xs font-semibold text-ink-muted hover:text-forest hover:bg-surface-muted flex items-center gap-1 transition-colors cursor-pointer\"\n          aria-label=\"Tutup panduan fitur\"\n        >\n          <span>Lewati</span>\n          <X className=\"w-4 h-4\" />\n        </button>\n      </div>\n\n      {/* Step Content */}\n      <div className=\"p-4 rounded-xl bg-surface-warm border border-line flex items-start gap-3.5\">\n        <div\n          className={`w-10 h-10 rounded-xl ${step.accentBg} ${step.accentText} flex items-center justify-center shrink-0 mt-0.5`}\n        >\n          <Icon className=\"w-5 h-5\" />\n        </div>\n        <div className=\"space-y-1.5 flex-1 min-w-0\">\n          <h3 className=\"text-sm sm:text-base font-bold text-forest\">\n            {step.title}\n          </h3>\n          <p className=\"text-xs sm:text-sm text-ink-muted leading-relaxed\">\n            {step.description}\n          </p>\n          <p className=\"text-xs text-forest font-medium bg-secondary/50 border border-line rounded-lg px-3 py-1.5\">\n            Tips: {step.tip}\n          </p>\n        </div>\n      </div>\n\n      {/* Step Dots & Controls */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-1\">\n        <div className=\"flex items-center gap-1.5\" role=\"tablist\" aria-label=\"Pilih langkah panduan\">\n          {WALKTHROUGH_STEPS.map((s, idx) => {\n            const active = idx === currentStepIndex;\n            return (\n              <button\n                key={s.id}\n                type=\"button\"\n                role=\"tab\"\n                aria-selected={active}\n                aria-label={`Langkah ${idx + 1}: ${s.title}`}\n                onClick={() => onSelectStep(idx)}\n                className={`h-2.5 rounded-full transition-all cursor-pointer ${\n                  active ? \'w-7 bg-forest\' : \'w-2.5 bg-line hover:bg-line-strong/60\'\n                }`}\n              />\n            );\n          })}\n        </div>\n\n        <div className=\"flex items-center justify-end gap-2 flex-wrap\">\n          {onJumpToFeature && (\n            <button\n              type=\"button\"\n              onClick={() => onJumpToFeature(step.id)}\n              className=\"min-h-[40px] px-3.5 py-1.5 rounded-xl bg-secondary/70 hover:bg-secondary text-forest text-xs font-semibold transition-colors cursor-pointer\"\n            >\n              Coba Fitur Ini\n            </button>\n          )}\n\n          {!isFirst && (\n            <button\n              type=\"button\"\n              onClick={onPrev}\n              className=\"min-h-[40px] px-3.5 py-1.5 rounded-xl bg-surface border border-line hover:bg-surface-muted text-ink text-xs font-semibold flex items-center gap-1 cursor-pointer\"\n            >\n              <ChevronLeft className=\"w-4 h-4\" />\n              <span>Sebelumnya</span>\n            </button>\n          )}\n\n          {!isLast ? (\n            <button\n              type=\"button\"\n              onClick={onNext}\n              className=\"min-h-[40px] px-4 py-1.5 rounded-xl bg-forest hover:bg-brand text-on-brand text-xs font-semibold flex items-center gap-1 cursor-pointer\"\n            >\n              <span>Berikutnya</span>\n              <ChevronRight className=\"w-4 h-4\" />\n            </button>\n          ) : (\n            <button\n              type=\"button\"\n              onClick={onClose}\n              className=\"min-h-[40px] px-4 py-1.5 rounded-xl bg-status-aman-text hover:bg-forest text-white text-xs font-semibold flex items-center gap-1.5 cursor-pointer\"\n            >\n              <CheckCircle2 className=\"w-4 h-4\" />\n              <span>Selesai</span>\n            </button>\n          )}\n        </div>\n      </div>\n    </section>\n  );\n};\n\ninterface FeatureTooltipProps {\n  title: string;\n  content: string;\n  align?: \'left\' | \'right\';\n}\n\nexport const FeatureTooltip: React.FC<FeatureTooltipProps> = ({\n  title,\n  content,\n  align = \'right\',\n}) => {\n  const [isOpen, setIsOpen] = useState(false);\n  const wrapperRef = useRef<HTMLDivElement>(null);\n\n  useEffect(() => {\n    if (!isOpen) return;\n\n    const handleClickOutside = (event: MouseEvent) => {\n      if (wrapperRef.current && !wrapperRef.current.contains(event.target as Node)) {\n        setIsOpen(false);\n      }\n    };\n\n    const handleKeyDown = (event: KeyboardEvent) => {\n      if (event.key === \'Escape\') {\n        setIsOpen(false);\n      }\n    };\n\n    document.addEventListener(\'mousedown\', handleClickOutside);\n    document.addEventListener(\'keydown\', handleKeyDown);\n    return () => {\n      document.removeEventListener(\'mousedown\', handleClickOutside);\n      document.removeEventListener(\'keydown\', handleKeyDown);\n    };\n  }, [isOpen]);\n\n  return (\n    <div ref={wrapperRef} className=\"relative inline-flex items-center\">\n      <button\n        type=\"button\"\n        onClick={() => setIsOpen((prev) => !prev)}\n        aria-expanded={isOpen}\n        aria-label={`Info fitur: ${title}`}\n        className={`w-8 h-8 rounded-full flex items-center justify-center transition-colors cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-focus ${\n          isOpen\n            ? \'bg-forest text-on-brand\'\n            : \'bg-surface-muted hover:bg-secondary text-ink-muted hover:text-forest border border-line\'\n        }`}\n      >\n        <HelpCircle className=\"w-4 h-4\" />\n      </button>\n\n      {isOpen && (\n        <div\n          role=\"tooltip\"\n          className={`absolute top-full mt-2 z-30 w-64 sm:w-72 p-4 rounded-2xl bg-forest text-white shadow-xl border border-white/10 text-left space-y-1.5 ro-fade-in ${\n            align === \'right\' ? \'right-0\' : \'left-0\'\n          }`}\n        >\n          <div className=\"flex items-center justify-between gap-2\">\n            <span className=\"text-xs font-bold text-sand\">{title}</span>\n            <button\n              type=\"button\"\n              onClick={() => setIsOpen(false)}\n              className=\"text-secondary/70 hover:text-white cursor-pointer p-0.5\"\n              aria-label=\"Tutup tooltip\"\n            >\n              <X className=\"w-3.5 h-3.5\" />\n            </button>\n          </div>\n          <p className=\"text-xs text-secondary/90 leading-relaxed\">{content}</p>\n        </div>\n      )}\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/BerandaWalkthrough.tsx"
        }
        overwrite: true
      }
    }
