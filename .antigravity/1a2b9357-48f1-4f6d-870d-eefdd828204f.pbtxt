            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "#### 2.3 Panduan Simpan & Buang (Prinsip Dagusibu)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "Memuat tata cara penyimpanan (suhu kamar, dingin, kering) dan tata cara merusak sediaan obat sebelum dibuang (menggerus tablet, mencampur dengan ampas kopi/tanah, merusak botol sirup, memotong label) agar tidak dipungut oknum pemalsu obat."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "#### 2.4 Kamus Label Obat"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "Glosarium 17+ istilah resmi: NIE, BUD, Exp. Date, Peringatan P.1 - P.6, Dosis, Efek Samping, Kontraindikasi, Rekonstitusi, Suhu Simpan, dan Swamedikasi."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "#### 2.5 Modul Skenario Swamedikasi (Cerita Bercabang)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "Simulasi kasus klinis nyata untuk menguji penalaran dan pengambilan keputusan swamedikasi yang aman:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "- **Kasus 1 (Antibiotik & AMR):** Demam flu dan bahaya meminum sisa kapsul amoksisilin milik teman."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "- **Kasus 2 (Takaran Sirup):** Batuk anak dan kekeliruan memakai sendok makan dapur (~15 mL) vs sendok takar obat 5 mL berskala."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "- **Kasus 3 (Steroid Kulit):** Gatal lipatan paha dan bahaya mengoleskan salep kortikosteroid keras sembarangan pada infeksi jamur."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "- **Kasus 4 (Antasida Lambung):** Nyeri ulu hati, waktu minum antasida yang optimal (1 jam sebelum / 2 jam setelah makan), dan keharusan mengunyah tablet kunyah."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "- **Red Flags Alert:** Kotak rambu bahaya tanda pasien wajib segera ke dokter/faskes."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "#### 2.6 Modul Flashcard Interaktif 3D Flip"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "Metode pengulangan aktif (active recall) dengan kartu dua sisi beranimasi putar 3D:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "- 12 kartu terstandar meliputi logo golongan, peringatan P.1-P.6, ED vs BUD, batas Beyond Use Date tetes mata & sirup kering, serta pemusnahan Dagusibu."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "- Dilengkapi pelacak pemahaman lokal (*\"Tandai Sudah Paham\"*), bar progres persentase, dan filter kategori."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "#### 2.7 Modul Kuis Evaluasi (Pre-Test & Post-Test Terstandar)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "Instrumen penelitian skripsi untuk mengukur dampak edukasi terhadap responden:"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "Instrumen evaluasi pemahaman literasi obat bagi pengguna:"
