  view_file {
    absolute_path_uri: "file:///src/components/latihan/SkenarioModule.tsx"
    end_line: 267
    content: "import React, { useState } from \'react\';\nimport { SCENARIO_ITEMS } from \'../../data/latihanData\';\nimport { ScenarioOption } from \'../../types/latihan\';\nimport { \n  GitBranch, \n  CheckCircle2, \n  AlertTriangle, \n  User, \n  HeartHandshake, \n  ArrowRight, \n  RotateCcw, \n  ChevronRight,\n  ShieldAlert,\n  Sparkles,\n  BookOpen\n} from \'lucide-react\';\n\nexport const SkenarioModule: React.FC = () => {\n  const [activeScenarioIndex, setActiveScenarioIndex] = useState(0);\n  const [selectedOption, setSelectedOption] = useState<ScenarioOption | null>(null);\n  const [completedScenarios, setCompletedScenarios] = useState<Record<string, boolean>>({});\n\n  const scenario = SCENARIO_ITEMS[activeScenarioIndex];\n\n  const handleSelectOption = (option: ScenarioOption) => {\n    setSelectedOption(option);\n    if (option.isBestPractice) {\n      setCompletedScenarios((prev) => ({ ...prev, [scenario.id]: true }));\n    }\n  };\n\n  const handleNextScenario = () => {\n    if (activeScenarioIndex < SCENARIO_ITEMS.length - 1) {\n      setActiveScenarioIndex((prev) => prev + 1);\n      setSelectedOption(null);\n    }\n  };\n\n  const handleResetCurrent = () => {\n    setSelectedOption(null);\n  };\n\n  const handleSwitchScenario = (index: number) => {\n    setActiveScenarioIndex(index);\n    setSelectedOption(null);\n  };\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Scenario Selector Chips */}\n      <div className=\"flex items-center gap-2 overflow-x-auto pb-2 scrollbar-thin\">\n        {SCENARIO_ITEMS.map((item, idx) => {\n          const isCurrent = idx === activeScenarioIndex;\n          const isDone = completedScenarios[item.id];\n          return (\n            <button\n              key={item.id}\n              type=\"button\"\n              onClick={() => handleSwitchScenario(idx)}\n              className={`px-3.5 py-2 rounded-xl text-xs sm:text-sm font-semibold whitespace-nowrap transition-all flex items-center gap-2 cursor-pointer ${\n                isCurrent\n                  ? \'bg-teal-700 text-white shadow-xs\'\n                  : isDone\n                  ? \'bg-emerald-50 text-emerald-800 border border-emerald-200\'\n                  : \'bg-white text-slate-700 border border-slate-200 hover:border-teal-400\'\n              }`}\n            >\n              <span>Kasus {idx + 1}</span>\n              {isDone && <CheckCircle2 className=\"w-3.5 h-3.5 text-emerald-600\" />}\n            </button>\n          );\n        })}\n      </div>\n\n      {/* Main Scenario Card */}\n      <div className=\"bg-white rounded-2xl border border-slate-200 shadow-2xs overflow-hidden\">\n        {/* Header Ribbon */}\n        <div className=\"p-4 sm:p-5 bg-gradient-to-r from-teal-900 via-teal-800 to-slate-900 text-white flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n          <div className=\"space-y-1\">\n            <div className=\"flex items-center gap-2\">\n              <span className=\"text-[11px] font-bold tracking-wider uppercase px-2.5 py-0.5 rounded-full bg-teal-500/20 text-teal-300 border border-teal-400/30\">\n                {scenario.badge}\n              </span>\n              <span className=\"text-xs text-slate-300\">\n                Kasus {activeScenarioIndex + 1} dari {SCENARIO_ITEMS.length}\n              </span>\n            </div>\n            <h2 className=\"text-lg sm:text-xl font-bold tracking-tight text-white\">\n              {scenario.title}\n            </h2>\n            <p className=\"text-xs sm:text-sm text-teal-200/90\">\n              {scenario.subtitle}\n            </p>\n          </div>\n\n          <div className=\"flex items-center gap-2 self-start sm:self-auto bg-slate-800/80 px-3 py-1.5 rounded-xl border border-slate-700 text-xs text-slate-300\">\n            <GitBranch className=\"w-4 h-4 text-teal-400\" />\n            <span>Cerita Keputusan</span>\n          </div>\n        </div>\n\n        {/* Narrative & Patient Profile */}\n        <div className=\"p-5 sm:p-6 space-y-5\">\n          {/* Patient Profile Pill */}\n          <div className=\"p-3.5 rounded-xl bg-slate-50 border border-slate-200/80 flex items-start gap-3\">\n            <div className=\"w-9 h-9 rounded-lg bg-teal-100 text-teal-800 flex items-center justify-center shrink-0 mt-0.5\">\n              <User className=\"w-5 h-5 text-teal-700\" />\n            </div>\n            <div className=\"text-xs sm:text-sm space-y-0.5\">\n              <div className=\"font-bold text-slate-900\">\n                {scenario.patientProfile.name} \342\200\242 <span className=\"font-normal text-slate-600\">{scenario.patientProfile.age}</span>\n              </div>\n              <p className=\"text-slate-600 text-xs leading-relaxed\">\n                <strong className=\"text-slate-700\">Kondisi:</strong> {scenario.patientProfile.condition}\n              </p>\n            </div>\n          </div>\n\n          {/* Story Narrative */}\n          <div className=\"p-4 rounded-xl bg-teal-50/50 border-l-4 border-teal-600 text-slate-800 text-xs sm:text-sm leading-relaxed space-y-2\">\n            <p className=\"italic text-slate-700\">\n              \"{scenario.story}\"\n            </p>\n          </div>\n\n          {/* Dilemma Question */}\n          <div className=\"space-y-3 pt-2\">\n            <div className=\"flex items-center gap-2 text-slate-900 font-bold text-sm sm:text-base\">\n              <Sparkles className=\"w-4 h-4 text-teal-700\" />\n              <span>{scenario.question}</span>\n            </div>\n\n            {/* Options list */}\n            <div className=\"space-y-2.5\">\n              {scenario.options.map((opt, i) => {\n                const isSelected = selectedOption?.id === opt.id;\n                return (\n                  <button\n                    key={opt.id}\n                    type=\"button\"\n                    onClick={() => handleSelectOption(opt)}\n                    className={`w-full p-4 rounded-xl text-left text-xs sm:text-sm transition-all flex items-start gap-3 cursor-pointer ${\n                      isSelected\n                        ? opt.isBestPractice\n                          ? \'bg-emerald-50/80 border-2 border-emerald-600 text-emerald-950 font-medium shadow-xs\'\n                          : \'bg-rose-50/80 border-2 border-rose-500 text-rose-950 font-medium shadow-xs\'\n                        : \'bg-white border border-slate-200 hover:border-teal-400 hover:bg-slate-50/60 text-slate-800\'\n                    }`}\n                  >\n                    <span className={`w-6 h-6 rounded-full flex items-center justify-center shrink-0 text-xs font-bold ${\n                      isSelected\n                        ? opt.isBestPractice\n                          ? \'bg-emerald-600 text-white\'\n                          : \'bg-rose-600 text-white\'\n                        : \'bg-slate-100 text-slate-700\'\n                    }`}>\n                      {String.fromCharCode(65 + i)}\n                    </span>\n                    <span className=\"flex-1 leading-relaxed\">\n                      {opt.text}\n                    </span>\n                    {isSelected && (\n                      opt.isBestPractice ? (\n                        <CheckCircle2 className=\"w-5 h-5 text-emerald-600 shrink-0\" />\n                      ) : (\n                        <AlertTriangle className=\"w-5 h-5 text-rose-600 shrink-0\" />\n                      )\n                    )}\n                  </button>\n                );\n              })}\n            </div>\n          </div>\n\n          {/* Feedback & Result Box if option is selected */}\n          {selectedOption && (\n            <div className={`p-4 sm:p-5 rounded-2xl border space-y-3 ro-fade-in ${\n              selectedOption.isBestPractice\n                ? \'bg-emerald-50/70 border-emerald-300 text-emerald-950\'\n                : \'bg-rose-50/70 border-rose-300 text-rose-950\'\n            }`}>\n              <div className=\"flex items-center gap-2\">\n                {selectedOption.isBestPractice ? (\n                  <span className=\"inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-600 text-white text-xs font-bold shadow-xs\">\n                    <CheckCircle2 className=\"w-3.5 h-3.5\" />\n                    Pilihan Tepat & Rasional\n                  </span>\n                ) : (\n                  <span className=\"inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-rose-600 text-white text-xs font-bold shadow-xs\">\n                    <AlertTriangle className=\"w-3.5 h-3.5\" />\n                    Beresiko & Tidak Dianjurkan\n                  </span>\n                )}\n                <span className=\"text-xs font-bold uppercase tracking-wide opacity-80\">\n                  {selectedOption.consequence}\n                </span>\n              </div>\n\n              <p className=\"text-xs sm:text-sm leading-relaxed font-normal\">\n                {selectedOption.feedback}\n              </p>\n\n              <div className=\"p-3 rounded-xl bg-white/80 border border-current/15 text-xs space-y-1\">\n                <div className=\"font-bold flex items-center gap-1.5\">\n                  <BookOpen className=\"w-3.5 h-3.5\" />\n                  <span>Alasan Ilmiah Farmakologi:</span>\n                </div>\n                <p className=\"leading-relaxed opacity-90\">\n                  {selectedOption.scientificReason}\n                </p>\n              </div>\n\n              {/* Action Buttons within feedback */}\n              <div className=\"pt-2 flex flex-wrap items-center justify-between gap-2\">\n                <button\n                  type=\"button\"\n                  onClick={handleResetCurrent}\n                  className=\"px-3 py-1.5 rounded-lg bg-white border border-slate-300 text-slate-700 hover:bg-slate-50 text-xs font-semibold flex items-center gap-1.5 cursor-pointer\"\n                >\n                  <RotateCcw className=\"w-3.5 h-3.5\" />\n                  <span>Coba Pilihan Lain</span>\n                </button>\n\n                {activeScenarioIndex < SCENARIO_ITEMS.length - 1 ? (\n                  <button\n                    type=\"button\"\n                    onClick={handleNextScenario}\n                    className=\"px-4 py-2 rounded-xl bg-teal-700 hover:bg-teal-800 text-white text-xs sm:text-sm font-bold flex items-center gap-1.5 cursor-pointer shadow-xs\"\n                  >\n                    <span>Lanjut ke Kasus Berikutnya</span>\n                    <ArrowRight className=\"w-4 h-4\" />\n                  </button>\n                ) : (\n                  <div className=\"text-xs font-bold text-teal-800 flex items-center gap-1\">\n                    <CheckCircle2 className=\"w-4 h-4 text-emerald-600\" />\n                    <span>Semua Kasus Skenario Selesai!</span>\n                  </div>\n                )}\n              </div>\n            </div>\n          )}\n\n          {/* Section: Red Flags / Kapan Wajib ke Dokter / Apoteker */}\n          <div className=\"p-4 rounded-xl bg-amber-50/80 border border-amber-200 text-amber-950 space-y-2.5\">\n            <div className=\"flex items-center gap-2 font-bold text-amber-900 text-xs sm:text-sm\">\n              <ShieldAlert className=\"w-4 h-4 text-amber-700 shrink-0\" />\n              <span>Tanda Bahaya: Kapan Pasien Wajib Segera ke Dokter / Apoteker?</span>\n            </div>\n            <ul className=\"text-xs text-amber-900/90 space-y-1.5 list-disc list-inside\">\n              {scenario.redFlags.map((flag, idx) => (\n                <li key={idx} className=\"leading-relaxed\">\n                  {flag}\n                </li>\n              ))}\n            </ul>\n          </div>\n\n          {/* Official Reference Citation */}\n          <div className=\"pt-3 border-t border-slate-100 flex items-center justify-between text-[11px] text-slate-500\">\n            <span>Rujukan: {scenario.referenceCitation}</span>\n            <span className=\"text-teal-700 font-medium\">Bahan Skripsi S1 Farmasi</span>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    num_lines: 268
    num_bytes: 11774
    line_range_bytes: 11774
  }
}
