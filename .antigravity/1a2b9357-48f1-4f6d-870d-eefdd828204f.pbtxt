            lines {
              text: "                        const fullDoc = `# DOKUMEN PROTOTIPE MEDIA EDUKASI SKRIPSI S1 FARMASI"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "# RUANG OBAT (\"Kenali label obatmu, kelola obat di rumahmu\")"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "IDENTITAS PENELITIAN:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "- Aplikasi Web: Ruang Obat (Mobile-First Web App)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "- Bidang: Farmasi Klinis dan Komunitas"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "- Sasaran: Mahasiswa Non-Kesehatan dan Masyarakat Umum"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "- Tahun: 2026"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "BAB I: LATAR BELAKANG & BATASAN ETIKA"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "1. Urgensi: Mengatasi ketidaktepatan swamedikasi, ketidakpahaman membedakan Expired Date pabrik vs Beyond Use Date (BUD), penyalahgunaan antibiotik sisa teman, dan pembuangan obat rusak yang berbahaya."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "2. Batasan Etika Farmasi (Patient Safety):"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "   - TANPA kalkulator dosis & TANPA diagnosis mandiri"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "   - TANPA klaim berlebihan (\"ditinjau apoteker\", testimoni)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "   - Seluruh materi menggunakan rujukan resmi Kemenkes RI, BPOM RI, dan Farmakope"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "   - Data lemari obat 100% tersimpan lokal di browser (localStorage)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "   - Disclaimer wajib di footer: \"Edukasi umum, bukan diagnosis atau saran dosis pribadi. Tanyakan ke apoteker atau dokter.\""
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
