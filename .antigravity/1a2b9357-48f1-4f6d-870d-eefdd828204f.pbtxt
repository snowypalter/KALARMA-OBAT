  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\nimport { TabType } from \'../types\';\nimport { LatihanSubTab } from \'../types/latihan\';\nimport { SkenarioModule } from \'../components/latihan/SkenarioModule\';\nimport { FlashcardModule } from \'../components/latihan/FlashcardModule\';\nimport { KuisModule } from \'../components/latihan/KuisModule\';\nimport { \n  GitBranch, \n  Layers, \n  FileCheck2, \n  ArrowLeft, \n  Sparkles, \n  GraduationCap\n} from \'lucide-react\';\n\ninterface LatihanViewProps {\n  onNavigate: (tab: TabType) => void;\n  initialSubTab?: LatihanSubTab;\n}\n\nexport const LatihanView: React.FC<LatihanViewProps> = ({ \n  onNavigate,\n  initialSubTab = \'skenario\'\n}) => {\n  const [activeSubTab, setActiveSubTab] = useState<LatihanSubTab>(initialSubTab);\n\n  return (\n    <div className=\"space-y-6 pb-12 animate-in fade-in duration-150\">\n      {/* Top Breadcrumb & Title */}\n      <div className=\"space-y-2\">\n        <button\n          type=\"button\"\n          onClick={() => onNavigate(\'beranda\')}\n          className=\"inline-flex items-center gap-1.5 text-xs font-semibold text-teal-800 hover:text-teal-900 cursor-pointer mb-1\"\n        >\n          <ArrowLeft className=\"w-4 h-4\" />\n          <span>Kembali ke Beranda</span>\n        </button>\n\n        <div className=\"flex flex-wrap items-center gap-2\">\n          <div className=\"inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-semibold\">\n            <Sparkles className=\"w-3.5 h-3.5 text-emerald-600\" />\n            <span>Tahap 2 Aktif: Modul Latihan & Evaluasi</span>\n          </div>\n\n          <div className=\"inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-slate-100 text-slate-700 text-xs font-medium\">\n            <GraduationCap className=\"w-3.5 h-3.5 text-teal-700\" />\n            <span>Instrumen Skripsi S1 Farmasi</span>\n          </div>\n        </div>\n\n        <h1 className=\"text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight\">\n          Latihan & Uji Pemahaman\n        </h1>\n        <p className=\"text-slate-600 text-sm sm:text-base leading-relaxed\">\n          Asah pemahaman label obat dan keputusan swamedikasi melalui skenario kasus nyata, flashcard interaktif, serta kuis evaluasi terstandar.\n        </p>\n      </div>\n\n      {/* Sub-tab Navigation (Skenario, Flashcard, Kuis) */}\n      <div className=\"grid grid-cols-3 gap-1.5 p-1 bg-slate-200/80 rounded-2xl border border-slate-200\">\n        <button\n          type=\"button\"\n          onClick={() => {\n            setActiveSubTab(\'skenario\');\n            window.scrollTo({ top: 120, behavior: \'smooth\' });\n          }}\n          className={`min-h-[46px] px-2 sm:px-4 py-2 rounded-xl text-xs sm:text-sm font-bold flex items-center justify-center gap-1.5 sm:gap-2 transition-all cursor-pointer ${\n            activeSubTab === \'skenario\'\n              ? \'bg-white text-teal-900 shadow-xs\'\n              : \'text-slate-600 hover:text-slate-900 hover:bg-white/40\'\n          }`}\n        >\n          <GitBranch className=\"w-4 h-4 shrink-0\" />\n          <span className=\"truncate\">Skenario Kasus</span>\n        </button>\n\n        <button\n          type=\"button\"\n          onClick={() => {\n            setActiveSubTab(\'flashcard\');\n            window.scrollTo({ top: 120, behavior: \'smooth\' });\n          }}\n          className={`min-h-[46px] px-2 sm:px-4 py-2 rounded-xl text-xs sm:text-sm font-bold flex items-center justify-center gap-1.5 sm:gap-2 transition-all cursor-pointer ${\n            activeSubTab === \'flashcard\'\n              ? \'bg-white text-teal-900 shadow-xs\'\n              : \'text-slate-600 hover:text-slate-900 hover:bg-white/40\'\n          }`}\n        >\n          <Layers className=\"w-4 h-4 shrink-0\" />\n          <span className=\"truncate\">Flashcard</span>\n        </button>\n\n        <button\n          type=\"button\"\n          onClick={() => {\n            setActiveSubTab(\'kuis\');\n            window.scrollTo({ top: 120, behavior: \'smooth\' });\n          }}\n          className={`min-h-[46px] px-2 sm:px-4 py-2 rounded-xl text-xs sm:text-sm font-bold flex items-center justify-center gap-1.5 sm:gap-2 transition-all cursor-pointer ${\n            activeSubTab === \'kuis\'\n              ? \'bg-white text-teal-900 shadow-xs\'\n              : \'text-slate-600 hover:text-slate-900 hover:bg-white/40\'\n          }`}\n        >\n          <FileCheck2 className=\"w-4 h-4 shrink-0\" />\n          <span className=\"truncate\">Kuis Pre/Post</span>\n        </button>\n      </div>\n\n      {/* Active Tab Content */}\n      <div className=\"pt-2\">\n        {activeSubTab === \'skenario\' && <SkenarioModule />}\n        {activeSubTab === \'flashcard\' && <FlashcardModule />}\n        {activeSubTab === \'kuis\' && <KuisModule />}\n      </div>\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/views/LatihanView.tsx"
        }
        overwrite: true
      }
    }
