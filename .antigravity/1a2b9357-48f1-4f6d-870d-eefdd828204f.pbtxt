        absolute_uri: "file:///src/utils/medicineUtils.ts"
      }
    }
    use_fast_apply: true
    description: "Update medicineUtils status tokens to warm editorial semantic color variables"
    diff_stats {
      additions: 36
      deletions: 17
    }
  }
}
