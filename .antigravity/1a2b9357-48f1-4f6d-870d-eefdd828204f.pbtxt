    tool_calls {
      id: "call_371837612518060688"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState, useEffect } from \'react\';\\nimport { PANDUAN_SIMPAN_BUANG } from \'../data/panduanSimpanBuang\';\\nimport { ModalShell } from \'./ui\';\\nimport { Trash2, ShieldAlert, Sparkles, Check, BookOpen } from \'lucide-react\';\\n\\ninterface PanduanSimpanBuangModalProps {\\n  isOpen: boolean;\\n  onClose: () => void;\\n  initialTab?: \'simpan\' | \'buang\';\\n}\\n\\nexport const PanduanSimpanBuangModal: React.FC<PanduanSimpanBuangModalProps> = ({\\n  isOpen,\\n  onClose,\\n  initialTab = \'simpan\',\\n}) => {\\n  const [activeMode, setActiveMode] = useState<\'simpan\' | \'buang\'>(initialTab);\\n  const [selectedSediaanIndex, setSelectedSediaanIndex] = useState<number>(0);\\n\\n  useEffect(() => {\\n    if (isOpen) {\\n      setActiveMode(initialTab);\\n    }\\n  }, [isOpen, initialTab]);\\n\\n  const currentItem =\\n    PANDUAN_SIMPAN_BUANG[selectedSediaanIndex] || PANDUAN_SIMPAN_BUANG[0];\\n\\n  return (\\n    <ModalShell\\n      isOpen={isOpen}\\n      onClose={onClose}\\n      title=\\\"Panduan Simpan & Buang Obat\\\"\\n      subtitle=\\\"Prinsip Dagusibu (Kelola Obat Rumah Tangga dengan Benar)\\\"\\n      maxWidth=\\\"xl\\\"\\n      headerIcon={<BookOpen className=\\\"w-5 h-5\\\" />}\\n      footer={\\n        <div className=\\\"flex items-center justify-between text-xs text-ink-muted\\\">\\n          <span>Rujukan: Dagusibu Kemenkes &amp; BPOM RI</span>\\n          <button\\n            type=\\\"button\\\"\\n            onClick={onClose}\\n            className=\\\"min-h-[44px] px-5 py-2 font-semibold text-forest bg-surface border border-line hover:bg-surface-muted rounded-xl transition-colors cursor-pointer\\\"\\n          >\\n            Tutup\\n          </button>\\n        </div>\\n      }\\n    >\\n      <div className=\\\"space-y-5\\\">\\n        {/* Mode Switcher: Simpan vs Buang */}\\n        <div className=\\\"grid grid-cols-2 gap-1.5 bg-surface-muted p-1.5 rounded-2xl border border-line\\\">\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => setActiveMode(\'simpan\')}\\n            className={`min-h-[44px] flex items-center justify-center gap-2 rounded-xl text-xs sm:text-sm font-semibold transition-all cursor-pointer ${\\n              activeMode === \'simpan\'\\n                ? \'bg-surface text-forest shadow-xs\'\\n                : \'text-ink-muted hover:text-forest\'\\n            }`}\\n          >\\n            <Sparkles className=\\\"w-4 h-4 text-brand\\\" />\\n            <span>Cara Menyimpan</span>\\n          </button>\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => setActiveMode(\'buang\')}\\n            className={`min-h-[44px] flex items-center justify-center gap-2 rounded-xl text-xs sm:text-sm font-semibold transition-all cursor-pointer ${\\n              activeMode === \'buang\'\\n                ? \'bg-surface text-status-kedaluwarsa-text shadow-xs\'\\n                : \'text-ink-muted hover:text-forest\'\\n            }`}\\n          >\\n            <Trash2 className=\\\"w-4 h-4 text-status-kedaluwarsa-text\\\" />\\n            <span>Cara Membuang (Rusak)</span>\\n          </button>\\n        </div>\\n\\n        {/* Form Selector */}\\n        <div className=\\\"flex items-center gap-2 overflow-x-auto pb-1 no-scrollbar\\\">\\n          <span className=\\\"text-xs font-semibold text-ink-muted whitespace-nowrap\\\">\\n            Bentuk:\\n          </span>\\n          {PANDUAN_SIMPAN_BUANG.map((item, idx) => (\\n            <button\\n              key={item.title}\\n              type=\\\"button\\\"\\n              onClick={() => setSelectedSediaanIndex(idx)}\\n              className={`min-h-[38px] px-3 py-1.5 rounded-xl text-xs font-semibold whitespace-nowrap transition-colors cursor-pointer border ${\\n                selectedSediaanIndex === idx\\n                  ? \'bg-forest text-white border-forest\'\\n                  : \'bg-surface border-line text-ink hover:bg-surface-muted\'\\n              }`}\\n            >\\n              {item.title}\\n            </button>\\n          ))}\\n        </div>\\n\\n        {/* Content Body */}\\n        <div className=\\\"space-y-4\\\">\\n          <div className=\\\"flex flex-wrap items-center justify-between gap-2 pb-2.5 border-b border-line\\\">\\n            <h3 className=\\\"font-display text-lg font-semibold text-forest\\\">\\n              {currentItem.title}\\n            </h3>\\n            <span className=\\\"text-xs text-ink-muted font-medium\\\">\\n              {activeMode === \'simpan\'\\n                ? \'Mode Penyimpanan Tepat\'\\n                : \'Mode Pemusnahan & Pembuangan\'}\\n            </span>\\n          </div>\\n\\n          <div className=\\\"space-y-3\\\">\\n            <h4 className=\\\"text-xs font-bold uppercase tracking-wider text-brand\\\">\\n              {activeMode === \'simpan\'\\n                ? \'Langkah Penyimpanan Aman\'\\n                : \'Langkah Membuang Obat Agar Tidak Disalahgunakan\'}\\n            </h4>\\n\\n            <ul className=\\\"space-y-2.5\\\">\\n              {(activeMode === \'simpan\'\\n                ? currentItem.simpanRules\\n                : currentItem.buangRules\\n              ).map((rule, idx) => (\\n                <li\\n                  key={idx}\\n                  className=\\\"flex items-start gap-3 p-3.5 bg-surface-warm rounded-xl border border-line text-sm\\\"\\n                >\\n                  <div\\n                    className={`w-6 h-6 rounded-full flex items-center justify-center shrink-0 mt-0.5 ${\\n                      activeMode === \'simpan\'\\n                        ? \'bg-status-aman-bg text-status-aman-text\'\\n                        : \'bg-status-kedaluwarsa-bg text-status-kedaluwarsa-text\'\\n                    }`}\\n                  >\\n                    {activeMode === \'simpan\' ? (\\n                      <Check className=\\\"w-3.5 h-3.5 stroke-[2.5]\\\" />\\n                    ) : (\\n                      <span className=\\\"text-xs font-mono font-bold\\\">{idx + 1}</span>\\n                    )}\\n                  </div>\\n                  <span className=\\\"text-ink leading-relaxed\\\">{rule}</span>\\n                </li>\\n              ))}\\n            </ul>\\n          </div>\\n\\n          <div className=\\\"p-4 bg-status-segera-bg/70 rounded-2xl border border-status-segera-text/20 flex items-start gap-3\\\">\\n            <ShieldAlert className=\\\"w-5 h-5 text-status-segera-text shrink-0 mt-0.5\\\" />\\n            <div className=\\\"text-xs text-ink space-y-1\\\">\\n              <span className=\\\"font-bold text-status-segera-text block\\\">\\n                Tanda Kerusakan Fisik Obat\\n              </span>\\n              <p className=\\\"leading-relaxed text-ink-muted\\\">\\n                {currentItem.catatanPenting}\\n              </p>\\n            </div>\\n          </div>\\n        </div>\\n      </div>\\n    </ModalShell>\\n  );\\n};\\n\", \"Description\":\"Redesign PanduanSimpanBuangModal with ModalShell, synced mode effect, and warm editorial palette\", \"Overwrite\":true, \"TargetFile\":\"/src/components/PanduanSimpanBuangModal.tsx\", \"toolAction\":\"Redesigning PanduanSimpanBuangModal\", \"toolSummary\":\"Redesign PanduanSimpanBuangModal.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_371837612518062571"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React from \'react\';\\nimport { ModalShell } from \'./ui\';\\nimport { ShieldCheck, BookMarked, UserCheck, Lock, Info } from \'lucide-react\';\\n\\ninterface TentangModalProps {\\n  isOpen: boolean;\\n  onClose: () => void;\\n}\\n\\nexport const TentangModal: React.FC<TentangModalProps> = ({ isOpen, onClose }) => {\\n  return (\\n    <ModalShell\\n      isOpen={isOpen}\\n      onClose={onClose}\\n      title=\\\"Tentang Ruang Obat\\\"\\n      subtitle=\\\"Media Edukasi Skripsi S1 Farmasi Klinis & Komunitas\\\"\\n      maxWidth=\\\"lg\\\"\\n      headerIcon={<Info className=\\\"w-5 h-5\\\" />}\\n      footer={\\n        <div className=\\\"flex justify-end\\\">\\n          <button\\n            type=\\\"button\\\"\\n            onClick={onClose}\\n            className=\\\"min-h-[44px] px-5 py-2 text-sm font-semibold text-on-brand bg-forest hover:bg-brand rounded-xl transition-colors cursor-pointer\\\"\\n          >\\n            Tutup\\n          </button>\\n        </div>\\n      }\\n    >\\n      <div className=\\\"space-y-6 text-ink text-sm leading-relaxed\\\">\\n        {/* Section 1: Tujuan */}\\n        <div className=\\\"space-y-2\\\">\\n          <div className=\\\"flex items-center gap-2 text-forest font-bold\\\">\\n            <BookMarked className=\\\"w-4 h-4 text-brand\\\" />\\n            <h3 className=\\\"text-xs uppercase tracking-wider\\\">Tujuan Media Edukasi</h3>\\n          </div>\\n          <p className=\\\"text-ink-muted text-sm leading-relaxed\\\">\\n            Ruang Obat dikembangkan sebagai instrumen media edukasi interaktif dalam penelitian skripsi S1 Farmasi Klinis dan Komunitas. Sasaran utamanya adalah mahasiswa non-kesehatan dan masyarakat umum untuk meningkatkan kecakapan literasi membaca label obat serta menumbuhkan kebiasaan pengelolaan obat rumah tangga yang aman (Dagusibu: Dapatkan, Gunakan, Simpan, Buang).\\n          </p>\\n        </div>\\n\\n        {/* Section 2: Peneliti & Institusi */}\\n        <div className=\\\"space-y-2.5 p-4 bg-surface-warm rounded-2xl border border-line\\\">\\n          <div className=\\\"flex items-center gap-2 text-forest font-bold\\\">\\n            <UserCheck className=\\\"w-4 h-4 text-brand\\\" />\\n            <h3 className=\\\"text-sm\\\">Identitas Pengembang &amp; Penelitian</h3>\\n          </div>\\n          <ul className=\\\"text-xs space-y-1.5 text-ink-muted\\\">\\n            <li>\\n              <strong className=\\\"text-ink\\\">Peneliti:</strong> [ISI NAMA PENGEMBANG / PENELITI SKRIPSI]\\n            </li>\\n            <li>\\n              <strong className=\\\"text-ink\\\">NIM / Program Studi:</strong> [ISI NIM &amp; PRODI S1 FARMASI]\\n            </li>\\n            <li>\\n              <strong className=\\\"text-ink\\\">Fakultas / Universitas:</strong> [ISI FAKULTAS &amp; UNIVERSITAS]\\n            </li>\\n            <li>\\n              <strong className=\\\"text-ink\\\">Tahun Penyusunan:</strong>{\' \'}\\n              <span className=\\\"font-mono\\\">2026</span>\\n            </li>\\n          </ul>\\n        </div>\\n\\n        {/* Section 3: Batasan Produk */}\\n        <div className=\\\"space-y-2\\\">\\n          <div className=\\\"flex items-center gap-2 text-status-segera-text font-bold\\\">\\n            <ShieldCheck className=\\\"w-4 h-4\\\" />\\n            <h3 className=\\\"text-xs uppercase tracking-wider\\\">Batasan Produk</h3>\\n          </div>\\n          <p className=\\\"text-ink-muted text-xs sm:text-sm leading-relaxed\\\">\\n            Aplikasi ini murni bersifat media edukasi umum. Aplikasi ini{\' \'}\\n            <strong className=\\\"text-ink\\\">TIDAK</strong> menyediakan kalkulator dosis, diagnosis penyakit, atau rekomendasi pemilihan obat tertentu untuk kondisi medis pribadi. Segala keluhan kesehatan dan pertimbangan dosis obat harus selalu dikonsultasikan secara langsung kepada dokter atau apoteker.\\n          </p>\\n        </div>\\n\\n        {/* Section 4: Kebijakan Privasi */}\\n        <div className=\\\"space-y-2\\\">\\n          <div className=\\\"flex items-center gap-2 text-forest font-bold\\\">\\n            <Lock className=\\\"w-4 h-4 text-brand\\\" />\\n            <h3 className=\\\"text-xs uppercase tracking-wider\\\">\\n              Kebijakan Privasi (Data On-Device)\\n            </h3>\\n          </div>\\n          <p className=\\\"text-ink-muted text-xs sm:text-sm leading-relaxed\\\">\\n            Daftar obat yang Anda catat pada menu <em>Lemari Obat</em> disimpan secara eksklusif di memori lokal peramban (<span className=\\\"font-mono\\\">localStorage</span>) perangkat Anda. Tidak ada data pribadi, nama obat, atau tanggal yang diunggah ke peladen eksternal mana pun.\\n          </p>\\n        </div>\\n      </div>\\n    </ModalShell>\\n  );\\n};\\n\", \"Description\":\"Redesign TentangModal using accessible ModalShell and warm editorial typography\", \"Overwrite\":true, \"TargetFile\":\"/src/components/TentangModal.tsx\", \"toolAction\":\"Redesigning TentangModal component\", \"toolSummary\":\"Redesign TentangModal.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_371837612518060358"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState } from \'react\';\\nimport { ModalShell } from \'./ui\';\\nimport {\\n  Copy,\\n  Check,\\n  Share2,\\n  GraduationCap,\\n  Bot,\\n  ExternalLink,\\n  Printer,\\n  CheckCircle2,\\n  FileText,\\n  FileDown,\\n  Download,\\n} from \'lucide-react\';\\nimport { generateAndDownloadPdf } from \'../utils/generatePdfClient\';\\n\\ninterface TinjauDosenModalProps {\\n  isOpen: boolean;\\n  onClose: () => void;\\n  defaultTab?: \'pdf\' | \'link\' | \'dosen\' | \'claude\';\\n}\\n\\nexport const TinjauDosenModal: React.FC<TinjauDosenModalProps> = ({\\n  isOpen,\\n  onClose,\\n  defaultTab = \'pdf\',\\n}) => {\\n  const [activeTab, setActiveTab] = useState<\'pdf\' | \'link\' | \'dosen\' | \'claude\'>(\\n    defaultTab\\n  );\\n  const [copiedLink, setCopiedLink] = useState(false);\\n  const [copiedClaudePrompt, setCopiedClaudePrompt] = useState(false);\\n  const [copiedFullDoc, setCopiedFullDoc] = useState(false);\\n  const [isGenerating, setIsGenerating] = useState(false);\\n\\n  const currentOrigin =\\n    typeof window !== \'undefined\'\\n      ? window.location.origin\\n      : \'https://ais-pre-i6cmepgnonm4mfj7yg2xyk-74888050060.asia-east1.run.app\';\\n  const sharedUrl =\\n    \'https://ais-pre-i6cmepgnonm4mfj7yg2xyk-74888050060.asia-east1.run.app\';\\n  const bestUrlToShare = currentOrigin.includes(\'localhost\')\\n    ? sharedUrl\\n    : currentOrigin;\\n\\n  const handleCopyLink = () => {\\n    navigator.clipboard.writeText(bestUrlToShare).then(() => {\\n      setCopiedLink(true);\\n      setTimeout(() => setCopiedLink(false), 2500);\\n    });\\n  };\\n\\n  const claudeReviewPrompt = `# Permohonan Review Media Edukasi Skripsi S1 Farmasi: \\\"Ruang Obat\\\"\\n\\nHalo Claude, saya mahasiswa S1 Farmasi Klinis dan Komunitas yang sedang menyusun skripsi media edukasi interaktif bernama \\\"Ruang Obat\\\" (Tagline: \\\"Kenali label obatmu, kelola obat di rumahmu\\\").\\n\\nTautan Web Media Prototipe Aktif:\\n${bestUrlToShare}\\n\\nSasaran Pengguna:\\nMahasiswa non-kesehatan dan masyarakat umum.\\n\\nAturan Ketat & Batasan Skripsi (Ethical Safeguards):\\n1. Murni edukasi umum; TIDAK ADA kalkulator dosis, diagnosis mandiri, atau rekomendasi obat/dosis tertentu.\\n2. Tidak mencantumkan klaim \\\"ditinjau apoteker\\\", \\\"terverifikasi\\\", atau testimoni apa pun.\\n3. Seluruh konten edukasi menggunakan acuan resmi BPOM RI, Kemenkes RI (Dagusibu), dan Farmakope Indonesia.\\n4. Data lemari obat 100% tersimpan lokal di browser pengguna (localStorage).\\n5. Disclaimer wajib di footer: \\\"Edukasi umum, bukan diagnosis atau saran dosis pribadi. Tanyakan ke apoteker atau dokter.\\\"\\n\\nFitur yang Telah Aktif untuk Dicek:\\n1. Beranda: Banner peringatan obat kedaluwarsa dinamis, 2 kartu aksi utama, grafik stok Recharts, panduan walkthrough, kartu skenario swamedikasi hari ini, akses cepat Kamus & Flashcard.\\n2. Cek Label: Simulasi kemasan interaktif (Tablet strip foil, Sirup botol cair, Salep tube kulit) dengan 6 titik ketuk resmi (Logo golongan obat, Nama/komposisi, Indikasi, Aturan pakai, Tanggal kedaluwarsa/bets, Nomor Izin Edar NIE BPOM).\\n3. Lemari Obat Saya: Inventaris mandiri dengan pencarian real-time, deteksi status otomatis (Aman, Segera kedaluwarsa <=30 hari, Kedaluwarsa) dengan ikon & teks, filter chip, tambah/edit obat, tautan langsung ke panduan pemusnahan obat rusak/kedaluwarsa.\\n4. Panduan Simpan & Buang (Dagusibu): Petunjuk penyimpanan dan pemusnahan per bentuk sediaan.\\n5. Kamus Label Obat: Glosarium istilah obat resmi dengan pencarian langsung dan filter abjad A-Z.\\n6. Modul Latihan & Uji Evaluasi (Tahap 2):\\n   - Skenario Swamedikasi Cerita Bercabang (4 kasus nyata).\\n   - Flashcard Interaktif 3D Flip (12 kartu terstandar).\\n   - Kuis Evaluasi Pre-Test & Post-Test (10 soal terstandar skripsi, kalkulasi skor /100, delta Pre-Post, pembahasan ilmiah).\\n7. Tentang & Berkas PDF Skripsi: Lembar penilaian dosen pembimbing dan dokumen akademik A4 siap cetak.\\n8. Chatbot Edukasi AI: Asisten tanya jawab materi website dan arsip buku referensi (.zip/.pdf/.txt).\\n\\nPertanyaan untuk Claude AI:\\n1. Menurut Anda, apakah tata letak informasi dan simulasi 6 titik label obat sudah komunikatif untuk masyarakat umum yang awam istilah medis?\\n2. Bagaimana evaluasi Anda terkait kepatuhan aspek etika farmasi dan patient safety pada modul Skenario Swamedikasi Bercabang dan Kuis Evaluasi?\\n3. Apakah instrumen kuis Pre-Test dan Post-Test ini sudah representatif untuk mengukur peningkatan literasi obat pada responden penelitian skripsi S1 Farmasi?`;\\n\\n  const handleCopyClaudePrompt = () => {\\n    navigator.clipboard.writeText(claudeReviewPrompt).then(() => {\\n      setCopiedClaudePrompt(true);\\n      setTimeout(() => setCopiedClaudePrompt(false), 2500);\\n    });\\n  };\\n\\n  const handlePrintValidationSheet = () => {\\n    window.print();\\n  };\\n\\n  return (\\n    <ModalShell\\n      isOpen={isOpen}\\n      onClose={onClose}\\n      title=\\\"Berkas Dokumen & Tinjauan Prototipe\\\"\\n      subtitle=\\\"Dokumen PDF Resmi untuk Dosen Pembimbing, Penguji, & Peninjau\\\"\\n      maxWidth=\\\"2xl\\\"\\n      headerIcon={<FileText className=\\\"w-5 h-5\\\" />}\\n      footer={\\n        <div className=\\\"flex items-center justify-between text-xs text-ink-muted\\\">\\n          <span className=\\\"truncate max-w-[220px] sm:max-w-xs\\\">\\n            Ruang Obat \302\267 Skripsi S1 Farmasi\\n          </span>\\n          <button\\n            type=\\\"button\\\"\\n            onClick={onClose}\\n            className=\\\"min-h-[44px] px-5 py-2 font-semibold text-forest bg-surface border border-line hover:bg-surface-muted rounded-xl transition-colors cursor-pointer\\\"\\n          >\\n            Tutup\\n          </button>\\n        </div>\\n      }\\n    >\\n      <div className=\\\"space-y-5\\\">\\n        {/* Tab Switcher */}\\n        <div className=\\\"grid grid-cols-4 gap-1 bg-surface-muted p-1.5 rounded-2xl border border-line text-xs\\\">\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => setActiveTab(\'pdf\')}\\n            className={`min-h-[40px] px-2 py-1.5 rounded-xl font-semibold transition-all flex items-center justify-center gap-1.5 cursor-pointer ${\\n              activeTab === \'pdf\'\\n                ? \'bg-surface text-forest shadow-xs\'\\n                : \'text-ink-muted hover:text-forest\'\\n            }`}\\n          >\\n            <FileDown className=\\\"w-3.5 h-3.5 text-brand shrink-0\\\" />\\n            <span>File PDF</span>\\n          </button>\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => setActiveTab(\'link\')}\\n            className={`min-h-[40px] px-2 py-1.5 rounded-xl font-semibold transition-all flex items-center justify-center gap-1.5 cursor-pointer ${\\n              activeTab === \'link\'\\n                ? \'bg-surface text-forest shadow-xs\'\\n                : \'text-ink-muted hover:text-forest\'\\n            }`}\\n          >\\n            <Share2 className=\\\"w-3.5 h-3.5 text-brand shrink-0\\\" />\\n            <span>Link Web</span>\\n          </button>\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => setActiveTab(\'dosen\')}\\n            className={`min-h-[40px] px-2 py-1.5 rounded-xl font-semibold transition-all flex items-center justify-center gap-1.5 cursor-pointer ${\\n              activeTab === \'dosen\'\\n                ? \'bg-surface text-forest shadow-xs\'\\n                : \'text-ink-muted hover:text-forest\'\\n            }`}\\n          >\\n            <GraduationCap className=\\\"w-3.5 h-3.5 text-brand shrink-0\\\" />\\n            <span className=\\\"hidden sm:inline\\\">Untuk Dosen</span>\\n            <span className=\\\"sm:hidden\\\">Dosen</span>\\n          </button>\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => setActiveTab(\'claude\')}\\n            className={`min-h-[40px] px-2 py-1.5 rounded-xl font-semibold transition-all flex items-center justify-center gap-1.5 cursor-pointer ${\\n              activeTab === \'claude\'\\n                ? \'bg-surface text-forest shadow-xs\'\\n                : \'text-ink-muted hover:text-forest\'\\n            }`}\\n          >\\n            <Bot className=\\\"w-3.5 h-3.5 text-brand shrink-0\\\" />\\n            <span className=\\\"hidden sm:inline\\\">Untuk Claude</span>\\n            <span className=\\\"sm:hidden\\\">Claude</span>\\n          </button>\\n        </div>\\n\\n        {/* TAB 1: FILE PDF PROTOTIPE */}\\n        {activeTab === \'pdf\' && (\\n          <div className=\\\"space-y-4\\\">\\n            <div className=\\\"space-y-1\\\">\\n              <p className=\\\"text-xs font-semibold uppercase tracking-wider text-brand\\\">\\n                Dokumen Prototipe Siap Diberikan\\n              </p>\\n              <h3 className=\\\"font-display text-lg font-semibold text-forest\\\">\\n                Dokumen PDF Prototipe Skripsi &ldquo;Ruang Obat&rdquo;\\n              </h3>\\n              <p className=\\\"text-xs sm:text-sm text-ink-muted leading-relaxed\\\">\\n                File PDF ini disusun formal (5 halaman A4 standar akademik) berisi rancangan prototipe, batasan etika farmasi, tabel 6 titik kemasan, lembar validasi dosen, dan prompt peninjauan.\\n              </p>\\n            </div>\\n\\n            <div className=\\\"p-4 sm:p-5 bg-surface-warm rounded-2xl border border-line space-y-4\\\">\\n              <div className=\\\"flex items-center gap-3.5\\\">\\n                <div className=\\\"w-12 h-12 rounded-xl bg-forest text-sand flex items-center justify-center shrink-0\\\">\\n                  <FileText className=\\\"w-6 h-6\\\" />\\n                </div>\\n                <div>\\n                  <h4 className=\\\"font-bold text-forest text-sm sm:text-base font-mono\\\">\\n                    Dokumen_Prototipe_Ruang_Obat.pdf\\n                  </h4>\\n                  <p className=\\\"text-xs text-ink-muted font-medium\\\">\\n                    Ukuran ~48 KB \302\267 5 Halaman Lengkap \302\267 Format Cetak A4 Standar Skripsi\\n                  </p>\\n                </div>\\n              </div>\\n\\n              <div className=\\\"space-y-2.5 pt-2 border-t border-line\\\">\\n                <div className=\\\"flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5\\\">\\n                  <button\\n                    type=\\\"button\\\"\\n                    disabled={isGenerating}\\n                    onClick={() => {\\n                      setIsGenerating(true);\\n                      try {\\n                        generateAndDownloadPdf();\\n                      } catch (err) {\\n                        console.error(err);\\n                      } finally {\\n                        setTimeout(() => setIsGenerating(false), 800);\\n                      }\\n                    }}\\n                    className=\\\"flex-1 min-h-[46px] px-5 py-2.5 rounded-xl bg-forest hover:bg-brand text-on-brand font-semibold text-xs sm:text-sm flex items-center justify-center gap-2 transition-colors cursor-pointer text-center\\\"\\n                  >\\n                    <Download className=\\\"w-4 h-4 text-sand\\\" />\\n                    <span>\\n                      {isGenerating\\n                        ? \'Membuat File PDF...\'\\n                        : \'Unduh File PDF Sekarang (Di Perangkat)\'}\\n                    </span>\\n                  </button>\\n\\n                  <button\\n                    type=\\\"button\\\"\\n                    onClick={() => {\\n                      const fullDoc = `# DOKUMEN PROTOTIPE MEDIA EDUKASI SKRIPSI S1 FARMASI\\n# RUANG OBAT (\\\"Kenali label obatmu, kelola obat di rumahmu\\\")\\n\\nIDENTITAS PENELITIAN:\\n- Aplikasi Web: Ruang Obat (Mobile-First Web App)\\n- Bidang: Farmasi Klinis dan Komunitas\\n- Sasaran: Mahasiswa Non-Kesehatan dan Masyarakat Umum\\n- Tahun: 2026\\n\\nBAB I: LATAR BELAKANG & BATASAN ETIKA\\n1. Urgensi: Mengatasi ketidaktepatan swamedikasi, ketidakpahaman membedakan Expired Date pabrik vs Beyond Use Date (BUD), penyalahgunaan antibiotik sisa teman, dan pembuangan obat rusak yang berbahaya.\\n2. Batasan Etika Farmasi (Patient Safety):\\n   - TANPA kalkulator dosis & TANPA diagnosis mandiri\\n   - TANPA klaim berlebihan (\\\"ditinjau apoteker\\\", testimoni)\\n   - Seluruh materi menggunakan rujukan resmi Kemenkes RI, BPOM RI, dan Farmakope\\n   - Data lemari obat 100% tersimpan lokal di browser (localStorage)\\n   - Disclaimer wajib di footer: \\\"Edukasi umum, bukan diagnosis atau saran dosis pribadi. Tanyakan ke apoteker atau dokter.\\\"\\n\\nBAB II: SPESIFIKASI PROTOTIPE\\n1. Simulasi Kemasan Interaktif (Tablet, Sirup, Salep) dengan 6 Titik Kritis:\\n   - Titik 1: Logo Golongan Obat (Bebas Hijau, Bebas Terbatas Biru P1-P6, Keras Merah K)\\n   - Titik 2: Nama & Komposisi Zat Aktif (Generik vs Dagang, kekuatan dosis)\\n   - Titik 3: Indikasi Medis Terdaftar\\n   - Titik 4: Aturan Pakai, Waktu Makan & Peringatan Khusus\\n   - Titik 5: Tanggal Kedaluwarsa (Exp Date) & Nomor Bets Produksi\\n   - Titik 6: Nomor Izin Edar (NIE BPOM 15 digit resmi)\\n2. Lemari Obat Saya:\\n   - Status otomatis dengan IKON & TEKS:\\n     * Aman (> 30 hari)\\n     * Segera Kedaluwarsa (<= 30 hari)\\n     * Kedaluwarsa (lewat tanggal)\\n   - Tautan langsung ke Panduan Simpan & Buang (Dagusibu)\\n3. Kamus Label Obat:\\n   - Glosarium 17+ istilah resmi (NIE, BUD, ED, Rekonstitusi, Suhu Simpan, dll.)\\n\\nBAB III: LEMBAR PENILAIAN & VALIDASI DOSEN\\n- Tabel 7 Indikator Kelayakan Media/Materi (Skala 1-5)\\n- Kolom catatan asistensi & rekomendasi perbaikan\\n- Kolom persetujuan dan tanda tangan Dosen Pembimbing\\n\\nBAB IV: PERTANYAAN EVALUASI UNTUK CLAUDE AI\\n1. Apakah visualisasi 6 titik label obat sudah komunikatif untuk masyarakat awam?\\n2. Apakah batasan etika farmasi dan keamanan pasien sudah kuat untuk skripsi S1?\\n3. Saran perbaikan untuk modul latihan (skenario bercabang, flashcard, dan kuis).`;\\n\\n                      navigator.clipboard.writeText(fullDoc).then(() => {\\n                        setCopiedFullDoc(true);\\n                        setTimeout(() => setCopiedFullDoc(false), 2500);\\n                      });\\n                    }}\\n                    className=\\\"min-h-[46px] px-4 py-2.5 rounded-xl bg-surface hover:bg-surface-muted border border-line text-forest font-semibold text-xs flex items-center justify-center gap-1.5 transition-colors cursor-pointer\\\"\\n                  >\\n                    {copiedFullDoc ? (\\n                      <>\\n                        <Check className=\\\"w-4 h-4 text-status-aman-text\\\" />\\n                        <span className=\\\"text-status-aman-text\\\">Teks Tersalin!</span>\\n                      </>\\n                    ) : (\\n                      <>\\n                        <Copy className=\\\"w-4 h-4 text-brand\\\" />\\n                        <span>Salin Naskah (.txt/.md)</span>\\n                      </>\\n                    )}\\n                  </button>\\n                </div>\\n\\n                <p className=\\\"text-[11px] text-ink-muted italic\\\">\\n                  * Tombol unduh memproses file PDF langsung di memori perangkat Anda tanpa kendala jaringan.\\n                </p>\\n              </div>\\n            </div>\\n\\n            <div className=\\\"space-y-2\\\">\\n              <span className=\\\"text-xs font-bold text-forest uppercase tracking-wider block\\\">\\n                Struktur 5 Halaman Dokumen PDF\\n              </span>\\n              <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-2.5 text-xs\\\">\\n                {[\\n                  {\\n                    num: 1,\\n                    title: \'Halaman Judul (Cover)\',\\n                    desc: \'Judul skripsi, tagline, identitas peneliti, tautan web aktif, dan kepatuhan etika.\',\\n                  },\\n                  {\\n                    num: 2,\\n                    title: \'Bab I: Latar Belakang & Etika\',\\n                    desc: \'Urgensi swamedikasi awam, tujuan Dagusibu, 5 batasan etika ketat, & peta navigasi.\',\\n                  },\\n                  {\\n                    num: 3,\\n                    title: \'Bab II: Spesifikasi Prototipe\',\\n                    desc: \'Tabel spesifikasi 6 titik kemasan (Tablet, Sirup, Salep), algoritma status lemari, & Dagusibu.\',\\n                  },\\n                  {\\n                    num: 4,\\n                    title: \'Bab III: Lembar Penilaian Dosen\',\\n                    desc: \'Tabel evaluasi 7 indikator kelayakan (skala 1-5), catatan revisi, & kolom tanda tangan.\',\\n                  },\\n                  {\\n                    num: 5,\\n                    title: \'Bab IV: Panduan Evaluasi Claude AI\',\\n                    desc: \'Teks prompt terstruktur siap salin atau diunggah sebagai PDF untuk analisis desain instruksional.\',\\n                    wide: true,\\n                  },\\n                ].map((pg) => (\\n                  <div\\n                    key={pg.num}\\n                    className={`p-3.5 bg-surface rounded-xl border border-line space-y-1 ${\\n                      pg.wide ? \'sm:col-span-2\' : \'\'\\n                    }`}\\n                  >\\n                    <div className=\\\"font-bold text-forest flex items-center gap-2\\\">\\n                      <span className=\\\"w-5 h-5 rounded-full bg-secondary text-forest flex items-center justify-center text-[10px] font-mono font-bold\\\">\\n                        {pg.num}\\n                      </span>\\n                      <span>{pg.title}</span>\\n                    </div>\\n                    <p className=\\\"text-ink-muted text-[11px] leading-relaxed\\\">\\n                      {pg.desc}\\n                    </p>\\n                  </div>\\n                ))}\\n              </div>\\n            </div>\\n          </div>\\n        )}\\n\\n        {/* TAB 2: Tautan Web & QR Code */}\\n        {activeTab === \'link\' && (\\n          <div className=\\\"space-y-4\\\">\\n            <div className=\\\"space-y-1\\\">\\n              <h3 className=\\\"font-display text-lg font-semibold text-forest\\\">\\n                Tautan Akses Publik Web App\\n              </h3>\\n              <p className=\\\"text-xs sm:text-sm text-ink-muted leading-relaxed\\\">\\n                Bagikan tautan ini kepada dosen pembimbing, penguji, atau partisipan uji coba agar aplikasi dapat dibuka langsung di peramban ponsel maupun laptop.\\n              </p>\\n            </div>\\n\\n            <div className=\\\"p-4 bg-surface-warm rounded-2xl border border-line space-y-2.5\\\">\\n              <span className=\\\"text-xs font-bold text-forest block\\\">\\n                Tautan Bersama (Shared Preview URL)\\n              </span>\\n              <div className=\\\"flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5\\\">\\n                <div className=\\\"flex-1 p-3 bg-surface border border-line rounded-xl text-xs font-mono text-forest break-all select-all\\\">\\n                  {bestUrlToShare}\\n                </div>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={handleCopyLink}\\n                  className={`min-h-[44px] px-4 py-2 rounded-xl font-semibold text-xs flex items-center justify-center gap-1.5 transition-colors cursor-pointer shrink-0 ${\\n                    copiedLink\\n                      ? \'bg-status-aman-text text-white\'\\n                      : \'bg-forest hover:bg-brand text-on-brand\'\\n                  }`}\\n                >\\n                  {copiedLink ? (\\n                    <>\\n                      <Check className=\\\"w-4 h-4\\\" />\\n                      <span>Tersalin!</span>\\n                    </>\\n                  ) : (\\n                    <>\\n                      <Copy className=\\\"w-4 h-4\\\" />\\n                      <span>Salin Tautan</span>\\n                    </>\\n                  )}\\n                </button>\\n              </div>\\n            </div>\\n\\n            <div className=\\\"p-4 bg-secondary/45 rounded-2xl border border-line flex flex-col sm:flex-row items-center gap-4\\\">\\n              <div className=\\\"w-24 h-24 bg-surface p-2 rounded-xl border border-line flex items-center justify-center shrink-0\\\">\\n                <svg\\n                  viewBox=\\\"0 0 100 100\\\"\\n                  className=\\\"w-full h-full text-forest\\\"\\n                  fill=\\\"currentColor\\\"\\n                >\\n                  <rect x=\\\"5\\\" y=\\\"5\\\" width=\\\"28\\\" height=\\\"28\\\" rx=\\\"4\\\" fill=\\\"currentColor\\\" />\\n                  <rect x=\\\"9\\\" y=\\\"9\\\" width=\\\"20\\\" height=\\\"20\\\" rx=\\\"2\\\" fill=\\\"white\\\" />\\n                  <rect x=\\\"14\\\" y=\\\"14\\\" width=\\\"10\\\" height=\\\"10\\\" fill=\\\"currentColor\\\" />\\n                  <rect x=\\\"67\\\" y=\\\"5\\\" width=\\\"28\\\" height=\\\"28\\\" rx=\\\"4\\\" fill=\\\"currentColor\\\" />\\n                  <rect x=\\\"71\\\" y=\\\"9\\\" width=\\\"20\\\" height=\\\"20\\\" rx=\\\"2\\\" fill=\\\"white\\\" />\\n                  <rect x=\\\"76\\\" y=\\\"14\\\" width=\\\"10\\\" height=\\\"10\\\" fill=\\\"currentColor\\\" />\\n                  <rect x=\\\"5\\\" y=\\\"67\\\" width=\\\"28\\\" height=\\\"28\\\" rx=\\\"4\\\" fill=\\\"currentColor\\\" />\\n                  <rect x=\\\"9\\\" y=\\\"71\\\" width=\\\"20\\\" height=\\\"20\\\" rx=\\\"2\\\" fill=\\\"white\\\" />\\n                  <rect x=\\\"14\\\" y=\\\"76\\\" width=\\\"10\\\" height=\\\"10\\\" fill=\\\"currentColor\\\" />\\n                  <rect x=\\\"38\\\" y=\\\"10\\\" width=\\\"8\\\" height=\\\"8\\\" fill=\\\"currentColor\\\" />\\n                  <rect x=\\\"50\\\" y=\\\"10\\\" width=\\\"8\\\" height=\\\"8\\\" fill=\\\"currentColor\\\" />\\n                  <rect x=\\\"44\\\" y=\\\"24\\\" width=\\\"8\\\" height=\\\"8\\\" fill=\\\"currentColor\\\" />\\n                  <rect x=\\\"10\\\" y=\\\"44\\\" width=\\\"8\\\" height=\\\"8\\\" fill=\\\"currentColor\\\" />\\n                  <rect x=\\\"24\\\" y=\\\"44\\\" width=\\\"8\\\" height=\\\"8\\\" fill=\\\"currentColor\\\" />\\n                  <rect x=\\\"38\\\" y=\\\"38\\\" width=\\\"8\\\" height=\\\"8\\\" fill=\\\"currentColor\\\" />\\n                  <rect x=\\\"52\\\" y=\\\"38\\\" width=\\\"8\\\" height=\\\"8\\\" fill=\\\"currentColor\\\" />\\n                  <rect x=\\\"66\\\" y=\\\"44\\\" width=\\\"8\\\" height=\\\"8\\\" fill=\\\"currentColor\\\" />\\n                  <rect x=\\\"80\\\" y=\\\"44\\\" width=\\\"8\\\" height=\\\"8\\\" fill=\\\"currentColor\\\" />\\n                  <rect x=\\\"44\\\" y=\\\"52\\\" width=\\\"8\\\" height=\\\"8\\\" fill=\\\"currentColor\\\" />\\n                  <rect x=\\\"38\\\" y=\\\"66\\\" width=\\\"8\\\" height=\\\"8\\\" fill=\\\"currentColor\\\" />\\n                  <rect x=\\\"52\\\" y=\\\"66\\\" width=\\\"8\\\" height=\\\"8\\\" fill=\\\"currentColor\\\" />\\n                  <rect x=\\\"66\\\" y=\\\"66\\\" width=\\\"8\\\" height=\\\"8\\\" fill=\\\"currentColor\\\" />\\n                  <rect x=\\\"80\\\" y=\\\"66\\\" width=\\\"8\\\" height=\\\"8\\\" fill=\\\"currentColor\\\" />\\n                  <rect x=\\\"44\\\" y=\\\"80\\\" width=\\\"8\\\" height=\\\"8\\\" fill=\\\"currentColor\\\" />\\n                  <rect x=\\\"66\\\" y=\\\"80\\\" width=\\\"8\\\" height=\\\"8\\\" fill=\\\"currentColor\\\" />\\n                  <rect x=\\\"80\\\" y=\\\"80\\\" width=\\\"8\\\" height=\\\"8\\\" fill=\\\"currentColor\\\" />\\n                </svg>\\n              </div>\\n              <div className=\\\"space-y-1 text-center sm:text-left\\\">\\n                <span className=\\\"text-xs font-bold text-forest block\\\">\\n                  Uji Coba Langsung di Smartphone\\n                </span>\\n                <p className=\\\"text-xs text-ink-muted leading-relaxed\\\">\\n                  Aplikasi ini dirancang dengan ergonomi sentuh yang nyaman di layar ponsel maupun layar lebar desktop.\\n                </p>\\n              </div>\\n            </div>\\n\\n            <div className=\\\"flex justify-end\\\">\\n              <a\\n                href={bestUrlToShare}\\n                target=\\\"_blank\\\"\\n                rel=\\\"noopener noreferrer\\\"\\n                className=\\\"min-h-[44px] px-4 py-2 rounded-xl border border-line hover:bg-surface-muted text-forest font-semibold text-xs flex items-center gap-1.5 transition-colors cursor-pointer\\\"\\n              >\\n                <ExternalLink className=\\\"w-4 h-4 text-brand\\\" />\\n                <span>Buka di Tab Baru Peramban</span>\\n              </a>\\n            </div>\\n          </div>\\n        )}\\n\\n        {/* TAB 3: Untuk Dosen Pembimbing / Penguji */}\\n        {activeTab === \'dosen\' && (\\n          <div className=\\\"space-y-4\\\">\\n            <div className=\\\"space-y-1\\\">\\n              <h3 className=\\\"font-display text-lg font-semibold text-forest\\\">\\n                Panduan Validasi &amp; Tinjauan Dosen Skripsi\\n              </h3>\\n              <p className=\\\"text-xs sm:text-sm text-ink-muted leading-relaxed\\\">\\n                Gunakan daftar periksa berikut saat asistensi atau bimbingan skripsi bersama Dosen Pembimbing.\\n              </p>\\n            </div>\\n\\n            <div className=\\\"space-y-2.5\\\">\\n              {[\\n                {\\n                  title: \'1. Validasi 6 Titik Kritis Kemasan Obat\',\\n                  desc: \'Memastikan titik ketuk pada kemasan Tablet, Sirup, dan Salep mencakup Logo Golongan, Zat Aktif, Indikasi, Aturan Pakai, ED/Bets, dan NIE BPOM sesuai rujukan resmi.\',\\n                },\\n                {\\n                  title: \'2. Kepatuhan Batasan Etika Farmasi (Patient Safety)\',\\n                  desc: \'Aplikasi bebas dari kalkulator dosis, bebas alat diagnosis mandiri, dan bebas rekomendasi terapi pribadi untuk menjaga keselamatan pasien.\',\\n                },\\n                {\\n                  title: \'3. Prinsip Dagusibu & Pengelolaan Obat Rumah Tangga\',\\n                  desc: \'Tersedia panduan penyimpanan dan pemusnahan obat kedaluwarsa/rusak agar tidak disalahgunakan atau mencemari lingkungan.\',\\n                },\\n                {\\n                  title: \'4. Integritas Data & Kerahasiaan (Data On-Device)\',\\n                  desc: \'Semua pencatatan lemari obat hanya tersimpan di memori perangkat responden tanpa mengirim riwayat obat ke server luar.\',\\n                },\\n              ].map((item, idx) => (\\n                <div\\n                  key={idx}\\n                  className=\\\"p-3.5 bg-surface-warm rounded-xl border border-line flex items-start gap-2.5\\\"\\n                >\\n                  <CheckCircle2 className=\\\"w-4 h-4 text-brand shrink-0 mt-0.5\\\" />\\n                  <div className=\\\"text-xs text-ink-muted leading-relaxed\\\">\\n                    <strong className=\\\"text-forest block mb-0.5\\\">{item.title}</strong>\\n                    {item.desc}\\n                  </div>\\n                </div>\\n              ))}\\n            </div>\\n\\n            <div className=\\\"p-4 bg-status-segera-bg/70 rounded-2xl border border-status-segera-text/20 flex flex-col sm:flex-row sm:items-center justify-between gap-3\\\">\\n              <div className=\\\"text-xs text-ink\\\">\\n                <span className=\\\"font-bold text-status-segera-text block\\\">\\n                  Butuh Lembar Cetak untuk Bimbingan?\\n                </span>\\n                <span className=\\\"text-ink-muted\\\">\\n                  Anda dapat mencetak rangkuman checklist ini langsung untuk tatap muka.\\n                </span>\\n              </div>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={handlePrintValidationSheet}\\n                className=\\\"min-h-[42px] px-4 py-2 bg-status-segera-text hover:opacity-90 text-white font-semibold text-xs rounded-xl flex items-center justify-center gap-1.5 shrink-0 cursor-pointer\\\"\\n              >\\n                <Printer className=\\\"w-3.5 h-3.5\\\" />\\n                <span>Cetak Lembar</span>\\n              </button>\\n            </div>\\n          </div>\\n        )}\\n\\n        {/* TAB 4: Untuk Claude AI */}\\n        {activeTab === \'claude\' && (\\n          <div className=\\\"space-y-4\\\">\\n            <div className=\\\"space-y-1\\\">\\n              <h3 className=\\\"font-display text-lg font-semibold text-forest\\\">\\n                Salin Prompt Evaluasi untuk Peninjau AI\\n              </h3>\\n              <p className=\\\"text-xs sm:text-sm text-ink-muted leading-relaxed\\\">\\n                Salin seluruh ringkasan teknis, aturan ketat skripsi, daftar fitur, dan pertanyaan evaluasi ke clipboard Anda.\\n              </p>\\n            </div>\\n\\n            <button\\n              type=\\\"button\\\"\\n              onClick={handleCopyClaudePrompt}\\n              className={`w-full min-h-[48px] p-3 rounded-xl font-semibold text-sm flex items-center justify-center gap-2 transition-colors cursor-pointer ${\\n                copiedClaudePrompt\\n                  ? \'bg-status-aman-text text-white\'\\n                  : \'bg-forest hover:bg-brand text-on-brand\'\\n              }`}\\n            >\\n              {copiedClaudePrompt ? (\\n                <>\\n                  <Check className=\\\"w-5 h-5\\\" />\\n                  <span>Prompt Evaluasi Berhasil Disalin!</span>\\n                </>\\n              ) : (\\n                <>\\n                  <Copy className=\\\"w-5 h-5 text-sand\\\" />\\n                  <span>Salin Prompt Ringkasan Skripsi</span>\\n                </>\\n              )}\\n            </button>\\n\\n            <div className=\\\"space-y-1.5\\\">\\n              <span className=\\\"text-xs font-bold text-forest block\\\">\\n                Pratinjau Teks yang Disalin\\n              </span>\\n              <div className=\\\"max-h-48 overflow-y-auto p-3.5 bg-surface-warm border border-line rounded-xl text-xs font-mono text-ink whitespace-pre-wrap leading-relaxed\\\">\\n                {claudeReviewPrompt}\\n              </div>\\n            </div>\\n          </div>\\n        )}\\n      </div>\\n    </ModalShell>\\n  );\\n};\\n\", \"Description\":\"Redesign TinjauDosenModal using accessible ModalShell and warm apothecary editorial tokens\", \"Overwrite\":true, \"TargetFile\":\"/src/components/TinjauDosenModal.tsx\", \"toolAction\":\"Redesigning TinjauDosenModal component\", \"toolSummary\":\"Redesign TinjauDosenModal.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_371837612518062241"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState, useEffect, useRef } from \'react\';\\nimport { TabType } from \'../types\';\\nimport {\\n  MessageSquareText,\\n  X,\\n  Send,\\n  Bot,\\n  User,\\n  BookOpen,\\n  Upload,\\n  RefreshCw,\\n  Trash2,\\n  RotateCcw,\\n  Sparkles,\\n  Zap,\\n  FileArchive,\\n  FileText,\\n  AlertCircle,\\n  CheckCircle2,\\n  Globe,\\n  Loader2,\\n} from \'lucide-react\';\\n\\ninterface ChatSourceRef {\\n  sourceType: \'website\' | \'book\';\\n  sourceName: string;\\n  sectionTitle: string;\\n}\\n\\ninterface ChatMessage {\\n  id: string;\\n  role: \'user\' | \'model\';\\n  text: string;\\n  sources?: ChatSourceRef[];\\n  modelUsed?: string;\\n  isError?: boolean;\\n}\\n\\ninterface BookSourceMeta {\\n  id: string;\\n  fileName: string;\\n  origin: \'folder\' | \'upload\';\\n  fileType: \'zip\' | \'pdf\' | \'text\';\\n  innerFiles: string[];\\n  chunkCount: number;\\n  totalChars: number;\\n  addedAt: string;\\n}\\n\\ninterface KnowledgeSummary {\\n  websiteChunks: number;\\n  websiteModules: string[];\\n  books: BookSourceMeta[];\\n  totalBookChunks: number;\\n}\\n\\ninterface ChatbotWidgetProps {\\n  currentTab: TabType;\\n  externalOpenTrigger?: number;\\n}\\n\\nconst CHAT_HISTORY_KEY = \'ruang_obat_chat_history_v1\';\\n\\nconst INITIAL_BOT_MESSAGE: ChatMessage = {\\n  id: \'welcome-1\',\\n  role: \'model\',\\n  text: \'Halo! Saya **Asisten Ruang Obat**. Kamu bisa bertanya seputar seluruh materi di website ini (6 titik label kemasan, Lemari Obat, DAGUSIBU, Kamus, Skenario, Kuis) maupun isi dari **buku referensi (.zip)** yang sudah ditambahkan.\\\\n\\\\nSilakan pilih pertanyaan cepat di bawah atau ketik pertanyaanmu!\',\\n};\\n\\nconst TAB_STARTER_QUESTIONS: Record<TabType, string[]> = {\\n  beranda: [\\n    \'Apa saja fitur utama di website Ruang Obat?\',\\n    \'Apa perbedaan Expired Date (ED) dan Beyond Use Date (BUD)?\',\\n    \'Jelaskan arti lingkaran hijau, biru, dan merah K pada kemasan obat.\',\\n  ],\\n  \'cek-label\': [\\n    \'Apa saja 6 titik informasi penting pada label kemasan obat?\',\\n    \'Bagaimana cara membaca kode 15 digit NIE BPOM (DBL, DTL, DKL)?\',\\n    \'Kenapa sirup tertentu wajib dikocok dahulu sebelum diminum?\',\\n  ],\\n  lemari: [\\n    \'Bagaimana cara membuang tablet dan sirup kedaluwarsa sesuai prinsip DAGUSIBU?\',\\n    \'Di mana tempat yang salah untuk menyimpan obat di rumah?\',\\n    \'Berapa lama batas aman (BUD) tetes mata dan sirup kering setelah dibuka?\',\\n  ],\\n  latihan: [\\n    \'Mengapa meminum sisa antibiotik teman sangat berbahaya?\',\\n    \'Kenapa sendok makan dapur tidak boleh dipakai untuk takaran sirup obat?\',\\n    \'Kapan waktu terbaik minum tablet kunyah antasida?\',\\n  ],\\n  pustaka: [\\n    \'Sumber resmi apa saja yang menjadi rujukan aplikasi Ruang Obat?\',\\n    \'Apa isi buku referensi .zip yang sedang dimuat saat ini?\',\\n    \'Jelaskan arti tanda peringatan P.No 1 sampai P.No 6.\',\\n  ],\\n};\\n\\nfunction arrayBufferToBase64(buffer: ArrayBuffer): string {\\n  const bytes = new Uint8Array(buffer);\\n  const chunkSize = 0x8000;\\n  let binary = \'\';\\n  for (let i = 0; i < bytes.length; i += chunkSize) {\\n    const slice = bytes.subarray(i, i + chunkSize);\\n    binary += String.fromCharCode(...slice);\\n  }\\n  return btoa(binary);\\n}\\n\\nfunction renderFormattedLine(line: string, keyPrefix: string) {\\n  const parts = line.split(/(\\\\*\\\\*[^*]+\\\\*\\\\*)/g);\\n  return (\\n    <React.Fragment key={keyPrefix}>\\n      {parts.map((part, idx) => {\\n        if (part.startsWith(\'**\') && part.endsWith(\'**\') && part.length > 4) {\\n          return (\\n            <strong key={idx} className=\\\"font-bold\\\">\\n              {part.slice(2, -2)}\\n            </strong>\\n          );\\n        }\\n        return <React.Fragment key={idx}>{part}</React.Fragment>;\\n      })}\\n    </React.Fragment>\\n  );\\n}\\n\\nfunction FormattedMessageText({ text }: { text: string }) {\\n  const blocks = text.split(\'\\\\n\');\\n  return (\\n    <div className=\\\"space-y-1.5 text-xs sm:text-sm leading-relaxed break-words\\\">\\n      {blocks.map((rawLine, idx) => {\\n        const line = rawLine.trim();\\n        if (!line) return <div key={idx} className=\\\"h-1\\\" />;\\n\\n        if (line.startsWith(\'- \') || line.startsWith(\'* \') || line.startsWith(\'\342\200\242 \')) {\\n          return (\\n            <div key={idx} className=\\\"flex items-start gap-2 pl-1\\\">\\n              <span className=\\\"text-brand font-bold mt-0.5\\\">\342\200\242</span>\\n              <div className=\\\"flex-1\\\">{renderFormattedLine(line.slice(2), `b-${idx}`)}</div>\\n            </div>\\n          );\\n        }\\n\\n        const numberedMatch = line.match(/^(\\\\d+\\\\.)\\\\s+(.*)$/);\\n        if (numberedMatch) {\\n          return (\\n            <div key={idx} className=\\\"flex items-start gap-2 pl-1\\\">\\n              <span className=\\\"font-bold text-forest font-mono shrink-0\\\">\\n                {numberedMatch[1]}\\n              </span>\\n              <div className=\\\"flex-1\\\">\\n                {renderFormattedLine(numberedMatch[2], `n-${idx}`)}\\n              </div>\\n            </div>\\n          );\\n        }\\n\\n        return <p key={idx}>{renderFormattedLine(line, `p-${idx}`)}</p>;\\n      })}\\n    </div>\\n  );\\n}\\n\\nexport const ChatbotWidget: React.FC<ChatbotWidgetProps> = ({\\n  currentTab,\\n  externalOpenTrigger = 0,\\n}) => {\\n  const [isOpen, setIsOpen] = useState(false);\\n  const [activePanel, setActivePanel] = useState<\'chat\' | \'sources\'>(\'chat\');\\n  const [speedMode, setSpeedMode] = useState<\'standar\' | \'cepat\'>(\'standar\');\\n  const [inputText, setInputText] = useState(\'\');\\n  const [isSending, setIsSending] = useState(false);\\n  const [knowledge, setKnowledge] = useState<KnowledgeSummary | null>(null);\\n  const [isLoadingKnowledge, setIsLoadingKnowledge] = useState(false);\\n  const [isUploading, setIsUploading] = useState(false);\\n  const [uploadStatus, setUploadStatus] = useState<{\\n    type: \'success\' | \'error\';\\n    message: string;\\n  } | null>(null);\\n\\n  const [messages, setMessages] = useState<ChatMessage[]>(() => {\\n    try {\\n      const saved = localStorage.getItem(CHAT_HISTORY_KEY);\\n      if (saved) {\\n        const parsed = JSON.parse(saved);\\n        if (Array.isArray(parsed) && parsed.length > 0) return parsed;\\n      }\\n    } catch {\\n      // ignore\\n    }\\n    return [INITIAL_BOT_MESSAGE];\\n  });\\n\\n  const messagesEndRef = useRef<HTMLDivElement>(null);\\n  const fileInputRef = useRef<HTMLInputElement>(null);\\n  const inputRef = useRef<HTMLTextAreaElement>(null);\\n\\n  useEffect(() => {\\n    if (externalOpenTrigger > 0) {\\n      setIsOpen(true);\\n    }\\n  }, [externalOpenTrigger]);\\n\\n  useEffect(() => {\\n    try {\\n      const toSave = messages.filter((m) => m.text.trim().length > 0).slice(-30);\\n      localStorage.setItem(CHAT_HISTORY_KEY, JSON.stringify(toSave));\\n    } catch {\\n      // ignore storage quota errors\\n    }\\n  }, [messages]);\\n\\n  useEffect(() => {\\n    if (isOpen && activePanel === \'chat\') {\\n      messagesEndRef.current?.scrollIntoView({ behavior: \'smooth\' });\\n    }\\n  }, [messages, isOpen, activePanel]);\\n\\n  const fetchKnowledgeSummary = async () => {\\n    setIsLoadingKnowledge(true);\\n    try {\\n      const res = await fetch(\'/api/knowledge\');\\n      if (res.ok) {\\n        const data = (await res.json()) as KnowledgeSummary;\\n        setKnowledge(data);\\n      }\\n    } catch {\\n      // silent fallback\\n    } finally {\\n      setIsLoadingKnowledge(false);\\n    }\\n  };\\n\\n  useEffect(() => {\\n    if (isOpen) {\\n      fetchKnowledgeSummary();\\n    }\\n  }, [isOpen]);\\n\\n  const handleResetChat = () => {\\n    setMessages([INITIAL_BOT_MESSAGE]);\\n    try {\\n      localStorage.removeItem(CHAT_HISTORY_KEY);\\n    } catch {\\n      // ignore\\n    }\\n  };\\n\\n  const handleSendMessage = async (overrideText?: string) => {\\n    const trimmed = (overrideText ?? inputText).trim();\\n    if (!trimmed || isSending) return;\\n\\n    const userMsg: ChatMessage = {\\n      id: `u-${Date.now()}`,\\n      role: \'user\',\\n      text: trimmed,\\n    };\\n\\n    const botPlaceholderId = `m-${Date.now() + 1}`;\\n    const botPlaceholder: ChatMessage = {\\n      id: botPlaceholderId,\\n      role: \'model\',\\n      text: \'\',\\n    };\\n\\n    const conversationForApi = [\\n      ...messages.filter((m) => !m.isError),\\n      userMsg,\\n    ].map((m) => ({\\n      role: m.role,\\n      text: m.text,\\n    }));\\n\\n    setMessages((prev) => [...prev, userMsg, botPlaceholder]);\\n    if (!overrideText) setInputText(\'\');\\n    setIsSending(true);\\n    setActivePanel(\'chat\');\\n\\n    try {\\n      const response = await fetch(\'/api/chat\', {\\n        method: \'POST\',\\n        headers: { \'Content-Type\': \'application/json\' },\\n        body: JSON.stringify({\\n          messages: conversationForApi,\\n          activeTab: currentTab,\\n          speedMode,\\n        }),\\n      });\\n\\n      if (!response.ok) {\\n        const errBody = await response.json().catch(() => ({}));\\n        throw new Error(\\n          errBody.error || `Gagal menghubungi asisten (HTTP ${response.status}).`\\n        );\\n      }\\n\\n      if (!response.body) {\\n        throw new Error(\'Respons stream tidak tersedia.\');\\n      }\\n\\n      const reader = response.body.getReader();\\n      const decoder = new TextDecoder();\\n      let sseBuffer = \'\';\\n      let accumulatedText = \'\';\\n\\n      while (true) {\\n        const { value, done } = await reader.read();\\n        if (done) break;\\n\\n        sseBuffer += decoder.decode(value, { stream: true });\\n        const events = sseBuffer.split(\'\\\\n\\\\n\');\\n        sseBuffer = events.pop() ?? \'\';\\n\\n        for (const rawEvent of events) {\\n          const line = rawEvent.split(\'\\\\n\').find((l) => l.startsWith(\'data: \'));\\n          if (!line) continue;\\n\\n          const payloadStr = line.slice(6).trim();\\n          if (!payloadStr) continue;\\n\\n          try {\\n            const payload = JSON.parse(payloadStr) as {\\n              type: \'chunk\' | \'done\' | \'error\';\\n              text?: string;\\n              sources?: ChatSourceRef[];\\n              model?: string;\\n              error?: string;\\n            };\\n\\n            if (payload.type === \'chunk\' && payload.text) {\\n              accumulatedText += payload.text;\\n              setMessages((prev) =>\\n                prev.map((m) =>\\n                  m.id === botPlaceholderId ? { ...m, text: accumulatedText } : m\\n                )\\n              );\\n            } else if (payload.type === \'done\') {\\n              setMessages((prev) =>\\n                prev.map((m) =>\\n                  m.id === botPlaceholderId\\n                    ? {\\n                        ...m,\\n                        text:\\n                          accumulatedText || \'Maaf, saya tidak menerima teks jawaban.\',\\n                        sources: payload.sources,\\n                        modelUsed: payload.model,\\n                      }\\n                    : m\\n                )\\n              );\\n            } else if (payload.type === \'error\') {\\n              throw new Error(\\n                payload.error || \'Terjadi kesalahan saat menghasilkan jawaban.\'\\n              );\\n            }\\n          } catch (parseErr) {\\n            if (\\n              parseErr instanceof Error &&\\n              parseErr.message !== \'Unexpected end of JSON input\'\\n            ) {\\n              throw parseErr;\\n            }\\n          }\\n        }\\n      }\\n    } catch (err) {\\n      const message =\\n        err instanceof Error\\n          ? err.message\\n          : \'Gagal terhubung ke server AI. Pastikan koneksi dan API key tersedia.\';\\n      setMessages((prev) =>\\n        prev.map((m) =>\\n          m.id === botPlaceholderId\\n            ? {\\n                ...m,\\n                text: message,\\n                isError: true,\\n              }\\n            : m\\n        )\\n      );\\n    } finally {\\n      setIsSending(false);\\n    }\\n  };\\n\\n  const handleUploadFiles = async (files: FileList | null) => {\\n    if (!files || files.length === 0) return;\\n    const file = files[0];\\n    setIsUploading(true);\\n    setUploadStatus(null);\\n\\n    try {\\n      const arrayBuffer = await file.arrayBuffer();\\n      const base64Data = arrayBufferToBase64(arrayBuffer);\\n\\n      const res = await fetch(\'/api/knowledge/upload\', {\\n        method: \'POST\',\\n        headers: { \'Content-Type\': \'application/json\' },\\n        body: JSON.stringify({\\n          fileName: file.name,\\n          base64Data,\\n        }),\\n      });\\n\\n      const data = await res.json();\\n      if (!res.ok) {\\n        throw new Error(data.error || \'Gagal mengunggah file buku.\');\\n      }\\n\\n      setKnowledge(data as KnowledgeSummary);\\n      setUploadStatus({\\n        type: \'success\',\\n        message: `Berhasil memuat \\\"${file.name}\\\". Chatbot kini dapat menjawab dari isi buku tersebut!`,\\n      });\\n    } catch (err) {\\n      setUploadStatus({\\n        type: \'error\',\\n        message: err instanceof Error ? err.message : \'Gagal memproses file.\',\\n      });\\n    } finally {\\n      setIsUploading(false);\\n      if (fileInputRef.current) fileInputRef.current.value = \'\';\\n    }\\n  };\\n\\n  const handleReloadFolder = async () => {\\n    setIsLoadingKnowledge(true);\\n    setUploadStatus(null);\\n    try {\\n      const res = await fetch(\'/api/knowledge/reload\', { method: \'POST\' });\\n      const data = await res.json();\\n      if (!res.ok) throw new Error(data.error || \'Gagal memuat ulang folder.\');\\n      setKnowledge(data as KnowledgeSummary);\\n      setUploadStatus({\\n        type: \'success\',\\n        message: \'Folder knowledge_books berhasil dipindai ulang.\',\\n      });\\n    } catch (err) {\\n      setUploadStatus({\\n        type: \'error\',\\n        message: err instanceof Error ? err.message : \'Gagal memuat ulang sumber.\',\\n      });\\n    } finally {\\n      setIsLoadingKnowledge(false);\\n    }\\n  };\\n\\n  const handleDeleteBook = async (fileName: string) => {\\n    setUploadStatus(null);\\n    try {\\n      const res = await fetch(`/api/knowledge/${encodeURIComponent(fileName)}`, {\\n        method: \'DELETE\',\\n      });\\n      const data = await res.json();\\n      if (!res.ok) throw new Error(data.error || \'Gagal menghapus buku.\');\\n      setKnowledge(data as KnowledgeSummary);\\n      setUploadStatus({\\n        type: \'success\',\\n        message: `Sumber \\\"${fileName}\\\" telah dihapus.`,\\n      });\\n    } catch (err) {\\n      setUploadStatus({\\n        type: \'error\',\\n        message: err instanceof Error ? err.message : \'Gagal menghapus file.\',\\n      });\\n    }\\n  };\\n\\n  const bookCount = knowledge?.books.length ?? 0;\\n  const starterQuestions =\\n    TAB_STARTER_QUESTIONS[currentTab] || TAB_STARTER_QUESTIONS.beranda;\\n\\n  return (\\n    <>\\n      {/* Floating Action Button */}\\n      {!isOpen && (\\n        <button\\n          type=\\\"button\\\"\\n          onClick={() => setIsOpen(true)}\\n          aria-label=\\\"Buka Asisten Chatbot Ruang Obat\\\"\\n          className=\\\"no-print fixed bottom-20 right-4 md:bottom-6 md:right-6 z-40 min-h-[50px] px-4 py-2.5 rounded-2xl bg-forest hover:bg-brand text-white shadow-lg border border-white/15 flex items-center gap-3 transition-transform duration-150 hover:scale-[1.02] active:scale-95 cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-focus\\\"\\n        >\\n          <div className=\\\"w-8 h-8 rounded-xl bg-white/10 flex items-center justify-center shrink-0\\\">\\n            <MessageSquareText className=\\\"w-4 h-4 text-sand\\\" />\\n          </div>\\n          <div className=\\\"text-left\\\">\\n            <span className=\\\"text-xs sm:text-sm font-semibold block leading-tight\\\">\\n              Tanya Ruang Obat\\n            </span>\\n            <span className=\\\"text-[10px] text-secondary/85 block leading-tight\\\">\\n              Materi Web &amp; Buku (.zip)\\n            </span>\\n          </div>\\n        </button>\\n      )}\\n\\n      {/* Chatbot Slide-over Panel */}\\n      {isOpen && (\\n        <div\\n          className=\\\"no-print fixed inset-0 z-50 flex items-end sm:items-center justify-end p-0 sm:p-4 bg-forest/55 backdrop-blur-xs\\\"\\n          role=\\\"dialog\\\"\\n          aria-modal=\\\"true\\\"\\n          aria-labelledby=\\\"chatbot-title\\\"\\n        >\\n          <div className=\\\"bg-surface w-full sm:max-w-lg h-[90vh] sm:h-[670px] sm:max-h-[90vh] rounded-t-3xl sm:rounded-3xl shadow-2xl border border-line flex flex-col overflow-hidden ro-sheet-in\\\">\\n            {/* Top Header */}\\n            <div className=\\\"bg-forest text-white px-5 py-4 flex items-center justify-between gap-2 shrink-0\\\">\\n              <div className=\\\"flex items-center gap-3 min-w-0\\\">\\n                <div className=\\\"w-9 h-9 rounded-xl bg-white/10 border border-white/15 flex items-center justify-center shrink-0\\\">\\n                  <Bot className=\\\"w-5 h-5 text-sand\\\" />\\n                </div>\\n                <div className=\\\"min-w-0\\\">\\n                  <h2\\n                    id=\\\"chatbot-title\\\"\\n                    className=\\\"font-display text-base font-semibold text-white truncate\\\"\\n                  >\\n                    Asisten Ruang Obat\\n                  </h2>\\n                  <p className=\\\"text-[11px] text-secondary/85 truncate\\\">\\n                    {bookCount > 0\\n                      ? `Aktif: Isi Website + ${bookCount} Buku Referensi`\\n                      : \'Aktif: Isi Website (Siap tambah .zip buku)\'}\\n                  </p>\\n                </div>\\n              </div>\\n\\n              <div className=\\\"flex items-center gap-1 shrink-0\\\">\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={handleResetChat}\\n                  title=\\\"Mulai percakapan baru\\\"\\n                  aria-label=\\\"Mulai percakapan baru\\\"\\n                  className=\\\"min-h-[40px] min-w-[40px] rounded-xl text-secondary hover:text-white hover:bg-white/10 flex items-center justify-center transition-colors cursor-pointer\\\"\\n                >\\n                  <RotateCcw className=\\\"w-4 h-4\\\" />\\n                </button>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => setIsOpen(false)}\\n                  aria-label=\\\"Tutup Chatbot\\\"\\n                  className=\\\"min-h-[40px] min-w-[40px] rounded-xl text-secondary hover:text-white hover:bg-white/10 flex items-center justify-center transition-colors cursor-pointer\\\"\\n                >\\n                  <X className=\\\"w-5 h-5\\\" />\\n                </button>\\n              </div>\\n            </div>\\n\\n            {/* Sub-bar: Panel Switch + Speed Mode */}\\n            <div className=\\\"px-3.5 py-2.5 bg-surface-warm border-b border-line flex items-center justify-between gap-2 shrink-0\\\">\\n              <div className=\\\"flex items-center gap-1 bg-surface-muted p-1 rounded-xl border border-line\\\">\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => setActivePanel(\'chat\')}\\n                  className={`px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition-all cursor-pointer ${\\n                    activePanel === \'chat\'\\n                      ? \'bg-surface text-forest shadow-xs\'\\n                      : \'text-ink-muted hover:text-forest\'\\n                  }`}\\n                >\\n                  <MessageSquareText className=\\\"w-3.5 h-3.5\\\" />\\n                  <span>Obrolan</span>\\n                </button>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => setActivePanel(\'sources\')}\\n                  className={`px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition-all cursor-pointer ${\\n                    activePanel === \'sources\'\\n                      ? \'bg-surface text-forest shadow-xs\'\\n                      : \'text-ink-muted hover:text-forest\'\\n                  }`}\\n                >\\n                  <FileArchive className=\\\"w-3.5 h-3.5\\\" />\\n                  <span>Sumber Buku</span>\\n                  <span className=\\\"font-mono tabular-nums text-[10px] text-brand font-bold\\\">\\n                    ({bookCount})\\n                  </span>\\n                </button>\\n              </div>\\n\\n              {activePanel === \'chat\' && (\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() =>\\n                    setSpeedMode((prev) => (prev === \'standar\' ? \'cepat\' : \'standar\'))\\n                  }\\n                  title=\\\"Pilih mode penalaran: Standar (gemini-4-hydrogen) atau Cepat (gemini-3.1-flash-lite)\\\"\\n                  className={`px-2.5 py-1.5 rounded-xl text-[11px] font-semibold border flex items-center gap-1 transition-colors cursor-pointer ${\\n                    speedMode === \'cepat\'\\n                      ? \'bg-status-segera-bg border-status-segera-text/30 text-status-segera-text\'\\n                      : \'bg-surface border-line text-forest hover:border-line-strong\'\\n                  }`}\\n                >\\n                  {speedMode === \'cepat\' ? (\\n                    <>\\n                      <Zap className=\\\"w-3 h-3\\\" />\\n                      <span>Mode Cepat</span>\\n                    </>\\n                  ) : (\\n                    <>\\n                      <Sparkles className=\\\"w-3 h-3 text-brand\\\" />\\n                      <span>Mode Lengkap</span>\\n                    </>\\n                  )}\\n                </button>\\n              )}\\n            </div>\\n\\n            {/* PANEL 1: CHAT THREAD */}\\n            {activePanel === \'chat\' ? (\\n              <>\\n                <div className=\\\"flex-1 overflow-y-auto p-4 space-y-4 bg-bg/70\\\">\\n                  {messages.map((msg) => {\\n                    const isUser = msg.role === \'user\';\\n                    return (\\n                      <div\\n                        key={msg.id}\\n                        className={`flex items-start gap-2.5 ${\\n                          isUser ? \'flex-row-reverse\' : \'\'\\n                        }`}\\n                      >\\n                        <div\\n                          className={`w-7 h-7 rounded-lg flex items-center justify-center shrink-0 mt-0.5 ${\\n                            isUser\\n                              ? \'bg-forest text-sand\'\\n                              : msg.isError\\n                              ? \'bg-status-kedaluwarsa-bg text-status-kedaluwarsa-text\'\\n                              : \'bg-secondary text-forest\'\\n                          }`}\\n                        >\\n                          {isUser ? (\\n                            <User className=\\\"w-4 h-4\\\" />\\n                          ) : (\\n                            <Bot className=\\\"w-4 h-4\\\" />\\n                          )}\\n                        </div>\\n\\n                        <div\\n                          className={`max-w-[85%] space-y-1.5 ${\\n                            isUser ? \'items-end\' : \'items-start\'\\n                          }`}\\n                        >\\n                          <div\\n                            className={`px-3.5 py-2.5 rounded-2xl ${\\n                              isUser\\n                                ? \'bg-forest text-white rounded-tr-sm\'\\n                                : msg.isError\\n                                ? \'bg-status-kedaluwarsa-bg border border-status-kedaluwarsa-text/25 text-status-kedaluwarsa-text rounded-tl-sm\'\\n                                : \'bg-surface border border-line text-ink rounded-tl-sm\'\\n                            }`}\\n                          >\\n                            {msg.text ? (\\n                              isUser ? (\\n                                <p className=\\\"text-xs sm:text-sm leading-relaxed whitespace-pre-wrap\\\">\\n                                  {msg.text}\\n                                </p>\\n                              ) : (\\n                                <FormattedMessageText text={msg.text} />\\n                              )\\n                            ) : (\\n                              <div className=\\\"flex items-center gap-2 text-xs text-ink-muted py-0.5\\\">\\n                                <Loader2 className=\\\"w-3.5 h-3.5 animate-spin text-brand\\\" />\\n                                <span>Menyusun jawaban dari sumber...</span>\\n                              </div>\\n                            )}\\n                          </div>\\n\\n                          {msg.sources && msg.sources.length > 0 && (\\n                            <div className=\\\"flex flex-wrap items-center gap-1.5 pt-0.5\\\">\\n                              {msg.sources.map((src, i) => (\\n                                <span\\n                                  key={i}\\n                                  className={`inline-flex items-center gap-1 px-2 py-0.5 rounded-lg text-[10px] font-medium border ${\\n                                    src.sourceType === \'book\'\\n                                      ? \'bg-sand-soft text-forest border-sand\'\\n                                      : \'bg-secondary/60 text-forest border-line\'\\n                                  }`}\\n                                >\\n                                  {src.sourceType === \'book\' ? (\\n                                    <BookOpen className=\\\"w-2.5 h-2.5 shrink-0\\\" />\\n                                  ) : (\\n                                    <Globe className=\\\"w-2.5 h-2.5 shrink-0\\\" />\\n                                  )}\\n                                  <span className=\\\"truncate max-w-[190px]\\\">\\n                                    {src.sectionTitle}\\n                                  </span>\\n                                </span>\\n                              ))}\\n                            </div>\\n                          )}\\n                        </div>\\n                      </div>\\n                    );\\n                  })}\\n\\n                  {messages.length === 1 && !isSending && (\\n                    <div className=\\\"pt-2 space-y-2\\\">\\n                      <span className=\\\"text-[11px] font-bold uppercase tracking-wider text-brand block\\\">\\n                        Contoh Pertanyaan\\n                      </span>\\n                      <div className=\\\"flex flex-col gap-1.5\\\">\\n                        {starterQuestions.map((q, idx) => (\\n                          <button\\n                            key={idx}\\n                            type=\\\"button\\\"\\n                            onClick={() => handleSendMessage(q)}\\n                            className=\\\"text-left text-xs px-3.5 py-2.5 rounded-xl bg-surface border border-line hover:border-line-strong hover:bg-surface-warm text-ink font-medium transition-colors cursor-pointer\\\"\\n                          >\\n                            &ldquo;{q}&rdquo;\\n                          </button>\\n                        ))}\\n                      </div>\\n                    </div>\\n                  )}\\n\\n                  <div ref={messagesEndRef} />\\n                </div>\\n\\n                {/* Chat Input Area */}\\n                <div className=\\\"p-3.5 bg-surface border-t border-line space-y-2 shrink-0\\\">\\n                  <form\\n                    onSubmit={(e) => {\\n                      e.preventDefault();\\n                      handleSendMessage();\\n                    }}\\n                    className=\\\"flex items-end gap-2\\\"\\n                  >\\n                    <textarea\\n                      ref={inputRef}\\n                      rows={1}\\n                      value={inputText}\\n                      onChange={(e) => setInputText(e.target.value)}\\n                      onKeyDown={(e) => {\\n                        if (e.key === \'Enter\' && !e.shiftKey) {\\n                          e.preventDefault();\\n                          handleSendMessage();\\n                        }\\n                      }}\\n                      placeholder=\\\"Tanya seputar label obat, DAGUSIBU, atau isi buku .zip...\\\"\\n                      aria-label=\\\"Tulis pertanyaan untuk asisten Ruang Obat\\\"\\n                      disabled={isSending}\\n                      className=\\\"flex-1 min-h-[44px] max-h-28 px-3.5 py-2.5 text-xs sm:text-sm bg-bg border border-line rounded-xl text-ink focus:outline-none focus:ring-2 focus:ring-focus focus:bg-surface resize-none\\\"\\n                    />\\n                    <button\\n                      type=\\\"submit\\\"\\n                      disabled={isSending || !inputText.trim()}\\n                      aria-label=\\\"Kirim pertanyaan\\\"\\n                      className=\\\"min-h-[44px] min-w-[44px] px-3.5 rounded-xl bg-forest hover:bg-brand disabled:opacity-40 disabled:cursor-not-allowed text-white flex items-center justify-center transition-colors cursor-pointer shrink-0\\\"\\n                    >\\n                      {isSending ? (\\n                        <Loader2 className=\\\"w-4 h-4 animate-spin\\\" />\\n                      ) : (\\n                        <Send className=\\\"w-4 h-4 text-sand\\\" />\\n                      )}\\n                    </button>\\n                  </form>\\n                  <p className=\\\"text-[10px] text-ink-muted text-center leading-snug\\\">\\n                    Edukasi umum berbasis isi Ruang Obat &amp; buku referensi, bukan diagnosis atau saran dosis pribadi.\\n                  </p>\\n                </div>\\n              </>\\n            ) : (\\n              /* PANEL 2: KNOWLEDGE SOURCES */\\n              <div className=\\\"flex-1 overflow-y-auto p-4 space-y-4 bg-bg/70\\\">\\n                <div className=\\\"p-4 rounded-2xl bg-surface border border-line space-y-3\\\">\\n                  <div className=\\\"flex items-start gap-3\\\">\\n                    <div className=\\\"w-10 h-10 rounded-xl bg-sand-soft text-forest flex items-center justify-center shrink-0\\\">\\n                      <FileArchive className=\\\"w-5 h-5\\\" />\\n                    </div>\\n                    <div className=\\\"space-y-0.5\\\">\\n                      <h3 className=\\\"text-sm font-bold text-forest\\\">\\n                        Tambahkan Sumber Buku (.zip / .pdf / .txt)\\n                      </h3>\\n                      <p className=\\\"text-xs text-ink-muted leading-relaxed\\\">\\n                        Unggah file{\' \'}\\n                        <code className=\\\"bg-surface-muted px-1 rounded\\\">.zip</code>{\' \'}\\n                        berisi buku atau pedoman farmasi (PDF, TXT, atau Markdown) agar asisten dapat menjawab langsung dari isi pustaka Anda.\\n                      </p>\\n                    </div>\\n                  </div>\\n\\n                  <input\\n                    ref={fileInputRef}\\n                    type=\\\"file\\\"\\n                    accept=\\\".zip,.pdf,.txt,.md,.csv,.json,.html,.htm\\\"\\n                    onChange={(e) => handleUploadFiles(e.target.files)}\\n                    className=\\\"hidden\\\"\\n                  />\\n\\n                  <div className=\\\"flex flex-wrap items-center gap-2\\\">\\n                    <button\\n                      type=\\\"button\\\"\\n                      disabled={isUploading}\\n                      onClick={() => fileInputRef.current?.click()}\\n                      className=\\\"min-h-[42px] px-4 py-2 rounded-xl bg-forest hover:bg-brand disabled:opacity-60 text-on-brand text-xs font-semibold flex items-center gap-2 cursor-pointer transition-colors\\\"\\n                    >\\n                      {isUploading ? (\\n                        <>\\n                          <Loader2 className=\\\"w-4 h-4 animate-spin\\\" />\\n                          <span>Memproses &amp; Mengindeks...</span>\\n                        </>\\n                      ) : (\\n                        <>\\n                          <Upload className=\\\"w-4 h-4 text-sand\\\" />\\n                          <span>Unggah File .zip / Buku</span>\\n                        </>\\n                      )}\\n                    </button>\\n\\n                    <button\\n                      type=\\\"button\\\"\\n                      disabled={isLoadingKnowledge}\\n                      onClick={handleReloadFolder}\\n                      className=\\\"min-h-[42px] px-3.5 py-2 rounded-xl bg-surface border border-line hover:border-line-strong text-forest text-xs font-semibold flex items-center gap-1.5 cursor-pointer transition-colors\\\"\\n                    >\\n                      <RefreshCw\\n                        className={`w-3.5 h-3.5 ${\\n                          isLoadingKnowledge ? \'animate-spin\' : \'\'\\n                        }`}\\n                      />\\n                      <span>Muat Ulang Folder</span>\\n                    </button>\\n                  </div>\\n\\n                  {uploadStatus && (\\n                    <div\\n                      className={`p-3 rounded-xl text-xs flex items-start gap-2 border ${\\n                        uploadStatus.type === \'success\'\\n                          ? \'bg-status-aman-bg border-status-aman-text/25 text-status-aman-text\'\\n                          : \'bg-status-kedaluwarsa-bg border-status-kedaluwarsa-text/25 text-status-kedaluwarsa-text\'\\n                      }`}\\n                    >\\n                      {uploadStatus.type === \'success\' ? (\\n                        <CheckCircle2 className=\\\"w-4 h-4 shrink-0 mt-0.5\\\" />\\n                      ) : (\\n                        <AlertCircle className=\\\"w-4 h-4 shrink-0 mt-0.5\\\" />\\n                      )}\\n                      <span>{uploadStatus.message}</span>\\n                    </div>\\n                  )}\\n\\n                  <p className=\\\"text-[11px] text-ink-muted\\\">\\n                    Tips: Anda juga dapat menaruh file{\' \'}\\n                    <code className=\\\"bg-surface-muted px-1 rounded\\\">.zip</code> langsung ke folder{\' \'}\\n                    <code className=\\\"bg-surface-muted px-1 rounded\\\">knowledge_books/</code> lalu tekan{\' \'}\\n                    <strong>Muat Ulang Folder</strong>.\\n                  </p>\\n                </div>\\n\\n                {/* Loaded Books List */}\\n                <div className=\\\"space-y-2\\\">\\n                  <div className=\\\"flex items-center justify-between\\\">\\n                    <h4 className=\\\"text-xs font-bold uppercase tracking-wider text-forest\\\">\\n                      Buku Referensi Terindeks ({knowledge?.books.length ?? 0})\\n                    </h4>\\n                    {knowledge && (\\n                      <span className=\\\"text-[11px] text-ink-muted font-mono tabular-nums\\\">\\n                        {knowledge.totalBookChunks} segmen teks\\n                      </span>\\n                    )}\\n                  </div>\\n\\n                  {!knowledge || knowledge.books.length === 0 ? (\\n                    <div className=\\\"p-5 rounded-2xl bg-surface border border-dashed border-line-strong/50 text-center space-y-1.5\\\">\\n                      <BookOpen className=\\\"w-6 h-6 text-brand mx-auto\\\" />\\n                      <p className=\\\"text-xs font-semibold text-forest\\\">\\n                        Belum ada arsip buku (.zip) yang ditambahkan\\n                      </p>\\n                      <p className=\\\"text-[11px] text-ink-muted\\\">\\n                        Saat ini asisten menggunakan seluruh isi website Ruang Obat sebagai sumber jawaban.\\n                      </p>\\n                    </div>\\n                  ) : (\\n                    <div className=\\\"space-y-2\\\">\\n                      {knowledge.books.map((book) => (\\n                        <div\\n                          key={book.id}\\n                          className=\\\"p-3.5 rounded-xl bg-surface border border-line space-y-2\\\"\\n                        >\\n                          <div className=\\\"flex items-start justify-between gap-2\\\">\\n                            <div className=\\\"flex items-start gap-2.5 min-w-0\\\">\\n                              <div className=\\\"w-8 h-8 rounded-lg bg-sand-soft text-forest flex items-center justify-center shrink-0 mt-0.5\\\">\\n                                {book.fileType === \'zip\' ? (\\n                                  <FileArchive className=\\\"w-4 h-4\\\" />\\n                                ) : (\\n                                  <FileText className=\\\"w-4 h-4\\\" />\\n                                )}\\n                              </div>\\n                              <div className=\\\"min-w-0\\\">\\n                                <div className=\\\"text-xs sm:text-sm font-bold text-forest truncate\\\">\\n                                  {book.fileName}\\n                                </div>\\n                                <div className=\\\"flex flex-wrap items-center gap-1.5 text-[11px] text-ink-muted mt-0.5 font-mono tabular-nums\\\">\\n                                  <span>\\n                                    {book.origin === \'upload\' ? \'Diunggah\' : \'Folder Proyek\'}\\n                                  </span>\\n                                  <span>\302\267</span>\\n                                  <span>{book.innerFiles.length} dokumen</span>\\n                                  <span>\302\267</span>\\n                                  <span>{book.chunkCount} segmen</span>\\n                                </div>\\n                              </div>\\n                            </div>\\n\\n                            {book.origin === \'upload\' && (\\n                              <button\\n                                type=\\\"button\\\"\\n                                onClick={() => handleDeleteBook(book.fileName)}\\n                                aria-label={`Hapus ${book.fileName}`}\\n                                className=\\\"p-1.5 rounded-lg text-ink-muted hover:text-status-kedaluwarsa-text hover:bg-status-kedaluwarsa-bg/60 transition-colors cursor-pointer shrink-0\\\"\\n                              >\\n                                <Trash2 className=\\\"w-4 h-4\\\" />\\n                              </button>\\n                            )}\\n                          </div>\\n\\n                          {book.innerFiles.length > 0 && (\\n                            <div className=\\\"text-[11px] text-ink-muted bg-surface-warm rounded-lg p-2 border border-line/80\\\">\\n                              <span className=\\\"font-semibold text-forest\\\">Isi dokumen: </span>\\n                              {book.innerFiles.join(\', \')}\\n                            </div>\\n                          )}\\n                        </div>\\n                      ))}\\n                    </div>\\n                  )}\\n                </div>\\n\\n                {/* Indexed Website Content */}\\n                <div className=\\\"p-4 rounded-2xl bg-surface border border-line space-y-2\\\">\\n                  <div className=\\\"flex items-center justify-between\\\">\\n                    <div className=\\\"flex items-center gap-2\\\">\\n                      <Globe className=\\\"w-4 h-4 text-brand\\\" />\\n                      <h4 className=\\\"text-xs font-bold uppercase tracking-wider text-forest\\\">\\n                        Materi Website Ruang Obat (Aktif)\\n                      </h4>\\n                    </div>\\n                    <span className=\\\"text-[11px] font-mono tabular-nums text-brand font-semibold\\\">\\n                      {knowledge?.websiteChunks ?? 0} segmen\\n                    </span>\\n                  </div>\\n                  <ul className=\\\"text-xs text-ink-muted space-y-1 list-disc list-inside\\\">\\n                    {(knowledge?.websiteModules ?? []).map((mod, i) => (\\n                      <li key={i}>{mod}</li>\\n                    ))}\\n                  </ul>\\n                </div>\\n              </div>\\n            )}\\n          </div>\\n        </div>\\n      )}\\n    </>\\n  );\\n};\\n\", \"Description\":\"Redesign ChatbotWidget with warm apothecary editorial theme while preserving streaming SSE, Gemini speed modes, and .zip book indexing\", \"Overwrite\":true, \"TargetFile\":\"/src/components/ChatbotWidget.tsx\", \"toolAction\":\"Redesigning ChatbotWidget theme\", \"toolSummary\":\"Redesign ChatbotWidget.tsx\"}"
      original_name: "write_to_file"
    }
    thinking_duration {
