            }
            lines {
              text: "    id: \'fc-8\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    category: \'titik-kritis\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    categoryLabel: \'Titik Kritis\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    title: \'Masa Simpan Tetes Mata Mini-Dose vs Botol Multi-Dosis\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    frontPrompt: \'Berapa batas waktu penggunaan (BUD) tetes mata mini-dose (tanpa pengawet) vs botol multi-dosis?\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    frontHint: \'Satu habis dalam 24 jam, satu lagi maksimal 28-30 hari.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    backDefinition: \'Tetes mata botol multi-dosis maksimal 28\342\200\22330 hari setelah dibuka. Tetes mata mini-dose (strip tube sekali pakai) maksimal 24 jam (3x24 jam jika ada tutup klik).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    backRules: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Tetes mata botol mengandung preservatif (pengawet antimikroba) yang menurun efektivitasnya setelah 1 bulan.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Mini-dose tidak memakai pengawet sehingga risiko kontaminasi kuman mata sangat cepat.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Jangan sampai ujung penetes menyentuh bola mata atau bulu mata.\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    referenceSource: \'Pedoman Beyond Use Date Kemenkes RI\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id: \'fc-9\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    category: \'titik-kritis\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    categoryLabel: \'Titik Kritis\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    title: \'Arti 15 Digit Nomor Izin Edar (NIE BPOM)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    frontPrompt: \'Apa arti kode 3 huruf pertama pada NIE BPOM (misal DBL atau DTL atau DKL)?\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    frontHint: \'Huruf 1 = Dagang/Generik, Huruf 2 = Golongan Obat, Huruf 3 = Asal Pabrik.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    backDefinition: \'Huruf 1: D (Nama Dagang) / G (Generik). Huruf 2: B (Bebas) / T (Bebas Terbatas) / K (Keras). Huruf 3: L (Produksi Lokal) / I (Impor).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    backRules: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'DBL: Obat dengan nama Dagang, golongan Bebas, diproduksi Dalam Negeri / Lokal.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'DTL: Obat nama Dagang, Bebas Terbatas, Lokal.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'DKL: Obat nama Dagang, Obat Keras, Lokal.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Dapat dicek keasliannya via aplikasi BPOM Mobile atau situs cekbpom.pom.go.id.\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    referenceSource: \'Badan Pengawas Obat dan Makanan (BPOM RI)\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id: \'fc-10\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    category: \'dagusibu\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    categoryLabel: \'Prinsip Dagusibu\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    title: \'Cara Aman Membuang Tablet & Kapsul Kedaluwarsa\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    frontPrompt: \'Bagaimana langkah merusak sediaan tablet dan kapsul sebelum dibuang ke tempat sampah rumah tangga?\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    frontHint: \'Cegah obat dipungut oknum pemalsu obat di tempat pembuangan akhir.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    backDefinition: \'Keluarkan obat dari blister/strip, gerus tablet atau buka cangkang kapsul, campur dengan tanah/ampas kopi/kotoran, bungkus rapat dalam kantong plastik, lalu buang.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    backRules: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Lepaskan atau gunting label identitas dan nama pasien.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Gunting blister/strip foil menjadi potongan kecil agar tidak dapat dipakai ulang sindikat pemalsu.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Jangan membuang tablet utuh langsung ke saluran wastafel atau kloset (mencemari air tanah).\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    referenceSource: \'Gerakan Masyarakat Cerdas Menggunakan Obat (GeMa CerMO) Kemenkes RI\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id: \'fc-11\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    category: \'dagusibu\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    categoryLabel: \'Prinsip Dagusibu\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    title: \'Cara Aman Membuang Sediaan Sirup & Botol Kaca\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    frontPrompt: \'Bagaimana cara membuang sediaan sirup obat batuk/demam yang sudah rusak atau kedaluwarsa?\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    frontHint: \'Pisahkan antara cairan obat dan botol kemasannya.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    backDefinition: \'Encerkan cairan sirup dengan air mengalir banyak di saluran pembuangan, lepaskan label botol dan rusak/pecahkan botol kaca, lalu buang botol di tempat sampah daur ulang.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    backRules: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Buka tutup botol dan tuang cairan sirup ke kloset atau saluran air bersama siraman air berlimpah.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Copot atau coret permanen label kemasan (nama merk dan nomor bets).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Rusak botol plastik dengan cara digunting/dihancurkan, atau botol kaca dipecahkan secara hati-hati terbungkus kain.\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    warningNote: \'Untuk sirup antibiotik sisa: endapkan dan campur dengan tanah sebelum dibuang untuk meminimalkan residu antimikroba di saluran got.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    referenceSource: \'Pedoman Penanganan Obat Rusak & Kedaluwarsa di Rumah Tangga - BPOM RI\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id: \'fc-12\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    category: \'dagusibu\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    categoryLabel: \'Prinsip Dagusibu\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    title: \'Tempat Terlarang Menyimpan Obat di Rumah\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    frontPrompt: \'Sebutkan 3 tempat di rumah yang sering keliru dijadikan tempat menyimpan obat!\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    frontHint: \'Area dengan fluktuasi panas tinggi, kelembapan uap air, atau paparan sinar matahari langsung.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    backDefinition: \'1) Dashboard mobil / laci kendaraan (panas ekstrem hingga >50\302\260C), 2) Lemari kamar mandi (kelembapan uap air tinggi), 3) Di atas kulkas / dekat kompor dapur (panas motor kulkas & uap memasak).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    backRules: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Suhu ruang aman: 15\302\260C \342\200\223 25\302\260C (sejuk dan kering).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Hindari paparan sinar matahari langsung yang mengoksidasi senyawa kimia aktif obat.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Jauhkan dari jangkauan anak-anak dan simpan dalam wadah asli bersegel rapat.\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    referenceSource: \'Petunjuk Penyimpanan Obat Kemenkes RI\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "export const QUIZ_QUESTIONS: QuizQuestion[] = ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id: 1,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    question: \'Sebuah kemasan obat batuk cair menampilkan tanda lingkaran biru dengan garis tepi hitam. Berdasarkan penggolongan resmi BPOM, apakah golongan obat tersebut?\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    competency: \'Identifikasi Logo Golongan Obat\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    options: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Obat Bebas yang dapat dibeli di mana saja tanpa peringatan khusus\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Obat Bebas Terbatas yang disertai salah satu tanda peringatan resmi P.No 1 s/d P.No 6\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Obat Keras yang mutlak membutuhkan resep dokter\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Narkotika dan Psikotropika dengan pengawasan ketat\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    correctIndex: 1,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    explanation: \'Lingkaran biru bergaris tepi hitam adalah tanda golongan Obat Bebas Terbatas. Obat ini tergolong obat keras namun dalam jumlah/takaran tertentu masih dapat dibeli tanpa resep dokter dan wajib memuat kotak peringatan P.No 1 s/d P.No 6.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    referenceSource: \'Permenkes RI No. 917/Menkes/Per/X/1993 tentang Penggolongan Obat\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id: 2,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    question: \'Di sisi strip obat pereda flu, terdapat kotak hitam bertuliskan: \"P.No. 1: Awas! Obat Keras. Bacalah aturan memakainya.\" Apa tindakan paling tepat yang wajib dilakukan konsumen?\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    competency: \'Paham Peringatan Khusus\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    options: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Langsung menelan 2 tablet sekaligus agar sakit flu segera tuntas\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Membaca seksama dosis maksimal per hari, jarak waktu konsumsi, dan batas maksimal 3 hari swamedikasi\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Mengabaikan peringatan karena obat tersebut dibeli di apotek tanpa resep dokter\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Menghaluskan tablet lalu mencampurnya ke dalam kopi panas\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    correctIndex: 1,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    explanation: \'Tanda Peringatan P.No 1 menegaskan bahwa obat memiliki kandungan zat aktif kuat. Konsumen wajib mematuhi dosis harian, batas waktu minum mandiri (maksimal 3 hari), serta tidak mengemudi bila ada efek sedatif (kantuk).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    referenceSource: \'SK Menkes No. 6355/Dirjen/SK/69 tentang Tanda Peringatan Obat Bebas Terbatas\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id: 3,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    question: \'Apa perbedaan paling mendasar antara Expired Date (ED) dan Beyond Use Date (BUD)?\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    competency: \'Perbedaan ED vs BUD\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    options: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'ED untuk obat cair, sedangkan BUD khusus untuk obat tablet dan kapsul\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'ED adalah masa kedaluwarsa saat wadah masih segel utuh dari pabrik, sedangkan BUD adalah batas aman setelah wadah dibuka oleh pasien\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'ED ditentukan oleh apoteker di apotek, sedangkan BUD ditentukan oleh pabrik farmasi\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'ED dan BUD memiliki arti yang persis sama dan tidak ada perbedaannya\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    correctIndex: 1,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    explanation: \'Expired Date (ED) merupakan jaminan stabilitas mutu dari produsen selama kemasan masih tersegel primer. Begitu segel dibuka atau direkonstitusi, stabilitas obat dihitung berdasarkan Beyond Use Date (BUD) yang sering kali jauh lebih singkat daripada ED pabrik.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    referenceSource: \'United States Pharmacopeia (USP) Compounding Compendium & Kemenkes RI\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id: 4,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    question: \'Ibu memiliki botol sirup antibiotik kering (dry syrup) yang baru saja dilarutkan dengan air matang hari ini. Jika disimpan di suhu ruangan (25\302\260C), berapa lama batas waktu penggunaan (BUD) sirup tersebut?\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    competency: \'Masa Simpan Sediaan Khusus (Sirup Kering)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    options: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Maksimal 7 hari setelah dilarutkan\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Hingga tanggal Expired Date yang tertera di kemasan (misal 2 tahun lagi)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Selama 6 bulan jika ditaruh di tempat gelap\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Sampai warna sirup berubah menjadi hitam pekat\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    correctIndex: 0,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    explanation: \'Sirup antibiotik rekonstitusi memiliki kestabilan fisikokimia yang sangat pendek setelah dicampur air, yaitu maksimal 7 hari pada suhu ruangan sejuk (atau 14 hari di dalam lemari pendingin non-freezer 2-8\302\260C). Melewati waktu tersebut, efektivitas antibiotik menurun drastis dan rentan kontaminasi mikroba.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    referenceSource: \'Farmakope Indonesia Edisi VI & Pedoman Beyond Use Date Kemenkes RI\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id: 5,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    question: \'Mengapa meminum sisa antibiotik milik orang lain saat Anda mengalami gejala demam dan flu dilarang keras dalam farmasi klinis?\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    competency: \'Patient Safety & Antimicrobial Resistance (AMR)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    options: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Karena rasa antibiotik sisa sudah pasti berubah menjadi sangat manis\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Karena sebagian besar flu disebabkan virus bukan bakteri, dan konsumsi antibiotik tanpa indikasi resep memicu Resistensi Antimikroba (AMR)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Karena antibiotik hanya boleh diminum oleh orang yang berusia di atas 60 tahun\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Karena antibiotik sisa akan langsung menguap begitu dibuka dari stripnya\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    correctIndex: 1,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    explanation: \'Antibiotik hanya efektif melawan infeksi bakteri, bukan virus (penyebab flu/selesma umum). Mengonsumsi sisa antibiotik teman dengan dosis tidak tuntas adalah penyebab utama timbulnya superbug kuman resisten (AMR) yang berbahaya bagi diri sendiri dan masyarakat luas.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    referenceSource: \'Pedoman Penatagunaan Antimikroba (PGA) Kemenkes RI & WHO Global AMR Framework\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id: 6,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    question: \'Nomor Izin Edar obat di Indonesia terdiri dari 15 digit. Jika sebuah obat memiliki kode awal \"DBL\", apakah arti dari kode 3 huruf tersebut?\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    competency: \'Verifikasi Nomor Izin Edar (NIE BPOM)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    options: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Obat Dinas, Bebas terbatas, Luar negeri\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Obat dengan nama Dagang, Golongan Bebas (lingkaran hijau), Produksi Dalam Negeri / Lokal\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Obat Generik, Berbahaya, Luar negeri\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Obat Keras impor yang diedarkan oleh Badan POM\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    correctIndex: 1,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    explanation: \'Huruf ke-1 \"D\" = Merk Dagang (Trade Name); Huruf ke-2 \"B\" = Golongan Obat Bebas; Huruf ke-3 \"L\" = Diproduksi secara Lokal di dalam negeri. Keabsahan 15 digit ini dapat dicek di BPOM Mobile.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    referenceSource: \'Peraturan Kepala BPOM RI tentang Tata Laksana Registrasi Obat\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id: 7,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    question: \'Berapakah takaran volume resmi untuk \"1 sendok teh obat\" (bahasa resep: cochlear theae / cth) pada sediaan sendok takar sirup?\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    competency: \'Ketepatan Takaran Sediaan Cair\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    options: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'2 mL\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'5 mL\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'10 mL\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'15 mL\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    correctIndex: 1,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    explanation: \'Dalam standar farmakope resmi, 1 sendok teh obat (cth) adalah tepat 5 mL. Sendok makan obat (C) bernilai 15 mL. Tidak boleh menyamakan sendok teh obat 5 mL dengan sendok makan dapur rumah tangga yang volumenya bervariasi luas antara 10-15 mL.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    referenceSource: \'Farmakope Indonesia Edisi V & Pedoman Dagusibu Apoteker\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id: 8,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    question: \'Berdasarkan pedoman DAGUSIBU Kemenkes RI, bagaimanakah cara memusnahkan sediaan tablet yang sudah kedaluwarsa sebelum dibuang ke tempat sampah rumah tangga?\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    competency: \'Prinsip DAGUSIBU (Cara Buang Obat Rusak)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    options: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Membuang blister utuh langsung ke saluran wastafel atau kloset\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Menjualnya ke pengepul barang rongsokan\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Keluarkan dari blister, hancurkan/gerus tablet, campur dengan tanah/ampas kopi, masukkan kantong plastik rapat, dan rusak kemasannya\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Membakar seluruh strip plastik di dalam kamar tidur\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    correctIndex: 2,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    explanation: \'Untuk mencegah penyalahgunaan obat rusak oleh sindikat daur ulang obat ilegal, tablet harus dikeluarkan dari kemasannya, dihancurkan, dan dicampur bahan menjijikkan/tanah/kopi agar tidak dapat dipungut. Strip/blister dipotong-potong kecil sebelum dibuang.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    referenceSource: \'Gerakan Masyarakat Cerdas Menggunakan Obat (GeMa CerMO) Kemenkes RI\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id: 9,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    question: \'Di manakah tempat di dalam rumah yang paling TIDAK Dianjurkan untuk menyimpan obat-obatan keluarga?\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    competency: \'Penyimpanan Obat Sesuai Karakteristik (Suhu & Kelembapan)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    options: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Kotak obat khusus yang tertutup di lemari ruang tamu yang sejuk dan kering\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Lemari gantung kamar mandi dan dashboard mobil yang terkena sinar matahari terik\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Rak meja belajar yang jauh dari jangkauan balita\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Laci lemari kamar tidur dengan suhu stabil ~25\302\260C\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    correctIndex: 1,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    explanation: \'Kamar mandi memiliki kelembapan udara sangat tinggi yang mempercepat hidrolisis dan jamur pada tablet/salep, sedangkan mobil memiliki suhu ekstrem (bisa >50\302\260C) yang merusak kestabilan zat aktif dan melelehkan kapsul/sirup.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    referenceSource: \'Petunjuk Teknis Penyimpanan Obat di Rumah Tangga - Kemenkes RI\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id: 10,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    question: \'Kapan saat yang paling tepat bagi seorang konsumen swamedikasi untuk segera menghentikan pengobatan mandiri dan menghubungi apoteker atau dokter?\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    competency: \'Kewaspadaan Swamedikasi & Patient Safety\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    options: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Setelah minum obat 5 menit dan belum langsung sembuh seketika\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Bila gejala tidak membaik setelah 3 hari, timbul reaksi alergi (bengkak/ruam), atau muncul tanda bahaya seperti sesak napas berat\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Hanya boleh berkonsultasi jika persediaan obat di rumah sudah habis 100%\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Tidak perlu bertanya ke dokter jika obat yang diminum berlogo hijau\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    correctIndex: 1,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    explanation: \'Swamedikasi hanya dibatasi untuk keluhan ringan dan sementara (maksimal 3 hari). Timbulnya tanda bahaya (red flags), sesak napas, penurunan kesadaran, atau reaksi alergi akut merupakan indikasi rujukan medis mendesak.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    referenceSource: \'Pedoman Pelayanan Kefarmasian untuk Pasien Swamedikasi Kemenkes RI\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
          }
        }
        absolute_uri: "file:///src/data/latihanData.ts"
        create_file: true
      }
    }
    use_fast_apply: true
    description: "Create rich dataset for Latihan modules: Scenarios with clinical consequences, 12 Flashcards with DAGUSIBU/Label concepts, and 10 Pretest/Posttest Quiz questions"
    diff_stats {
