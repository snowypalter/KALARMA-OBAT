  view_file {
    absolute_path_uri: "file:///src/components/ChatbotWidget.tsx"
    end_line: 918
    content: "import React, { useState, useEffect, useRef } from \'react\';\nimport { TabType } from \'../types\';\nimport {\n  MessageSquareText,\n  X,\n  Send,\n  Bot,\n  User,\n  BookOpen,\n  Upload,\n  RefreshCw,\n  Trash2,\n  RotateCcw,\n  Sparkles,\n  Zap,\n  FileArchive,\n  FileText,\n  AlertCircle,\n  CheckCircle2,\n  Globe,\n  Loader2,\n} from \'lucide-react\';\n\ninterface ChatSourceRef {\n  sourceType: \'website\' | \'book\';\n  sourceName: string;\n  sectionTitle: string;\n}\n\ninterface ChatMessage {\n  id: string;\n  role: \'user\' | \'model\';\n  text: string;\n  sources?: ChatSourceRef[];\n  modelUsed?: string;\n  isError?: boolean;\n}\n\ninterface BookSourceMeta {\n  id: string;\n  fileName: string;\n  origin: \'folder\' | \'upload\';\n  fileType: \'zip\' | \'pdf\' | \'text\';\n  innerFiles: string[];\n  chunkCount: number;\n  totalChars: number;\n  addedAt: string;\n}\n\ninterface KnowledgeSummary {\n  websiteChunks: number;\n  websiteModules: string[];\n  books: BookSourceMeta[];\n  totalBookChunks: number;\n}\n\ninterface ChatbotWidgetProps {\n  currentTab: TabType;\n  externalOpenTrigger?: number;\n}\n\nconst CHAT_HISTORY_KEY = \'ruang_obat_chat_history_v1\';\n\nconst INITIAL_BOT_MESSAGE: ChatMessage = {\n  id: \'welcome-1\',\n  role: \'model\',\n  text: \'Halo! Saya **Asisten Ruang Obat**. Kamu bisa bertanya seputar seluruh materi di website ini (6 titik label kemasan, Lemari Obat, DAGUSIBU, Kamus, Skenario, Kuis) maupun isi dari **buku referensi (.zip)** yang sudah ditambahkan.\\n\\nSilakan pilih pertanyaan cepat di bawah atau ketik pertanyaanmu!\',\n};\n\nconst TAB_STARTER_QUESTIONS: Record<TabType, string[]> = {\n  beranda: [\n    \'Apa saja fitur utama di website Ruang Obat?\',\n    \'Apa perbedaan Expired Date (ED) dan Beyond Use Date (BUD)?\',\n    \'Jelaskan arti lingkaran hijau, biru, dan merah K pada kemasan obat.\',\n  ],\n  \'cek-label\': [\n    \'Apa saja 6 titik informasi penting pada label kemasan obat?\',\n    \'Bagaimana cara membaca kode 15 digit NIE BPOM (DBL, DTL, DKL)?\',\n    \'Kenapa sirup tertentu wajib dikocok dahulu sebelum diminum?\',\n  ],\n  lemari: [\n    \'Bagaimana cara membuang tablet dan sirup kedaluwarsa sesuai prinsip DAGUSIBU?\',\n    \'Di mana tempat yang salah untuk menyimpan obat di rumah?\',\n    \'Berapa lama batas aman (BUD) tetes mata dan sirup kering setelah dibuka?\',\n  ],\n  latihan: [\n    \'Mengapa meminum sisa antibiotik teman sangat berbahaya?\',\n    \'Kenapa sendok makan dapur tidak boleh dipakai untuk takaran sirup obat?\',\n    \'Kapan waktu terbaik minum tablet kunyah antasida?\',\n  ],\n  pustaka: [\n    \'Sumber resmi apa saja yang menjadi rujukan aplikasi Ruang Obat?\',\n    \'Apa isi buku referensi .zip yang sedang dimuat saat ini?\',\n    \'Jelaskan arti tanda peringatan P.No 1 sampai P.No 6.\',\n  ],\n};\n\nfunction arrayBufferToBase64(buffer: ArrayBuffer): string {\n  const bytes = new Uint8Array(buffer);\n  const chunkSize = 0x8000;\n  let binary = \'\';\n  for (let i = 0; i < bytes.length; i += chunkSize) {\n    const slice = bytes.subarray(i, i + chunkSize);\n    binary += String.fromCharCode(...slice);\n  }\n  return btoa(binary);\n}\n\nfunction renderFormattedLine(line: string, keyPrefix: string) {\n  // Parse **bold** inline segments safely without dangerouslySetInnerHTML\n  const parts = line.split(/(\\*\\*[^*]+\\*\\*)/g);\n  return (\n    <React.Fragment key={keyPrefix}>\n      {parts.map((part, idx) => {\n        if (part.startsWith(\'**\') && part.endsWith(\'**\') && part.length > 4) {\n          return (\n            <strong key={idx} className=\"font-bold\">\n              {part.slice(2, -2)}\n            </strong>\n          );\n        }\n        return <React.Fragment key={idx}>{part}</React.Fragment>;\n      })}\n    </React.Fragment>\n  );\n}\n\nfunction FormattedMessageText({ text }: { text: string }) {\n  const blocks = text.split(\'\\n\');\n  return (\n    <div className=\"space-y-1.5 text-xs sm:text-sm leading-relaxed break-words\">\n      {blocks.map((rawLine, idx) => {\n        const line = rawLine.trim();\n        if (!line) return <div key={idx} className=\"h-1\" />;\n\n        if (line.startsWith(\'- \') || line.startsWith(\'* \') || line.startsWith(\'\342\200\242 \')) {\n          return (\n            <div key={idx} className=\"flex items-start gap-2 pl-1\">\n              <span className=\"text-teal-600 font-bold mt-0.5\">\342\200\242</span>\n              <div className=\"flex-1\">{renderFormattedLine(line.slice(2), `b-${idx}`)}</div>\n            </div>\n          );\n        }\n\n        const numberedMatch = line.match(/^(\\d+\\.)\\s+(.*)$/);\n        if (numberedMatch) {\n          return (\n            <div key={idx} className=\"flex items-start gap-2 pl-1\">\n              <span className=\"font-bold text-teal-800 shrink-0\">{numberedMatch[1]}</span>\n              <div className=\"flex-1\">{renderFormattedLine(numberedMatch[2], `n-${idx}`)}</div>\n            </div>\n          );\n        }\n\n        return <p key={idx}>{renderFormattedLine(line, `p-${idx}`)}</p>;\n      })}\n    </div>\n  );\n}\n\nexport const ChatbotWidget: React.FC<ChatbotWidgetProps> = ({\n  currentTab,\n  externalOpenTrigger = 0,\n}) => {\n  const [isOpen, setIsOpen] = useState(false);\n  const [activePanel, setActivePanel] = useState<\'chat\' | \'sources\'>(\'chat\');\n  const [speedMode, setSpeedMode] = useState<\'standar\' | \'cepat\'>(\'standar\');\n  const [inputText, setInputText] = useState(\'\');\n  const [isSending, setIsSending] = useState(false);\n  const [knowledge, setKnowledge] = useState<KnowledgeSummary | null>(null);\n  const [isLoadingKnowledge, setIsLoadingKnowledge] = useState(false);\n  const [isUploading, setIsUploading] = useState(false);\n  const [uploadStatus, setUploadStatus] = useState<{ type: \'success\' | \'error\'; message: string } | null>(null);\n\n  const [messages, setMessages] = useState<ChatMessage[]>(() => {\n    try {\n      const saved = localStorage.getItem(CHAT_HISTORY_KEY);\n      if (saved) {\n        const parsed = JSON.parse(saved);\n        if (Array.isArray(parsed) && parsed.length > 0) return parsed;\n      }\n    } catch {\n      // ignore\n    }\n    return [INITIAL_BOT_MESSAGE];\n  });\n\n  const messagesEndRef = useRef<HTMLDivElement>(null);\n  const fileInputRef = useRef<HTMLInputElement>(null);\n  const inputRef = useRef<HTMLTextAreaElement>(null);\n\n  useEffect(() => {\n    if (externalOpenTrigger > 0) {\n      setIsOpen(true);\n    }\n  }, [externalOpenTrigger]);\n\n  useEffect(() => {\n    try {\n      // Save only non-empty non-streaming finalized messages\n      const toSave = messages.filter((m) => m.text.trim().length > 0).slice(-30);\n      localStorage.setItem(CHAT_HISTORY_KEY, JSON.stringify(toSave));\n    } catch {\n      // ignore storage quota errors\n    }\n  }, [messages]);\n\n  useEffect(() => {\n    if (isOpen && activePanel === \'chat\') {\n      messagesEndRef.current?.scrollIntoView({ behavior: \'smooth\' });\n    }\n  }, [messages, isOpen, activePanel]);\n\n  const fetchKnowledgeSummary = async () => {\n    setIsLoadingKnowledge(true);\n    try {\n      const res = await fetch(\'/api/knowledge\');\n      if (res.ok) {\n        const data = (await res.json()) as KnowledgeSummary;\n        setKnowledge(data);\n      }\n    } catch {\n      // silent fallback\n    } finally {\n      setIsLoadingKnowledge(false);\n    }\n  };\n\n  useEffect(() => {\n    if (isOpen) {\n      fetchKnowledgeSummary();\n    }\n  }, [isOpen]);\n\n  const handleResetChat = () => {\n    setMessages([INITIAL_BOT_MESSAGE]);\n    try {\n      localStorage.removeItem(CHAT_HISTORY_KEY);\n    } catch {\n      // ignore\n    }\n  };\n\n  const handleSendMessage = async (overrideText?: string) => {\n    const trimmed = (overrideText ?? inputText).trim();\n    if (!trimmed || isSending) return;\n\n    const userMsg: ChatMessage = {\n      id: `u-${Date.now()}`,\n      role: \'user\',\n      text: trimmed,\n    };\n\n    const botPlaceholderId = `m-${Date.now() + 1}`;\n    const botPlaceholder: ChatMessage = {\n      id: botPlaceholderId,\n      role: \'model\',\n      text: \'\',\n    };\n\n    const conversationForApi = [...messages.filter((m) => !m.isError), userMsg].map((m) => ({\n      role: m.role,\n      text: m.text,\n    }));\n\n    setMessages((prev) => [...prev, userMsg, botPlaceholder]);\n    if (!overrideText) setInputText(\'\');\n    setIsSending(true);\n    setActivePanel(\'chat\');\n\n    try {\n      const response = await fetch(\'/api/chat\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({\n          messages: conversationForApi,\n          activeTab: currentTab,\n          speedMode,\n        }),\n      });\n\n      if (!response.ok) {\n        const errBody = await response.json().catch(() => ({}));\n        throw new Error(errBody.error || `Gagal menghubungi asisten (HTTP ${response.status}).`);\n      }\n\n      if (!response.body) {\n        throw new Error(\'Respons stream tidak tersedia.\');\n      }\n\n      const reader = response.body.getReader();\n      const decoder = new TextDecoder();\n      let sseBuffer = \'\';\n      let accumulatedText = \'\';\n\n      while (true) {\n        const { value, done } = await reader.read();\n        if (done) break;\n\n        sseBuffer += decoder.decode(value, { stream: true });\n        const events = sseBuffer.split(\'\\n\\n\');\n        sseBuffer = events.pop() ?? \'\';\n\n        for (const rawEvent of events) {\n          const line = rawEvent\n            .split(\'\\n\')\n            .find((l) => l.startsWith(\'data: \'));\n          if (!line) continue;\n\n          const payloadStr = line.slice(6).trim();\n          if (!payloadStr) continue;\n\n          try {\n            const payload = JSON.parse(payloadStr) as {\n              type: \'chunk\' | \'done\' | \'error\';\n              text?: string;\n              sources?: ChatSourceRef[];\n              model?: string;\n              error?: string;\n            };\n\n            if (payload.type === \'chunk\' && payload.text) {\n              accumulatedText += payload.text;\n              setMessages((prev) =>\n                prev.map((m) =>\n                  m.id === botPlaceholderId ? { ...m, text: accumulatedText } : m\n                )\n              );\n            } else if (payload.type === \'done\') {\n              setMessages((prev) =>\n                prev.map((m) =>\n                  m.id === botPlaceholderId\n                    ? {\n                        ...m,\n                        text: accumulatedText || \'Maaf, saya tidak menerima teks jawaban.\',\n                        sources: payload.sources,\n                        modelUsed: payload.model,\n                      }\n                    : m\n                )\n              );\n            } else if (payload.type === \'error\') {\n              throw new Error(payload.error || \'Terjadi kesalahan saat menghasilkan jawaban.\');\n            }\n          } catch (parseErr) {\n            if (parseErr instanceof Error && parseErr.message !== \'Unexpected end of JSON input\') {\n              throw parseErr;\n            }\n          }\n        }\n      }\n    } catch (err) {\n      const message =\n        err instanceof Error\n          ? err.message\n          : \'Gagal terhubung ke server AI. Pastikan koneksi dan API key tersedia.\';\n      setMessages((prev) =>\n        prev.map((m) =>\n          m.id === botPlaceholderId\n            ? {\n                ...m,\n                text: message,\n                isError: true,\n              }\n            : m\n        )\n      );\n    } finally {\n      setIsSending(false);\n    }\n  };\n\n  const handleUploadFiles = async (files: FileList | null) => {\n    if (!files || files.length === 0) return;\n    const file = files[0];\n    setIsUploading(true);\n    setUploadStatus(null);\n\n    try {\n      const arrayBuffer = await file.arrayBuffer();\n      const base64Data = arrayBufferToBase64(arrayBuffer);\n\n      const res = await fetch(\'/api/knowledge/upload\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({\n          fileName: file.name,\n          base64Data,\n        }),\n      });\n\n      const data = await res.json();\n      if (!res.ok) {\n        throw new Error(data.error || \'Gagal mengunggah file buku.\');\n      }\n\n      setKnowledge(data as KnowledgeSummary);\n      setUploadStatus({\n        type: \'success\',\n        message: `Berhasil memuat \"${file.name}\". Chatbot kini dapat menjawab dari isi buku tersebut!`,\n      });\n    } catch (err) {\n      setUploadStatus({\n        type: \'error\',\n        message: err instanceof Error ? err.message : \'Gagal memproses file.\',\n      });\n    } finally {\n      setIsUploading(false);\n      if (fileInputRef.current) fileInputRef.current.value = \'\';\n    }\n  };\n\n  const handleReloadFolder = async () => {\n    setIsLoadingKnowledge(true);\n    setUploadStatus(null);\n    try {\n      const res = await fetch(\'/api/knowledge/reload\', { method: \'POST\' });\n      const data = await res.json();\n      if (!res.ok) throw new Error(data.error || \'Gagal memuat ulang folder.\');\n      setKnowledge(data as KnowledgeSummary);\n      setUploadStatus({\n        type: \'success\',\n        message: \'Folder knowledge_books berhasil dipindai ulang.\',\n      });\n    } catch (err) {\n      setUploadStatus({\n        type: \'error\',\n        message: err instanceof Error ? err.message : \'Gagal memuat ulang sumber.\',\n      });\n    } finally {\n      setIsLoadingKnowledge(false);\n    }\n  };\n\n  const handleDeleteBook = async (fileName: string) => {\n    setUploadStatus(null);\n    try {\n      const res = await fetch(`/api/knowledge/${encodeURIComponent(fileName)}`, {\n        method: \'DELETE\',\n      });\n      const data = await res.json();\n      if (!res.ok) throw new Error(data.error || \'Gagal menghapus buku.\');\n      setKnowledge(data as KnowledgeSummary);\n      setUploadStatus({\n        type: \'success\',\n        message: `Sumber \"${fileName}\" telah dihapus.`,\n      });\n    } catch (err) {\n      setUploadStatus({\n        type: \'error\',\n        message: err instanceof Error ? err.message : \'Gagal menghapus file.\',\n      });\n    }\n  };\n\n  const bookCount = knowledge?.books.length ?? 0;\n  const starterQuestions = TAB_STARTER_QUESTIONS[currentTab] || TAB_STARTER_QUESTIONS.beranda;\n\n  return (\n    <>\n      {/* Floating Action Button (positioned safely above mobile BottomNav) */}\n      {!isOpen && (\n        <button\n          type=\"button\"\n          onClick={() => setIsOpen(true)}\n          aria-label=\"Buka Asisten Chatbot Ruang Obat\"\n          className=\"no-print fixed bottom-20 right-4 md:bottom-6 md:right-6 z-40 min-h-[48px] px-4 py-2.5 rounded-2xl bg-teal-700 hover:bg-teal-800 text-white shadow-lg border border-teal-600/80 flex items-center gap-2.5 transition-all hover:scale-[1.02] active:scale-95 cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-teal-500\"\n        >\n          <div className=\"w-7 h-7 rounded-lg bg-teal-600/80 flex items-center justify-center shrink-0\">\n            <MessageSquareText className=\"w-4 h-4 text-white\" />\n          </div>\n          <div className=\"text-left\">\n            <span className=\"text-xs sm:text-sm font-bold block leading-tight\">\n              Tanya Ruang Obat\n            </span>\n            <span className=\"text-[10px] text-teal-100 block leading-tight\">\n              AI Materi &amp; Buku (.zip)\n            </span>\n          </div>\n        </button>\n      )}\n\n      {/* Chatbot Modal / Slide-over Panel */}\n      {isOpen && (\n        <div\n          className=\"no-print fixed inset-0 z-50 flex items-end sm:items-center justify-end p-0 sm:p-4 bg-slate-900/50 backdrop-blur-xs\"\n          role=\"dialog\"\n          aria-modal=\"true\"\n          aria-labelledby=\"chatbot-title\"\n        >\n          <div className=\"bg-white w-full sm:max-w-lg h-[90vh] sm:h-[660px] sm:max-h-[90vh] rounded-t-3xl sm:rounded-2xl shadow-2xl border border-slate-200 flex flex-col overflow-hidden ro-sheet-in\">\n            {/* Top Header */}\n            <div className=\"bg-gradient-to-r from-teal-900 via-teal-800 to-slate-900 text-white px-4 py-3.5 flex items-center justify-between gap-2 shrink-0\">\n              <div className=\"flex items-center gap-2.5 min-w-0\">\n                <div className=\"w-9 h-9 rounded-xl bg-teal-500/20 border border-teal-400/30 flex items-center justify-center shrink-0\">\n                  <Bot className=\"w-5 h-5 text-teal-300\" />\n                </div>\n                <div className=\"min-w-0\">\n                  <h2 id=\"chatbot-title\" className=\"text-sm sm:text-base font-bold text-white truncate\">\n                    Asisten Ruang Obat\n                  </h2>\n                  <p className=\"text-[11px] text-teal-200/90 truncate\">\n                    {bookCount > 0\n                      ? `Aktif: Isi Website + ${bookCount} Buku Referensi`\n                      : \'Aktif: Isi Website (Siap tambah .zip buku)\'}\n                  </p>\n                </div>\n              </div>\n\n              <div className=\"flex items-center gap-1 shrink-0\">\n                <button\n                  type=\"button\"\n                  onClick={handleResetChat}\n                  title=\"Mulai percakapan baru\"\n                  aria-label=\"Mulai percakapan baru\"\n                  className=\"min-h-[38px] min-w-[38px] rounded-xl text-teal-100 hover:text-white hover:bg-white/10 flex items-center justify-center transition-colors cursor-pointer\"\n                >\n                  <RotateCcw className=\"w-4 h-4\" />\n                </button>\n                <button\n                  type=\"button\"\n                  onClick={() => setIsOpen(false)}\n                  aria-label=\"Tutup Chatbot\"\n                  className=\"min-h-[38px] min-w-[38px] rounded-xl text-teal-100 hover:text-white hover:bg-white/10 flex items-center justify-center transition-colors cursor-pointer\"\n                >\n                  <X className=\"w-5 h-5\" />\n                </button>\n              </div>\n            </div>\n\n            {/* Sub-bar: Panel Switch (Obrolan vs Sumber Buku .zip) + Speed Mode */}\n            <div className=\"px-3 py-2 bg-slate-50 border-b border-slate-200 flex items-center justify-between gap-2 shrink-0\">\n              <div className=\"flex items-center gap-1 bg-slate-200/70 p-0.5 rounded-xl\">\n                <button\n                  type=\"button\"\n                  onClick={() => setActivePanel(\'chat\')}\n                  className={`px-3 py-1.5 rounded-lg text-xs font-bold flex items-center gap-1.5 transition-all cursor-pointer ${\n                    activePanel === \'chat\'\n                      ? \'bg-white text-teal-900 shadow-2xs\'\n                      : \'text-slate-600 hover:text-slate-900\'\n                  }`}\n                >\n                  <MessageSquareText className=\"w-3.5 h-3.5\" />\n                  <span>Obrolan</span>\n                </button>\n                <button\n                  type=\"button\"\n                  onClick={() => setActivePanel(\'sources\')}\n                  className={`px-3 py-1.5 rounded-lg text-xs font-bold flex items-center gap-1.5 transition-all cursor-pointer ${\n                    activePanel === \'sources\'\n                      ? \'bg-white text-teal-900 shadow-2xs\'\n                      : \'text-slate-600 hover:text-slate-900\'\n                  }`}\n                >\n                  <FileArchive className=\"w-3.5 h-3.5\" />\n                  <span>Sumber Buku</span>\n                  <span className=\"px-1.5 py-0.2 rounded-full text-[10px] bg-teal-100 text-teal-900 font-extrabold\">\n                    {bookCount}\n                  </span>\n                </button>\n              </div>\n\n              {/* Speed toggle (gemini-4-hydrogen vs gemini-3.1-flash-lite) */}\n              {activePanel === \'chat\' && (\n                <button\n                  type=\"button\"\n                  onClick={() => setSpeedMode((prev) => (prev === \'standar\' ? \'cepat\' : \'standar\'))}\n                  title=\"Pilih mode penalaran: Standar (gemini-4-hydrogen) atau Cepat (gemini-3.1-flash-lite)\"\n                  className={`px-2.5 py-1.5 rounded-lg text-[11px] font-bold border flex items-center gap-1 transition-colors cursor-pointer ${\n                    speedMode === \'cepat\'\n                      ? \'bg-amber-50 border-amber-300 text-amber-900\'\n                      : \'bg-white border-slate-200 text-slate-700 hover:border-teal-400\'\n                  }`}\n                >\n                  {speedMode === \'cepat\' ? (\n                    <>\n                      <Zap className=\"w-3 h-3 text-amber-600\" />\n                      <span>Mode Cepat</span>\n                    </>\n                  ) : (\n                    <>\n                      <Sparkles className=\"w-3 h-3 text-teal-700\" />\n                      <span>Mode Lengkap</span>\n                    </>\n                  )}\n                </button>\n              )}\n            </div>\n\n            {/* PANEL 1: CHAT THREAD */}\n            {activePanel === \'chat\' ? (\n              <>\n                <div className=\"flex-1 overflow-y-auto p-4 space-y-4 bg-slate-50/50\">\n                  {messages.map((msg) => {\n                    const isUser = msg.role === \'user\';\n                    return (\n                      <div\n                        key={msg.id}\n                        className={`flex items-start gap-2.5 ${isUser ? \'flex-row-reverse\' : \'\'}`}\n                      >\n                        <div\n                          className={`w-7 h-7 rounded-lg flex items-center justify-center shrink-0 mt-0.5 ${\n                            isUser\n                              ? \'bg-teal-700 text-white\'\n                              : msg.isError\n                              ? \'bg-rose-100 text-rose-700\'\n                              : \'bg-emerald-100 text-emerald-800\'\n                          }`}\n                        >\n                          {isUser ? <User className=\"w-4 h-4\" /> : <Bot className=\"w-4 h-4\" />}\n                        </div>\n\n                        <div className={`max-w-[85%] space-y-1.5 ${isUser ? \'items-end\' : \'items-start\'}`}>\n                          <div\n                            className={`px-3.5 py-2.5 rounded-2xl shadow-2xs ${\n                              isUser\n                                ? \'bg-teal-700 text-white rounded-tr-sm\'\n                                : msg.isError\n                                ? \'bg-rose-50 border border-rose-200 text-rose-900 rounded-tl-sm\'\n                                : \'bg-white border border-slate-200 text-slate-800 rounded-tl-sm\'\n                            }`}\n                          >\n                            {msg.text ? (\n                              isUser ? (\n                                <p className=\"text-xs sm:text-sm leading-relaxed whitespace-pre-wrap\">\n                                  {msg.text}\n                                </p>\n                              ) : (\n                                <FormattedMessageText text={msg.text} />\n                              )\n                            ) : (\n                              <div className=\"flex items-center gap-2 text-xs text-slate-500 py-0.5\">\n                                <Loader2 className=\"w-3.5 h-3.5 animate-spin text-teal-700\" />\n                                <span>Menyusun jawaban dari sumber...</span>\n                              </div>\n                            )}\n                          </div>\n\n                          {/* Cited Sources */}\n                          {msg.sources && msg.sources.length > 0 && (\n                            <div className=\"flex flex-wrap items-center gap-1 pt-0.5\">\n                              {msg.sources.map((src, i) => (\n                                <span\n                                  key={i}\n                                  className={`inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[10px] font-medium border ${\n                                    src.sourceType === \'book\'\n                                      ? \'bg-indigo-50 text-indigo-800 border-indigo-200\'\n                                      : \'bg-teal-50 text-teal-800 border-teal-200/80\'\n                                  }`}\n                                >\n                                  {src.sourceType === \'book\' ? (\n                                    <BookOpen className=\"w-2.5 h-2.5 shrink-0\" />\n                                  ) : (\n                                    <Globe className=\"w-2.5 h-2.5 shrink-0\" />\n                                  )}\n                                  <span className=\"truncate max-w-[190px]\">{src.sectionTitle}</span>\n                                </span>\n                              ))}\n                            </div>\n                          )}\n                        </div>\n                      </div>\n                    );\n                  })}\n\n                  {/* Starter Questions when conversation has only welcome message */}\n                  {messages.length === 1 && !isSending && (\n                    <div className=\"pt-2 space-y-2\">\n                      <span className=\"text-[11px] font-bold uppercase tracking-wide text-slate-500 block\">\n                        Contoh Pertanyaan:\n                      </span>\n                      <div className=\"flex flex-col gap-1.5\">\n                        {starterQuestions.map((q, idx) => (\n                          <button\n                            key={idx}\n                            type=\"button\"\n                            onClick={() => handleSendMessage(q)}\n                            className=\"text-left text-xs px-3 py-2 rounded-xl bg-white border border-slate-200 hover:border-teal-400 hover:bg-teal-50/50 text-slate-700 font-medium transition-colors cursor-pointer\"\n                          >\n                            \"{q}\"\n                          </button>\n                        ))}\n                      </div>\n                    </div>\n                  )}\n\n                  <div ref={messagesEndRef} />\n                </div>\n\n                {/* Chat Input Area */}\n                <div className=\"p-3 bg-white border-t border-slate-200 space-y-2 shrink-0\">\n                  <form\n                    onSubmit={(e) => {\n                      e.preventDefault();\n                      handleSendMessage();\n                    }}\n                    className=\"flex items-end gap-2\"\n                  >\n                    <textarea\n                      ref={inputRef}\n                      rows={1}\n                      value={inputText}\n                      onChange={(e) => setInputText(e.target.value)}\n                      onKeyDown={(e) => {\n                        if (e.key === \'Enter\' && !e.shiftKey) {\n                          e.preventDefault();\n                          handleSendMessage();\n                        }\n                      }}\n                      placeholder=\"Tanya seputar label obat, DAGUSIBU, atau isi buku .zip...\"\n                      aria-label=\"Tulis pertanyaan untuk asisten Ruang Obat\"\n                      disabled={isSending}\n                      className=\"flex-1 min-h-[44px] max-h-28 px-3.5 py-2.5 text-xs sm:text-sm bg-slate-50 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-teal-600 focus:bg-white resize-none\"\n                    />\n                    <button\n                      type=\"submit\"\n                      disabled={isSending || !inputText.trim()}\n                      aria-label=\"Kirim pertanyaan\"\n                      className=\"min-h-[44px] min-w-[44px] px-3.5 rounded-xl bg-teal-700 hover:bg-teal-800 disabled:opacity-40 disabled:cursor-not-allowed text-white flex items-center justify-center transition-colors cursor-pointer shrink-0 shadow-xs\"\n                    >\n                      {isSending ? (\n                        <Loader2 className=\"w-4 h-4 animate-spin\" />\n                      ) : (\n                        <Send className=\"w-4 h-4\" />\n                      )}\n                    </button>\n                  </form>\n                  <p className=\"text-[10px] text-slate-500 text-center leading-snug\">\n                    Edukasi umum berbasis isi Ruang Obat &amp; buku referensi, bukan diagnosis atau saran dosis pribadi.\n                  </p>\n                </div>\n              </>\n            ) : (\n              /* PANEL 2: KNOWLEDGE SOURCES (.ZIP BOOKS & WEBSITE CONTENT) */\n              <div className=\"flex-1 overflow-y-auto p-4 space-y-4 bg-slate-50/50\">\n                {/* Upload .zip card */}\n                <div className=\"p-4 rounded-2xl bg-white border border-slate-200 space-y-3 shadow-2xs\">\n                  <div className=\"flex items-start gap-3\">\n                    <div className=\"w-10 h-10 rounded-xl bg-indigo-50 text-indigo-700 flex items-center justify-center shrink-0\">\n                      <FileArchive className=\"w-5 h-5\" />\n                    </div>\n                    <div className=\"space-y-0.5\">\n                      <h3 className=\"text-sm font-bold text-slate-900\">\n                        Tambahkan Sumber Buku (.zip / .pdf / .txt)\n                      </h3>\n                      <p className=\"text-xs text-slate-600 leading-relaxed\">\n                        Unggah file <code className=\"bg-slate-100 px-1 rounded\">.zip</code> berisi buku/pedoman farmasi (PDF, TXT, atau Markdown) agar chatbot dapat menjawab langsung dari sumber pustaka Anda.\n                      </p>\n                    </div>\n                  </div>\n\n                  <input\n                    ref={fileInputRef}\n                    type=\"file\"\n                    accept=\".zip,.pdf,.txt,.md,.csv,.json,.html,.htm\"\n                    onChange={(e) => handleUploadFiles(e.target.files)}\n                    className=\"hidden\"\n                  />\n\n                  <div className=\"flex flex-wrap items-center gap-2\">\n                    <button\n                      type=\"button\"\n                      disabled={isUploading}\n                      onClick={() => fileInputRef.current?.click()}\n                      className=\"min-h-[42px] px-4 py-2 rounded-xl bg-teal-700 hover:bg-teal-800 disabled:opacity-60 text-white text-xs font-bold flex items-center gap-2 cursor-pointer transition-colors shadow-xs\"\n                    >\n                      {isUploading ? (\n                        <>\n                          <Loader2 className=\"w-4 h-4 animate-spin\" />\n                          <span>Memproses &amp; Mengindeks...</span>\n                        </>\n                      ) : (\n                        <>\n                          <Upload className=\"w-4 h-4\" />\n                          <span>Unggah File .zip / Buku</span>\n                        </>\n                      )}\n                    </button>\n\n                    <button\n                      type=\"button\"\n                      disabled={isLoadingKnowledge}\n                      onClick={handleReloadFolder}\n                      className=\"min-h-[42px] px-3.5 py-2 rounded-xl bg-white border border-slate-300 hover:border-teal-400 text-slate-700 text-xs font-semibold flex items-center gap-1.5 cursor-pointer transition-colors\"\n                    >\n                      <RefreshCw className={`w-3.5 h-3.5 ${isLoadingKnowledge ? \'animate-spin\' : \'\'}`} />\n                      <span>Muat Ulang Folder</span>\n                    </button>\n                  </div>\n\n                  {uploadStatus && (\n                    <div\n                      className={`p-3 rounded-xl text-xs flex items-start gap-2 border ${\n                        uploadStatus.type === \'success\'\n                          ? \'bg-emerald-50 border-emerald-200 text-emerald-900\'\n                          : \'bg-rose-50 border-rose-200 text-rose-900\'\n                      }`}\n                    >\n                      {uploadStatus.type === \'success\' ? (\n                        <CheckCircle2 className=\"w-4 h-4 text-emerald-600 shrink-0 mt-0.5\" />\n                      ) : (\n                        <AlertCircle className=\"w-4 h-4 text-rose-600 shrink-0 mt-0.5\" />\n                      )}\n                      <span>{uploadStatus.message}</span>\n                    </div>\n                  )}\n\n                  <p className=\"text-[11px] text-slate-500\">\n                    Tips: Anda juga dapat menaruh file <code className=\"bg-slate-100 px-1 rounded\">.zip</code> secara langsung ke folder{\' \'}\n                    <code className=\"bg-slate-100 px-1 rounded\">knowledge_books/</code> di proyek lalu tekan <strong>Muat Ulang Folder</strong>.\n                  </p>\n                </div>\n\n                {/* Loaded Books List */}\n                <div className=\"space-y-2\">\n                  <div className=\"flex items-center justify-between\">\n                    <h4 className=\"text-xs font-bold uppercase tracking-wide text-slate-700\">\n                      Buku Referensi Terindeks ({knowledge?.books.length ?? 0})\n                    </h4>\n                    {knowledge && (\n                      <span className=\"text-[11px] text-slate-500 font-mono\">\n                        {knowledge.totalBookChunks} segmen teks\n                      </span>\n                    )}\n                  </div>\n\n                  {!knowledge || knowledge.books.length === 0 ? (\n                    <div className=\"p-5 rounded-2xl bg-white border border-dashed border-slate-300 text-center space-y-1.5\">\n                      <BookOpen className=\"w-6 h-6 text-slate-400 mx-auto\" />\n                      <p className=\"text-xs font-semibold text-slate-700\">\n                        Belum ada arsip buku (.zip) yang ditambahkan\n                      </p>\n                      <p className=\"text-[11px] text-slate-500\">\n                        Saat ini chatbot menggunakan seluruh isi website Ruang Obat sebagai sumber jawaban.\n                      </p>\n                    </div>\n                  ) : (\n                    <div className=\"space-y-2\">\n                      {knowledge.books.map((book) => (\n                        <div\n                          key={book.id}\n                          className=\"p-3.5 rounded-xl bg-white border border-slate-200 space-y-2 shadow-2xs\"\n                        >\n                          <div className=\"flex items-start justify-between gap-2\">\n                            <div className=\"flex items-start gap-2.5 min-w-0\">\n                              <div className=\"w-8 h-8 rounded-lg bg-indigo-50 text-indigo-700 flex items-center justify-center shrink-0 mt-0.5\">\n                                {book.fileType === \'zip\' ? (\n                                  <FileArchive className=\"w-4 h-4\" />\n                                ) : (\n                                  <FileText className=\"w-4 h-4\" />\n                                )}\n                              </div>\n                              <div className=\"min-w-0\">\n                                <div className=\"text-xs sm:text-sm font-bold text-slate-900 truncate\">\n                                  {book.fileName}\n                                </div>\n                                <div className=\"flex flex-wrap items-center gap-1.5 text-[11px] text-slate-500 mt-0.5\">\n                                  <span className=\"px-1.5 py-0.5 rounded bg-slate-100 text-slate-700 font-medium\">\n                                    {book.origin === \'upload\' ? \'Diunggah\' : \'Folder Proyek\'}\n                                  </span>\n                                  <span>{book.innerFiles.length} dokumen</span>\n                                  <span>\342\200\242</span>\n                                  <span>{book.chunkCount} segmen</span>\n                                </div>\n                              </div>\n                            </div>\n\n                            {book.origin === \'upload\' && (\n                              <button\n                                type=\"button\"\n                                onClick={() => handleDeleteBook(book.fileName)}\n                                aria-label={`Hapus ${book.fileName}`}\n                                className=\"p-1.5 rounded-lg text-slate-400 hover:text-rose-600 hover:bg-rose-50 transition-colors cursor-pointer shrink-0\"\n                              >\n                                <Trash2 className=\"w-4 h-4\" />\n                              </button>\n                            )}\n                          </div>\n\n                          {book.innerFiles.length > 0 && (\n                            <div className=\"text-[11px] text-slate-600 bg-slate-50 rounded-lg p-2 border border-slate-100\">\n                              <span className=\"font-semibold text-slate-700\">Isi dokumen: </span>\n                              {book.innerFiles.join(\', \')}\n                            </div>\n                          )}\n                        </div>\n                      ))}\n                    </div>\n                  )}\n                </div>\n\n                {/* Indexed Website Content */}\n                <div className=\"p-4 rounded-2xl bg-white border border-slate-200 space-y-2\">\n                  <div className=\"flex items-center justify-between\">\n                    <div className=\"flex items-center gap-2\">\n                      <Globe className=\"w-4 h-4 text-teal-700\" />\n                      <h4 className=\"text-xs font-bold uppercase tracking-wide text-slate-800\">\n                        Materi Website Ruang Obat (Aktif)\n                      </h4>\n                    </div>\n                    <span className=\"text-[11px] font-mono text-teal-800 font-semibold\">\n                      {knowledge?.websiteChunks ?? 0} segmen\n                    </span>\n                  </div>\n                  <ul className=\"text-xs text-slate-600 space-y-1 list-disc list-inside\">\n                    {(knowledge?.websiteModules ?? []).map((mod, i) => (\n                      <li key={i}>{mod}</li>\n                    ))}\n                  </ul>\n                </div>\n              </div>\n            )}\n          </div>\n        </div>\n      )}\n    </>\n  );\n};\n"
    num_lines: 919
    num_bytes: 37650
    line_range_bytes: 37650
  }
}
