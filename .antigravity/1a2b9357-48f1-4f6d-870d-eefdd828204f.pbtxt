  view_file {
    absolute_path_uri: "file:///src/utils/medicineUtils.ts"
    end_line: 67
    content: "import { MedicineItem, MedicineStatus } from \'../types\';\n\nexport const calculateDaysRemaining = (expiryDateStr: string): number => {\n  const today = new Date();\n  today.setHours(0, 0, 0, 0);\n\n  const [year, month, day] = expiryDateStr.split(\'-\').map(Number);\n  const expiry = new Date(year, month - 1, day);\n  expiry.setHours(0, 0, 0, 0);\n\n  const diffTime = expiry.getTime() - today.getTime();\n  return Math.ceil(diffTime / (1000 * 60 * 60 * 24));\n};\n\nexport const getMedicineStatus = (expiryDateStr: string): MedicineStatus => {\n  const days = calculateDaysRemaining(expiryDateStr);\n  if (days < 0) return \'kedaluwarsa\';\n  if (days <= 30) return \'segera\';\n  return \'aman\';\n};\n\nexport const formatIndonesianDate = (dateStr: string): string => {\n  if (!dateStr) return \'-\';\n  try {\n    const [year, month, day] = dateStr.split(\'-\');\n    const months = [\n      \'Januari\', \'Februari\', \'Maret\', \'April\', \'Mei\', \'Juni\',\n      \'Juli\', \'Agustus\', \'September\', \'Oktober\', \'November\', \'Desember\'\n    ];\n    const monthName = months[parseInt(month, 10) - 1] || month;\n    return `${parseInt(day, 10)} ${monthName} ${year}`;\n  } catch {\n    return dateStr;\n  }\n};\n\nexport const getStatusMeta = (status: MedicineStatus, daysRemaining: number) => {\n  switch (status) {\n    case \'kedaluwarsa\':\n      return {\n        label: \'Kedaluwarsa\',\n        badgeBg: \'bg-rose-50 text-rose-800 border-rose-200\',\n        detailText: daysRemaining === -1 ? \'Kedaluwarsa 1 hari lalu\' : `Kedaluwarsa ${Math.abs(daysRemaining)} hari lalu`,\n        cardBorder: \'border-rose-200 hover:border-rose-300\',\n        iconName: \'AlertOctagon\' as const\n      };\n    case \'segera\':\n      return {\n        label: \'Segera Kedaluwarsa\',\n        badgeBg: \'bg-amber-50 text-amber-800 border-amber-200\',\n        detailText: daysRemaining === 0 ? \'Kedaluwarsa hari ini!\' : `Tersisa ${daysRemaining} hari lagi`,\n        cardBorder: \'border-amber-200 hover:border-amber-300\',\n        iconName: \'AlertTriangle\' as const\n      };\n    case \'aman\':\n    default:\n      return {\n        label: \'Aman\',\n        badgeBg: \'bg-emerald-50 text-emerald-800 border-emerald-200\',\n        detailText: daysRemaining > 365 \n          ? `Masa simpan > 1 tahun (${Math.floor(daysRemaining / 30)} bulan)` \n          : `Tersisa ${daysRemaining} hari`,\n        cardBorder: \'border-slate-200 hover:border-teal-200\',\n        iconName: \'CheckCircle2\' as const\n      };\n  }\n};\n"
    num_lines: 68
    num_bytes: 2401
    line_range_bytes: 2401
  }
}
