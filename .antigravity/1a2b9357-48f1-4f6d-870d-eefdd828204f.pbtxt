  view_file {
    absolute_path_uri: "file:///src/views/BerandaView.tsx"
    end_line: 469
    content: "import React, { useState, useEffect, useRef } from \'react\';\nimport { TabType, MedicineItem } from \'../types\';\nimport { calculateDaysRemaining } from \'../utils/medicineUtils\';\nimport { \n  ScanSearch, \n  Archive, \n  AlertTriangle, \n  ChevronRight, \n  BookA, \n  Layers, \n  Sparkles,\n  HelpCircle,\n  Share2,\n  FileDown,\n  FileText,\n  Compass\n} from \'lucide-react\';\nimport { generateAndDownloadPdf } from \'../utils/generatePdfClient\';\nimport { RingkasanStokObatChart } from \'../components/RingkasanStokObatChart\';\nimport {\n  BerandaWalkthrough,\n  FeatureTooltip,\n  WALKTHROUGH_STEPS,\n  WalkthroughStep,\n} from \'../components/BerandaWalkthrough\';\n\nconst WALKTHROUGH_STORAGE_KEY = \'ruang_obat_walkthrough_done_v1\';\n\ninterface BerandaViewProps {\n  onNavigate: (tab: TabType) => void;\n  onNavigateLemariWithFilter?: (filter: \'segera\' | \'kedaluwarsa\' | \'semua\') => void;\n  onNavigateLatihan?: (subTab: \'skenario\' | \'flashcard\' | \'kuis\') => void;\n  medicines: MedicineItem[];\n  onOpenKamus: () => void;\n  onOpenTinjau?: () => void;\n}\n\nexport const BerandaView: React.FC<BerandaViewProps> = ({\n  onNavigate,\n  onNavigateLemariWithFilter,\n  onNavigateLatihan,\n  medicines,\n  onOpenKamus,\n  onOpenTinjau,\n}) => {\n  const [isWalkthroughOpen, setIsWalkthroughOpen] = useState<boolean>(() => {\n    try {\n      return localStorage.getItem(WALKTHROUGH_STORAGE_KEY) !== \'true\';\n    } catch {\n      return true;\n    }\n  });\n  const [walkthroughStepIndex, setWalkthroughStepIndex] = useState(0);\n\n  const cekLabelRef = useRef<HTMLDivElement>(null);\n  const lemariStokRef = useRef<HTMLDivElement>(null);\n  const latihanRef = useRef<HTMLDivElement>(null);\n  const belajarCepatRef = useRef<HTMLDivElement>(null);\n\n  const activeStepId = isWalkthroughOpen\n    ? WALKTHROUGH_STEPS[walkthroughStepIndex]?.id\n    : null;\n\n  const scrollToStepTarget = (stepId: WalkthroughStep[\'id\']) => {\n    const refMap: Record<WalkthroughStep[\'id\'], React.RefObject<HTMLDivElement | null>> = {\n      \'cek-label\': cekLabelRef,\n      \'lemari-stok\': lemariStokRef,\n      \'latihan\': latihanRef,\n      \'belajar-cepat\': belajarCepatRef,\n    };\n    const target = refMap[stepId]?.current;\n    if (target) {\n      target.scrollIntoView({ behavior: \'smooth\', block: \'center\' });\n    }\n  };\n\n  useEffect(() => {\n    if (!isWalkthroughOpen) return;\n    // Only auto-scroll after user advances past step 0 or explicitly changes step\n    if (walkthroughStepIndex > 0) {\n      scrollToStepTarget(WALKTHROUGH_STEPS[walkthroughStepIndex].id);\n    }\n  }, [walkthroughStepIndex, isWalkthroughOpen]);\n\n  const handleCloseWalkthrough = () => {\n    setIsWalkthroughOpen(false);\n    try {\n      localStorage.setItem(WALKTHROUGH_STORAGE_KEY, \'true\');\n    } catch {\n      // ignore storage errors\n    }\n  };\n\n  const handleOpenWalkthrough = () => {\n    setWalkthroughStepIndex(0);\n    setIsWalkthroughOpen(true);\n  };\n\n  const handleJumpToFeature = (stepId: WalkthroughStep[\'id\']) => {\n    handleCloseWalkthrough();\n    if (stepId === \'cek-label\') {\n      onNavigate(\'cek-label\');\n    } else if (stepId === \'lemari-stok\') {\n      onNavigate(\'lemari\');\n    } else if (stepId === \'latihan\') {\n      if (onNavigateLatihan) {\n        onNavigateLatihan(\'skenario\');\n      } else {\n        onNavigate(\'latihan\');\n      }\n    } else if (stepId === \'belajar-cepat\') {\n      onOpenKamus();\n    }\n  };\n\n  // Calculate expiring & expired items\n  const expiringOrExpired = medicines.filter((m) => {\n    const days = calculateDaysRemaining(m.expiryDate);\n    return days <= 30; // <= 30 days remaining or already expired (<0)\n  });\n\n  const warningCount = expiringOrExpired.length;\n\n  return (\n    <div className=\"space-y-6 pb-12 animate-in fade-in duration-150\">\n      {/* Hero / Greeting */}\n      <div className=\"text-center md:text-left space-y-2 pt-2\">\n        <div className=\"flex flex-wrap items-center justify-center md:justify-between gap-2\">\n          <div className=\"inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-teal-50 border border-teal-200/80 text-teal-800 text-xs font-semibold\">\n            <Sparkles className=\"w-3.5 h-3.5 text-teal-600\" />\n            <span>Media Edukasi Farmasi Klinis & Komunitas</span>\n          </div>\n\n          <button\n            type=\"button\"\n            onClick={isWalkthroughOpen ? handleCloseWalkthrough : handleOpenWalkthrough}\n            className=\"inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white border border-slate-200 hover:border-teal-400 text-slate-700 hover:text-teal-800 text-xs font-semibold shadow-2xs transition-colors cursor-pointer\"\n          >\n            <Compass className=\"w-3.5 h-3.5 text-teal-700\" />\n            <span>{isWalkthroughOpen ? \'Tutup Panduan\' : \'Panduan Fitur\'}</span>\n          </button>\n        </div>\n\n        <h1 className=\"text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight text-balance\">\n          Kenali label obatmu, kelola obat di rumahmu\n        </h1>\n        <p className=\"text-slate-600 text-sm sm:text-base max-w-2xl leading-relaxed\">\n          Pelajari simbol resmi, aturan pakai, dan masa simpan obat secara mandiri dan aman untuk melindungi keluarga di rumah.\n        </p>\n      </div>\n\n      {/* Interactive New-User Walkthrough */}\n      <BerandaWalkthrough\n        isActive={isWalkthroughOpen}\n        currentStepIndex={walkthroughStepIndex}\n        onNext={() =>\n          setWalkthroughStepIndex((prev) =>\n            Math.min(prev + 1, WALKTHROUGH_STEPS.length - 1)\n          )\n        }\n        onPrev={() => setWalkthroughStepIndex((prev) => Math.max(prev - 1, 0))}\n        onSelectStep={(idx) => {\n          setWalkthroughStepIndex(idx);\n          scrollToStepTarget(WALKTHROUGH_STEPS[idx].id);\n        }}\n        onClose={handleCloseWalkthrough}\n        onJumpToFeature={handleJumpToFeature}\n      />\n\n      {/* Warning Banner: Hanya muncul bila ada data obat <= 30 hari atau sudah kedaluwarsa */}\n      {warningCount > 0 && (\n        <button\n          type=\"button\"\n          onClick={() => {\n            if (onNavigateLemariWithFilter) {\n              onNavigateLemariWithFilter(\'segera\');\n            } else {\n              onNavigate(\'lemari\');\n            }\n          }}\n          className=\"w-full p-4 rounded-2xl bg-amber-50 border border-amber-300/80 shadow-xs flex items-center justify-between gap-3 text-left transition-all hover:bg-amber-100/70 cursor-pointer group\"\n          aria-label={`Peringatan: ada ${warningCount} obat yang hampir atau telah kedaluwarsa. Ketuk untuk membuka lemari obat.`}\n        >\n          <div className=\"flex items-center gap-3\">\n            <div className=\"w-10 h-10 rounded-xl bg-amber-200 text-amber-900 flex items-center justify-center shrink-0\">\n              <AlertTriangle className=\"w-5 h-5 text-amber-800\" />\n            </div>\n            <div>\n              <div className=\"flex items-center gap-2\">\n                <span className=\"font-bold text-slate-900 text-sm sm:text-base\">\n                  Perhatian: Obat Mendekati / Lewat Kedaluwarsa\n                </span>\n                <span className=\"bg-amber-500 text-white font-extrabold text-xs px-2 py-0.5 rounded-full\">\n                  {warningCount}\n                </span>\n              </div>\n              <p className=\"text-xs sm:text-sm text-slate-700 mt-0.5\">\n                Ada {warningCount} obat di lemarimu yang perlu segera dicek dan dipisahkan.\n              </p>\n            </div>\n          </div>\n          <div className=\"flex items-center text-amber-800 font-semibold text-xs sm:text-sm shrink-0 group-hover:translate-x-1 transition-transform\">\n            <span className=\"hidden sm:inline mr-1\">Buka Lemari</span>\n            <ChevronRight className=\"w-5 h-5\" />\n          </div>\n        </button>\n      )}\n\n      {/* 2 Kartu Aksi Utama */}\n      <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n        {/* Card 1: Cek Label */}\n        <div\n          ref={cekLabelRef}\n          className={`relative rounded-2xl transition-all ${\n            activeStepId === \'cek-label\'\n              ? \'ring-2 ring-teal-600 ring-offset-2 ring-offset-slate-50 shadow-md\'\n              : \'\'\n          }`}\n        >\n          <button\n            type=\"button\"\n            onClick={() => onNavigate(\'cek-label\')}\n            className=\"w-full h-full p-5 rounded-2xl bg-white border border-slate-200 hover:border-teal-400 hover:shadow-md transition-all text-left flex flex-col justify-between group cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-teal-600\"\n          >\n            <div className=\"space-y-3\">\n              <div className=\"w-12 h-12 rounded-xl bg-teal-50 text-teal-700 flex items-center justify-center group-hover:bg-teal-700 group-hover:text-white transition-colors\">\n                <ScanSearch className=\"w-6 h-6\" />\n              </div>\n              <div>\n                <h2 className=\"text-lg font-bold text-slate-900 group-hover:text-teal-800 transition-colors\">\n                  Cek Label Obat\n                </h2>\n                <p className=\"text-slate-600 text-xs sm:text-sm mt-1 leading-relaxed\">\n                  Simulasi interaktif kemasan obat (Tablet, Sirup, Salep). Ketuk 6 titik penting untuk memahami logo, aturan pakai, hingga nomor izin edar.\n                </p>\n              </div>\n            </div>\n            <div className=\"pt-4 flex items-center text-teal-800 font-semibold text-xs sm:text-sm\">\n              <span>Mulai Simulasi Kemasan</span>\n              <ChevronRight className=\"w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform\" />\n            </div>\n          </button>\n          <div className=\"absolute top-4 right-4 z-10\">\n            <FeatureTooltip\n              title=\"Cek Label Obat (6 Titik)\"\n              content=\"Ketuk nomor 1\342\200\2236 pada kemasan Tablet, Sirup, atau Salep untuk memahami arti logo golongan, dosis zat aktif, batas kedaluwarsa (ED/BUD), dan nomor NIE BPOM.\"\n            />\n          </div>\n        </div>\n\n        {/* Card 2: Lemari Obat */}\n        <div className=\"relative rounded-2xl\">\n          <button\n            type=\"button\"\n            onClick={() => onNavigate(\'lemari\')}\n            className=\"w-full h-full p-5 rounded-2xl bg-white border border-slate-200 hover:border-teal-400 hover:shadow-md transition-all text-left flex flex-col justify-between group cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-teal-600\"\n          >\n            <div className=\"space-y-3\">\n              <div className=\"w-12 h-12 rounded-xl bg-emerald-50 text-emerald-700 flex items-center justify-center group-hover:bg-emerald-700 group-hover:text-white transition-colors\">\n                <Archive className=\"w-6 h-6\" />\n              </div>\n              <div>\n                <div className=\"flex items-center justify-between gap-2\">\n                  <h2 className=\"text-lg font-bold text-slate-900 group-hover:text-teal-800 transition-colors\">\n                    Lemari Obat Saya\n                  </h2>\n                  <span className=\"text-xs font-semibold px-2 py-0.5 rounded-full bg-slate-100 text-slate-600 shrink-0\">\n                    {medicines.length} Obat\n                  </span>\n                </div>\n                <p className=\"text-slate-600 text-xs sm:text-sm mt-1 leading-relaxed\">\n                  Catat dan pantau tanggal kedaluwarsa obat di rumah secara otomatis (Aman, Segera Kedaluwarsa, Kedaluwarsa). Data tersimpan aman di perangkatmu.\n                </p>\n              </div>\n            </div>\n            <div className=\"pt-4 flex items-center text-teal-800 font-semibold text-xs sm:text-sm\">\n              <span>Buka Lemari Obat</span>\n              <ChevronRight className=\"w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform\" />\n            </div>\n          </button>\n          <div className=\"absolute top-4 right-4 z-10\">\n            <FeatureTooltip\n              title=\"Lemari Obat Saya (Lokal)\"\n              content=\"Data persediaan obat Anda hanya tersimpan di memori perangkat ini (localStorage) tanpa dikirim ke server. Tersedia pula panduan cara memusnahkan obat kedaluwarsa.\"\n            />\n          </div>\n        </div>\n      </div>\n\n      {/* Visualisasi Stok Obat Berdasarkan Kategori (Recharts) */}\n      <div\n        ref={lemariStokRef}\n        className={`rounded-2xl transition-all ${\n          activeStepId === \'lemari-stok\'\n            ? \'ring-2 ring-teal-600 ring-offset-2 ring-offset-slate-50 shadow-md\'\n            : \'\'\n        }`}\n      >\n        <RingkasanStokObatChart\n          medicines={medicines}\n          onNavigateLemariWithFilter={onNavigateLemariWithFilter}\n          onNavigateToLemari={() => onNavigate(\'lemari\')}\n        />\n      </div>\n\n      {/* Kartu: Skenario Hari Ini */}\n      <div\n        ref={latihanRef}\n        className={`p-5 rounded-2xl bg-gradient-to-br from-slate-900 to-teal-950 text-white shadow-md space-y-4 transition-all ${\n          activeStepId === \'latihan\'\n            ? \'ring-2 ring-teal-500 ring-offset-2 ring-offset-slate-50\'\n            : \'\'\n        }`}\n      >\n        <div className=\"flex items-center justify-between\">\n          <div className=\"flex items-center gap-2\">\n            <span className=\"w-2 h-2 rounded-full bg-teal-400\" />\n            <span className=\"text-xs font-bold uppercase tracking-wider text-teal-300\">\n              Skenario Swamedikasi Hari Ini\n            </span>\n          </div>\n          <span className=\"text-xs text-slate-400\">Kasus Nyata</span>\n        </div>\n\n        <div className=\"space-y-2\">\n          <h3 className=\"text-base sm:text-lg font-bold text-white leading-snug\">\n            \"Demam, ada sisa antibiotik teman...\"\n          </h3>\n          <p className=\"text-xs sm:text-sm text-slate-300 leading-relaxed\">\n            Teman sekamarmu memiliki sisa kapsul antibiotik dari resep dokter bulan lalu dan menawarinya kepadamu karena kamu sedang demam tinggi. Bolehkah kamu meminumnya?\n          </p>\n        </div>\n\n        <div className=\"pt-2 flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-t border-slate-700/80\">\n          <div className=\"flex items-center gap-1.5 text-xs text-teal-300\">\n            <HelpCircle className=\"w-4 h-4 shrink-0\" />\n            <span>Kapan saat tepat bertanya ke apoteker?</span>\n          </div>\n          <button\n            type=\"button\"\n            onClick={() => {\n              if (onNavigateLatihan) {\n                onNavigateLatihan(\'skenario\');\n              } else {\n                onNavigate(\'latihan\');\n              }\n            }}\n            className=\"min-h-[44px] px-4 py-2 rounded-xl bg-teal-600 hover:bg-teal-500 text-white font-semibold text-xs sm:text-sm flex items-center justify-center gap-1.5 transition-colors cursor-pointer\"\n          >\n            <span>Uji Pilihanmu di Latihan</span>\n            <ChevronRight className=\"w-4 h-4\" />\n          </button>\n        </div>\n      </div>\n\n      {/* Belajar Cepat: Tautan Cepat ke Kamus & Flashcard */}\n      <div\n        ref={belajarCepatRef}\n        className={`space-y-3 rounded-2xl transition-all ${\n          activeStepId === \'belajar-cepat\'\n            ? \'p-3 -m-3 ring-2 ring-teal-600 bg-teal-50/30\'\n            : \'\'\n        }`}\n      >\n        <div className=\"flex items-center justify-between gap-2\">\n          <h3 className=\"text-sm font-bold text-slate-900 uppercase tracking-wide\">\n            Belajar Cepat\n          </h3>\n          <FeatureTooltip\n            title=\"Akses Cepat Belajar\"\n            content=\"Buka Kamus Label Obat untuk mencari istilah medis resmi, atau gunakan Flashcard 3D untuk mengulang hafalan simbol dan aturan Dagusibu.\"\n          />\n        </div>\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n          <button\n            type=\"button\"\n            onClick={onOpenKamus}\n            className=\"p-4 rounded-xl bg-white border border-slate-200 hover:border-teal-400 flex items-center gap-3 text-left transition-all cursor-pointer group\"\n          >\n            <div className=\"w-10 h-10 rounded-lg bg-teal-50 text-teal-700 flex items-center justify-center group-hover:scale-105 transition-transform\">\n              <BookA className=\"w-5 h-5\" />\n            </div>\n            <div>\n              <h4 className=\"text-sm font-bold text-slate-900 group-hover:text-teal-800\">\n                Kamus Label Obat\n              </h4>\n              <p className=\"text-xs text-slate-500\">\n                Pahami istilah NIE, BUD, Exp. Date, dan arti logo kemasan\n              </p>\n            </div>\n          </button>\n\n          <button\n            type=\"button\"\n            onClick={() => {\n              if (onNavigateLatihan) {\n                onNavigateLatihan(\'flashcard\');\n              } else {\n                onNavigate(\'latihan\');\n              }\n            }}\n            className=\"p-4 rounded-xl bg-white border border-slate-200 hover:border-teal-400 flex items-center gap-3 text-left transition-all cursor-pointer group\"\n          >\n            <div className=\"w-10 h-10 rounded-lg bg-indigo-50 text-indigo-700 flex items-center justify-center group-hover:scale-105 transition-transform\">\n              <Layers className=\"w-5 h-5\" />\n            </div>\n            <div>\n              <h4 className=\"text-sm font-bold text-slate-900 group-hover:text-indigo-800\">\n                Flashcard Cepat\n              </h4>\n              <p className=\"text-xs text-slate-500\">\n                Latih daya ingat simbol obat dan peringatan khusus\n              </p>\n            </div>\n          </button>\n        </div>\n      </div>\n\n      {/* Card: Khusus Dosen & Claude AI Reviewer */}\n      {onOpenTinjau && (\n        <div className=\"p-4 sm:p-5 rounded-2xl bg-slate-900 text-white shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4\">\n          <div className=\"flex items-start gap-3\">\n            <div className=\"w-11 h-11 rounded-xl bg-teal-800 text-white flex items-center justify-center shrink-0 mt-0.5\">\n              <FileText className=\"w-6 h-6 text-teal-300\" />\n            </div>\n            <div className=\"space-y-0.5\">\n              <div className=\"flex items-center gap-2\">\n                <span className=\"text-xs font-bold text-teal-300 uppercase tracking-wide\">\n                  Berkas Skripsi\n                </span>\n                <span className=\"text-[10px] bg-slate-800 text-slate-300 px-2 py-0.5 rounded-full border border-slate-700\">\n                  Format PDF Resmi A4\n                </span>\n              </div>\n              <h3 className=\"text-sm sm:text-base font-bold text-white\">\n                Dokumen PDF Prototipe untuk Dosen & Claude AI\n              </h3>\n              <p className=\"text-xs text-slate-300 max-w-xl leading-relaxed\">\n                Tersedia file PDF siap pakai (5 halaman) berisi identitas skripsi, tabel 6 titik kemasan, batasan etika farmasi, lembar penilaian dosen, dan prompt Claude AI.\n              </p>\n            </div>\n          </div>\n\n          <div className=\"flex items-center gap-2 shrink-0\">\n            <button\n              type=\"button\"\n              onClick={() => {\n                generateAndDownloadPdf();\n              }}\n              className=\"min-h-[44px] px-3.5 py-2 rounded-xl bg-teal-600 hover:bg-teal-500 text-white font-bold text-xs sm:text-sm flex items-center justify-center gap-1.5 transition-all cursor-pointer shadow-xs\"\n            >\n              <FileDown className=\"w-4 h-4\" />\n              <span>Unduh PDF</span>\n            </button>\n\n            <button\n              type=\"button\"\n              onClick={onOpenTinjau}\n              className=\"min-h-[44px] px-3.5 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-200 font-semibold text-xs sm:text-sm flex items-center justify-center gap-1.5 transition-all cursor-pointer\"\n            >\n              <Share2 className=\"w-4 h-4 text-teal-400\" />\n              <span>Buka Dokumen</span>\n            </button>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n"
