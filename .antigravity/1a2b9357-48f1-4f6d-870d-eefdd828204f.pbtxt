    tool_calls {
      id: "call_5320764427504824654"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState } from \'react\';\\nimport { MedicineItem } from \'../types\';\\nimport { getMedicineStatus } from \'../utils/medicineUtils\';\\nimport {\\n  PieChart,\\n  Pie,\\n  Cell,\\n  ResponsiveContainer,\\n  Tooltip,\\n  BarChart,\\n  Bar,\\n  XAxis,\\n  YAxis,\\n  CartesianGrid,\\n} from \'recharts\';\\nimport {\\n  CheckCircle2,\\n  AlertTriangle,\\n  AlertOctagon,\\n  BarChart3,\\n  PieChart as PieIcon,\\n  ChevronRight,\\n  PlusCircle,\\n  Archive,\\n} from \'lucide-react\';\\n\\ninterface RingkasanStokObatChartProps {\\n  medicines: MedicineItem[];\\n  onNavigateLemariWithFilter?: (filter: \'segera\' | \'kedaluwarsa\' | \'semua\') => void;\\n  onNavigateToLemari: () => void;\\n}\\n\\nexport const RingkasanStokObatChart: React.FC<RingkasanStokObatChartProps> = ({\\n  medicines,\\n  onNavigateLemariWithFilter,\\n  onNavigateToLemari,\\n}) => {\\n  const [chartType, setChartType] = useState<\'donut\' | \'bar\'>(\'donut\');\\n\\n  let amanCount = 0;\\n  let segeraCount = 0;\\n  let kedaluwarsaCount = 0;\\n\\n  medicines.forEach((med) => {\\n    const status = getMedicineStatus(med.expiryDate);\\n    if (status === \'kedaluwarsa\') kedaluwarsaCount++;\\n    else if (status === \'segera\') segeraCount++;\\n    else amanCount++;\\n  });\\n\\n  const totalCount = medicines.length;\\n\\n  const data = [\\n    {\\n      name: \'Aman\',\\n      key: \'aman\' as const,\\n      value: amanCount,\\n      color: \'#275E45\',\\n      lightBg: \'bg-status-aman-bg/65 hover:bg-status-aman-bg\',\\n      border: \'border-status-aman-text/20\',\\n      text: \'text-status-aman-text\',\\n      icon: CheckCircle2,\\n      desc: \'Masa simpan > 30 hari\',\\n    },\\n    {\\n      name: \'Segera Kedaluwarsa\',\\n      key: \'segera\' as const,\\n      value: segeraCount,\\n      color: \'#B86E18\',\\n      lightBg: \'bg-status-segera-bg/65 hover:bg-status-segera-bg\',\\n      border: \'border-status-segera-text/20\',\\n      text: \'text-status-segera-text\',\\n      icon: AlertTriangle,\\n      desc: \'Kritis (<= 30 hari)\',\\n    },\\n    {\\n      name: \'Kedaluwarsa\',\\n      key: \'kedaluwarsa\' as const,\\n      value: kedaluwarsaCount,\\n      color: \'#A33838\',\\n      lightBg: \'bg-status-kedaluwarsa-bg/65 hover:bg-status-kedaluwarsa-bg\',\\n      border: \'border-status-kedaluwarsa-text/20\',\\n      text: \'text-status-kedaluwarsa-text\',\\n      icon: AlertOctagon,\\n      desc: \'Lewat batas aman\',\\n    },\\n  ];\\n\\n  const handleCategoryClick = (categoryKey?: string) => {\\n    if (!categoryKey) return;\\n    if (onNavigateLemariWithFilter) {\\n      if (categoryKey === \'segera\' || categoryKey === \'kedaluwarsa\') {\\n        onNavigateLemariWithFilter(categoryKey);\\n      } else {\\n        onNavigateLemariWithFilter(\'semua\');\\n      }\\n    } else {\\n      onNavigateToLemari();\\n    }\\n  };\\n\\n  if (totalCount === 0) {\\n    return (\\n      <div className=\\\"h-full p-6 sm:p-7 rounded-2xl bg-surface border border-line flex flex-col items-center justify-center space-y-3.5 text-center\\\">\\n        <div className=\\\"w-12 h-12 rounded-xl bg-surface-muted text-brand flex items-center justify-center\\\">\\n          <Archive className=\\\"w-6 h-6\\\" />\\n        </div>\\n        <div>\\n          <h3 className=\\\"font-display text-lg font-semibold text-forest\\\">\\n            Lemari Obat Masih Kosong\\n          </h3>\\n          <p className=\\\"text-xs sm:text-sm text-ink-muted mt-1 max-w-sm\\\">\\n            Tambahkan persediaan obat rumah tangga Anda untuk memantau status kedaluwarsa secara visual.\\n          </p>\\n        </div>\\n        <button\\n          type=\\\"button\\\"\\n          onClick={onNavigateToLemari}\\n          className=\\\"min-h-[44px] inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-forest hover:bg-brand text-on-brand text-xs sm:text-sm font-semibold cursor-pointer transition-colors\\\"\\n        >\\n          <PlusCircle className=\\\"w-4 h-4 text-sand\\\" />\\n          <span>Kelola Lemari Obat</span>\\n        </button>\\n      </div>\\n    );\\n  }\\n\\n  return (\\n    <div className=\\\"h-full p-6 sm:p-7 rounded-2xl bg-surface border border-line flex flex-col justify-between space-y-5\\\">\\n      {/* Header & Chart Type Toggle */}\\n      <div className=\\\"flex flex-col sm:flex-row sm:items-center justify-between gap-3\\\">\\n        <div className=\\\"space-y-0.5\\\">\\n          <div className=\\\"flex flex-wrap items-center gap-2 text-xs\\\">\\n            <span className=\\\"font-semibold uppercase tracking-[0.1em] text-brand\\\">\\n              Visualisasi Stok\\n            </span>\\n            <span className=\\\"text-line-strong/60\\\" aria-hidden=\\\"true\\\">\302\267</span>\\n            <span className=\\\"font-mono tabular-nums text-ink-muted font-medium\\\">\\n              Total {totalCount} Obat\\n            </span>\\n          </div>\\n          <h2 className=\\\"font-display text-lg sm:text-xl font-semibold text-forest\\\">\\n            Ringkasan Status Masa Simpan\\n          </h2>\\n        </div>\\n\\n        {/* Interactive Chart Type Toggle */}\\n        <div className=\\\"flex items-center gap-1 p-1 bg-surface-muted rounded-xl border border-line self-start sm:self-auto\\\">\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => setChartType(\'donut\')}\\n            className={`min-h-[36px] px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition-all cursor-pointer ${\\n              chartType === \'donut\'\\n                ? \'bg-surface text-forest shadow-xs\'\\n                : \'text-ink-muted hover:text-ink\'\\n            }`}\\n            title=\\\"Tampilkan Diagram Lingkaran\\\"\\n          >\\n            <PieIcon className=\\\"w-3.5 h-3.5\\\" />\\n            <span>Lingkaran</span>\\n          </button>\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => setChartType(\'bar\')}\\n            className={`min-h-[36px] px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition-all cursor-pointer ${\\n              chartType === \'bar\'\\n                ? \'bg-surface text-forest shadow-xs\'\\n                : \'text-ink-muted hover:text-ink\'\\n            }`}\\n            title=\\\"Tampilkan Diagram Batang\\\"\\n          >\\n            <BarChart3 className=\\\"w-3.5 h-3.5\\\" />\\n            <span>Batang</span>\\n          </button>\\n        </div>\\n      </div>\\n\\n      {/* Main Content: Chart + Interactive Stat Cards */}\\n      <div className=\\\"grid grid-cols-1 sm:grid-cols-12 gap-5 items-center\\\">\\n        {/* Chart Canvas Area */}\\n        <div className=\\\"sm:col-span-5 h-[200px] w-full flex items-center justify-center relative\\\">\\n          {chartType === \'donut\' ? (\\n            <>\\n              <ResponsiveContainer width=\\\"100%\\\" height={200}>\\n                <PieChart>\\n                  <Tooltip\\n                    content={({ active, payload }) => {\\n                      if (active && payload && payload.length) {\\n                        const item = payload[0].payload;\\n                        const pct = Math.round((item.value / totalCount) * 100);\\n                        return (\\n                          <div className=\\\"p-3 bg-forest text-white text-xs rounded-xl shadow-lg border border-white/10 space-y-1\\\">\\n                            <div className=\\\"font-bold flex items-center gap-1.5\\\">\\n                              <span\\n                                className=\\\"w-2.5 h-2.5 rounded-full\\\"\\n                                style={{ backgroundColor: item.color }}\\n                              />\\n                              <span>{item.name}</span>\\n                            </div>\\n                            <div className=\\\"text-secondary tabular-nums\\\">\\n                              Jumlah: <strong>{item.value} obat</strong> ({pct}%)\\n                            </div>\\n                            <div className=\\\"text-[11px] text-sand\\\">\\n                              Ketuk untuk buka lemari\\n                            </div>\\n                          </div>\\n                        );\\n                      }\\n                      return null;\\n                    }}\\n                  />\\n                  <Pie\\n                    data={data}\\n                    cx=\\\"50%\\\"\\n                    cy=\\\"50%\\\"\\n                    innerRadius={52}\\n                    outerRadius={80}\\n                    paddingAngle={4}\\n                    dataKey=\\\"value\\\"\\n                    onClick={(entry: { key?: string; payload?: { key?: string } }) =>\\n                      handleCategoryClick(entry?.key || entry?.payload?.key)\\n                    }\\n                    cursor=\\\"pointer\\\"\\n                  >\\n                    {data.map((entry, index) => (\\n                      <Cell\\n                        key={`cell-${index}`}\\n                        fill={entry.color}\\n                        stroke=\\\"#FFFFFF\\\"\\n                        strokeWidth={2}\\n                      />\\n                    ))}\\n                  </Pie>\\n                </PieChart>\\n              </ResponsiveContainer>\\n              <div className=\\\"absolute inset-0 flex flex-col items-center justify-center pointer-events-none\\\">\\n                <span className=\\\"font-display text-2xl font-bold text-forest tabular-nums leading-none\\\">\\n                  {totalCount}\\n                </span>\\n                <span className=\\\"text-[11px] uppercase font-semibold text-ink-muted tracking-wider mt-1\\\">\\n                  Obat\\n                </span>\\n              </div>\\n            </>\\n          ) : (\\n            <ResponsiveContainer width=\\\"100%\\\" height={200}>\\n              <BarChart\\n                data={data}\\n                margin={{ top: 15, right: 10, left: -20, bottom: 5 }}\\n              >\\n                <CartesianGrid strokeDasharray=\\\"3 3\\\" vertical={false} stroke=\\\"#E2E4DC\\\" />\\n                <XAxis\\n                  dataKey=\\\"name\\\"\\n                  tick={{ fontSize: 10, fill: \'#53645E\' }}\\n                  interval={0}\\n                  tickLine={false}\\n                  axisLine={{ stroke: \'#D4D8CE\' }}\\n                />\\n                <YAxis\\n                  allowDecimals={false}\\n                  tick={{ fontSize: 10, fill: \'#53645E\' }}\\n                  tickLine={false}\\n                  axisLine={{ stroke: \'#D4D8CE\' }}\\n                />\\n                <Tooltip\\n                  content={({ active, payload }) => {\\n                    if (active && payload && payload.length) {\\n                      const item = payload[0].payload;\\n                      const pct = Math.round((item.value / totalCount) * 100);\\n                      return (\\n                        <div className=\\\"p-3 bg-forest text-white text-xs rounded-xl shadow-lg border border-white/10 space-y-1\\\">\\n                          <div className=\\\"font-bold flex items-center gap-1.5\\\">\\n                            <span\\n                              className=\\\"w-2.5 h-2.5 rounded-full\\\"\\n                              style={{ backgroundColor: item.color }}\\n                            />\\n                            <span>{item.name}</span>\\n                          </div>\\n                          <div className=\\\"text-secondary tabular-nums\\\">\\n                            Jumlah: <strong>{item.value} obat</strong> ({pct}%)\\n                          </div>\\n                        </div>\\n                      );\\n                    }\\n                    return null;\\n                  }}\\n                />\\n                <Bar\\n                  dataKey=\\\"value\\\"\\n                  radius={[8, 8, 0, 0]}\\n                  onClick={(entry: { key?: string; payload?: { key?: string } }) =>\\n                    handleCategoryClick(entry?.key || entry?.payload?.key)\\n                  }\\n                  cursor=\\\"pointer\\\"\\n                >\\n                  {data.map((entry, index) => (\\n                    <Cell key={`bar-${index}`} fill={entry.color} />\\n                  ))}\\n                </Bar>\\n              </BarChart>\\n            </ResponsiveContainer>\\n          )}\\n        </div>\\n\\n        {/* 3 Clickable Metric Rows */}\\n        <div className=\\\"sm:col-span-7 space-y-2.5\\\">\\n          {data.map((item) => {\\n            const Icon = item.icon;\\n            const pct = Math.round((item.value / totalCount) * 100) || 0;\\n            return (\\n              <button\\n                key={item.key}\\n                type=\\\"button\\\"\\n                onClick={() => handleCategoryClick(item.key)}\\n                className={`w-full p-3.5 rounded-xl border transition-all text-left flex items-center justify-between gap-3 group cursor-pointer ${item.lightBg} ${item.border}`}\\n              >\\n                <div className=\\\"flex items-center gap-3 min-w-0\\\">\\n                  <div\\n                    className=\\\"w-9 h-9 rounded-lg flex items-center justify-center shrink-0 text-white\\\"\\n                    style={{ backgroundColor: item.color }}\\n                  >\\n                    <Icon className=\\\"w-4 h-4\\\" />\\n                  </div>\\n                  <div className=\\\"min-w-0\\\">\\n                    <div className=\\\"flex items-center gap-2\\\">\\n                      <span className=\\\"font-bold text-ink text-xs sm:text-sm truncate\\\">\\n                        {item.name}\\n                      </span>\\n                      <span className=\\\"text-[11px] font-mono tabular-nums text-ink-muted\\\">\\n                        \302\267 {pct}%\\n                      </span>\\n                    </div>\\n                    <p className=\\\"text-[11px] text-ink-muted truncate\\\">\\n                      {item.desc}\\n                    </p>\\n                  </div>\\n                </div>\\n\\n                <div className=\\\"flex items-center gap-2 shrink-0\\\">\\n                  <span className={`font-mono text-base sm:text-lg font-bold tabular-nums ${item.text}`}>\\n                    {item.value}\\n                  </span>\\n                  <ChevronRight className=\\\"w-4 h-4 text-ink-muted group-hover:translate-x-0.5 group-hover:text-forest transition-all\\\" />\\n                </div>\\n              </button>\\n            );\\n          })}\\n        </div>\\n      </div>\\n\\n      {/* Action Footer Callout */}\\n      <div className=\\\"pt-3 border-t border-line flex flex-col xs:flex-row xs:items-center justify-between gap-2 text-xs\\\">\\n        <span className=\\\"text-ink-muted\\\">\\n          {kedaluwarsaCount > 0 ? (\\n            <span className=\\\"text-status-kedaluwarsa-text font-semibold flex items-center gap-1.5\\\">\\n              <AlertOctagon className=\\\"w-3.5 h-3.5 shrink-0\\\" />\\n              Segera pisahkan {kedaluwarsaCount} obat yang telah kedaluwarsa.\\n            </span>\\n          ) : segeraCount > 0 ? (\\n            <span className=\\\"text-status-segera-text font-semibold flex items-center gap-1.5\\\">\\n              <AlertTriangle className=\\\"w-3.5 h-3.5 shrink-0\\\" />\\n              {segeraCount} obat mendekati kedaluwarsa dalam 30 hari.\\n            </span>\\n          ) : (\\n            <span className=\\\"text-status-aman-text font-medium flex items-center gap-1.5\\\">\\n              <CheckCircle2 className=\\\"w-3.5 h-3.5 shrink-0\\\" />\\n              Semua persediaan obat saat ini dalam status aman.\\n            </span>\\n          )}\\n        </span>\\n\\n        <button\\n          type=\\\"button\\\"\\n          onClick={onNavigateToLemari}\\n          className=\\\"text-brand hover:text-forest font-semibold inline-flex items-center gap-1 cursor-pointer self-end xs:self-auto\\\"\\n        >\\n          <span>Buka Semua di Lemari</span>\\n          <ChevronRight className=\\\"w-3.5 h-3.5\\\" />\\n        </button>\\n      </div>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Upgrade RingkasanStokObatChart with warm editorial palette, Fraunces heading, tabular numbers, and Recharts styling\", \"Overwrite\":true, \"TargetFile\":\"/src/components/RingkasanStokObatChart.tsx\", \"toolAction\":\"Upgrading RingkasanStokObatChart styling\", \"toolSummary\":\"Upgrade RingkasanStokObatChart.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_5320764427504825143"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState, useEffect, useRef } from \'react\';\\nimport {\\n  Compass,\\n  X,\\n  ChevronLeft,\\n  ChevronRight,\\n  CheckCircle2,\\n  HelpCircle,\\n  ScanSearch,\\n  Archive,\\n  Dumbbell,\\n  BookOpen,\\n} from \'lucide-react\';\\n\\nexport interface WalkthroughStep {\\n  id: \'cek-label\' | \'lemari-stok\' | \'latihan\' | \'belajar-cepat\';\\n  stepNumber: number;\\n  title: string;\\n  description: string;\\n  tip: string;\\n  icon: React.ElementType;\\n  accentBg: string;\\n  accentText: string;\\n}\\n\\nexport const WALKTHROUGH_STEPS: WalkthroughStep[] = [\\n  {\\n    id: \'cek-label\',\\n    stepNumber: 1,\\n    title: \'Simulasi Cek Label Obat\',\\n    description:\\n      \'Ketuk 6 titik kritis pada kemasan Tablet, Sirup, dan Salep untuk mengenali arti logo golongan, aturan pakai, tanggal kedaluwarsa, hingga kode NIE BPOM.\',\\n    tip: \'Mulai dari sini jika Anda belum terbiasa membaca etiket obat kemasan.\',\\n    icon: ScanSearch,\\n    accentBg: \'bg-secondary\',\\n    accentText: \'text-forest\',\\n  },\\n  {\\n    id: \'lemari-stok\',\\n    stepNumber: 2,\\n    title: \'Lemari Obat & Grafik Stok\',\\n    description:\\n      \'Catat obat yang tersimpan di rumah. Grafik otomatis mengelompokkan status Aman, Segera Kedaluwarsa (\342\211\244 30 hari), dan Kedaluwarsa agar mudah dipantau.\',\\n    tip: \'Klik salah satu kategori pada grafik untuk langsung menyaring daftar obat.\',\\n    icon: Archive,\\n    accentBg: \'bg-status-aman-bg\',\\n    accentText: \'text-status-aman-text\',\\n  },\\n  {\\n    id: \'latihan\',\\n    stepNumber: 3,\\n    title: \'Skenario Kasus, Flashcard & Kuis\',\\n    description:\\n      \'Latih pengambilan keputusan swamedikasi lewat cerita bercabang, hafalkan istilah dengan Flashcard 3D, dan ukur pemahaman lewat Kuis Pre/Post-Test.\',\\n    tip: \'Semua jawaban kuis disertai alasan ilmiah dari pedoman resmi.\',\\n    icon: Dumbbell,\\n    accentBg: \'bg-sand-soft\',\\n    accentText: \'text-forest\',\\n  },\\n  {\\n    id: \'belajar-cepat\',\\n    stepNumber: 4,\\n    title: \'Kamus Istilah & Pustaka Resmi\',\\n    description:\\n      \'Temukan arti istilah seperti BUD, Exp. Date, dan P.No 1\342\200\2236 di Kamus Label Obat, serta lihat sumber rujukan Kemenkes RI & BPOM di tab Pustaka.\',\\n    tip: \'Gunakan tombol \\\"Panduan Fitur\\\" di atas kapan saja untuk memutar ulang tur ini.\',\\n    icon: BookOpen,\\n    accentBg: \'bg-status-segera-bg\',\\n    accentText: \'text-status-segera-text\',\\n  },\\n];\\n\\ninterface BerandaWalkthroughProps {\\n  isActive: boolean;\\n  currentStepIndex: number;\\n  onNext: () => void;\\n  onPrev: () => void;\\n  onSelectStep: (index: number) => void;\\n  onClose: () => void;\\n  onJumpToFeature?: (stepId: WalkthroughStep[\'id\']) => void;\\n}\\n\\nexport const BerandaWalkthrough: React.FC<BerandaWalkthroughProps> = ({\\n  isActive,\\n  currentStepIndex,\\n  onNext,\\n  onPrev,\\n  onSelectStep,\\n  onClose,\\n  onJumpToFeature,\\n}) => {\\n  if (!isActive) return null;\\n\\n  const step = WALKTHROUGH_STEPS[currentStepIndex];\\n  const Icon = step.icon;\\n  const isFirst = currentStepIndex === 0;\\n  const isLast = currentStepIndex === WALKTHROUGH_STEPS.length - 1;\\n\\n  return (\\n    <section\\n      aria-label=\\\"Panduan Interaktif Fitur Beranda\\\"\\n      className=\\\"ro-fade-in rounded-2xl bg-surface border border-line-strong/60 shadow-sm p-5 sm:p-6 space-y-4 relative overflow-hidden\\\"\\n    >\\n      {/* Top Progress Strip */}\\n      <div className=\\\"flex items-center justify-between gap-2\\\">\\n        <div className=\\\"flex items-center gap-3\\\">\\n          <div className=\\\"w-9 h-9 rounded-xl bg-forest text-sand flex items-center justify-center shrink-0\\\">\\n            <Compass className=\\\"w-4 h-4\\\" />\\n          </div>\\n          <div>\\n            <span className=\\\"text-[11px] font-semibold uppercase tracking-[0.1em] text-brand block leading-none\\\">\\n              Panduan Pengguna Baru\\n            </span>\\n            <span className=\\\"text-xs text-ink-muted font-mono tabular-nums mt-1 block\\\">\\n              Langkah {step.stepNumber} dari {WALKTHROUGH_STEPS.length}\\n            </span>\\n          </div>\\n        </div>\\n\\n        <button\\n          type=\\\"button\\\"\\n          onClick={onClose}\\n          className=\\\"min-h-[40px] px-3 py-1.5 rounded-xl text-xs font-semibold text-ink-muted hover:text-forest hover:bg-surface-muted flex items-center gap-1 transition-colors cursor-pointer\\\"\\n          aria-label=\\\"Tutup panduan fitur\\\"\\n        >\\n          <span>Lewati</span>\\n          <X className=\\\"w-4 h-4\\\" />\\n        </button>\\n      </div>\\n\\n      {/* Step Content */}\\n      <div className=\\\"p-4 rounded-xl bg-surface-warm border border-line flex items-start gap-3.5\\\">\\n        <div\\n          className={`w-10 h-10 rounded-xl ${step.accentBg} ${step.accentText} flex items-center justify-center shrink-0 mt-0.5`}\\n        >\\n          <Icon className=\\\"w-5 h-5\\\" />\\n        </div>\\n        <div className=\\\"space-y-1.5 flex-1 min-w-0\\\">\\n          <h3 className=\\\"text-sm sm:text-base font-bold text-forest\\\">\\n            {step.title}\\n          </h3>\\n          <p className=\\\"text-xs sm:text-sm text-ink-muted leading-relaxed\\\">\\n            {step.description}\\n          </p>\\n          <p className=\\\"text-xs text-forest font-medium bg-secondary/50 border border-line rounded-lg px-3 py-1.5\\\">\\n            Tips: {step.tip}\\n          </p>\\n        </div>\\n      </div>\\n\\n      {/* Step Dots & Controls */}\\n      <div className=\\\"flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-1\\\">\\n        <div className=\\\"flex items-center gap-1.5\\\" role=\\\"tablist\\\" aria-label=\\\"Pilih langkah panduan\\\">\\n          {WALKTHROUGH_STEPS.map((s, idx) => {\\n            const active = idx === currentStepIndex;\\n            return (\\n              <button\\n                key={s.id}\\n                type=\\\"button\\\"\\n                role=\\\"tab\\\"\\n                aria-selected={active}\\n                aria-label={`Langkah ${idx + 1}: ${s.title}`}\\n                onClick={() => onSelectStep(idx)}\\n                className={`h-2.5 rounded-full transition-all cursor-pointer ${\\n                  active ? \'w-7 bg-forest\' : \'w-2.5 bg-line hover:bg-line-strong/60\'\\n                }`}\\n              />\\n            );\\n          })}\\n        </div>\\n\\n        <div className=\\\"flex items-center justify-end gap-2 flex-wrap\\\">\\n          {onJumpToFeature && (\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => onJumpToFeature(step.id)}\\n              className=\\\"min-h-[40px] px-3.5 py-1.5 rounded-xl bg-secondary/70 hover:bg-secondary text-forest text-xs font-semibold transition-colors cursor-pointer\\\"\\n            >\\n              Coba Fitur Ini\\n            </button>\\n          )}\\n\\n          {!isFirst && (\\n            <button\\n              type=\\\"button\\\"\\n              onClick={onPrev}\\n              className=\\\"min-h-[40px] px-3.5 py-1.5 rounded-xl bg-surface border border-line hover:bg-surface-muted text-ink text-xs font-semibold flex items-center gap-1 cursor-pointer\\\"\\n            >\\n              <ChevronLeft className=\\\"w-4 h-4\\\" />\\n              <span>Sebelumnya</span>\\n            </button>\\n          )}\\n\\n          {!isLast ? (\\n            <button\\n              type=\\\"button\\\"\\n              onClick={onNext}\\n              className=\\\"min-h-[40px] px-4 py-1.5 rounded-xl bg-forest hover:bg-brand text-on-brand text-xs font-semibold flex items-center gap-1 cursor-pointer\\\"\\n            >\\n              <span>Berikutnya</span>\\n              <ChevronRight className=\\\"w-4 h-4\\\" />\\n            </button>\\n          ) : (\\n            <button\\n              type=\\\"button\\\"\\n              onClick={onClose}\\n              className=\\\"min-h-[40px] px-4 py-1.5 rounded-xl bg-status-aman-text hover:bg-forest text-white text-xs font-semibold flex items-center gap-1.5 cursor-pointer\\\"\\n            >\\n              <CheckCircle2 className=\\\"w-4 h-4\\\" />\\n              <span>Selesai</span>\\n            </button>\\n          )}\\n        </div>\\n      </div>\\n    </section>\\n  );\\n};\\n\\ninterface FeatureTooltipProps {\\n  title: string;\\n  content: string;\\n  align?: \'left\' | \'right\';\\n}\\n\\nexport const FeatureTooltip: React.FC<FeatureTooltipProps> = ({\\n  title,\\n  content,\\n  align = \'right\',\\n}) => {\\n  const [isOpen, setIsOpen] = useState(false);\\n  const wrapperRef = useRef<HTMLDivElement>(null);\\n\\n  useEffect(() => {\\n    if (!isOpen) return;\\n\\n    const handleClickOutside = (event: MouseEvent) => {\\n      if (wrapperRef.current && !wrapperRef.current.contains(event.target as Node)) {\\n        setIsOpen(false);\\n      }\\n    };\\n\\n    const handleKeyDown = (event: KeyboardEvent) => {\\n      if (event.key === \'Escape\') {\\n        setIsOpen(false);\\n      }\\n    };\\n\\n    document.addEventListener(\'mousedown\', handleClickOutside);\\n    document.addEventListener(\'keydown\', handleKeyDown);\\n    return () => {\\n      document.removeEventListener(\'mousedown\', handleClickOutside);\\n      document.removeEventListener(\'keydown\', handleKeyDown);\\n    };\\n  }, [isOpen]);\\n\\n  return (\\n    <div ref={wrapperRef} className=\\\"relative inline-flex items-center\\\">\\n      <button\\n        type=\\\"button\\\"\\n        onClick={() => setIsOpen((prev) => !prev)}\\n        aria-expanded={isOpen}\\n        aria-label={`Info fitur: ${title}`}\\n        className={`w-8 h-8 rounded-full flex items-center justify-center transition-colors cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-focus ${\\n          isOpen\\n            ? \'bg-forest text-on-brand\'\\n            : \'bg-surface-muted hover:bg-secondary text-ink-muted hover:text-forest border border-line\'\\n        }`}\\n      >\\n        <HelpCircle className=\\\"w-4 h-4\\\" />\\n      </button>\\n\\n      {isOpen && (\\n        <div\\n          role=\\\"tooltip\\\"\\n          className={`absolute top-full mt-2 z-30 w-64 sm:w-72 p-4 rounded-2xl bg-forest text-white shadow-xl border border-white/10 text-left space-y-1.5 ro-fade-in ${\\n            align === \'right\' ? \'right-0\' : \'left-0\'\\n          }`}\\n        >\\n          <div className=\\\"flex items-center justify-between gap-2\\\">\\n            <span className=\\\"text-xs font-bold text-sand\\\">{title}</span>\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => setIsOpen(false)}\\n              className=\\\"text-secondary/70 hover:text-white cursor-pointer p-0.5\\\"\\n              aria-label=\\\"Tutup tooltip\\\"\\n            >\\n              <X className=\\\"w-3.5 h-3.5\\\" />\\n            </button>\\n          </div>\\n          <p className=\\\"text-xs text-secondary/90 leading-relaxed\\\">{content}</p>\\n        </div>\\n      )}\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Update BerandaWalkthrough and FeatureTooltip to warm apothecary editorial tokens\", \"Overwrite\":true, \"TargetFile\":\"/src/components/BerandaWalkthrough.tsx\", \"toolAction\":\"Updating BerandaWalkthrough editorial theme\", \"toolSummary\":\"Update BerandaWalkthrough.tsx\"}"
      original_name: "write_to_file"
    }
