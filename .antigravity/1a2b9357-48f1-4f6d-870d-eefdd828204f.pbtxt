  planner_response {
    thinking: "**Defining Test Modes**\n\nI\'m currently focused on defining the test modes for the pharmacy thesis evaluation component. I\'ve broken it down into \"Mode Pre-test,\" which serves as an initial assessment, and \"Mode Post-test,\" to measure understanding after engaging with the \"Ruang Obat\" material. These are crucial components.\n\n\n"
    tool_calls {
      id: "call_15012454026759039232"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState } from \'react\';\\nimport { QUIZ_QUESTIONS } from \'../../data/latihanData\';\\nimport { QuizMode, QuizResultState } from \'../../types/latihan\';\\nimport { \\n  FileCheck2, \\n  CheckCircle2, \\n  XCircle, \\n  RotateCcw, \\n  Copy, \\n  Check, \\n  ExternalLink, \\n  ArrowRight, \\n  Award,\\n  ChevronLeft,\\n  ChevronRight,\\n  TrendingUp,\\n  BookOpen\\n} from \'lucide-react\';\\n\\nexport const KuisModule: React.FC = () => {\\n  const [mode, setMode] = useState<QuizMode>(\'posttest\');\\n  const [currentQuestionIndex, setCurrentQuestionIndex] = useState(0);\\n  const [userAnswers, setUserAnswers] = useState<Record<number, number>>({});\\n  const [isSubmitted, setIsSubmitted] = useState(false);\\n  const [hasCopied, setHasCopied] = useState(false);\\n\\n  // Stored pretest & posttest scores for delta calculation\\n  const [pretestScore, setPretestScore] = useState<number | null>(() => {\\n    try {\\n      const saved = localStorage.getItem(\'ruang_obat_pretest_score\');\\n      return saved ? Number(saved) : null;\\n    } catch {\\n      return null;\\n    }\\n  });\\n\\n  const [posttestScore, setPosttestScore] = useState<number | null>(() => {\\n    try {\\n      const saved = localStorage.getItem(\'ruang_obat_posttest_score\');\\n      return saved ? Number(saved) : null;\\n    } catch {\\n      return null;\\n    }\\n  });\\n\\n  const totalQuestions = QUIZ_QUESTIONS.length;\\n  const currentQ = QUIZ_QUESTIONS[currentQuestionIndex];\\n  const answeredCount = Object.keys(userAnswers).length;\\n\\n  const handleSelectOption = (questionId: number, optionIndex: number) => {\\n    if (isSubmitted) return;\\n    setUserAnswers((prev) => ({\\n      ...prev,\\n      [questionId]: optionIndex\\n    }));\\n  };\\n\\n  const calculateScore = () => {\\n    let correct = 0;\\n    QUIZ_QUESTIONS.forEach((q) => {\\n      if (userAnswers[q.id] === q.correctIndex) {\\n        correct++;\\n      }\\n    });\\n    return Math.round((correct / totalQuestions) * 100);\\n  };\\n\\n  const handleSubmit = () => {\\n    const score = calculateScore();\\n    setIsSubmitted(true);\\n    if (mode === \'pretest\') {\\n      setPretestScore(score);\\n      try {\\n        localStorage.setItem(\'ruang_obat_pretest_score\', String(score));\\n      } catch {\\n        // ignore\\n      }\\n    } else {\\n      setPosttestScore(score);\\n      try {\\n        localStorage.setItem(\'ruang_obat_posttest_score\', String(score));\\n      } catch {\\n        // ignore\\n      }\\n    }\\n    window.scrollTo({ top: 120, behavior: \'smooth\' });\\n  };\\n\\n  const handleReset = (newMode?: QuizMode) => {\\n    if (newMode) setMode(newMode);\\n    setUserAnswers({});\\n    setIsSubmitted(false);\\n    setCurrentQuestionIndex(0);\\n  };\\n\\n  const currentScore = calculateScore();\\n\\n  // Copy summary to clipboard for thesis researcher\\n  const handleCopySummary = () => {\\n    const correctCount = QUIZ_QUESTIONS.filter((q) => userAnswers[q.id] === q.correctIndex).length;\\n    const modeLabel = mode === \'pretest\' ? \'PRE-TEST (Uji Awal)\' : \'POST-TEST (Uji Akhir)\';\\n    const text = `--- HASIL EVALUASI LITERASI OBAT (RUANG OBAT) ---\\nInstrumen Penelitian Skripsi S1 Farmasi\\nMode: ${modeLabel}\\nWaktu Selesai: ${new Date().toLocaleString(\'id-ID\')}\\nSkor: ${currentScore} / 100 (${correctCount} dari ${totalQuestions} Benar)\\nStatus: ${\\n      currentScore >= 80 ? \'Sangat Baik (Literasi Tinggi)\' : currentScore >= 60 ? \'Baik (Cukup Paham)\' : \'Perlu Edukasi Ulang\'\\n    }\\nRincian Jawaban:\\n${QUIZ_QUESTIONS.map(\\n  (q) => `No ${q.id} [${q.competency}]: ${userAnswers[q.id] === q.correctIndex ? \'BENAR\' : \'SALAH\'}`\\n).join(\'\\\\n\')}\\n--------------------------------------------------`;\\n\\n    navigator.clipboard.writeText(text);\\n    setHasCopied(true);\\n    setTimeout(() => setHasCopied(false), 3000);\\n  };\\n\\n  return (\\n    <div className=\\\"space-y-6\\\">\\n      {/* Mode Selector & Header */}\\n      <div className=\\\"p-4 sm:p-5 bg-white rounded-2xl border border-slate-200 shadow-2xs space-y-4\\\">\\n        <div className=\\\"flex flex-col sm:flex-row sm:items-center justify-between gap-3\\\">\\n          <div>\\n            <div className=\\\"flex items-center gap-2\\\">\\n              <span className=\\\"text-xs font-bold uppercase tracking-wide text-teal-800\\\">\\n                Instrumen Evaluasi Skripsi\\n              </span>\\n              <span className=\\\"text-[10px] px-2 py-0.5 rounded-full bg-slate-100 text-slate-600 font-mono\\\">\\n                10 Butir Soal Terstandar\\n              </span>\\n            </div>\\n            <h2 className=\\\"text-lg sm:text-xl font-bold text-slate-900 mt-0.5\\\">\\n              Uji Pemahaman Literasi Obat\\n            </h2>\\n          </div>\\n\\n          {/* Mode Switch (Pretest / Posttest) */}\\n          <div className=\\\"flex items-center gap-1.5 p-1 bg-slate-100 rounded-xl border border-slate-200 self-start sm:self-auto\\\">\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => handleReset(\'pretest\')}\\n              className={`px-3 py-1.5 rounded-lg text-xs font-bold transition-all cursor-pointer ${\\n                mode === \'pretest\'\\n                  ? \'bg-amber-600 text-white shadow-xs\'\\n                  : \'text-slate-600 hover:text-slate-900\'\\n              }`}\\n            >\\n              Mode Pre-Test\\n            </button>\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => handleReset(\'posttest\')}\\n              className={`px-3 py-1.5 rounded-lg text-xs font-bold transition-all cursor-pointer ${\\n                mode === \'posttest\'\\n                  ? \'bg-teal-700 text-white shadow-xs\'\\n                  : \'text-slate-600 hover:text-slate-900\'\\n              }`}\\n            >\\n              Mode Post-Test\\n            </button>\\n          </div>\\n        </div>\\n\\n        <p className=\\\"text-xs sm:text-sm text-slate-600 leading-relaxed\\\">\\n          {mode === \'pretest\' ? (\\n            <span className=\\\"text-amber-900 bg-amber-50 p-2 rounded-lg border border-amber-200/80 block\\\">\\n              <strong>Catatan Pre-Test:</strong> Uji ini untuk mengukur pengetahuan awal Anda sebelum mempelajari seluruh materi label kemasan dan Lemari Obat. Kerjakan secara spontan tanpa melihat kunci.\\n            </span>\\n          ) : (\\n            <span className=\\\"text-teal-900 bg-teal-50 p-2 rounded-lg border border-teal-200/80 block\\\">\\n              <strong>Catatan Post-Test:</strong> Uji ini untuk mengukur peningkatan pemahaman Anda setelah mengeksplorasi fitur Cek Label 6 Titik, Lemari Obat, dan Kamus Label.\\n            </span>\\n          )}\\n        </p>\\n      </div>\\n\\n      {/* If Quiz is NOT submitted, show question runner */}\\n      {!isSubmitted ? (\\n        <div className=\\\"space-y-4\\\">\\n          {/* Progress & Question Numbers */}\\n          <div className=\\\"bg-white p-4 rounded-2xl border border-slate-200 shadow-2xs space-y-3\\\">\\n            <div className=\\\"flex items-center justify-between text-xs font-semibold text-slate-700\\\">\\n              <span>Pertanyaan {currentQuestionIndex + 1} dari {totalQuestions}</span>\\n              <span className=\\\"text-teal-800\\\">\\n                Terjawab: {answeredCount} / {totalQuestions}\\n              </span>\\n            </div>\\n\\n            {/* Quick jump circles */}\\n            <div className=\\\"flex items-center gap-1.5 overflow-x-auto pb-1 scrollbar-thin\\\">\\n              {QUIZ_QUESTIONS.map((q, idx) => {\\n                const isAnswered = userAnswers[q.id] !== undefined;\\n                const isCurrent = idx === currentQuestionIndex;\\n                return (\\n                  <button\\n                    key={q.id}\\n                    type=\\\"button\\\"\\n                    onClick={() => setCurrentQuestionIndex(idx)}\\n                    className={`w-7 h-7 rounded-lg text-xs font-bold flex items-center justify-center shrink-0 transition-all cursor-pointer ${\\n                      isCurrent\\n                        ? \'bg-teal-700 text-white ring-2 ring-teal-400\'\\n                        : isAnswered\\n                        ? \'bg-teal-100 text-teal-900\'\\n                        : \'bg-slate-100 text-slate-600 hover:bg-slate-200\'\\n                    }`}\\n                  >\\n                    {q.id}\\n                  </button>\\n                );\\n              })}\\n            </div>\\n          </div>\\n\\n          {/* Current Question Box */}\\n          <div className=\\\"bg-white rounded-2xl border border-slate-200 shadow-2xs p-5 sm:p-6 space-y-5\\\">\\n            <div className=\\\"space-y-1\\\">\\n              <span className=\\\"text-[11px] font-bold text-teal-800 uppercase tracking-wide bg-teal-50 px-2.5 py-0.5 rounded-full border border-teal-200/60\\\">\\n                {currentQ.competency}\\n              </span>\\n              <h3 className=\\\"text-base sm:text-lg font-bold text-slate-900 leading-snug pt-1\\\">\\n                {currentQ.id}. {currentQ.question}\\n              </h3>\\n            </div>\\n\\n            {/* Options */}\\n            <div className=\\\"space-y-2.5\\\">\\n              {currentQ.options.map((opt, i) => {\\n                const isSelected = userAnswers[currentQ.id] === i;\\n                return (\\n                  <button\\n                    key={i}\\n                    type=\\\"button\\\"\\n                    onClick={() => handleSelectOption(currentQ.id, i)}\\n                    className={`w-full p-4 rounded-xl text-left text-xs sm:text-sm transition-all flex items-start gap-3 cursor-pointer ${\\n                      isSelected\\n                        ? \'bg-teal-50 border-2 border-teal-700 text-teal-950 font-semibold shadow-xs\'\\n                        : \'bg-white border border-slate-200 hover:border-teal-300 hover:bg-slate-50 text-slate-700\'\\n                    }`}\\n                  >\\n                    <span className={`w-6 h-6 rounded-full flex items-center justify-center shrink-0 text-xs font-bold ${\\n                      isSelected\\n                        ? \'bg-teal-700 text-white\'\\n                        : \'bg-slate-100 text-slate-700\'\\n                    }`}>\\n                      {String.fromCharCode(65 + i)}\\n                    </span>\\n                    <span className=\\\"leading-relaxed flex-1\\\">{opt}</span>\\n                  </button>\\n                );\\n              })}\\n            </div>\\n\\n            {/* Navigation buttons */}\\n            <div className=\\\"pt-4 border-t border-slate-100 flex items-center justify-between gap-3\\\">\\n              <button\\n                type=\\\"button\\\"\\n                disabled={currentQuestionIndex === 0}\\n                onClick={() => setCurrentQuestionIndex((prev) => prev - 1)}\\n                className=\\\"min-h-[44px] px-3.5 py-2 rounded-xl border border-slate-200 text-slate-700 hover:bg-slate-50 disabled:opacity-40 disabled:cursor-not-allowed text-xs font-semibold flex items-center gap-1.5 cursor-pointer\\\"\\n              >\\n                <ChevronLeft className=\\\"w-4 h-4\\\" />\\n                <span>Sebelumnya</span>\\n              </button>\\n\\n              {currentQuestionIndex < totalQuestions - 1 ? (\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => setCurrentQuestionIndex((prev) => prev + 1)}\\n                  className=\\\"min-h-[44px] px-4 py-2 rounded-xl bg-teal-700 hover:bg-teal-800 text-white text-xs sm:text-sm font-bold flex items-center gap-1.5 cursor-pointer shadow-xs\\\"\\n                >\\n                  <span>Berikutnya</span>\\n                  <ChevronRight className=\\\"w-4 h-4\\\" />\\n                </button>\\n              ) : (\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={handleSubmit}\\n                  className=\\\"min-h-[44px] px-5 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs sm:text-sm font-bold flex items-center gap-2 cursor-pointer shadow-xs\\\"\\n                >\\n                  <FileCheck2 className=\\\"w-4 h-4\\\" />\\n                  <span>Selesaikan & Lihat Nilai</span>\\n                </button>\\n              )}\\n            </div>\\n          </div>\\n        </div>\\n      ) : (\\n        /* Results View */\\n        <div className=\\\"space-y-6 ro-fade-in\\\">\\n          {/* Score Card */}\\n          <div className=\\\"p-6 bg-gradient-to-br from-slate-900 to-teal-950 text-white rounded-3xl shadow-md text-center space-y-4\\\">\\n            <div className=\\\"w-16 h-16 mx-auto rounded-2xl bg-teal-500/20 text-teal-300 flex items-center justify-center border border-teal-400/30\\\">\\n              <Award className=\\\"w-8 h-8 text-teal-400\\\" />\\n            </div>\\n\\n            <div className=\\\"space-y-1\\\">\\n              <span className=\\\"text-xs uppercase tracking-widest text-teal-300 font-bold\\\">\\n                Hasil Evaluasi {mode === \'pretest\' ? \'Pre-Test\' : \'Post-Test\'}\\n              </span>\\n              <div className=\\\"text-4xl sm:text-5xl font-black text-white\\\">\\n                {currentScore} <span className=\\\"text-xl text-teal-300\\\">/ 100</span>\\n              </div>\\n              <p className=\\\"text-xs sm:text-sm text-slate-300 font-medium\\\">\\n                {currentScore >= 80 ? (\\n                  \'Tingkat Literasi Sangat Baik! Anda siap melakukan swamedikasi secara aman dan bijak.\'\\n                ) : currentScore >= 60 ? (\\n                  \'Pemahaman Baik. Tingkatkan pemahaman pada bagian Beyond Use Date dan prinsip Dagusibu.\'\\n                ) : (\\n                  \'Perlu Mengulang Materi. Simak kembali 6 titik label kemasan dan panduan pemusnahan obat rusak.\'\\n                )}\\n              </p>\\n            </div>\\n\\n            {/* Delta comparison if both pre and post test have scores */}\\n            {pretestScore !== null && posttestScore !== null && (\\n              <div className=\\\"p-3 bg-teal-900/60 rounded-xl border border-teal-700/80 text-xs flex items-center justify-center gap-3 text-teal-100\\\">\\n                <TrendingUp className=\\\"w-4 h-4 text-emerald-400\\\" />\\n                <span>\\n                  Perbandingan: Pre-Test <strong>{pretestScore}</strong> \342\236\224 Post-Test <strong>{posttestScore}</strong> ({posttestScore >= pretestScore ? `+${posttestScore - pretestScore}` : posttestScore - pretestScore} poin)\\n                </span>\\n              </div>\\n            )}\\n\\n            {/* Action buttons */}\\n            <div className=\\\"pt-2 flex flex-wrap items-center justify-center gap-3\\\">\\n              <button\\n                type=\\\"button\\\"\\n                onClick={handleCopySummary}\\n                className=\\\"min-h-[44px] px-4 py-2 rounded-xl bg-teal-600 hover:bg-teal-500 text-white text-xs sm:text-sm font-bold flex items-center gap-2 cursor-pointer shadow-xs transition-colors\\\"\\n              >\\n                {hasCopied ? (\\n                  <>\\n                    <Check className=\\\"w-4 h-4 text-emerald-300\\\" />\\n                    <span>Tersalin ke Clipboard!</span>\\n                  </>\\n                ) : (\\n                  <>\\n                    <Copy className=\\\"w-4 h-4\\\" />\\n                    <span>Salin Rekap untuk Skripsi</span>\\n                  </>\\n                )}\\n              </button>\\n\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => handleReset()}\\n                className=\\\"min-h-[44px] px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-200 text-xs sm:text-sm font-semibold flex items-center gap-2 cursor-pointer transition-colors\\\"\\n              >\\n                <RotateCcw className=\\\"w-4 h-4\\\" />\\n                <span>Ulangi Uji Ini</span>\\n              </button>\\n            </div>\\n          </div>\\n\\n          {/* Research Questionnaire Card */}\\n          <div className=\\\"p-4 rounded-2xl bg-amber-50/70 border border-amber-200/90 text-amber-950 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs sm:text-sm\\\">\\n            <div className=\\\"space-y-0.5\\\">\\n              <div className=\\\"font-bold text-amber-900\\\">\\n                Integrasi Kuesioner Responden Penelitian\\n              </div>\\n              <p className=\\\"text-amber-800 text-xs\\\">\\n                Apakah Anda responden penelitian skripsi ini? Masukkan skor Anda ke formulir evaluasi resmi.\\n              </p>\\n            </div>\\n            <a\\n              href=\\\"#form-penelitian-skripsi\\\"\\n              onClick={(e) => {\\n                e.preventDefault();\\n                alert(\'Tautan kuesioner Google Form responden dapat dipasang oleh peneliti pada berkas ini.\');\\n              }}\\n              className=\\\"min-h-[40px] px-3.5 py-1.5 rounded-xl bg-amber-600 hover:bg-amber-700 text-white font-bold text-xs flex items-center justify-center gap-1.5 shrink-0 transition-colors\\\"\\n            >\\n              <span>Isi Kuesioner Google Form</span>\\n              <ExternalLink className=\\\"w-3.5 h-3.5\\\" />\\n            </a>\\n          </div>\\n\\n          {/* Detailed Question Review with Explanations */}\\n          <div className=\\\"space-y-4\\\">\\n            <h3 className=\\\"text-base sm:text-lg font-bold text-slate-900\\\">\\n              Pembahasan Ilmiah & Kunci Jawaban Lengkap:\\n            </h3>\\n\\n            {QUIZ_QUESTIONS.map((q) => {\\n              const userAns = userAnswers[q.id];\\n              const isCorrect = userAns === q.correctIndex;\\n\\n              return (\\n                <div\\n                  key={q.id}\\n                  className={`p-5 rounded-2xl border bg-white shadow-2xs space-y-3 ${\\n                    isCorrect ? \'border-emerald-200\' : \'border-rose-200\'\\n                  }`}\\n                >\\n                  <div className=\\\"flex items-start justify-between gap-3\\\">\\n                    <div className=\\\"flex items-center gap-2\\\">\\n                      <span className={`w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold text-white shrink-0 ${\\n                        isCorrect ? \'bg-emerald-600\' : \'bg-rose-600\'\\n                      }`}>\\n                        {q.id}\\n                      </span>\\n                      <span className=\\\"text-xs font-bold text-slate-500 uppercase\\\">\\n                        {q.competency}\\n                      </span>\\n                    </div>\\n\\n                    {isCorrect ? (\\n                      <span className=\\\"inline-flex items-center gap-1 text-xs font-bold text-emerald-700 bg-emerald-50 px-2.5 py-0.5 rounded-full border border-emerald-200\\\">\\n                        <CheckCircle2 className=\\\"w-3.5 h-3.5\\\" />\\n                        Benar (+10)\\n                      </span>\\n                    ) : (\\n                      <span className=\\\"inline-flex items-center gap-1 text-xs font-bold text-rose-700 bg-rose-50 px-2.5 py-0.5 rounded-full border border-rose-200\\\">\\n                        <XCircle className=\\\"w-3.5 h-3.5\\\" />\\n                        Salah (+0)\\n                      </span>\\n                    )}\\n                  </div>\\n\\n                  <p className=\\\"font-semibold text-slate-900 text-xs sm:text-sm leading-snug\\\">\\n                    {q.question}\\n                  </p>\\n\\n                  <div className=\\\"space-y-1.5 text-xs\\\">\\n                    <div className=\\\"p-2.5 rounded-xl bg-slate-50 border border-slate-200/80\\\">\\n                      <span className=\\\"text-slate-500 font-medium\\\">Jawaban Anda: </span>\\n                      <strong className={isCorrect ? \'text-emerald-700\' : \'text-rose-700\'}>\\n                        {userAns !== undefined ? `${String.fromCharCode(65 + userAns)}. ${q.options[userAns]}` : \'Tidak dijawab\'}\\n                      </strong>\\n                    </div>\\n\\n                    {!isCorrect && (\\n                      <div className=\\\"p-2.5 rounded-xl bg-emerald-50/70 border border-emerald-200 text-emerald-950\\\">\\n                        <span className=\\\"font-medium text-emerald-800\\\">Kunci Jawaban yang Benar: </span>\\n                        <strong>{String.fromCharCode(65 + q.correctIndex)}. {q.options[q.correctIndex]}</strong>\\n                      </div>\\n                    )}\\n                  </div>\\n\\n                  {/* Scientific Explanation */}\\n                  <div className=\\\"p-3 rounded-xl bg-teal-50/50 border border-teal-100 text-xs text-slate-700 space-y-1\\\">\\n                    <div className=\\\"font-bold text-teal-900 flex items-center gap-1.5\\\">\\n                      <BookOpen className=\\\"w-3.5 h-3.5\\\" />\\n                      <span>Pembahasan Ilmiah Farmasi:</span>\\n                    </div>\\n                    <p className=\\\"leading-relaxed text-slate-700\\\">\\n                      {q.explanation}\\n                    </p>\\n                    <div className=\\\"text-[11px] text-teal-800 font-medium pt-1\\\">\\n                      Rujukan: {q.referenceSource}\\n                    </div>\\n                  </div>\\n                </div>\\n              );\\n            })}\\n          </div>\\n        </div>\\n      )}\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Create KuisModule with Pre-test and Post-test modes, score calculation, delta comparison, and scientific explanations\", \"Overwrite\":true, \"TargetFile\":\"/src/components/latihan/KuisModule.tsx\", \"toolAction\":\"Writing code\", \"toolSummary\":\"Create KuisModule.tsx\"}"
      thinking_signature: "\022\230\f\n\225\f\001i\024}\023JZ\347\326E\225\021@U\224\b\205\253\341\217&l\233\221\224D\035\265\275Ul\371Azb\343%\031(\301\205\002\021\026\270\260\215\\;\337U\\\037\217\203\b\177\b\3155\217\243\331\323\250z\033\252\300\342-#DW\307HG\276\343\300I\022\233\216,\212\022jh:\364sW \271-U\020)\335\350\337&Ur\365\211\224\314\250\356\251\372Pm\302v\b\370\001\200\205\306\311F\302\026\034\342\"\226l\273Q\255\032\362\0209\245\233\213,\031\274\026\213\263\224\301\234\262\222\363\307\271\207U\232]e\343\247\\\222N\2646/Db\255?\224\317\266-B>/\217@L\264d5\2721s\255\n\206\020\357\003\001\273:\205\307\310\336\216=\361\342X1\334\235D\316\001\001\2207kxn0\315m\203\273\370\336\364\3463=J\341J\312\274Y\315D\250\206,\273\332\237\322\001\322:\343\307Q:X+7\257J\021\274\"\336\233\270]\n\\\003\370s\246\250|v\005\367\264\255\222\331\201o\a(N\321\210\225N\302\201\022\337`\025]\254\261\327\364W\n\240\202Y\bu\365\343\216\262N\376\373Jv\223\266\300\275{\025\325\vy\351\345\244\022\0175\000v\376f\357h\021\021\267q\300\253\231\315\024\364\204?2\365ij\271\256\204\355\335\203vw\325\366\375m \016\3147\005\253\344\307\375\372N\020/=\334\253\221.\245\351[M\253\301\371yq{\270t\221\252\202Pr2\255\361\350\033kF\275\226C^%\201)3{c\3412KZ\024YQ\215sI`\005\261\320\0272^-S\311H\230\301D\246\025\270\313W\243!\245d\313 \225c\371ki\314Bt\250z\272\273\005\241\245\333\346\033\340t\033\221\350<\223kl;Ik\273\223\177d(\316\232\264\200\f\006\022\375\344\376V\353\364\273b\207\0208\b\vE1\307\305\223\246\3765\025\322\324BiqcA\365\004z\316\0207|\242\326#E\232\322\312L(\267\204\035\333\354*\210\266Y\021\"\256]\021\277\306tJ\217\234\374\222\201\a\335f\312}R\336\220\020c\353\\p:]\323\266\035\327i\005{zj\032\274\331\257\'X\205\273S\217\270\336\342|\363w\202\257s\332\235\305\350\362\351\016>~z\222\355\240\226\302\371Rpu2D\243;<\212*,6\250\351\307\254?\031\377\362\362\277\353\310\347\216`\036\236\367\003S\324\256\221\317i\324\250\003Z*g\274\212\256\275a\212P~\0273\360o\225\343\215\371\277\025\026\307\225\260\0321y\332\332\304\366Z_;\341W\352X9a$\205)p#05Y\240p\021N\026\326G3\256\246V\336\244\335\346\323+\b\212\016n`ej-\342&\020\0352@r2\200\365\320\004\202c\234\302\347\313\356\0241\270j\362j\255\375bI\254\361Y\251\026\3359\336\3469\272\275\347\2074z\314{\365\311\2442\276Z\"Yo`\t,P\221sJ\220\277)B\210\004I\336m\232\253\212\317\271;$N\201Q3\264\265X#\211`*\2366\024v\221\247\247\266\342\t\030\350\300/z\305\242~\224\377i \037\361\201\347\237m\341\204Kd9\210!5.\354\217M\333.\324\324~\250\'\252\0203\236\232\250\003F\273\375\351\233d\325az1 \003V\313_?\354\003\236P\366\035\302\360\275\020nm\223l*u\202\216U\225\301\235\212\\\227Jo0\031\374\323\257\353#\362r\"\252@\023+\b\356\v@8\363\321\265\0324\346wU}u\343\205K\035\025\343\fk\367\370\305XF\326]\\\326&\2768\222X\216\363\213\366\213\255\250\215w5I.\257\252\340CI\2041\271\314\004\316go(\322\n\303\216j\302\310\344\206\236\f\0319U\310\tq\241O\227\366 \177e\241\255XDi\203e\216\035\001]\a\004\376\r,\330\240\310\016#\256?\321\0011\213\f\217\315\257\324\246\270\253\277\337\274\3346@\360\034Wb\211\f\310\320\206\330\271\251\305\017U\246\351CG\363\"\255\250:\246\342\312\024l\337\300\260!\350s\223\235\371\371\266W\373\305\223\370Ibr\320\227F\353\207\004\263\334\002\033\230\026\375\3426wt\026>\"3#M\313q\243\351_},\201z\333\024\324\257\226z\260\301)&J~u\215Z\301\027\277\300\253\357\326\3772\340s\022oZ\356\252\331\\\376X\235mS#\206\313\247\276\'t\236LB\244\372\224\211\b\261\027N\237}t[*\371\016C\000\260\363\340F\006o\325\230Kdgh\217F\037)n\314`\322\336\2031A\246G\231\220\317\224\345\374\310.\000\000\307\020\315O\321\352\220\bvx\317\246\225\201[\200\214\251\227{\360i\r\ry\0338t\305\'7H\3513E_/G\324\v\250\3328\342\345T\202b@Y;\022E\322o#\301\212\343\'}yd\354\366\271\324\376\'\361[\204D\272\346i\336\342\004h\257\335?\245\b\330I\350}\\\242\352\232\233V\262\335\301T\345\277(\r\355\032\244RR\365\030&C\275Z\020\256\310N\0258\204\260M\334\346D\3673\211n\305ur<WA\236\206c\026\203A\220\001:@\177\032\354\312B\252\000 \244\363@Q\037\266\247\r\216\