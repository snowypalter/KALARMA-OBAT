    end_line: 21
    content: "import React from \'react\';\nimport { AlertCircle } from \'lucide-react\';\n\nexport const FooterDisclaimer: React.FC = () => {\n  return (\n    <footer className=\"w-full bg-slate-100/80 border-t border-slate-200 py-6 px-4 mb-20 md:mb-0\">\n      <div className=\"max-w-3xl mx-auto flex flex-col items-center text-center gap-2\">\n        <div className=\"flex items-center gap-1.5 text-slate-700 font-medium text-xs sm:text-sm\">\n          <AlertCircle className=\"w-4 h-4 text-amber-600 shrink-0\" />\n          <span>Pemberitahuan Edukasi</span>\n        </div>\n        <p className=\"text-xs sm:text-sm text-slate-600 leading-relaxed max-w-xl\">\n          Edukasi umum, bukan diagnosis atau saran dosis pribadi. Tanyakan ke apoteker atau dokter.\n        </p>\n        <p className=\"text-[11px] text-slate-600 pt-2 border-t border-slate-200/80 w-full max-w-md\">\n          Ruang Obat \302\267 Media Edukasi Skripsi S1 Farmasi Klinis dan Komunitas\n        </p>\n      </div>\n    </footer>\n  );\n};\n"
    num_lines: 22
    num_bytes: 969
    line_range_bytes: 969
  }
