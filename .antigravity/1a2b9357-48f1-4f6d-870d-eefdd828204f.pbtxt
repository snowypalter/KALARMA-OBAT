    end_line: 578
    content: "import React, { useState } from \'react\';\nimport { ModalShell } from \'./ui\';\nimport {\n  Copy,\n  Check,\n  Share2,\n  GraduationCap,\n  Bot,\n  ExternalLink,\n  Printer,\n  CheckCircle2,\n  FileText,\n  FileDown,\n  Download,\n} from \'lucide-react\';\nimport { generateAndDownloadPdf } from \'../utils/generatePdfClient\';\n\ninterface TinjauDosenModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  defaultTab?: \'pdf\' | \'link\' | \'dosen\' | \'claude\';\n}\n\nexport const TinjauDosenModal: React.FC<TinjauDosenModalProps> = ({\n  isOpen,\n  onClose,\n  defaultTab = \'pdf\',\n}) => {\n  const [activeTab, setActiveTab] = useState<\'pdf\' | \'link\' | \'dosen\' | \'claude\'>(\n    defaultTab\n  );\n  const [copiedLink, setCopiedLink] = useState(false);\n  const [copiedClaudePrompt, setCopiedClaudePrompt] = useState(false);\n  const [copiedFullDoc, setCopiedFullDoc] = useState(false);\n  const [isGenerating, setIsGenerating] = useState(false);\n\n  const currentOrigin =\n    typeof window !== \'undefined\'\n      ? window.location.origin\n      : \'https://ais-pre-i6cmepgnonm4mfj7yg2xyk-74888050060.asia-east1.run.app\';\n  const sharedUrl =\n    \'https://ais-pre-i6cmepgnonm4mfj7yg2xyk-74888050060.asia-east1.run.app\';\n  const bestUrlToShare = currentOrigin.includes(\'localhost\')\n    ? sharedUrl\n    : currentOrigin;\n\n  const handleCopyLink = () => {\n    navigator.clipboard.writeText(bestUrlToShare).then(() => {\n      setCopiedLink(true);\n      setTimeout(() => setCopiedLink(false), 2500);\n    });\n  };\n\n  const claudeReviewPrompt = `# Permohonan Review Media Edukasi Skripsi S1 Farmasi: \"Ruang Obat\"\n\nHalo Claude, saya mahasiswa S1 Farmasi Klinis dan Komunitas yang sedang menyusun skripsi media edukasi interaktif bernama \"Ruang Obat\" (Tagline: \"Kenali label obatmu, kelola obat di rumahmu\").\n\nTautan Web Media Prototipe Aktif:\n${bestUrlToShare}\n\nSasaran Pengguna:\nMahasiswa non-kesehatan dan masyarakat umum.\n\nAturan Ketat & Batasan Skripsi (Ethical Safeguards):\n1. Murni edukasi umum; TIDAK ADA kalkulator dosis, diagnosis mandiri, atau rekomendasi obat/dosis tertentu.\n2. Tidak mencantumkan klaim \"ditinjau apoteker\", \"terverifikasi\", atau testimoni apa pun.\n3. Seluruh konten edukasi menggunakan acuan resmi BPOM RI, Kemenkes RI (Dagusibu), dan Farmakope Indonesia.\n4. Data lemari obat 100% tersimpan lokal di browser pengguna (localStorage).\n5. Disclaimer wajib di footer: \"Edukasi umum, bukan diagnosis atau saran dosis pribadi. Tanyakan ke apoteker atau dokter.\"\n\nFitur yang Telah Aktif untuk Dicek:\n1. Beranda: Banner peringatan obat kedaluwarsa dinamis, 2 kartu aksi utama, grafik stok Recharts, panduan walkthrough, kartu skenario swamedikasi hari ini, akses cepat Kamus & Flashcard.\n2. Cek Label: Simulasi kemasan interaktif (Tablet strip foil, Sirup botol cair, Salep tube kulit) dengan 6 titik ketuk resmi (Logo golongan obat, Nama/komposisi, Indikasi, Aturan pakai, Tanggal kedaluwarsa/bets, Nomor Izin Edar NIE BPOM).\n3. Lemari Obat Saya: Inventaris mandiri dengan pencarian real-time, deteksi status otomatis (Aman, Segera kedaluwarsa <=30 hari, Kedaluwarsa) dengan ikon & teks, filter chip, tambah/edit obat, tautan langsung ke panduan pemusnahan obat rusak/kedaluwarsa.\n4. Panduan Simpan & Buang (Dagusibu): Petunjuk penyimpanan dan pemusnahan per bentuk sediaan.\n5. Kamus Label Obat: Glosarium istilah obat resmi dengan pencarian langsung dan filter abjad A-Z.\n6. Modul Latihan & Uji Evaluasi (Tahap 2):\n   - Skenario Swamedikasi Cerita Bercabang (4 kasus nyata).\n   - Flashcard Interaktif 3D Flip (12 kartu terstandar).\n   - Kuis Evaluasi Pre-Test & Post-Test (10 soal terstandar skripsi, kalkulasi skor /100, delta Pre-Post, pembahasan ilmiah).\n7. Tentang & Berkas PDF Skripsi: Lembar penilaian dosen pembimbing dan dokumen akademik A4 siap cetak.\n8. Chatbot Edukasi AI: Asisten tanya jawab materi website dan arsip buku referensi (.zip/.pdf/.txt).\n\nPertanyaan untuk Claude AI:\n1. Menurut Anda, apakah tata letak informasi dan simulasi 6 titik label obat sudah komunikatif untuk masyarakat umum yang awam istilah medis?\n2. Bagaimana evaluasi Anda terkait kepatuhan aspek etika farmasi dan patient safety pada modul Skenario Swamedikasi Bercabang dan Kuis Evaluasi?\n3. Apakah instrumen kuis Pre-Test dan Post-Test ini sudah representatif untuk mengukur peningkatan literasi obat pada responden penelitian skripsi S1 Farmasi?`;\n\n  const handleCopyClaudePrompt = () => {\n    navigator.clipboard.writeText(claudeReviewPrompt).then(() => {\n      setCopiedClaudePrompt(true);\n      setTimeout(() => setCopiedClaudePrompt(false), 2500);\n    });\n  };\n\n  const handlePrintValidationSheet = () => {\n    window.print();\n  };\n\n  return (\n    <ModalShell\n      isOpen={isOpen}\n      onClose={onClose}\n      title=\"Berkas Dokumen & Tinjauan Prototipe\"\n      subtitle=\"Dokumen PDF Resmi untuk Dosen Pembimbing, Penguji, & Peninjau\"\n      maxWidth=\"2xl\"\n      headerIcon={<FileText className=\"w-5 h-5\" />}\n      footer={\n        <div className=\"flex items-center justify-between text-xs text-ink-muted\">\n          <span className=\"truncate max-w-[220px] sm:max-w-xs\">\n            Ruang Obat \302\267 Skripsi S1 Farmasi\n          </span>\n          <button\n            type=\"button\"\n            onClick={onClose}\n            className=\"min-h-[44px] px-5 py-2 font-semibold text-forest bg-surface border border-line hover:bg-surface-muted rounded-xl transition-colors cursor-pointer\"\n          >\n            Tutup\n          </button>\n        </div>\n      }\n    >\n      <div className=\"space-y-5\">\n        {/* Tab Switcher */}\n        <div className=\"grid grid-cols-4 gap-1 bg-surface-muted p-1.5 rounded-2xl border border-line text-xs\">\n          <button\n            type=\"button\"\n            onClick={() => setActiveTab(\'pdf\')}\n            className={`min-h-[40px] px-2 py-1.5 rounded-xl font-semibold transition-all flex items-center justify-center gap-1.5 cursor-pointer ${\n              activeTab === \'pdf\'\n                ? \'bg-surface text-forest shadow-xs\'\n                : \'text-ink-muted hover:text-forest\'\n            }`}\n          >\n            <FileDown className=\"w-3.5 h-3.5 text-brand shrink-0\" />\n            <span>File PDF</span>\n          </button>\n          <button\n            type=\"button\"\n            onClick={() => setActiveTab(\'link\')}\n            className={`min-h-[40px] px-2 py-1.5 rounded-xl font-semibold transition-all flex items-center justify-center gap-1.5 cursor-pointer ${\n              activeTab === \'link\'\n                ? \'bg-surface text-forest shadow-xs\'\n                : \'text-ink-muted hover:text-forest\'\n            }`}\n          >\n            <Share2 className=\"w-3.5 h-3.5 text-brand shrink-0\" />\n            <span>Link Web</span>\n          </button>\n          <button\n            type=\"button\"\n            onClick={() => setActiveTab(\'dosen\')}\n            className={`min-h-[40px] px-2 py-1.5 rounded-xl font-semibold transition-all flex items-center justify-center gap-1.5 cursor-pointer ${\n              activeTab === \'dosen\'\n                ? \'bg-surface text-forest shadow-xs\'\n                : \'text-ink-muted hover:text-forest\'\n            }`}\n          >\n            <GraduationCap className=\"w-3.5 h-3.5 text-brand shrink-0\" />\n            <span className=\"hidden sm:inline\">Untuk Dosen</span>\n            <span className=\"sm:hidden\">Dosen</span>\n          </button>\n          <button\n            type=\"button\"\n            onClick={() => setActiveTab(\'claude\')}\n            className={`min-h-[40px] px-2 py-1.5 rounded-xl font-semibold transition-all flex items-center justify-center gap-1.5 cursor-pointer ${\n              activeTab === \'claude\'\n                ? \'bg-surface text-forest shadow-xs\'\n                : \'text-ink-muted hover:text-forest\'\n            }`}\n          >\n            <Bot className=\"w-3.5 h-3.5 text-brand shrink-0\" />\n            <span className=\"hidden sm:inline\">Untuk Claude</span>\n            <span className=\"sm:hidden\">Claude</span>\n          </button>\n        </div>\n\n        {/* TAB 1: FILE PDF PROTOTIPE */}\n        {activeTab === \'pdf\' && (\n          <div className=\"space-y-4\">\n            <div className=\"space-y-1\">\n              <p className=\"text-xs font-semibold uppercase tracking-wider text-brand\">\n                Dokumen Prototipe Siap Diberikan\n              </p>\n              <h3 className=\"font-display text-lg font-semibold text-forest\">\n                Dokumen PDF Prototipe Skripsi &ldquo;Ruang Obat&rdquo;\n              </h3>\n              <p className=\"text-xs sm:text-sm text-ink-muted leading-relaxed\">\n                File PDF ini disusun formal (5 halaman A4 standar akademik) berisi rancangan prototipe, batasan etika farmasi, tabel 6 titik kemasan, lembar validasi dosen, dan prompt peninjauan.\n              </p>\n            </div>\n\n            <div className=\"p-4 sm:p-5 bg-surface-warm rounded-2xl border border-line space-y-4\">\n              <div className=\"flex items-center gap-3.5\">\n                <div className=\"w-12 h-12 rounded-xl bg-forest text-sand flex items-center justify-center shrink-0\">\n                  <FileText className=\"w-6 h-6\" />\n                </div>\n                <div>\n                  <h4 className=\"font-bold text-forest text-sm sm:text-base font-mono\">\n                    Dokumen_Prototipe_Ruang_Obat.pdf\n                  </h4>\n                  <p className=\"text-xs text-ink-muted font-medium\">\n                    Ukuran ~48 KB \302\267 5 Halaman Lengkap \302\267 Format Cetak A4 Standar Skripsi\n                  </p>\n                </div>\n              </div>\n\n              <div className=\"space-y-2.5 pt-2 border-t border-line\">\n                <div className=\"flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5\">\n                  <button\n                    type=\"button\"\n                    disabled={isGenerating}\n                    onClick={() => {\n                      setIsGenerating(true);\n                      try {\n                        generateAndDownloadPdf();\n                      } catch (err) {\n                        console.error(err);\n                      } finally {\n                        setTimeout(() => setIsGenerating(false), 800);\n                      }\n                    }}\n                    className=\"flex-1 min-h-[46px] px-5 py-2.5 rounded-xl bg-forest hover:bg-brand text-on-brand font-semibold text-xs sm:text-sm flex items-center justify-center gap-2 transition-colors cursor-pointer text-center\"\n                  >\n                    <Download className=\"w-4 h-4 text-sand\" />\n                    <span>\n                      {isGenerating\n                        ? \'Membuat File PDF...\'\n                        : \'Unduh File PDF Sekarang (Di Perangkat)\'}\n                    </span>\n                  </button>\n\n                  <button\n                    type=\"button\"\n                    onClick={() => {\n                      const fullDoc = `# DOKUMEN PROTOTIPE MEDIA EDUKASI SKRIPSI S1 FARMASI\n# RUANG OBAT (\"Kenali label obatmu, kelola obat di rumahmu\")\n\nIDENTITAS PENELITIAN:\n- Aplikasi Web: Ruang Obat (Mobile-First Web App)\n- Bidang: Farmasi Klinis dan Komunitas\n- Sasaran: Mahasiswa Non-Kesehatan dan Masyarakat Umum\n- Tahun: 2026\n\nBAB I: LATAR BELAKANG & BATASAN ETIKA\n1. Urgensi: Mengatasi ketidaktepatan swamedikasi, ketidakpahaman membedakan Expired Date pabrik vs Beyond Use Date (BUD), penyalahgunaan antibiotik sisa teman, dan pembuangan obat rusak yang berbahaya.\n2. Batasan Etika Farmasi (Patient Safety):\n   - TANPA kalkulator dosis & TANPA diagnosis mandiri\n   - TANPA klaim berlebihan (\"ditinjau apoteker\", testimoni)\n   - Seluruh materi menggunakan rujukan resmi Kemenkes RI, BPOM RI, dan Farmakope\n   - Data lemari obat 100% tersimpan lokal di browser (localStorage)\n   - Disclaimer wajib di footer: \"Edukasi umum, bukan diagnosis atau saran dosis pribadi. Tanyakan ke apoteker atau dokter.\"\n\nBAB II: SPESIFIKASI PROTOTIPE\n1. Simulasi Kemasan Interaktif (Tablet, Sirup, Salep) dengan 6 Titik Kritis:\n   - Titik 1: Logo Golongan Obat (Bebas Hijau, Bebas Terbatas Biru P1-P6, Keras Merah K)\n   - Titik 2: Nama & Komposisi Zat Aktif (Generik vs Dagang, kekuatan dosis)\n   - Titik 3: Indikasi Medis Terdaftar\n   - Titik 4: Aturan Pakai, Waktu Makan & Peringatan Khusus\n   - Titik 5: Tanggal Kedaluwarsa (Exp Date) & Nomor Bets Produksi\n   - Titik 6: Nomor Izin Edar (NIE BPOM 15 digit resmi)\n2. Lemari Obat Saya:\n   - Status otomatis dengan IKON & TEKS:\n     * Aman (> 30 hari)\n     * Segera Kedaluwarsa (<= 30 hari)\n     * Kedaluwarsa (lewat tanggal)\n   - Tautan langsung ke Panduan Simpan & Buang (Dagusibu)\n3. Kamus Label Obat:\n   - Glosarium 17+ istilah resmi (NIE, BUD, ED, Rekonstitusi, Suhu Simpan, dll.)\n\nBAB III: LEMBAR PENILAIAN & VALIDASI DOSEN\n- Tabel 7 Indikator Kelayakan Media/Materi (Skala 1-5)\n- Kolom catatan asistensi & rekomendasi perbaikan\n- Kolom persetujuan dan tanda tangan Dosen Pembimbing\n\nBAB IV: PERTANYAAN EVALUASI UNTUK CLAUDE AI\n1. Apakah visualisasi 6 titik label obat sudah komunikatif untuk masyarakat awam?\n2. Apakah batasan etika farmasi dan keamanan pasien sudah kuat untuk skripsi S1?\n3. Saran perbaikan untuk modul latihan (skenario bercabang, flashcard, dan kuis).`;\n\n                      navigator.clipboard.writeText(fullDoc).then(() => {\n                        setCopiedFullDoc(true);\n                        setTimeout(() => setCopiedFullDoc(false), 2500);\n                      });\n                    }}\n                    className=\"min-h-[46px] px-4 py-2.5 rounded-xl bg-surface hover:bg-surface-muted border border-line text-forest font-semibold text-xs flex items-center justify-center gap-1.5 transition-colors cursor-pointer\"\n                  >\n                    {copiedFullDoc ? (\n                      <>\n                        <Check className=\"w-4 h-4 text-status-aman-text\" />\n                        <span className=\"text-status-aman-text\">Teks Tersalin!</span>\n                      </>\n                    ) : (\n                      <>\n                        <Copy className=\"w-4 h-4 text-brand\" />\n                        <span>Salin Naskah (.txt/.md)</span>\n                      </>\n                    )}\n                  </button>\n                </div>\n\n                <p className=\"text-[11px] text-ink-muted italic\">\n                  * Tombol unduh memproses file PDF langsung di memori perangkat Anda tanpa kendala jaringan.\n                </p>\n              </div>\n            </div>\n\n            <div className=\"space-y-2\">\n              <span className=\"text-xs font-bold text-forest uppercase tracking-wider block\">\n                Struktur 5 Halaman Dokumen PDF\n              </span>\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-2.5 text-xs\">\n                {[\n                  {\n                    num: 1,\n                    title: \'Halaman Judul (Cover)\',\n                    desc: \'Judul skripsi, tagline, identitas peneliti, tautan web aktif, dan kepatuhan etika.\',\n                  },\n                  {\n                    num: 2,\n                    title: \'Bab I: Latar Belakang & Etika\',\n                    desc: \'Urgensi swamedikasi awam, tujuan Dagusibu, 5 batasan etika ketat, & peta navigasi.\',\n                  },\n                  {\n                    num: 3,\n                    title: \'Bab II: Spesifikasi Prototipe\',\n                    desc: \'Tabel spesifikasi 6 titik kemasan (Tablet, Sirup, Salep), algoritma status lemari, & Dagusibu.\',\n                  },\n                  {\n                    num: 4,\n                    title: \'Bab III: Lembar Penilaian Dosen\',\n                    desc: \'Tabel evaluasi 7 indikator kelayakan (skala 1-5), catatan revisi, & kolom tanda tangan.\',\n                  },\n                  {\n                    num: 5,\n                    title: \'Bab IV: Panduan Evaluasi Claude AI\',\n                    desc: \'Teks prompt terstruktur siap salin atau diunggah sebagai PDF untuk analisis desain instruksional.\',\n                    wide: true,\n                  },\n                ].map((pg) => (\n                  <div\n                    key={pg.num}\n                    className={`p-3.5 bg-surface rounded-xl border border-line space-y-1 ${\n                      pg.wide ? \'sm:col-span-2\' : \'\'\n                    }`}\n                  >\n                    <div className=\"font-bold text-forest flex items-center gap-2\">\n                      <span className=\"w-5 h-5 rounded-full bg-secondary text-forest flex items-center justify-center text-[10px] font-mono font-bold\">\n                        {pg.num}\n                      </span>\n                      <span>{pg.title}</span>\n                    </div>\n                    <p className=\"text-ink-muted text-[11px] leading-relaxed\">\n                      {pg.desc}\n                    </p>\n                  </div>\n                ))}\n              </div>\n            </div>\n          </div>\n        )}\n\n        {/* TAB 2: Tautan Web & QR Code */}\n        {activeTab === \'link\' && (\n          <div className=\"space-y-4\">\n            <div className=\"space-y-1\">\n              <h3 className=\"font-display text-lg font-semibold text-forest\">\n                Tautan Akses Publik Web App\n              </h3>\n              <p className=\"text-xs sm:text-sm text-ink-muted leading-relaxed\">\n                Bagikan tautan ini kepada dosen pembimbing, penguji, atau partisipan uji coba agar aplikasi dapat dibuka langsung di peramban ponsel maupun laptop.\n              </p>\n            </div>\n\n            <div className=\"p-4 bg-surface-warm rounded-2xl border border-line space-y-2.5\">\n              <span className=\"text-xs font-bold text-forest block\">\n                Tautan Bersama (Shared Preview URL)\n              </span>\n              <div className=\"flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5\">\n                <div className=\"flex-1 p-3 bg-surface border border-line rounded-xl text-xs font-mono text-forest break-all select-all\">\n                  {bestUrlToShare}\n                </div>\n                <button\n                  type=\"button\"\n                  onClick={handleCopyLink}\n                  className={`min-h-[44px] px-4 py-2 rounded-xl font-semibold text-xs flex items-center justify-center gap-1.5 transition-colors cursor-pointer shrink-0 ${\n                    copiedLink\n                      ? \'bg-status-aman-text text-white\'\n                      : \'bg-forest hover:bg-brand text-on-brand\'\n                  }`}\n                >\n                  {copiedLink ? (\n                    <>\n                      <Check className=\"w-4 h-4\" />\n                      <span>Tersalin!</span>\n                    </>\n                  ) : (\n                    <>\n                      <Copy className=\"w-4 h-4\" />\n                      <span>Salin Tautan</span>\n                    </>\n                  )}\n                </button>\n              </div>\n            </div>\n\n            <div className=\"p-4 bg-secondary/45 rounded-2xl border border-line flex flex-col sm:flex-row items-center gap-4\">\n              <div className=\"w-24 h-24 bg-surface p-2 rounded-xl border border-line flex items-center justify-center shrink-0\">\n                <svg\n                  viewBox=\"0 0 100 100\"\n                  className=\"w-full h-full text-forest\"\n                  fill=\"currentColor\"\n                >\n                  <rect x=\"5\" y=\"5\" width=\"28\" height=\"28\" rx=\"4\" fill=\"currentColor\" />\n                  <rect x=\"9\" y=\"9\" width=\"20\" height=\"20\" rx=\"2\" fill=\"white\" />\n                  <rect x=\"14\" y=\"14\" width=\"10\" height=\"10\" fill=\"currentColor\" />\n                  <rect x=\"67\" y=\"5\" width=\"28\" height=\"28\" rx=\"4\" fill=\"currentColor\" />\n                  <rect x=\"71\" y=\"9\" width=\"20\" height=\"20\" rx=\"2\" fill=\"white\" />\n                  <rect x=\"76\" y=\"14\" width=\"10\" height=\"10\" fill=\"currentColor\" />\n                  <rect x=\"5\" y=\"67\" width=\"28\" height=\"28\" rx=\"4\" fill=\"currentColor\" />\n                  <rect x=\"9\" y=\"71\" width=\"20\" height=\"20\" rx=\"2\" fill=\"white\" />\n                  <rect x=\"14\" y=\"76\" width=\"10\" height=\"10\" fill=\"currentColor\" />\n                  <rect x=\"38\" y=\"10\" width=\"8\" height=\"8\" fill=\"currentColor\" />\n                  <rect x=\"50\" y=\"10\" width=\"8\" height=\"8\" fill=\"currentColor\" />\n                  <rect x=\"44\" y=\"24\" width=\"8\" height=\"8\" fill=\"currentColor\" />\n                  <rect x=\"10\" y=\"44\" width=\"8\" height=\"8\" fill=\"currentColor\" />\n                  <rect x=\"24\" y=\"44\" width=\"8\" height=\"8\" fill=\"currentColor\" />\n                  <rect x=\"38\" y=\"38\" width=\"8\" height=\"8\" fill=\"currentColor\" />\n                  <rect x=\"52\" y=\"38\" width=\"8\" height=\"8\" fill=\"currentColor\" />\n                  <rect x=\"66\" y=\"44\" width=\"8\" height=\"8\" fill=\"currentColor\" />\n                  <rect x=\"80\" y=\"44\" width=\"8\" height=\"8\" fill=\"currentColor\" />\n                  <rect x=\"44\" y=\"52\" width=\"8\" height=\"8\" fill=\"currentColor\" />\n                  <rect x=\"38\" y=\"66\" width=\"8\" height=\"8\" fill=\"currentColor\" />\n                  <rect x=\"52\" y=\"66\" width=\"8\" height=\"8\" fill=\"currentColor\" />\n                  <rect x=\"66\" y=\"66\" width=\"8\" height=\"8\" fill=\"currentColor\" />\n                  <rect x=\"80\" y=\"66\" width=\"8\" height=\"8\" fill=\"currentColor\" />\n                  <rect x=\"44\" y=\"80\" width=\"8\" height=\"8\" fill=\"currentColor\" />\n                  <rect x=\"66\" y=\"80\" width=\"8\" height=\"8\" fill=\"currentColor\" />\n                  <rect x=\"80\" y=\"80\" width=\"8\" height=\"8\" fill=\"currentColor\" />\n                </svg>\n              </div>\n              <div className=\"space-y-1 text-center sm:text-left\">\n                <span className=\"text-xs font-bold text-forest block\">\n                  Uji Coba Langsung di Smartphone\n                </span>\n                <p className=\"text-xs text-ink-muted leading-relaxed\">\n                  Aplikasi ini dirancang dengan ergonomi sentuh yang nyaman di layar ponsel maupun layar lebar desktop.\n                </p>\n              </div>\n            </div>\n\n            <div className=\"flex justify-end\">\n              <a\n                href={bestUrlToShare}\n                target=\"_blank\"\n                rel=\"noopener noreferrer\"\n                className=\"min-h-[44px] px-4 py-2 rounded-xl border border-line hover:bg-surface-muted text-forest font-semibold text-xs flex items-center gap-1.5 transition-colors cursor-pointer\"\n              >\n                <ExternalLink className=\"w-4 h-4 text-brand\" />\n                <span>Buka di Tab Baru Peramban</span>\n              </a>\n            </div>\n          </div>\n        )}\n\n        {/* TAB 3: Untuk Dosen Pembimbing / Penguji */}\n        {activeTab === \'dosen\' && (\n          <div className=\"space-y-4\">\n            <div className=\"space-y-1\">\n              <h3 className=\"font-display text-lg font-semibold text-forest\">\n                Panduan Validasi &amp; Tinjauan Dosen Skripsi\n              </h3>\n              <p className=\"text-xs sm:text-sm text-ink-muted leading-relaxed\">\n                Gunakan daftar periksa berikut saat asistensi atau bimbingan skripsi bersama Dosen Pembimbing.\n              </p>\n            </div>\n\n            <div className=\"space-y-2.5\">\n              {[\n                {\n                  title: \'1. Validasi 6 Titik Kritis Kemasan Obat\',\n                  desc: \'Memastikan titik ketuk pada kemasan Tablet, Sirup, dan Salep mencakup Logo Golongan, Zat Aktif, Indikasi, Aturan Pakai, ED/Bets, dan NIE BPOM sesuai rujukan resmi.\',\n                },\n                {\n                  title: \'2. Kepatuhan Batasan Etika Farmasi (Patient Safety)\',\n                  desc: \'Aplikasi bebas dari kalkulator dosis, bebas alat diagnosis mandiri, dan bebas rekomendasi terapi pribadi untuk menjaga keselamatan pasien.\',\n                },\n                {\n                  title: \'3. Prinsip Dagusibu & Pengelolaan Obat Rumah Tangga\',\n                  desc: \'Tersedia panduan penyimpanan dan pemusnahan obat kedaluwarsa/rusak agar tidak disalahgunakan atau mencemari lingkungan.\',\n                },\n                {\n                  title: \'4. Integritas Data & Kerahasiaan (Data On-Device)\',\n                  desc: \'Semua pencatatan lemari obat hanya tersimpan di memori perangkat responden tanpa mengirim riwayat obat ke server luar.\',\n                },\n              ].map((item, idx) => (\n                <div\n                  key={idx}\n                  className=\"p-3.5 bg-surface-warm rounded-xl border border-line flex items-start gap-2.5\"\n                >\n                  <CheckCircle2 className=\"w-4 h-4 text-brand shrink-0 mt-0.5\" />\n                  <div className=\"text-xs text-ink-muted leading-relaxed\">\n                    <strong className=\"text-forest block mb-0.5\">{item.title}</strong>\n                    {item.desc}\n                  </div>\n                </div>\n              ))}\n            </div>\n\n            <div className=\"p-4 bg-status-segera-bg/70 rounded-2xl border border-status-segera-text/20 flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n              <div className=\"text-xs text-ink\">\n                <span className=\"font-bold text-status-segera-text block\">\n                  Butuh Lembar Cetak untuk Bimbingan?\n                </span>\n                <span className=\"text-ink-muted\">\n                  Anda dapat mencetak rangkuman checklist ini langsung untuk tatap muka.\n                </span>\n              </div>\n              <button\n                type=\"button\"\n                onClick={handlePrintValidationSheet}\n                className=\"min-h-[42px] px-4 py-2 bg-status-segera-text hover:opacity-90 text-white font-semibold text-xs rounded-xl flex items-center justify-center gap-1.5 shrink-0 cursor-pointer\"\n              >\n                <Printer className=\"w-3.5 h-3.5\" />\n                <span>Cetak Lembar</span>\n              </button>\n            </div>\n          </div>\n        )}\n\n        {/* TAB 4: Untuk Claude AI */}\n        {activeTab === \'claude\' && (\n          <div className=\"space-y-4\">\n            <div className=\"space-y-1\">\n              <h3 className=\"font-display text-lg font-semibold text-forest\">\n                Salin Prompt Evaluasi untuk Peninjau AI\n              </h3>\n              <p className=\"text-xs sm:text-sm text-ink-muted leading-relaxed\">\n                Salin seluruh ringkasan teknis, aturan ketat skripsi, daftar fitur, dan pertanyaan evaluasi ke clipboard Anda.\n              </p>\n            </div>\n\n            <button\n              type=\"button\"\n              onClick={handleCopyClaudePrompt}\n              className={`w-full min-h-[48px] p-3 rounded-xl font-semibold text-sm flex items-center justify-center gap-2 transition-colors cursor-pointer ${\n                copiedClaudePrompt\n                  ? \'bg-status-aman-text text-white\'\n                  : \'bg-forest hover:bg-brand text-on-brand\'\n              }`}\n            >\n              {copiedClaudePrompt ? (\n                <>\n                  <Check className=\"w-5 h-5\" />\n                  <span>Prompt Evaluasi Berhasil Disalin!</span>\n                </>\n              ) : (\n                <>\n                  <Copy className=\"w-5 h-5 text-sand\" />\n                  <span>Salin Prompt Ringkasan Skripsi</span>\n                </>\n              )}\n            </button>\n\n            <div className=\"space-y-1.5\">\n              <span className=\"text-xs font-bold text-forest block\">\n                Pratinjau Teks yang Disalin\n              </span>\n              <div className=\"max-h-48 overflow-y-auto p-3.5 bg-surface-warm border border-line rounded-xl text-xs font-mono text-ink whitespace-pre-wrap leading-relaxed\">\n                {claudeReviewPrompt}\n              </div>\n            </div>\n          </div>\n        )}\n      </div>\n    </ModalShell>\n  );\n};\n"
    num_lines: 579
    num_bytes: 27744
    line_range_bytes: 27744
  }
}
