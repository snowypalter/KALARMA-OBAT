      arguments_json: "{\"Description\":\"Wire Hero search and Panduan handlers from BerandaView in App.tsx\", \"Instruction\":\"Add kamusInitialQuery and lemariSearchQuery state and pass handlers cleanly to BerandaView, LemariView, and KamusModal\", \"ReplacementChunks\":[{\"AllowMultiple\":false, \"EndLine\":36, \"ReplacementContent\":\"  const [currentTab, setCurrentTab] = useState<TabType>(\'beranda\');\\n  const [latihanSubTab, setLatihanSubTab] = useState<LatihanSubTab>(\'skenario\');\\n  const [lemariFilter, setLemariFilter] = useState<\'semua\' | \'aman\' | \'segera\' | \'kedaluwarsa\'>(\'semua\');\\n  const [lemariSearchQuery, setLemariSearchQuery] = useState(\'\');\\n\\n  // Modals state\\n  const [isAboutOpen, setIsAboutOpen] = useState(false);\\n  const [isKamusOpen, setIsKamusOpen] = useState(false);\\n  const [kamusQuery, setKamusQuery] = useState(\'\');\\n  const [isTinjauOpen, setIsTinjauOpen] = useState(false);\\n  const [panduanState, setPanduanState] = useState<{ isOpen: boolean; mode: \'simpan\' | \'buang\' }>({\\n    isOpen: false,\\n    mode: \'simpan\',\\n  });\", \"StartLine\":24, \"TargetContent\":\"  const [currentTab, setCurrentTab] = useState<TabType>(\'beranda\');\\n  const [latihanSubTab, setLatihanSubTab] = useState<LatihanSubTab>(\'skenario\');\\n  const [lemariFilter, setLemariFilter] = useState<\'semua\' | \'aman\' | \'segera\' | \'kedaluwarsa\'>(\'semua\');\\n\\n  // Modals state\\n  const [isAboutOpen, setIsAboutOpen] = useState(false);\\n  const [isKamusOpen, setIsKamusOpen] = useState(false);\\n  const [isTinjauOpen, setIsTinjauOpen] = useState(false);\\n  const [panduanState, setPanduanState] = useState<{ isOpen: boolean; mode: \'simpan\' | \'buang\' }>({\\n    isOpen: false,\\n    mode: \'simpan\',\\n  });\"}, {\"AllowMultiple\":false, \"EndLine\":147, \"ReplacementContent\":\"        {currentTab === \'beranda\' && (\\n          <BerandaView\\n            onNavigate={(tab) => {\\n              if (tab === \'lemari\') setLemariSearchQuery(\'\');\\n              setCurrentTab(tab);\\n              window.scrollTo({ top: 0, behavior: \'smooth\' });\\n            }}\\n            onNavigateLemariWithFilter={(filter) => {\\n              setLemariSearchQuery(\'\');\\n              handleNavigateLemariWithFilter(filter);\\n            }}\\n            onNavigateLemariWithSearch={(query) => {\\n              setLemariFilter(\'semua\');\\n              setLemariSearchQuery(query);\\n              setCurrentTab(\'lemari\');\\n              window.scrollTo({ top: 0, behavior: \'smooth\' });\\n            }}\\n            onNavigateLatihan={handleNavigateLatihan}\\n            medicines={medicines}\\n            onOpenKamus={(query = \'\') => {\\n              setKamusQuery(query);\\n              setIsKamusOpen(true);\\n            }}\\n            onOpenPanduan={(mode = \'simpan\') =>\\n              setPanduanState({ isOpen: true, mode })\\n            }\\n            onOpenTinjau={SHOW_REVIEWER_TOOLS ? () => setIsTinjauOpen(true) : undefined}\\n            onOpenAbout={() => setIsAboutOpen(true)}\\n          />\\n        )}\\n\\n        {currentTab === \'cek-label\' && (\\n          <CekLabelView\\n            onOpenKamus={() => {\\n              setKamusQuery(\'\');\\n              setIsKamusOpen(true);\\n            }}\\n          />\\n        )}\\n\\n        {currentTab === \'lemari\' && (\\n          <LemariView\\n            medicines={medicines}\\n            onAddMedicine={handleAddMedicine}\\n            onEditMedicine={handleEditMedicine}\\n            onDeleteMedicine={handleDeleteMedicine}\\n            initialFilter={lemariFilter}\\n            initialSearchQuery={lemariSearchQuery}\\n            onOpenPanduan={(mode = \'simpan\') =>\\n              setPanduanState({ isOpen: true, mode })\\n            }\\n          />\\n        )}\", \"StartLine\":117, \"TargetContent\":\"        {currentTab === \'beranda\' && (\\n          <BerandaView\\n            onNavigate={(tab) => {\\n              setCurrentTab(tab);\\n              window.scrollTo({ top: 0, behavior: \'smooth\' });\\n            }}\\n            onNavigateLemariWithFilter={handleNavigateLemariWithFilter}\\n            onNavigateLatihan={handleNavigateLatihan}\\n            medicines={medicines}\\n            onOpenKamus={() => setIsKamusOpen(true)}\\n            onOpenTinjau={SHOW_REVIEWER_TOOLS ? () => setIsTinjauOpen(true) : undefined}\\n            onOpenAbout={() => setIsAboutOpen(true)}\\n          />\\n        )}\\n\\n        {currentTab === \'cek-label\' && (\\n          <CekLabelView onOpenKamus={() => setIsKamusOpen(true)} />\\n        )}\\n\\n        {currentTab === \'lemari\' && (\\n          <LemariView\\n            medicines={medicines}\\n            onAddMedicine={handleAddMedicine}\\n            onEditMedicine={handleEditMedicine}\\n            onDeleteMedicine={handleDeleteMedicine}\\n            initialFilter={lemariFilter}\\n            onOpenPanduan={(mode = \'simpan\') =>\\n              setPanduanState({ isOpen: true, mode })\\n            }\\n          />\\n        )}\"}, {\"AllowMultiple\":false, \"EndLine\":185, \"ReplacementContent\":\"      <KamusModal\\n        isOpen={isKamusOpen}\\n        onClose={() => setIsKamusOpen(false)}\\n        initialQuery={kamusQuery}\\n      />\", \"StartLine\":181, \"TargetContent\":\"      <KamusModal\\n        isOpen={isKamusOpen}\\n        onClose={() => setIsKamusOpen(false)}\\n      />\"}], \"TargetFile\":\"/src/App.tsx\", \"toolAction\":\"Wiring hero search and guidance handlers in App.tsx\", \"toolSummary\":\"Wire handlers in App.tsx\"}"
      original_name: "multi_replace_file_content"
