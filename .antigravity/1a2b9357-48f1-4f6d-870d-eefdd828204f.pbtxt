  view_file {
    absolute_path_uri: "file:///src/components/TentangModal.tsx"
    end_line: 122
    content: "import React from \'react\';\nimport { ModalShell } from \'./ui\';\nimport { IDENTITAS_PROYEK } from \'../data/identitasProyek\';\nimport { ShieldCheck, BookMarked, UserCheck, Lock, Info, Users } from \'lucide-react\';\n\ninterface TentangModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n}\n\nexport const TentangModal: React.FC<TentangModalProps> = ({ isOpen, onClose }) => {\n  return (\n    <ModalShell\n      isOpen={isOpen}\n      onClose={onClose}\n      title={`Tentang ${IDENTITAS_PROYEK.namaAplikasi}`}\n      subtitle={`Media Edukasi ${IDENTITAS_PROYEK.jenisKarya} ${IDENTITAS_PROYEK.programStudi}`}\n      maxWidth=\"lg\"\n      headerIcon={<Info className=\"w-5 h-5\" />}\n      footer={\n        <div className=\"flex items-center justify-between gap-3\">\n          <span className=\"text-xs text-ink-muted font-medium\">\n            {IDENTITAS_PROYEK.statusVersi}\n          </span>\n          <button\n            type=\"button\"\n            onClick={onClose}\n            className=\"min-h-[44px] px-5 py-2 text-sm font-semibold text-on-brand bg-brand hover:bg-forest rounded-xl transition-colors cursor-pointer\"\n          >\n            Tutup\n          </button>\n        </div>\n      }\n    >\n      <div className=\"space-y-6 text-ink text-sm leading-relaxed\">\n        {/* Section 1: Tujuan */}\n        <div className=\"space-y-2\">\n          <div className=\"flex items-center gap-2 text-forest font-bold\">\n            <BookMarked className=\"w-4 h-4 text-brand shrink-0\" />\n            <h3 className=\"text-xs uppercase tracking-wider\">Tujuan Media Edukasi</h3>\n          </div>\n          <p className=\"text-ink-muted text-sm leading-relaxed\">\n            {IDENTITAS_PROYEK.namaAplikasi} dikembangkan sebagai media edukasi interaktif dalam {IDENTITAS_PROYEK.jenisKarya} Program Studi {IDENTITAS_PROYEK.programStudi}. Sasaran utamanya adalah mahasiswa non-kesehatan dan masyarakat umum untuk meningkatkan kecakapan literasi membaca label obat serta menumbuhkan kebiasaan pengelolaan obat rumah tangga yang aman (Dagusibu: Dapatkan, Gunakan, Simpan, Buang).\n          </p>\n        </div>\n\n        {/* Section 2: Tim Pengembang Website */}\n        <div className=\"space-y-3 p-4 bg-surface-warm rounded-2xl border border-line\">\n          <div className=\"flex items-center gap-2 text-forest font-bold\">\n            <Users className=\"w-4 h-4 text-brand shrink-0\" />\n            <h3 className=\"text-sm\">Tim Pengembang Website</h3>\n          </div>\n          <p className=\"text-xs sm:text-sm text-ink-muted leading-relaxed\">\n            Dikembangkan sebagai luaran {IDENTITAS_PROYEK.jenisKarya} oleh mahasiswa Program Studi {IDENTITAS_PROYEK.programStudi}, {IDENTITAS_PROYEK.institusi}.\n          </p>\n          <ul className=\"space-y-1.5 text-xs sm:text-sm text-ink\">\n            {IDENTITAS_PROYEK.timPengembang.map((anggota) => (\n              <li\n                key={anggota.nim}\n                className=\"flex flex-wrap items-baseline justify-between gap-x-3 gap-y-0.5 py-1 border-b border-line/60 last:border-b-0\"\n              >\n                <span className=\"font-semibold text-forest\">{anggota.nama}</span>\n                <span className=\"font-mono text-xs text-ink-muted\">\n                  NIM {anggota.nim}\n                </span>\n              </li>\n            ))}\n          </ul>\n          <p className=\"text-xs font-semibold text-brand pt-1\">\n            {IDENTITAS_PROYEK.programStudi} \342\200\242 {IDENTITAS_PROYEK.institusi} ({IDENTITAS_PROYEK.tahun})\n          </p>\n        </div>\n\n        {/* Section 3: Identitas Kategori Proyek */}\n        <div className=\"space-y-2 p-4 bg-surface rounded-2xl border border-line\">\n          <div className=\"flex items-center gap-2 text-forest font-bold\">\n            <UserCheck className=\"w-4 h-4 text-brand shrink-0\" />\n            <h3 className=\"text-xs uppercase tracking-wider\">Kategori Proyek Akademik</h3>\n          </div>\n          <ul className=\"text-xs space-y-1.5 text-ink-muted\">\n            <li>\n              <strong className=\"text-ink\">Kategori:</strong> {IDENTITAS_PROYEK.kategoriProyek}\n            </li>\n            <li>\n              <strong className=\"text-ink\">Jenis Karya:</strong> {IDENTITAS_PROYEK.jenisKarya}\n            </li>\n            <li>\n              <strong className=\"text-ink\">Status:</strong> {IDENTITAS_PROYEK.statusVersi}\n            </li>\n          </ul>\n        </div>\n\n        {/* Section 4: Batasan Produk */}\n        <div className=\"space-y-2\">\n          <div className=\"flex items-center gap-2 text-status-segera-text font-bold\">\n            <ShieldCheck className=\"w-4 h-4 shrink-0\" />\n            <h3 className=\"text-xs uppercase tracking-wider\">Batasan Produk</h3>\n          </div>\n          <p className=\"text-ink-muted text-xs sm:text-sm leading-relaxed\">\n            {IDENTITAS_PROYEK.kalimatBatasan}\n          </p>\n          <p className=\"text-ink-muted text-xs sm:text-sm leading-relaxed\">\n            Aplikasi ini <strong className=\"text-ink\">TIDAK</strong> menyediakan kalkulator dosis, diagnosis penyakit, atau rekomendasi pemilihan obat tertentu untuk kondisi medis pribadi.\n          </p>\n        </div>\n\n        {/* Section 5: Kebijakan Privasi */}\n        <div className=\"space-y-2\">\n          <div className=\"flex items-center gap-2 text-forest font-bold\">\n            <Lock className=\"w-4 h-4 text-brand shrink-0\" />\n            <h3 className=\"text-xs uppercase tracking-wider\">\n              Kebijakan Privasi (Data On-Device)\n            </h3>\n          </div>\n          <p className=\"text-ink-muted text-xs sm:text-sm leading-relaxed\">\n            Daftar obat yang Anda catat pada menu <em>Lemari Obat</em> disimpan secara eksklusif di memori lokal peramban (<span className=\"font-mono\">localStorage</span>) perangkat Anda. Tidak ada data pribadi, nama obat, atau tanggal yang diunggah ke peladen eksternal mana pun.\n          </p>\n        </div>\n      </div>\n    </ModalShell>\n  );\n};\n"
    num_lines: 123
    num_bytes: 5871
    line_range_bytes: 5871
  }
}
