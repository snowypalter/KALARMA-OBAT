            }
            lines {
              text: "    backDefinition: \'Expired Date adalah batas aman mutu dari pabrik saat kemasan MASIH TERSEGEL UTUH. Beyond Use Date adalah batas aman setelah wadah dibuka oleh pasien.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    backRules: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'ED: Tertera pada strip/botol asli (misal: ED Feb 2028).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'BUD: Dihitung sejak tutup botol dibuka pertama kali atau sirup dilarutkan.\',"
