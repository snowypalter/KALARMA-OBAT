              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\342\224\202                Asisten Chatbot & Indeks Pengetahuan (Server)            \342\224\202"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\342\224\202   ChatbotWidget (Tema Editorial) \342\227\204\342\224\200\342\224\200 SSE \342\224\200\342\224\200\342\226\272 Server Express + Gemini AI \342\224\202"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
