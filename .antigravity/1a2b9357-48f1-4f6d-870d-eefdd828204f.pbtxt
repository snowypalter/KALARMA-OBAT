            lines {
              text: "        currentStepIndex={walkthroughStepIndex}"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        onNext={() =>"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          setWalkthroughStepIndex((prev) =>"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            Math.min(prev + 1, WALKTHROUGH_STEPS.length - 1)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          )"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        onPrev={() => setWalkthroughStepIndex((prev) => Math.max(prev - 1, 0))}"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        onSelectStep={(idx) => {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          setWalkthroughStepIndex(idx);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          scrollToStepTarget(WALKTHROUGH_STEPS[idx].id);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        }}"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
