      thinking_signature: "\022\206\n\n\203\n\001i\024}\023o\326\232\257\201\024\274\\\3023V\354\245\313\\\026\305\315@_\360\232L,{\267\256\366\220\226\333\353G\204\222\027\366\254\204\277V)\232\226\210\034\230\333\342e-\321\361\000R\303\3125\224\374, \221\240J,>\311J\257\322/\277\v\006J\v>\250l0\356\224\\\225=\252\326\205\301M\316Yw}\240\237\374n\224\250\223\356e\'c\262\337B\312-\223\2148\306\316q8?\024\332\327}>R\212pAR\020W\006g\374ts\236\224\301\271\276\363v\272\345V\006l>\261\311\027\272\201w\342\253\266\24341\237a[\360&n\365X\362\3437;\024hB5]\036^Z\257\233.h\022v\226UF\247\v\204~\312\025\253\t]\bO\302e\250@\021#Jg\025\313\203\204,f\253\321}\023\224\000_U\367pN\031\001\213\r\232\a\r\307:\3665[\002\350\207\353C!\344M\365\"\253.\215\343\3116\221N\221z\274\234E1\274\324aTg\033>\226\311\354=\rf\225\006\363~d\345\235\205\333\267\177\367\233\f\243\262\026\263h\271`\f\264\001?:\306fK\364v\257\223\273\305|ft\376!\234\323\265J\326\002\016\n\224\265\374\t6_\354\207\305/\275n\221?oN\020\264\021T\256\\s\277\355\0203sIz8\305\214\a\310\211\257\254q>\022>\252\016\216\vh\002\005\303\034\212\233K\342d\032\373\235\021nkS\002\333\312U+yM\350\363yD\343+\276\241\223=\211\370\244\310 \275Y@\035\361.\2302\262\220\320\223\231\246\305\3631\237\006\177I\214\267\257iE\334\230i\215a\371\027\006\351I\031\312c<7\265<\307\\\025\037\0331\2116Wv\370=+\202$\034H\351p\202\001w\311a;\1775o\326u\214\266\334\217\273f=\027\206I\337\221\t\030\260\002Z$E\353\021^hp\357a\001\214i\a\204Q&\032\350EQ4s\300\034\357d\207^\350\340\006c0`2%/\t\\u;po\320\tR\321\2146\022:\037\305\260%IMj\234\301\030\267\203\242\271\234\373\332\265\355^\213\275=t\272=\026lE9UT\336\340\023vwR\335\304L\275\000\b\220a\3206\371z\242\243<se\212\343\270\241m\223\373\334(\247c#\357\373I\326\262\223\326\331\025\212*\222!\035I_\206r\311\316Y\261\332\256\033K\356\254\375L\024c\322z\244~h9!\317\267\320\177I\036\032Op\'\005\275\311.\226d\271C\335\b \273\220\017L\020,\365\340-f:\315\204\324F\204\3355\267;?C\361=\200_\a\372XY9\350[\031\312c\