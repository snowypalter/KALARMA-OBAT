        target_content: "import React, { useState, useMemo } from \'react\';\nimport { KAMUS_ITEMS } from \'../data/kamusData\';\nimport { ModalShell, RujukanText } from \'./ui\';\nimport { Search, X, BookA } from \'lucide-react\';\n\ninterface KamusModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n}\n\nexport const KamusModal: React.FC<KamusModalProps> = ({ isOpen, onClose }) => {\n  const [searchQuery, setSearchQuery] = useState(\'\');\n  const [selectedLetter, setSelectedLetter] = useState<string>(\'Semua\');"
        replacement_content: "import React, { useState, useMemo, useEffect } from \'react\';\nimport { KAMUS_ITEMS } from \'../data/kamusData\';\nimport { ModalShell, RujukanText } from \'./ui\';\nimport { Search, X, BookA } from \'lucide-react\';\n\ninterface KamusModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  initialQuery?: string;\n}\n\nexport const KamusModal: React.FC<KamusModalProps> = ({\n  isOpen,\n  onClose,\n  initialQuery = \'\',\n}) => {\n  const [searchQuery, setSearchQuery] = useState(initialQuery);\n  const [selectedLetter, setSelectedLetter] = useState<string>(\'Semua\');\n\n  useEffect(() => {\n    if (isOpen && initialQuery !== undefined) {\n      setSearchQuery(initialQuery);\n      setSelectedLetter(\'Semua\');\n    }\n  }, [isOpen, initialQuery]);"
        start_line: 1
        end_line: 16
      }
      num_matches: 1
    }
    description: "Support optional initialQuery prop on KamusModal for instant search from Beranda hero dock"
