            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "Fitur yang Telah Aktif untuk Dicek:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "1. Beranda: Banner peringatan obat kedaluwarsa dinamis, 2 kartu aksi utama, kartu skenario swamedikasi hari ini, akses cepat Kamus & Flashcard."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "1. Beranda: Banner peringatan obat kedaluwarsa dinamis, 2 kartu aksi utama, grafik stok Recharts, panduan walkthrough, kartu skenario swamedikasi hari ini, akses cepat Kamus & Flashcard."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "2. Cek Label: Simulasi kemasan interaktif (Tablet strip foil, Sirup botol cair, Salep tube kulit) dengan 6 titik ketuk resmi (Logo golongan obat, Nama/komposisi, Indikasi, Aturan pakai, Tanggal kedaluwarsa/bets, Nomor Izin Edar NIE BPOM)."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "3. Lemari Obat Saya: Inventaris mandiri, deteksi status otomatis (Aman, Segera kedaluwarsa <=30 hari, Kedaluwarsa) dengan ikon & teks, filter chip, tambah/edit obat, tautan langsung ke panduan pemusnahan obat rusak/kedaluwarsa."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
