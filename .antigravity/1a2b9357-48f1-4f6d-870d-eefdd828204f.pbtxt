              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    - `--surface-muted`: `#EFEEE8` (Krem batu lembut untuk wadah sekunder, bilah tab tersegmentasi, dan kotak kutipan rujukan)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
