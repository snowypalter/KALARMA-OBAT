  view_file {
    absolute_path_uri: "file:///src/components/ui/EmptyState.tsx"
    end_line: 38
    content: "import React from \'react\';\n\nexport interface EmptyStateProps {\n  icon?: React.ReactNode;\n  title: string;\n  description: string;\n  action?: React.ReactNode;\n  className?: string;\n}\n\nexport const EmptyState: React.FC<EmptyStateProps> = ({\n  icon,\n  title,\n  description,\n  action,\n  className = \'\',\n}) => {\n  return (\n    <div\n      className={`p-8 sm:p-12 text-center bg-surface rounded-2xl border border-line space-y-4 max-w-md mx-auto ${className}`}\n    >\n      {icon && (\n        <div className=\"w-14 h-14 rounded-2xl bg-surface-muted text-primary flex items-center justify-center mx-auto shadow-2xs\">\n          {icon}\n        </div>\n      )}\n      <div className=\"space-y-1.5\">\n        <h3 className=\"text-base sm:text-lg font-bold text-ink\">\n          {title}\n        </h3>\n        <p className=\"text-xs sm:text-sm text-ink-muted leading-relaxed\">\n          {description}\n        </p>\n      </div>\n      {action && <div className=\"pt-2\">{action}</div>}\n    </div>\n  );\n};\n"
    num_lines: 39
    num_bytes: 977
    line_range_bytes: 977
  }
}
