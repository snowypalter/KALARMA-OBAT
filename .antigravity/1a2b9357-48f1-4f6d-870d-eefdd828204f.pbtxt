    end_line: 33
    content: "import React from \'react\';\n\nexport interface RujukanTextProps {\n  text: string;\n  className?: string;\n  block?: boolean;\n}\n\nexport const RujukanText: React.FC<RujukanTextProps> = ({\n  text,\n  className = \'\',\n  block = false,\n}) => {\n  const isPlaceholder = typeof text === \'string\' && text.trim().startsWith(\'[ISI DARI RUJUKAN\');\n\n  if (isPlaceholder) {\n    return (\n      <span\n        className={`font-mono text-xs sm:text-[13px] bg-surface-muted text-ink-muted border border-dashed border-line-strong/40 px-2.5 py-1.5 rounded-lg select-text leading-relaxed tracking-tight ${\n          block ? \'block my-1.5\' : \'inline-block\'\n        } ${className}`}\n      >\n        {text}\n      </span>\n    );\n  }\n\n  return (\n    <span className={`text-sm text-ink leading-relaxed ${className}`}>\n      {text}\n    </span>\n  );\n};\n"
    num_lines: 34
    num_bytes: 817
    line_range_bytes: 817
  }
}
