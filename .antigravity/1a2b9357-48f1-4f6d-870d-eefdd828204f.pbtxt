            lines {
              text: "    id: \'skenario-antibiotik\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    title: \'Demam & Godaan Sisa Antibiotik Teman\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    subtitle: \'Kasus Swamedikasi Flu & Batuk\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    badge: \'Antibiotik & AMR\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    patientProfile: {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      name: \'Rian (21 tahun)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      age: \'Mahasiswa Teknik Semester 6\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      condition: \'Demam 38\302\260C, tenggorokan sakit, bersin, dan pilek sejak kemarin.\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    story: \'Rian sedang sibuk mempersiapkan tugas akhir. Karena badannya panas dingin dan tenggorokan nyeri saat menelan, teman satu kosnya menawarkan strip kapsul Amoksisilin 500 mg sisa resep dokter dari sakit giginya bulan lalu. Temannya berkata: \"Minum ini aja Bro, kemarin gigiku langsung sembuh. Biar demammu cepat turun.\"\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    question: \'Berdasarkan etika dan keselamatan penggunaan obat, tindakan mana yang paling bijak dilakukan Rian?\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    options: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        id: \'opt-a\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        text: \'Meminum 1 kapsul amoksisilin tersebut segera untuk membunuh bakteri penyebab demam.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        isBestPractice: false,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        consequence: \'Bahaya Resistensi Antimikroba (AMR) & Tidak Efektif\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        feedback: \'Tindakan ini sangat berbahaya! Demam dan flu sebagian besar disebabkan oleh virus, bukan bakteri, sehingga antibiotik tidak berkhasiat. Meminum antibiotik sisa secara sembarangan memicu bakteri di tubuh menjadi resisten (kebal obat).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        scientificReason: \'Amoksisilin adalah golongan Obat Keras (Lingkaran Merah K) yang hanya boleh diperoleh dengan resep dokter setelah pemeriksaan klinis dan harus dihabiskan satu siklus penuh.\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        id: \'opt-b\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        text: \'Menolak sisa antibiotik, memilih parasetamol (obat bebas) untuk meredakan demam, beristirahat cukup, dan banyak minum air hangat.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        isBestPractice: true,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        consequence: \'Tindakan Tepat & Sesuai Kaidah Swamedikasi Aman\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        feedback: \'Tepat sekali! Flu dan radang tenggorokan awal umumnya infeksi virus swasirna (self-limiting). Parasetamol bertindak sebagai antipiretik dan analgesik aman (lingkaran hijau), dibarengi istirahat untuk memulihkan daya tahan tubuh.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        scientificReason: \'Obat bebas (logo hijau) dapat digunakan untuk meredakan gejala sementara (simtomatik). Apabila gejala demam menetap > 3 hari, barulah diperlukan pemeriksaan faskes.\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        id: \'opt-c\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        text: \'Menghaluskan kapsul amoksisilin lalu dicampur dengan susu hangat agar tidak pahit.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        isBestPractice: false,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        consequence: \'Keliru Ganda: Penggunaan Salah & Potensi Interaksi Obat\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        feedback: \'Salah besar! Selain antibiotik tidak boleh diminum tanpa indikasi medis, membuka isi kapsul secara mandiri dapat merusak kestabilan zat aktif dan interaksi dengan senyawa kalsium pada susu dapat mengganggu penyerapan obat.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        scientificReason: \'Kapsul gelatin dirancang melindungi mukosa lambung dan memastikan zat aktif lepas pada saluran cerna dengan laju yang tepat.\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    redFlags: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Demam tinggi > 39\302\260C yang tidak turun setelah 3 hari mengonsumsi antipiretik.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Disertai sesak napas berat, nyeri dada, atau batuk berdarah.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Kesulitan membuka mulut atau menelan cairan sama sekali.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Muncul ruam kulit merah atau bengkak pada bibir/wajah (tanda syok alergi).\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    referenceCitation: \'Pedoman Penggunaan Antibiotik Bijak Kemenkes RI & BPOM RI - Pencegahan Resistensi Antimikroba\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id: \'skenario-sirup-sendok\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    title: \'Batuk Berdahak & Sendok Makan Dapur\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    subtitle: \'Kasus Takaran Sediaan Cair (Sirup)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    badge: \'Sendok Takar vs Dapur\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    patientProfile: {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      name: \'Ibu Nisa & Faris (7 tahun)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      age: \'Anak Usia Sekolah\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      condition: \'Batuk berdahak sejak 2 hari setelah kehujanan, tidak demam.\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    story: \'Ibu Nisa membeli obat batuk sirup berlogo lingkaran biru (obat bebas terbatas) di apotek. Di rumah, sendok takar plastik bawaan kemasan hilang tercecer. Di label etiket tertulis: \"Aturan Pakai: 3 kali sehari 1 sendok takar obat (5 mL)\". Karena terburu-buru, Ibu Nisa hendak mengambil sendok makan stainless steel yang biasa dipakai makan sup di meja makan.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    question: \'Apakah tindakan menggunakan sendok makan dapur untuk meminumkan sirup obat tersebut dibenarkan?\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    options: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        id: \'opt-a\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        text: \'Boleh, asalkan sendok makan dapur tersebut hanya diisi setengahnya saja.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        isBestPractice: false,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        consequence: \'Risiko Dosis Tidak Akurat (Under/Overdose)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        feedback: \'Kurang tepat! Sendok makan dapur tidak terkalibrasi. Memperkirakan \"setengah sendok\" memiliki variasi volume yang sangat tinggi (antara 4 mL hingga 9 mL tergantung kedalaman lekukan sendok).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        scientificReason: \'Bentuk sediaan cair anak membutuhkan presisi dosis tinggi untuk menghindari toksisitas zat aktif mukolitik atau ekspektoran.\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        id: \'opt-b\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        text: \'Tidak boleh. Sendok makan dapur berkapasitas ~15 mL (3x lipat takaran 5 mL). Sebaiknya gunakan sendok takar obat 5 mL bawaan, syringe oral, atau pipet tetes berskala.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        isBestPractice: true,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        consequence: \'Tindakan Tepat & Mencegah Bahaya Toksisitas Dosis\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        feedback: \'Benar sekali! Sendok makan (C = cochlear) bernilai ~15 mL, sedangkan sendok teh obat (cth = cochlear theae) adalah 5 mL. Menggunakan sendok makan dapur berisiko memberikan obat hingga 300% dari dosis lazim anak!\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        scientificReason: \'Farmakope Indonesia menetapkan sendok obat resmi: 1 sendok teh obat = 5 mL berskala, 1 sendok makan obat = 15 mL berskala.\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        id: \'opt-c\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        text: \'Boleh langsung diminum dari mulut botol secukupnya agar tidak repot mencuci sendok.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        isBestPractice: false,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        consequence: \'Kontaminasi Bakteri & Kerusakan Cepat Sediaan Cair\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        feedback: \'Sangat dilarang! Meminum langsung dari botol memindahkan bakteri air liur ke dalam larutan sirup yang manis, mempercepat pembusukan dan pertumbuhan mikroba, serta dosis sama sekali tidak terukur.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        scientificReason: \'Kemasan sirup mengandung pemanis yang menjadi medium subur mikroorganisme jika terpapar flora mulut.\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    redFlags: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Anak tampak lemas, tarikan dinding dada ke dalam (retraksi napas), atau napas berbunyi mengi (stridor).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Batuk berdahak disertai muntah terus-menerus sehingga obat tidak masuk.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Dahak berwarna kehijauan pekat atau bercampur darah.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Batuk menetap lebih dari 7 hari tanpa perbaikan.\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    referenceCitation: \'Pedoman Pelayanan Farmasi Pediatrik Kemenkes RI & Tata Laksana Batuk Swamedikasi BPOM\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id: \'skenario-salep-steroid\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    title: \'Gatal Selangkangan & Salep Milik Saudara\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    subtitle: \'Kasus Sediaan Semipadat (Salep Kulit)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    badge: \'Obat Keras & Kulit\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    patientProfile: {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      name: \'Dimas (24 tahun)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      age: \'Karyawan Swasta\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      condition: \'Gatal dan ruam merah melingkar di area lipatan paha setelah olahraga berulang.\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    story: \'Dimas merasa tidak nyaman dengan gatal di lipatan pahanya yang makin meluas. Kakaknya menyodorkan sisa tube salep kulit berlabel \"Kloramfenikol + Deksametason\" atau salep Betametason dengan logo Lingkaran Merah K yang tertinggal di laci obat keluarga. Kakaknya berkata: \"Pakai ini aja, salep dewa gatal langsung reda dalam 1 jam.\"\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    question: \'Bagaimana analisis farmasi terhadap langkah penggunaan salep kortikosteroid tersebut?\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    options: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        id: \'opt-a\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        text: \'Mengoleskan salep tersebut tebal-tebal 4 kali sehari di seluruh permukaan ruam agar gatal cepat tuntas.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        isBestPractice: false,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        consequence: \'Fatal: Infeksi Jamur Meledak & Atrofi Kulit Menipis\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        feedback: \'Tindakan ini sangat berbahaya! Ruam melingkar di lipatan paha setelah olahraga lembap sering kali merupakan Tinea cruris (infeksi jamur kurap). Kortikosteroid menekan sistem imun lokal, sehingga jamur akan berkembang biak makin ganas!\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        scientificReason: \'Kortikosteroid potensi sedang/kuat tanpa antijamur pada infeksi mikosis menyebabkan Tinea Incognito dan penipisan lapisan dermis kulit (atrofi).\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        id: \'opt-b\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        text: \'Tidak mengoleskan salep steroid keras tersebut. Jaga area tetap kering, gunakan pakaian dalam bersih longgar, dan konsultasikan ke apoteker/dokter untuk membedakan alergi vs infeksi jamur.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        isBestPractice: true,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        consequence: \'Tindakan Tepat & Rasional Mencegah Perburukan Penyakit\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        feedback: \'Luar biasa! Gejala gatal kulit memiliki etiologi sangat beragam (infeksi jamur, scabies, bakteri, atau dermatitis kontak). Salep berlogo K keras memerlukan diagnosis tepat agar tidak memperparah infeksi.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        scientificReason: \'Sediaan semipadat berlogo Lingkaran Merah K wajib berdasarkan resep dan diagnosis dokter untuk memastikan agen kausatif (antifungi vs antiinflamasi).\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        id: \'opt-c\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        text: \'Mencampur salep tersebut dengan alkohol 70% sebelum dioleskan agar steril.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        isBestPractice: false,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        consequence: \'Kerusakan Basis Salep & Iritasi Perih Berat\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        feedback: \'Sangat keliru! Alkohol 70% merusak basis sediaan salep dan akan menyebabkan sensasi terbakar yang menyiksa pada kulit yang sedang teriritasi atau lecet.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        scientificReason: \'Sediaan salep dirancang dengan basis hidrokarbon/lemak yang tidak kompatibel dengan alkohol pelarut polar.\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    redFlags: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Ruam kulit meluas dengan nanah, luka lepuh, atau demam tinggi.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Rasa perih menyengat hebat menyerupai luka bakar.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Gatal menyebar ke seluruh anggota keluarga di rumah (waspada skabies/kudis).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Tidak membaik setelah 5 hari perawatan kebersihan mandiri.\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    referenceCitation: \'Pedoman Penatalaksanaan Penyakit Kulit Perhimpunan Dokter Spesialis Kulit & Kelamin (PERDOSKI) & Farmakope Indonesia\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id: \'skenario-antasida\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    title: \'Nyeri Lambung (Maag) & Waktu Minum Antasida\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    subtitle: \'Kasus Aturan Pakai & Waktu Minum Obat\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    badge: \'Aturan Pakai Optimal\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    patientProfile: {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      name: \'Maya (22 tahun)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      age: \'Mahasiswi Arsitektur\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      condition: \'Nyeri perih di ulu hati, mual, dan rasa terbakar di dada karena sering terlambat makan.\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    story: \'Maya membeli tablet kunyah Antasida di minimarket (logo hijau). Karena lapar dan perutnya perih, Maya segera makan nasi padang sampai kenyang. Tepat setelah suapan terakhir selesai, Maya langsung menelan utuh satu tablet antasida dengan segelas air es.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    question: \'Apakah cara Maya mengonsumsi tablet antasida tersebut sudah tepat sesuai kaidah farmasi klinis?\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    options: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        id: \'opt-a\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        text: \'Sudah tepat karena semua obat lambung harus diminum saat perut kenyang agar lambung tidak teriritasi.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        isBestPractice: false,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        consequence: \'Efek Netralisasi Asam Lambung Tidak Optimal\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        feedback: \'Kurang tepat! Antasida justru berkhasiat paling optimal saat diminum 1 jam sebelum makan atau 2 jam setelah makan (saat perut kosong), dan harus dikunyah lumat terlebih dahulu sebelum ditelan.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        scientificReason: \'Antasida bekerja secara kimiawi lokal menetralisir asam lambung bebas (HCl). Makanan kenyang akan mempercepat pengosongan lambung sehingga antasida keluar sebelum sempat bekerja.\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        id: \'opt-b\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        text: \'Keliru. Tablet antasida wajib dikunyah halus terlebih dahulu, diminum 1 jam sebelum makan atau 2 jam setelah makan, atau menjelang tidur malam.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        isBestPractice: true,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        consequence: \'Tindakan Tepat: Luas Permukaan Kontak Maksimal\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        feedback: \'Tepat sekali! Mengunyah tablet antasida bertujuan memperluas permukaan kontak partikel basa antasida (Al-hidroksida / Mg-hidroksida) dengan cairan asam lambung, memberikan peredaan nyeri ulu hati yang cepat.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        scientificReason: \'Tablet kunyah (chewable tablet) diformulasikan khusus agar dihancurkan oleh gigi sehingga absorpsi dan reaksi netralisasi lokal di lambung berjalan seketika.\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        id: \'opt-c\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        text: \'Tablet antasida harus dilarutkan ke dalam air mendidih lalu diminum seperti teh herbal.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        isBestPractice: false,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        consequence: \'Merusak Bentuk Sediaan Tablet Kunyah\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        feedback: \'Salah! Tablet kunyah antasida bukan tablet effervescent. Melarutkannya dalam air panas tidak dianjurkan dan menurunkan kenyamanan konsumsi.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        scientificReason: \'Formulasi tablet kunyah mengandung zat perasa (peppermint/manis) yang ditujukan untuk mastikasi di rongga mulut.\'"
