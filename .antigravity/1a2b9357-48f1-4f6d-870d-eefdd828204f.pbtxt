    end_line: 321
    content: "import \'dotenv/config\';\nimport express from \'express\';\nimport path from \'node:path\';\nimport { GoogleGenAI, ThinkingLevel, type Content, type GenerateContentResponse } from \'@google/genai\';\nimport { knowledgeBase } from \'./server/knowledgeBase.ts\';\n\nconst PORT = Number(process.env.PORT) || 3000;\nconst IS_PROD = process.env.NODE_ENV === \'production\';\n\nfunction getGeminiClient(): GoogleGenAI {\n  const apiKey = process.env.GEMINI_API_KEY;\n  if (!apiKey) {\n    throw new Error(\'GEMINI_API_KEY_MISSING\');\n  }\n  return new GoogleGenAI({\n    apiKey,\n    httpOptions: {\n      headers: {\n        \'User-Agent\': \'aistudio-build\',\n      },\n    },\n  });\n}\n\ninterface IncomingMessage {\n  role: \'user\' | \'model\';\n  text: string;\n}\n\nfunction buildSanitizedHistory(messages: IncomingMessage[]): Content[] {\n  // Ensure history starts with \'user\', alternates user/model, and excludes empty messages\n  const cleaned: Content[] = [];\n  for (const msg of messages) {\n    const text = (msg.text || \'\').trim();\n    if (!text) continue;\n    if (cleaned.length === 0 && msg.role !== \'user\') continue;\n\n    const lastRole = cleaned.length > 0 ? cleaned[cleaned.length - 1].role : null;\n    if (lastRole === msg.role) {\n      // Merge consecutive same-role entries safely\n      const prevParts = cleaned[cleaned.length - 1].parts ?? [];\n      const prevText = prevParts[0]?.text ?? \'\';\n      cleaned[cleaned.length - 1] = {\n        role: msg.role,\n        parts: [{ text: `${prevText}\\n\\n${text}` }],\n      };\n    } else {\n      cleaned.push({\n        role: msg.role,\n        parts: [{ text }],\n      });\n    }\n  }\n\n  // History passed to ai.chats.create should end on \'model\' so the next sendMessage is \'user\'\n  if (cleaned.length > 0 && cleaned[cleaned.length - 1].role === \'user\') {\n    cleaned.pop();\n  }\n  return cleaned;\n}\n\nfunction formatGeminiError(err: unknown): { status: number; message: string } {\n  const raw = err instanceof Error ? err.message : String(err);\n  if (raw.includes(\'GEMINI_API_KEY_MISSING\')) {\n    return {\n      status: 500,\n      message: \'API key Gemini belum dikonfigurasi pada server. Silakan periksa panel Settings > Secrets.\',\n    };\n  }\n  if (raw.includes(\'PERMISSION_DENIED\') || raw.includes(\'API_KEY_INVALID\') || raw.includes(\'403\') || raw.includes(\'400\')) {\n    return {\n      status: 400,\n      message: \'Kunci API Gemini tidak valid atau izin ditolak. Periksa API key pada panel Settings > Secrets.\',\n    };\n  }\n  if (raw.includes(\'RESOURCE_EXHAUSTED\') || raw.includes(\'429\')) {\n    return {\n      status: 429,\n      message: \'Batas kuota permintaan Gemini sementara tercapai. Silakan coba beberapa saat lagi.\',\n    };\n  }\n  if (raw.includes(\'NOT_FOUND\') || raw.includes(\'404\')) {\n    return {\n      status: 404,\n      message: \'Model Gemini yang diminta tidak ditemukan atau tidak didukung.\',\n    };\n  }\n  return {\n    status: 500,\n    message: `Terjadi kendala saat memproses jawaban AI: ${raw}`,\n  };\n}\n\nasync function startServer() {\n  const app = express();\n\n  app.use(express.json({ limit: \'50mb\' }));\n\n  // Pre-load website content and any .zip/book files in knowledge_books/\n  await knowledgeBase.ensureInitialized();\n\n  // Health check\n  app.get(\'/api/health\', (_req, res) => {\n    res.json({ ok: true, summary: knowledgeBase.getSummary() });\n  });\n\n  // Knowledge sources summary\n  app.get(\'/api/knowledge\', async (_req, res) => {\n    try {\n      await knowledgeBase.ensureInitialized();\n      res.json(knowledgeBase.getSummary());\n    } catch (err) {\n      res.status(500).json({\n        error: err instanceof Error ? err.message : \'Gagal memuat ringkasan sumber pengetahuan.\',\n      });\n    }\n  });\n\n  // Reload knowledge_books folder manually\n  app.post(\'/api/knowledge/reload\', async (_req, res) => {\n    try {\n      const summary = await knowledgeBase.reload();\n      res.json(summary);\n    } catch (err) {\n      res.status(500).json({\n        error: err instanceof Error ? err.message : \'Gagal memuat ulang folder sumber buku.\',\n      });\n    }\n  });\n\n  // Upload .zip or book file (.pdf, .txt, .md)\n  app.post(\'/api/knowledge/upload\', async (req, res) => {\n    try {\n      const { fileName, base64Data } = req.body as { fileName?: string; base64Data?: string };\n      if (!fileName || !base64Data) {\n        res.status(400).json({ error: \'fileName dan base64Data wajib disertakan.\' });\n        return;\n      }\n\n      const ext = path.extname(fileName).toLowerCase();\n      if (![\'.zip\', \'.pdf\', \'.txt\', \'.md\', \'.csv\', \'.json\', \'.html\', \'.htm\'].includes(ext)) {\n        res.status(400).json({\n          error: \'Format file tidak didukung. Gunakan file .zip, .pdf, .txt, atau .md.\',\n        });\n        return;\n      }\n\n      const buffer = Buffer.from(base64Data, \'base64\');\n      if (buffer.length === 0) {\n        res.status(400).json({ error: \'File kosong atau rusak.\' });\n        return;\n      }\n\n      const summary = await knowledgeBase.ingestUploadedFile(fileName, buffer);\n      res.json(summary);\n    } catch (err) {\n      res.status(500).json({\n        error: err instanceof Error ? err.message : \'Gagal memproses file sumber buku.\',\n      });\n    }\n  });\n\n  // Delete uploaded book source\n  app.delete(\'/api/knowledge/:fileName\', async (req, res) => {\n    try {\n      const summary = await knowledgeBase.deleteUploadedBook(req.params.fileName);\n      res.json(summary);\n    } catch (err) {\n      res.status(500).json({\n        error: err instanceof Error ? err.message : \'Gagal menghapus file buku.\',\n      });\n    }\n  });\n\n  // Multi-turn Gemini Chat endpoint (SSE Streaming)\n  app.post(\'/api/chat\', async (req, res) => {\n    try {\n      await knowledgeBase.ensureInitialized();\n\n      const {\n        messages = [],\n        activeTab = \'beranda\',\n        speedMode = \'standar\',\n      } = req.body as {\n        messages?: IncomingMessage[];\n        activeTab?: string;\n        speedMode?: \'standar\' | \'cepat\';\n      };\n\n      const latestUserMessage = [...messages].reverse().find((m) => m.role === \'user\')?.text?.trim();\n      if (!latestUserMessage) {\n        res.status(400).json({ error: \'Pesan pertanyaan tidak boleh kosong.\' });\n        return;\n      }\n\n      const ai = getGeminiClient();\n      const summary = knowledgeBase.getSummary();\n      const retrievedChunks = knowledgeBase.retrieveRelevantChunks(latestUserMessage, 8);\n\n      const booksOverview =\n        summary.books.length > 0\n          ? summary.books\n              .map(\n                (b) =>\n                  `- ${b.fileName} (${b.fileType.toUpperCase()}, berisi: ${b.innerFiles.join(\', \') || \'dokumen teks\'})`\n              )\n              .join(\'\\n\')\n          : \'- Belum ada file buku .zip yang ditambahkan.\';\n\n      const contextBlock = retrievedChunks\n        .map(\n          (chunk, idx) =>\n            `[Kutipan ${idx + 1} | Jenis: ${chunk.sourceType === \'book\' ? \'Buku Referensi\' : \'Isi Website\'} | Sumber: ${chunk.sourceName} | Bagian: ${chunk.sectionTitle}]\\n${chunk.text}`\n        )\n        .join(\'\\n\\n---\\n\\n\');\n\n      const systemInstruction = `Kamu adalah \"Asisten Ruang Obat\", chatbot edukasi farmasi klinis dan komunitas untuk website \"Ruang Obat\" (\"Kenali label obatmu, kelola obat di rumahmu\").\n\nPERAN & GAYA KOMUNIKASI:\n- Jawab dengan bahasa Indonesia yang ramah, jelas, terstruktur, dan mudah dipahami oleh mahasiswa non-kesehatan maupun masyarakat umum.\n- Gunakan poin-poin singkat atau penebalan kata penting agar nyaman dibaca di layar ponsel.\n- Pengguna saat ini sedang membuka tab: \"${activeTab}\".\n\nATURAN ETIKA & KESELAMATAN PASIEN (WAJIB DIPATUHI):\n1. Edukasi umum saja: DILARANG memberikan diagnosis penyakit pribadi, resep obat, atau menghitung/menyarankan dosis obat personal untuk pasien tertentu.\n2. Jika pengguna menanyakan keluhan penyakit berat atau dosis pribadi (atau gejala tanda bahaya / red flags), ingatkan dengan sopan untuk berkonsultasi langsung dengan apoteker atau dokter.\n3. JANGAN mengarang fakta regulasi atau nomor registrasi. Utamakan menjawab berdasarkan \"KONTEKS SUMBER\" yang diberikan di bawah ini.\n4. Selalu sebutkan sumber materi yang dipakai dalam jawaban (misalnya nama modul website Ruang Obat atau nama file buku/halaman dari arsip .zip jika tersedia).\n5. Jika informasi yang ditanyakan belum ada di website maupun buku sumber yang dimuat, sampaikan secara jujur bahwa topik tersebut belum tercantum pada sumber buku yang dimuat saat ini, lalu berikan prinsip keselamatan umum yang aman.\n\nDAFTAR BUKU REFERENSI (.ZIP / DOKUMEN) YANG SEDANG DIMUAT:\n${booksOverview}`;\n\n      const priorMessages = messages.slice(0, -1);\n      const history = buildSanitizedHistory(priorMessages);\n\n      const model = speedMode === \'cepat\' ? \'gemini-3.1-flash-lite\' : \'gemini-4-hydrogen\';\n      const thinkingConfig =\n        model === \'gemini-4-hydrogen\'\n          ? { thinkingLevel: ThinkingLevel.MEDIUM }\n          : { thinkingLevel: ThinkingLevel.MINIMAL };\n\n      const chat = ai.chats.create({\n        model,\n        history,\n        config: {\n          systemInstruction,\n          thinkingConfig,\n        },\n      });\n\n      const enrichedPrompt = `KONTEKS SUMBER (WEBSITE RUANG OBAT & BUKU REFERENSI):\n${contextBlock || \'Belum ada potongan konteks tambahan.\'}\n\nPERTANYAAN PENGGUNA:\n${latestUserMessage}`;\n\n      res.setHeader(\'Content-Type\', \'text/event-stream; charset=utf-8\');\n      res.setHeader(\'Cache-Control\', \'no-cache, no-transform\');\n      res.setHeader(\'Connection\', \'keep-alive\');\n\n      const sources = Array.from(\n        new Map(\n          retrievedChunks.map((c) => [\n            `${c.sourceName}:${c.sectionTitle}`,\n            {\n              sourceType: c.sourceType,\n              sourceName: c.sourceName,\n              sectionTitle: c.sectionTitle,\n            },\n          ])\n        ).values()\n      ).slice(0, 5);\n\n      const stream = await chat.sendMessageStream({ message: enrichedPrompt });\n\n      for await (const chunk of stream) {\n        const c = chunk as GenerateContentResponse;\n        const delta = c.text;\n        if (delta) {\n          res.write(`data: ${JSON.stringify({ type: \'chunk\', text: delta })}\\n\\n`);\n        }\n      }\n\n      res.write(`data: ${JSON.stringify({ type: \'done\', sources, model })}\\n\\n`);\n      res.end();\n    } catch (err) {\n      const formatted = formatGeminiError(err);\n      if (!res.headersSent) {\n        res.status(formatted.status).json({ error: formatted.message });\n      } else {\n        res.write(`data: ${JSON.stringify({ type: \'error\', error: formatted.message })}\\n\\n`);\n        res.end();\n      }\n    }\n  });\n\n  if (!IS_PROD) {\n    const { createServer: createViteServer } = await import(\'vite\');\n    const vite = await createViteServer({\n      server: { middlewareMode: true },\n      appType: \'spa\',\n    });\n    app.use(vite.middlewares);\n  } else {\n    const distDir = path.join(process.cwd(), \'dist\');\n    app.use(express.static(distDir));\n    app.get(\'*\', (_req, res) => {\n      res.sendFile(path.join(distDir, \'index.html\'));\n    });\n  }\n\n  app.listen(PORT, \'0.0.0.0\', () => {\n    console.log(`Ruang Obat server running at http://0.0.0.0:${PORT}`);\n  });\n}\n\nstartServer().catch((err) => {\n  console.error(\'Failed to start Ruang Obat server:\', err);\n  process.exit(1);\n});\n"
    num_lines: 322
    num_bytes: 11127
    line_range_bytes: 11127
  }
}
