  view_file {
    absolute_path_uri: "file:///src/views/LemariView.tsx"
    end_line: 548
    content: "import React, { useState } from \'react\';\nimport { MedicineItem, MedicineStatus, SediaanType } from \'../types\';\nimport { \n  getMedicineStatus, \n  calculateDaysRemaining, \n  formatIndonesianDate, \n  getStatusMeta \n} from \'../utils/medicineUtils\';\nimport { \n  Plus, \n  Search, \n  Edit3, \n  Trash2, \n  CheckCircle2, \n  AlertTriangle, \n  AlertOctagon, \n  Calendar, \n  Sparkles, \n  Trash, \n  ShieldCheck, \n  X,\n  Pill,\n  BookOpen\n} from \'lucide-react\';\n\ninterface LemariViewProps {\n  medicines: MedicineItem[];\n  onAddMedicine: (item: Omit<MedicineItem, \'id\' | \'createdAt\'>) => void;\n  onEditMedicine: (id: string, item: Omit<MedicineItem, \'id\' | \'createdAt\'>) => void;\n  onDeleteMedicine: (id: string) => void;\n  onOpenPanduan: (mode?: \'simpan\' | \'buang\') => void;\n  initialFilter?: \'semua\' | \'aman\' | \'segera\' | \'kedaluwarsa\';\n}\n\nconst SEDIAAN_OPTIONS: SediaanType[] = [\n  \'Tablet\',\n  \'Kapsul\',\n  \'Sirup / Cair\',\n  \'Salep / Krim / Gel\',\n  \'Tetes Mata / Telinga\',\n  \'Inhaler / Semprot\',\n  \'Lainnya\'\n];\n\nexport const LemariView: React.FC<LemariViewProps> = ({\n  medicines,\n  onAddMedicine,\n  onEditMedicine,\n  onDeleteMedicine,\n  onOpenPanduan,\n  initialFilter = \'semua\',\n}) => {\n  const [filter, setFilter] = useState<\'semua\' | \'aman\' | \'segera\' | \'kedaluwarsa\'>(initialFilter);\n  const [searchQuery, setSearchQuery] = useState(\'\');\n  const [isFormOpen, setIsFormOpen] = useState(false);\n  const [editingMedicine, setEditingMedicine] = useState<MedicineItem | null>(null);\n\n  // Form states\n  const [formName, setFormName] = useState(\'\');\n  const [formSediaan, setFormSediaan] = useState<SediaanType>(\'Tablet\');\n  const [formExpiryDate, setFormExpiryDate] = useState(\'\');\n  const [formOpenedDate, setFormOpenedDate] = useState(\'\');\n  const [formNotes, setFormNotes] = useState(\'\');\n  const [formError, setFormError] = useState(\'\');\n\n  const openAddModal = () => {\n    setEditingMedicine(null);\n    setFormName(\'\');\n    setFormSediaan(\'Tablet\');\n    // Default expiry 6 months from now\n    const d = new Date();\n    d.setMonth(d.getMonth() + 6);\n    setFormExpiryDate(d.toISOString().split(\'T\')[0]);\n    setFormOpenedDate(\'\');\n    setFormNotes(\'\');\n    setFormError(\'\');\n    setIsFormOpen(true);\n  };\n\n  const openEditModal = (item: MedicineItem) => {\n    setEditingMedicine(item);\n    setFormName(item.name);\n    setFormSediaan(item.sediaan);\n    setFormExpiryDate(item.expiryDate);\n    setFormOpenedDate(item.openedDate || \'\');\n    setFormNotes(item.notes || \'\');\n    setFormError(\'\');\n    setIsFormOpen(true);\n  };\n\n  const handleSaveForm = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!formName.trim()) {\n      setFormError(\'Nama obat wajib diisi.\');\n      return;\n    }\n    if (!formExpiryDate) {\n      setFormError(\'Tanggal kedaluwarsa wajib dipilih.\');\n      return;\n    }\n\n    if (editingMedicine) {\n      onEditMedicine(editingMedicine.id, {\n        name: formName.trim(),\n        sediaan: formSediaan,\n        expiryDate: formExpiryDate,\n        openedDate: formOpenedDate || undefined,\n        notes: formNotes.trim() || undefined,\n      });\n    } else {\n      onAddMedicine({\n        name: formName.trim(),\n        sediaan: formSediaan,\n        expiryDate: formExpiryDate,\n        openedDate: formOpenedDate || undefined,\n        notes: formNotes.trim() || undefined,\n      });\n    }\n\n    setIsFormOpen(false);\n  };\n\n  // Status counts for filter chips\n  const counts = {\n    semua: medicines.length,\n    aman: medicines.filter((m) => getMedicineStatus(m.expiryDate) === \'aman\').length,\n    segera: medicines.filter((m) => getMedicineStatus(m.expiryDate) === \'segera\').length,\n    kedaluwarsa: medicines.filter((m) => getMedicineStatus(m.expiryDate) === \'kedaluwarsa\').length,\n  };\n\n  // Filtered and searched list\n  const filteredMedicines = medicines.filter((m) => {\n    const status = getMedicineStatus(m.expiryDate);\n    const matchesFilter = filter === \'semua\' || status === filter;\n    const matchesSearch = \n      m.name.toLowerCase().includes(searchQuery.toLowerCase()) ||\n      m.sediaan.toLowerCase().includes(searchQuery.toLowerCase()) ||\n      (m.notes && m.notes.toLowerCase().includes(searchQuery.toLowerCase()));\n\n    return matchesFilter && matchesSearch;\n  });\n\n  return (\n    <div className=\"space-y-5 pb-12 animate-in fade-in duration-150\">\n      {/* Header bar: Title & Add Button */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n        <div>\n          <h1 className=\"text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight\">\n            Lemari Obat Saya\n          </h1>\n          <p className=\"text-slate-600 text-sm\">\n            Pantau masa simpan dan waktu kedaluwarsa persediaan obat di rumah.\n          </p>\n        </div>\n\n        <div className=\"flex items-center gap-2\">\n          <button\n            type=\"button\"\n            onClick={() => onOpenPanduan(\'simpan\')}\n            className=\"min-h-[44px] px-3.5 py-2 rounded-xl border border-teal-200 bg-teal-50 hover:bg-teal-100 text-teal-800 text-xs font-semibold flex items-center gap-1.5 transition-colors cursor-pointer\"\n          >\n            <BookOpen className=\"w-4 h-4 text-teal-700\" />\n            <span>Panduan Simpan & Buang</span>\n          </button>\n\n          <button\n            type=\"button\"\n            onClick={openAddModal}\n            className=\"min-h-[44px] px-4 py-2 rounded-xl bg-teal-700 hover:bg-teal-800 text-white font-bold text-xs sm:text-sm flex items-center gap-1.5 shadow-sm transition-transform active:scale-95 cursor-pointer\"\n          >\n            <Plus className=\"w-4 h-4\" />\n            <span>Tambah Obat</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Privacy Banner: Strict rule requirement */}\n      <div className=\"p-3 bg-emerald-50/70 border border-emerald-200/80 rounded-xl flex items-center justify-between gap-2 text-xs text-emerald-900\">\n        <div className=\"flex items-center gap-2\">\n          <ShieldCheck className=\"w-4 h-4 text-emerald-700 shrink-0\" />\n          <span className=\"font-medium\">Data hanya tersimpan di perangkatmu (tidak dikirim ke internet).</span>\n        </div>\n        <span className=\"text-[11px] text-emerald-700 font-semibold hidden sm:inline\">Penyimpanan Lokal</span>\n      </div>\n\n      {/* Search & Filter Chips */}\n      <div className=\"space-y-3\">\n        {/* Search Input */}\n        <div className=\"relative\">\n          <Search className=\"w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none\" />\n          <input\n            type=\"text\"\n            value={searchQuery}\n            onChange={(e) => setSearchQuery(e.target.value)}\n            placeholder=\"Cari obat di lemari...\"\n            className=\"w-full min-h-[44px] pl-10 pr-4 py-2 text-sm bg-white border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-teal-600 focus:border-transparent\"\n          />\n        </div>\n\n        {/* Filter Chips: Semua, Aman, Segera, Kedaluwarsa */}\n        <div className=\"flex items-center gap-2 overflow-x-auto pb-1 no-scrollbar text-xs\">\n          <button\n            type=\"button\"\n            onClick={() => setFilter(\'semua\')}\n            className={`min-h-[40px] px-3.5 py-1.5 rounded-xl font-bold transition-all cursor-pointer flex items-center gap-1.5 ${\n              filter === \'semua\'\n                ? \'bg-slate-900 text-white shadow-xs\'\n                : \'bg-white border border-slate-200 text-slate-700 hover:bg-slate-100\'\n            }`}\n          >\n            <span>Semua</span>\n            <span className={`px-1.5 py-0.2 rounded-full text-[10px] ${filter === \'semua\' ? \'bg-slate-700 text-white\' : \'bg-slate-100 text-slate-600\'}`}>\n              {counts.semua}\n            </span>\n          </button>\n\n          <button\n            type=\"button\"\n            onClick={() => setFilter(\'aman\')}\n            className={`min-h-[40px] px-3.5 py-1.5 rounded-xl font-bold transition-all cursor-pointer flex items-center gap-1.5 ${\n              filter === \'aman\'\n                ? \'bg-emerald-700 text-white shadow-xs\'\n                : \'bg-white border border-slate-200 text-emerald-800 hover:bg-emerald-50\'\n            }`}\n          >\n            <CheckCircle2 className=\"w-3.5 h-3.5\" />\n            <span>Aman</span>\n            <span className={`px-1.5 py-0.2 rounded-full text-[10px] ${filter === \'aman\' ? \'bg-emerald-800 text-white\' : \'bg-emerald-100 text-emerald-800\'}`}>\n              {counts.aman}\n            </span>\n          </button>\n\n          <button\n            type=\"button\"\n            onClick={() => setFilter(\'segera\')}\n            className={`min-h-[40px] px-3.5 py-1.5 rounded-xl font-bold transition-all cursor-pointer flex items-center gap-1.5 ${\n              filter === \'segera\'\n                ? \'bg-amber-600 text-white shadow-xs\'\n                : \'bg-white border border-slate-200 text-amber-800 hover:bg-amber-50\'\n            }`}\n          >\n            <AlertTriangle className=\"w-3.5 h-3.5\" />\n            <span>Segera (\342\211\24430 Hari)</span>\n            <span className={`px-1.5 py-0.2 rounded-full text-[10px] ${filter === \'segera\' ? \'bg-amber-700 text-white\' : \'bg-amber-100 text-amber-900\'}`}>\n              {counts.segera}\n            </span>\n          </button>\n\n          <button\n            type=\"button\"\n            onClick={() => setFilter(\'kedaluwarsa\')}\n            className={`min-h-[40px] px-3.5 py-1.5 rounded-xl font-bold transition-all cursor-pointer flex items-center gap-1.5 ${\n              filter === \'kedaluwarsa\'\n                ? \'bg-rose-700 text-white shadow-xs\'\n                : \'bg-white border border-slate-200 text-rose-800 hover:bg-rose-50\'\n            }`}\n          >\n            <AlertOctagon className=\"w-3.5 h-3.5\" />\n            <span>Kedaluwarsa</span>\n            <span className={`px-1.5 py-0.2 rounded-full text-[10px] ${filter === \'kedaluwarsa\' ? \'bg-rose-800 text-white\' : \'bg-rose-100 text-rose-800\'}`}>\n              {counts.kedaluwarsa}\n            </span>\n          </button>\n        </div>\n      </div>\n\n      {/* List of Medicine Cards */}\n      <div className=\"space-y-3\">\n        {filteredMedicines.length === 0 ? (\n          <div className=\"p-8 sm:p-12 text-center bg-white rounded-2xl border border-slate-200 space-y-3\">\n            <div className=\"w-12 h-12 rounded-full bg-slate-100 text-slate-400 flex items-center justify-center mx-auto\">\n              <Pill className=\"w-6 h-6\" />\n            </div>\n            <div className=\"space-y-1\">\n              <h2 className=\"text-base font-bold text-slate-800\">\n                {medicines.length === 0 ? \'Lemari obatmu masih kosong\' : \'Tidak ada obat yang cocok dengan filter\'}\n              </h2>\n              <p className=\"text-xs sm:text-sm text-slate-500 max-w-sm mx-auto\">\n                {medicines.length === 0\n                  ? \'Catat persediaan obat di rumah untuk memastikan tanggal kedaluwarsa terpantau dengan aman.\'\n                  : \'Coba ubah kata kunci pencarian atau pilih filter status yang lain.\'}\n              </p>\n            </div>\n            <button\n              type=\"button\"\n              onClick={openAddModal}\n              className=\"min-h-[44px] px-5 py-2.5 rounded-xl bg-teal-700 hover:bg-teal-800 text-white text-xs sm:text-sm font-bold inline-flex items-center gap-1.5 cursor-pointer\"\n            >\n              <Plus className=\"w-4 h-4\" />\n              <span>Tambah Obat Sekarang</span>\n            </button>\n          </div>\n        ) : (\n          filteredMedicines.map((item) => {\n            const daysRemaining = calculateDaysRemaining(item.expiryDate);\n            const status: MedicineStatus = getMedicineStatus(item.expiryDate);\n            const meta = getStatusMeta(status, daysRemaining);\n\n            return (\n              <div\n                key={item.id}\n                className={`p-4 sm:p-5 bg-white rounded-2xl border transition-all shadow-2xs space-y-3 ${meta.cardBorder}`}\n              >\n                {/* Header row: Name, Badge, Actions */}\n                <div className=\"flex items-start justify-between gap-3\">\n                  <div className=\"space-y-1\">\n                    <div className=\"flex flex-wrap items-center gap-2\">\n                      <h2 className=\"font-extrabold text-slate-900 text-base sm:text-lg leading-tight\">\n                        {item.name}\n                      </h2>\n                      {/* Status displayed with BOTH icon AND text, never color alone */}\n                      <span\n                        className={`inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold border ${meta.badgeBg}`}\n                      >\n                        {status === \'aman\' && <CheckCircle2 className=\"w-3.5 h-3.5 text-emerald-700\" />}\n                        {status === \'segera\' && <AlertTriangle className=\"w-3.5 h-3.5 text-amber-600\" />}\n                        {status === \'kedaluwarsa\' && <AlertOctagon className=\"w-3.5 h-3.5 text-rose-600\" />}\n                        <span>{meta.label}</span>\n                      </span>\n                    </div>\n\n                    <div className=\"text-xs text-slate-500 font-medium\">\n                      Bentuk: <span className=\"text-slate-700 font-semibold\">{item.sediaan}</span>\n                    </div>\n                  </div>\n\n                  {/* Edit and Delete Buttons */}\n                  <div className=\"flex items-center gap-1 shrink-0\">\n                    <button\n                      type=\"button\"\n                      onClick={() => openEditModal(item)}\n                      className=\"min-h-[38px] min-w-[38px] text-slate-500 hover:text-teal-700 hover:bg-slate-100 rounded-lg flex items-center justify-center transition-colors cursor-pointer\"\n                      aria-label={`Edit ${item.name}`}\n                    >\n                      <Edit3 className=\"w-4 h-4\" />\n                    </button>\n                    <button\n                      type=\"button\"\n                      onClick={() => {\n                        if (confirm(`Hapus \"${item.name}\" dari lemari obat?`)) {\n                          onDeleteMedicine(item.id);\n                        }\n                      }}\n                      className=\"min-h-[38px] min-w-[38px] text-slate-400 hover:text-rose-600 hover:bg-rose-50 rounded-lg flex items-center justify-center transition-colors cursor-pointer\"\n                      aria-label={`Hapus ${item.name}`}\n                    >\n                      <Trash2 className=\"w-4 h-4\" />\n                    </button>\n                  </div>\n                </div>\n\n                {/* Dates Information Grid */}\n                <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs pt-1 border-t border-slate-100\">\n                  <div className=\"flex items-center gap-1.5 text-slate-600\">\n                    <Calendar className=\"w-4 h-4 text-slate-400 shrink-0\" />\n                    <span>\n                      Kedaluwarsa:{\' \'}\n                      <strong className=\"text-slate-800\">\n                        {formatIndonesianDate(item.expiryDate)}\n                      </strong>{\' \'}\n                      ({meta.detailText})\n                    </span>\n                  </div>\n\n                  {item.openedDate && (\n                    <div className=\"flex items-center gap-1.5 text-slate-600\">\n                      <Sparkles className=\"w-4 h-4 text-amber-500 shrink-0\" />\n                      <span>\n                        Pertama Dibuka:{\' \'}\n                        <strong className=\"text-slate-800\">\n                          {formatIndonesianDate(item.openedDate)}\n                        </strong>\n                      </span>\n                    </div>\n                  )}\n                </div>\n\n                {/* Notes if any */}\n                {item.notes && (\n                  <p className=\"text-xs text-slate-600 italic bg-slate-50 p-2 rounded-lg border border-slate-100\">\n                    \"{item.notes}\"\n                  </p>\n                )}\n\n                {/* Conditional Disposal Link for Expired or Expiring items */}\n                {(status === \'kedaluwarsa\' || status === \'segera\') && (\n                  <div className=\"pt-2 border-t border-slate-100 flex items-center justify-between gap-2\">\n                    <span className=\"text-xs text-slate-500\">\n                      {status === \'kedaluwarsa\'\n                        ? \'Obat kedaluwarsa berbahaya bila diminum.\'\n                        : \'Siapkan pengganti sebelum obat kedaluwarsa.\'}\n                    </span>\n                    <button\n                      type=\"button\"\n                      onClick={() => onOpenPanduan(status === \'kedaluwarsa\' ? \'buang\' : \'simpan\')}\n                      className={`text-xs font-bold underline flex items-center gap-1 cursor-pointer ${\n                        status === \'kedaluwarsa\' ? \'text-rose-700 hover:text-rose-900\' : \'text-amber-800 hover:text-amber-950\'\n                      }`}\n                    >\n                      <Trash className=\"w-3.5 h-3.5\" />\n                      <span>Lihat Panduan Simpan & Buang</span>\n                    </button>\n                  </div>\n                )}\n              </div>\n            );\n          })\n        )}\n      </div>\n\n      {/* Form Modal: Tambah / Edit Obat */}\n      {isFormOpen && (\n        <div\n          className=\"fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-4 bg-slate-900/60 backdrop-blur-xs animate-in fade-in duration-200\"\n          role=\"dialog\"\n          aria-modal=\"true\"\n          aria-labelledby=\"form-obat-title\"\n        >\n          <div className=\"bg-white rounded-2xl max-w-md w-full shadow-2xl border border-slate-200 overflow-hidden flex flex-col max-h-[92vh]\">\n            <div className=\"flex items-center justify-between px-5 py-4 border-b border-slate-100 bg-teal-800 text-white\">\n              <h2 id=\"form-obat-title\" className=\"text-base sm:text-lg font-bold\">\n                {editingMedicine ? \'Edit Catatan Obat\' : \'Tambah Obat ke Lemari\'}\n              </h2>\n              <button\n                type=\"button\"\n                onClick={() => setIsFormOpen(false)}\n                className=\"min-h-[44px] min-w-[44px] rounded-lg text-teal-100 hover:text-white flex items-center justify-center cursor-pointer\"\n                aria-label=\"Tutup formulir obat\"\n              >\n                <X className=\"w-5 h-5\" />\n              </button>\n            </div>\n\n            <form onSubmit={handleSaveForm} className=\"p-5 overflow-y-auto space-y-4 text-sm\">\n              {formError && (\n                <div className=\"p-3 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs font-medium\">\n                  {formError}\n                </div>\n              )}\n\n              {/* Nama Obat */}\n              <div className=\"space-y-1\">\n                <label htmlFor=\"form-name\" className=\"block text-xs font-bold text-slate-700 uppercase tracking-wide\">\n                  Nama Obat <span className=\"text-rose-600\">*</span>\n                </label>\n                <input\n                  id=\"form-name\"\n                  type=\"text\"\n                  required\n                  value={formName}\n                  onChange={(e) => setFormName(e.target.value)}\n                  placeholder=\"Misal: Parasetamol 500 mg, Sirup Batuk...\"\n                  className=\"w-full min-h-[44px] px-3.5 py-2 text-sm bg-white border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-teal-600\"\n                />\n              </div>\n\n              {/* Bentuk Sediaan */}\n              <div className=\"space-y-1\">\n                <label htmlFor=\"form-sediaan\" className=\"block text-xs font-bold text-slate-700 uppercase tracking-wide\">\n                  Bentuk Sediaan\n                </label>\n                <select\n                  id=\"form-sediaan\"\n                  value={formSediaan}\n                  onChange={(e) => setFormSediaan(e.target.value as SediaanType)}\n                  className=\"w-full min-h-[44px] px-3 py-2 text-sm bg-white border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-teal-600\"\n                >\n                  {SEDIAAN_OPTIONS.map((opt) => (\n                    <option key={opt} value={opt}>\n                      {opt}\n                    </option>\n                  ))}\n                </select>\n              </div>\n\n              {/* Tanggal Kedaluwarsa */}\n              <div className=\"space-y-1\">\n                <label htmlFor=\"form-expiry\" className=\"block text-xs font-bold text-slate-700 uppercase tracking-wide\">\n                  Tanggal Kedaluwarsa (Exp. Date) <span className=\"text-rose-600\">*</span>\n                </label>\n                <input\n                  id=\"form-expiry\"\n                  type=\"date\"\n                  required\n                  value={formExpiryDate}\n                  onChange={(e) => setFormExpiryDate(e.target.value)}\n                  className=\"w-full min-h-[44px] px-3 py-2 text-sm bg-white border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-teal-600\"\n                />\n                <span className=\"text-[11px] text-slate-500\">\n                  Lihat tanggal yang tercetak di kemasan strip, botol, atau lipatan tube.\n                </span>\n              </div>\n\n              {/* Tanggal Dibuka (Opsional) */}\n              <div className=\"space-y-1\">\n                <label htmlFor=\"form-opened\" className=\"block text-xs font-bold text-slate-700 uppercase tracking-wide\">\n                  Tanggal Pertama Dibuka <span className=\"text-slate-400 font-normal\">(Opsional)</span>\n                </label>\n                <input\n                  id=\"form-opened\"\n                  type=\"date\"\n                  value={formOpenedDate}\n                  onChange={(e) => setFormOpenedDate(e.target.value)}\n                  className=\"w-full min-h-[44px] px-3 py-2 text-sm bg-white border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-teal-600\"\n                />\n                <span className=\"text-[11px] text-slate-500\">\n                  Sangat disarankan untuk sirup atau tetes mata guna memantau Beyond Use Date (BUD).\n                </span>\n              </div>\n\n              {/* Catatan Penyimpanan */}\n              <div className=\"space-y-1\">\n                <label htmlFor=\"form-notes\" className=\"block text-xs font-bold text-slate-700 uppercase tracking-wide\">\n                  Catatan Tambahan <span className=\"text-slate-400 font-normal\">(Opsional)</span>\n                </label>\n                <textarea\n                  id=\"form-notes\"\n                  rows={2}\n                  value={formNotes}\n                  onChange={(e) => setFormNotes(e.target.value)}\n                  placeholder=\"Misal: Simpan di kotak P3K ruang tamu, jauhkan dari anak...\"\n                  className=\"w-full p-3 text-sm bg-white border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-teal-600\"\n                />\n              </div>\n\n              {/* Buttons */}\n              <div className=\"pt-3 border-t border-slate-100 flex items-center justify-end gap-2\">\n                <button\n                  type=\"button\"\n                  onClick={() => setIsFormOpen(false)}\n                  className=\"min-h-[44px] px-4 py-2 text-slate-600 hover:bg-slate-100 font-semibold rounded-xl text-xs sm:text-sm cursor-pointer\"\n                >\n                  Batal\n                </button>\n                <button\n                  type=\"submit\"\n                  className=\"min-h-[44px] px-5 py-2 bg-teal-700 hover:bg-teal-800 text-white font-bold rounded-xl text-xs sm:text-sm shadow-xs cursor-pointer\"\n                >\n                  {editingMedicine ? \'Simpan Perubahan\' : \'Tambahkan ke Lemari\'}\n                </button>\n              </div>\n            </form>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n"
