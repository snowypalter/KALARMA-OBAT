              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    referenceSource: \'Farmakope Indonesia VI & Formularium Nasional\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
