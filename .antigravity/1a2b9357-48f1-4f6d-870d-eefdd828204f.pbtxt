    content: "import React from \'react\';\nimport { X, ShieldCheck, BookMarked, UserCheck, Lock } from \'lucide-react\';\n\ninterface TentangModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n}\n\nexport const TentangModal: React.FC<TentangModalProps> = ({ isOpen, onClose }) => {\n  if (!isOpen) return null;\n\n  return (\n    <div \n      className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/50 backdrop-blur-xs animate-in fade-in duration-200\"\n      role=\"dialog\"\n      aria-modal=\"true\"\n      aria-labelledby=\"tentang-title\"\n    >\n      <div \n        className=\"bg-white rounded-2xl max-w-lg w-full max-h-[90vh] flex flex-col shadow-xl border border-slate-200 overflow-hidden\"\n      >\n        {/* Header */}\n        <div className=\"flex items-center justify-between px-6 py-4 border-b border-slate-100 bg-teal-800 text-white\">\n          <div>\n            <h2 id=\"tentang-title\" className=\"text-lg font-bold\">Tentang Ruang Obat</h2>\n            <p className=\"text-xs text-teal-100\">Media Edukasi Skripsi S1 Farmasi</p>\n          </div>\n          <button\n            type=\"button\"\n            onClick={onClose}\n            className=\"min-h-[44px] min-w-[44px] rounded-lg text-teal-100 hover:text-white hover:bg-teal-700/50 flex items-center justify-center transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-white\"\n            aria-label=\"Tutup jendela informasi tentang\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Content */}\n        <div className=\"p-6 overflow-y-auto space-y-6 text-slate-700 text-sm leading-relaxed\">\n          {/* Section 1: Tujuan */}\n          <div className=\"space-y-2\">\n            <div className=\"flex items-center gap-2 text-teal-800 font-bold\">\n              <BookMarked className=\"w-4 h-4 text-teal-700\" />\n              <h3 className=\"text-sm uppercase tracking-wide\">Tujuan Media Edukasi</h3>\n            </div>\n            <p className=\"text-slate-600 text-sm\">\n              Ruang Obat dikembangkan sebagai instrumen media edukasi interaktif dalam penelitian skripsi S1 Farmasi Klinis dan Komunitas. Sasaran utamanya adalah mahasiswa non-kesehatan dan masyarakat umum untuk meningkatkan kecakapan literasi membaca label obat serta menumbuhkan kebiasaan pengelolaan obat rumah tangga yang aman (Dagusibu: Dapatkan, Gunakan, Simpan, Buang).\n            </p>\n          </div>\n\n          {/* Section 2: Peneliti & Institusi */}\n          <div className=\"space-y-2 p-3.5 bg-slate-50 rounded-xl border border-slate-200\">\n            <div className=\"flex items-center gap-2 text-slate-800 font-bold\">\n              <UserCheck className=\"w-4 h-4 text-teal-700\" />\n              <h3 className=\"text-sm\">Identitas Pengembang & Penelitian</h3>\n            </div>\n            <ul className=\"text-xs space-y-1.5 text-slate-600\">\n              <li><strong className=\"text-slate-700\">Peneliti:</strong> [ISI NAMA PENGEMBANG / PENELITI SKRIPSI]</li>\n              <li><strong className=\"text-slate-700\">NIM / Program Studi:</strong> [ISI NIM & PRODI S1 FARMASI]</li>\n              <li><strong className=\"text-slate-700\">Fakultas / Universitas:</strong> [ISI FAKULTAS & UNIVERSITAS]</li>\n              <li><strong className=\"text-slate-700\">Tahun Penyusunan:</strong> 2026</li>\n            </ul>\n          </div>\n\n          {/* Section 3: Batasan Produk */}\n          <div className=\"space-y-2\">\n            <div className=\"flex items-center gap-2 text-amber-800 font-bold\">\n              <ShieldCheck className=\"w-4 h-4 text-amber-600\" />\n              <h3 className=\"text-sm uppercase tracking-wide\">Batasan Produk</h3>\n            </div>\n            <p className=\"text-slate-600 text-xs sm:text-sm\">\n              Aplikasi ini murni bersifat media edukasi umum. Aplikasi ini <strong>TIDAK</strong> menyediakan kalkulator dosis, diagnosis penyakit, atau rekomendasi pemilihan obat tertentu untuk kondisi medis pribadi. Segala keluhan kesehatan dan pertimbangan dosis obat harus selalu dikonsultasikan secara langsung kepada dokter atau apoteker.\n            </p>\n          </div>\n\n          {/* Section 4: Kebijakan Privasi */}\n          <div className=\"space-y-2\">\n            <div className=\"flex items-center gap-2 text-slate-800 font-bold\">\n              <Lock className=\"w-4 h-4 text-teal-700\" />\n              <h3 className=\"text-sm uppercase tracking-wide\">Kebijakan Privasi (Data On-Device)</h3>\n            </div>\n            <p className=\"text-slate-600 text-xs sm:text-sm\">\n              Daftar obat yang Anda catat pada menu <em>Lemari Obat</em> disimpan secara eksklusif di memori lokal peramban (localStorage) perangkat Anda. Tidak ada data pribadi, nama obat, atau tanggal yang diunggah ke peladen (server) eksternal mana pun.\n            </p>\n          </div>\n        </div>\n\n        {/* Footer */}\n        <div className=\"px-6 py-3 bg-slate-50 border-t border-slate-200 flex justify-end\">\n          <button\n            type=\"button\"\n            onClick={onClose}\n            className=\"min-h-[44px] px-5 py-2 text-sm font-semibold text-white bg-teal-800 hover:bg-teal-900 rounded-xl transition-colors cursor-pointer\"\n          >\n            Tutup\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    num_lines: 102
    num_bytes: 5237
    line_range_bytes: 5237
  }
}
