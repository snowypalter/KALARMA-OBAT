            lines {
              text: "          setWalkthroughStepIndex(idx);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          scrollToStepTarget(WALKTHROUGH_STEPS[idx].id);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        }}"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
