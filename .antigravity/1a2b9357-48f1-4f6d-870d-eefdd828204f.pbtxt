    tool_calls {
      id: "call_2908930543094038056"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React from \'react\';\\nimport { AlertCircle, Info } from \'lucide-react\';\\nimport { IDENTITAS_PROYEK } from \'../data/identitasProyek\';\\n\\ninterface FooterDisclaimerProps {\\n  onOpenAbout?: () => void;\\n}\\n\\nexport const FooterDisclaimer: React.FC<FooterDisclaimerProps> = ({ onOpenAbout }) => {\\n  const daftarNamaTim = IDENTITAS_PROYEK.timPengembang\\n    .map((anggota) => anggota.nama)\\n    .join(\' \302\267 \');\\n\\n  return (\\n    <footer className=\\\"w-full bg-surface-muted/75 border-t border-line py-7 px-4 sm:px-6 mb-20 md:mb-0\\\">\\n      <div className=\\\"max-w-3xl mx-auto flex flex-col items-center text-center gap-2.5\\\">\\n        <div className=\\\"flex items-center gap-1.5 text-forest font-semibold text-xs sm:text-sm\\\">\\n          <AlertCircle className=\\\"w-4 h-4 text-status-segera-text shrink-0\\\" />\\n          <span>Pemberitahuan Edukasi</span>\\n        </div>\\n\\n        <p className=\\\"text-xs sm:text-sm text-ink-muted leading-relaxed max-w-2xl\\\">\\n          {IDENTITAS_PROYEK.kalimatBatasan}\\n        </p>\\n\\n        <div className=\\\"pt-3 border-t border-line w-full max-w-2xl flex flex-col items-center gap-1.5 text-xs text-ink-muted\\\">\\n          <span className=\\\"font-medium text-ink\\\">\\n            {IDENTITAS_PROYEK.taglineFooter}\\n          </span>\\n          <span>\\n            Tim Pengembang: {daftarNamaTim}\\n          </span>\\n          <span>\\n            {IDENTITAS_PROYEK.programStudi} \302\267 {IDENTITAS_PROYEK.institusi} \302\267 {IDENTITAS_PROYEK.statusVersi}\\n          </span>\\n\\n          {onOpenAbout && (\\n            <button\\n              type=\\\"button\\\"\\n              onClick={onOpenAbout}\\n              className=\\\"mt-1 min-h-[44px] inline-flex items-center gap-1.5 text-brand hover:text-forest font-semibold underline-offset-4 hover:underline cursor-pointer py-2 px-3 rounded-xl focus-visible:ring-2 focus-visible:ring-focus\\\"\\n            >\\n              <Info className=\\\"w-3.5 h-3.5\\\" />\\n              <span>Tentang &amp; Batasan Etika</span>\\n            </button>\\n          )}\\n        </div>\\n      </div>\\n    </footer>\\n  );\\n};\\n\", \"Description\":\"Update FooterDisclaimer.tsx to show IDENTITAS_PROYEK info without NIM, plus version status and disclaimer\", \"Overwrite\":true, \"TargetFile\":\"/src/components/FooterDisclaimer.tsx\", \"toolAction\":\"Updating FooterDisclaimer.tsx\", \"toolSummary\":\"Update FooterDisclaimer.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_2908930543094037963"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState } from \'react\';\\nimport { TabType } from \'../types\';\\nimport { SHOW_REVIEWER_TOOLS } from \'../config/appConfig\';\\nimport { Pill, FileText, Share2, Check } from \'lucide-react\';\\n\\ninterface HeaderProps {\\n  currentTab: TabType;\\n  onNavigate: (tab: TabType) => void;\\n  onOpenTinjau: () => void;\\n}\\n\\nexport const Header: React.FC<HeaderProps> = ({\\n  currentTab,\\n  onNavigate,\\n  onOpenTinjau,\\n}) => {\\n  const [copiedPublicLink, setCopiedPublicLink] = useState(false);\\n\\n  const navItems: { id: TabType; label: string }[] = [\\n    { id: \'beranda\', label: \'Beranda\' },\\n    { id: \'cek-label\', label: \'Cek Label\' },\\n    { id: \'lemari\', label: \'Lemari Obat\' },\\n    { id: \'latihan\', label: \'Latihan\' },\\n    { id: \'pustaka\', label: \'Pustaka\' },\\n  ];\\n\\n  const handlePublicShare = async () => {\\n    const shareUrl =\\n      typeof window !== \'undefined\'\\n        ? window.location.href\\n        : \'https://ais-pre-i6cmepgnonm4mfj7yg2xyk-74888050060.asia-east1.run.app\';\\n    const shareData = {\\n      title: \'Ruang Obat \342\200\223 Kenali Label Obatmu, Kelola Obat di Rumahmu\',\\n      text: \'Media edukasi informasi label obat dan pengelolaan obat rumah tangga.\',\\n      url: shareUrl,\\n    };\\n\\n    try {\\n      if (typeof navigator !== \'undefined\' && navigator.share) {\\n        await navigator.share(shareData);\\n        return;\\n      }\\n    } catch {\\n      // Fallback ke salin tautan jika share dibatalkan atau tidak didukung\\n    }\\n\\n    try {\\n      await navigator.clipboard.writeText(shareUrl);\\n      setCopiedPublicLink(true);\\n      setTimeout(() => setCopiedPublicLink(false), 2500);\\n    } catch {\\n      // ignore clipboard errors\\n    }\\n  };\\n\\n  return (\\n    <header className=\\\"sticky top-0 z-30 bg-bg/92 backdrop-blur-md border-b border-line\\\">\\n      <div className=\\\"max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 md:h-[68px] flex items-center justify-between gap-4 sm:gap-8\\\">\\n        {/* Zone 1: Single-element Wordmark */}\\n        <button\\n          type=\\\"button\\\"\\n          onClick={() => onNavigate(\'beranda\')}\\n          className=\\\"min-h-[44px] flex items-center gap-2.5 text-left cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-focus rounded-xl py-1 shrink-0 group\\\"\\n          aria-label=\\\"Kembali ke Beranda Ruang Obat\\\"\\n        >\\n          <span className=\\\"w-8 h-8 rounded-xl bg-forest text-on-brand flex items-center justify-center transition-transform duration-200 group-hover:scale-105\\\">\\n            <Pill className=\\\"w-4 h-4 -rotate-45\\\" />\\n          </span>\\n          <span className=\\\"font-display text-lg sm:text-xl font-semibold text-forest tracking-tight whitespace-nowrap\\\">\\n            Ruang Obat\\n          </span>\\n        </button>\\n\\n        {/* Zone 2: Desktop Single-Line Navigation Links */}\\n        <nav className=\\\"hidden md:flex items-center gap-7 text-sm\\\" aria-label=\\\"Navigasi Desktop\\\">\\n          {navItems.map((item) => {\\n            const isActive = currentTab === item.id;\\n            return (\\n              <button\\n                key={item.id}\\n                type=\\\"button\\\"\\n                onClick={() => onNavigate(item.id)}\\n                className={`relative min-h-[44px] whitespace-nowrap shrink-0 py-2 transition-colors cursor-pointer ${\\n                  isActive\\n                    ? \'text-forest font-semibold\'\\n                    : \'text-ink-muted hover:text-forest font-medium\'\\n                }`}\\n                aria-current={isActive ? \'page\' : undefined}\\n              >\\n                <span>{item.label}</span>\\n                {isActive && (\\n                  <span\\n                    className=\\\"absolute left-0 right-0 -bottom-[1px] h-0.5 bg-brand rounded-full\\\"\\n                    aria-hidden=\\\"true\\\"\\n                  />\\n                )}\\n              </button>\\n            );\\n          })}\\n        </nav>\\n\\n        {/* Zone 3: Reviewer CTA (if enabled) or Public Share CTA */}\\n        <div className=\\\"flex items-center shrink-0\\\">\\n          {SHOW_REVIEWER_TOOLS ? (\\n            <button\\n              type=\\\"button\\\"\\n              onClick={onOpenTinjau}\\n              className=\\\"min-h-[44px] px-4 py-2 text-xs sm:text-sm font-semibold text-on-brand bg-brand hover:bg-forest rounded-xl flex items-center gap-2 transition-colors cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-focus whitespace-nowrap\\\"\\n              aria-label=\\\"Buka berkas dokumen dan tinjauan Tugas Akhir Berbasis Proyek\\\"\\n            >\\n              <FileText className=\\\"w-4 h-4 text-sand shrink-0\\\" />\\n              <span className=\\\"hidden sm:inline\\\">Tinjau / Bagikan</span>\\n              <span className=\\\"sm:hidden\\\">Tinjau</span>\\n            </button>\\n          ) : (\\n            <button\\n              type=\\\"button\\\"\\n              onClick={handlePublicShare}\\n              className={`min-h-[44px] px-4 py-2 text-xs sm:text-sm font-semibold rounded-xl flex items-center gap-2 transition-colors cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-focus whitespace-nowrap ${\\n                copiedPublicLink\\n                  ? \'bg-status-aman-text text-on-brand\'\\n                  : \'bg-brand hover:bg-forest text-on-brand\'\\n              }`}\\n              aria-label=\\\"Bagikan tautan Ruang Obat\\\"\\n            >\\n              {copiedPublicLink ? (\\n                <>\\n                  <Check className=\\\"w-4 h-4 shrink-0\\\" />\\n                  <span>Tersalin!</span>\\n                </>\\n              ) : (\\n                <>\\n                  <Share2 className=\\\"w-4 h-4 shrink-0\\\" />\\n                  <span>Bagikan</span>\\n                </>\\n              )}\\n            </button>\\n          )}\\n        </div>\\n      </div>\\n    </header>\\n  );\\n};\\n\", \"Description\":\"Hide reviewer tools in Header when SHOW_REVIEWER_TOOLS is false while preserving public link sharing\", \"Overwrite\":true, \"TargetFile\":\"/src/components/Header.tsx\", \"toolAction\":\"Updating Header.tsx\", \"toolSummary\":\"Update Header.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_2908930543094037870"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { useState, useEffect } from \'react\';\\nimport { TabType, MedicineItem } from \'./types\';\\nimport { SHOW_REVIEWER_TOOLS } from \'./config/appConfig\';\\nimport { getInitialMedicines } from \'./data/initialMedicines\';\\nimport { calculateDaysRemaining } from \'./utils/medicineUtils\';\\nimport { Header } from \'./components/Header\';\\nimport { BottomNav } from \'./components/BottomNav\';\\nimport { FooterDisclaimer } from \'./components/FooterDisclaimer\';\\nimport { TentangModal } from \'./components/TentangModal\';\\nimport { KamusModal } from \'./components/KamusModal\';\\nimport { PanduanSimpanBuangModal } from \'./components/PanduanSimpanBuangModal\';\\nimport { TinjauDosenModal } from \'./components/TinjauDosenModal\';\\nimport { ChatbotWidget } from \'./components/ChatbotWidget\';\\nimport { BerandaView } from \'./views/BerandaView\';\\nimport { CekLabelView } from \'./views/CekLabelView\';\\nimport { LemariView } from \'./views/LemariView\';\\nimport { LatihanView } from \'./views/LatihanView\';\\nimport { PustakaView } from \'./views/PustakaView\';\\nimport { LatihanSubTab } from \'./types/latihan\';\\n\\nconst STORAGE_KEY = \'ruang_obat_medicines_v1\';\\n\\nexport default function App() {\\n  const [currentTab, setCurrentTab] = useState<TabType>(\'beranda\');\\n  const [latihanSubTab, setLatihanSubTab] = useState<LatihanSubTab>(\'skenario\');\\n  const [lemariFilter, setLemariFilter] = useState<\'semua\' | \'aman\' | \'segera\' | \'kedaluwarsa\'>(\'semua\');\\n\\n  // Modals state\\n  const [isAboutOpen, setIsAboutOpen] = useState(false);\\n  const [isKamusOpen, setIsKamusOpen] = useState(false);\\n  const [isTinjauOpen, setIsTinjauOpen] = useState(false);\\n  const [panduanState, setPanduanState] = useState<{ isOpen: boolean; mode: \'simpan\' | \'buang\' }>({\\n    isOpen: false,\\n    mode: \'simpan\',\\n  });\\n\\n  // LocalStorage state for medicines\\n  const [medicines, setMedicines] = useState<MedicineItem[]>(() => {\\n    try {\\n      const stored = localStorage.getItem(STORAGE_KEY);\\n      if (stored) {\\n        return JSON.parse(stored);\\n      }\\n    } catch {\\n      // ignore\\n    }\\n    return getInitialMedicines();\\n  });\\n\\n  // Save to localStorage whenever medicines change\\n  useEffect(() => {\\n    try {\\n      localStorage.setItem(STORAGE_KEY, JSON.stringify(medicines));\\n    } catch {\\n      // storage unavailable or full\\n    }\\n  }, [medicines]);\\n\\n  // Handle adding new medicine\\n  const handleAddMedicine = (newItem: Omit<MedicineItem, \'id\' | \'createdAt\'>) => {\\n    const item: MedicineItem = {\\n      ...newItem,\\n      id: `med-${Date.now()}`,\\n      createdAt: Date.now(),\\n    };\\n    setMedicines((prev) => [item, ...prev]);\\n  };\\n\\n  // Handle editing existing medicine\\n  const handleEditMedicine = (id: string, updated: Omit<MedicineItem, \'id\' | \'createdAt\'>) => {\\n    setMedicines((prev) =>\\n      prev.map((item) => (item.id === id ? { ...item, ...updated } : item))\\n    );\\n  };\\n\\n  // Handle deleting medicine\\n  const handleDeleteMedicine = (id: string) => {\\n    setMedicines((prev) => prev.filter((item) => item.id !== id));\\n  };\\n\\n  // Quick navigation to Lemari with warning filter\\n  const handleNavigateLemariWithFilter = (filter: \'segera\' | \'kedaluwarsa\' | \'semua\') => {\\n    setLemariFilter(filter);\\n    setCurrentTab(\'lemari\');\\n    window.scrollTo({ top: 0, behavior: \'smooth\' });\\n  };\\n\\n  // Quick navigation to Latihan with specific sub-module\\n  const handleNavigateLatihan = (subTab: LatihanSubTab = \'skenario\') => {\\n    setLatihanSubTab(subTab);\\n    setCurrentTab(\'latihan\');\\n    window.scrollTo({ top: 0, behavior: \'smooth\' });\\n  };\\n\\n  // Count expiring medicines for bottom nav badge\\n  const expiringCount = medicines.filter((m) => {\\n    const days = calculateDaysRemaining(m.expiryDate);\\n    return days <= 30;\\n  }).length;\\n\\n  return (\\n    <div className=\\\"min-h-screen flex flex-col bg-bg text-ink selection:bg-secondary selection:text-forest\\\">\\n      {/* Top Header */}\\n      <Header\\n        currentTab={currentTab}\\n        onNavigate={(tab) => {\\n          setCurrentTab(tab);\\n          window.scrollTo({ top: 0, behavior: \'smooth\' });\\n        }}\\n        onOpenTinjau={() => {\\n          if (SHOW_REVIEWER_TOOLS) setIsTinjauOpen(true);\\n        }}\\n      />\\n\\n      {/* Main Content Area \342\200\224 Spacious max-w-6xl canvas */}\\n      <main className=\\\"flex-1 max-w-6xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8 md:py-10\\\">\\n        {currentTab === \'beranda\' && (\\n          <BerandaView\\n            onNavigate={(tab) => {\\n              setCurrentTab(tab);\\n              window.scrollTo({ top: 0, behavior: \'smooth\' });\\n            }}\\n            onNavigateLemariWithFilter={handleNavigateLemariWithFilter}\\n            onNavigateLatihan={handleNavigateLatihan}\\n            medicines={medicines}\\n            onOpenKamus={() => setIsKamusOpen(true)}\\n            onOpenTinjau={SHOW_REVIEWER_TOOLS ? () => setIsTinjauOpen(true) : undefined}\\n            onOpenAbout={() => setIsAboutOpen(true)}\\n          />\\n        )}\\n\\n        {currentTab === \'cek-label\' && (\\n          <CekLabelView onOpenKamus={() => setIsKamusOpen(true)} />\\n        )}\\n\\n        {currentTab === \'lemari\' && (\\n          <LemariView\\n            medicines={medicines}\\n            onAddMedicine={handleAddMedicine}\\n            onEditMedicine={handleEditMedicine}\\n            onDeleteMedicine={handleDeleteMedicine}\\n            initialFilter={lemariFilter}\\n            onOpenPanduan={(mode = \'simpan\') =>\\n              setPanduanState({ isOpen: true, mode })\\n            }\\n          />\\n        )}\\n\\n        {currentTab === \'latihan\' && (\\n          <LatihanView\\n            onNavigate={(tab) => {\\n              setCurrentTab(tab);\\n              window.scrollTo({ top: 0, behavior: \'smooth\' });\\n            }}\\n            initialSubTab={latihanSubTab}\\n          />\\n        )}\\n\\n        {currentTab === \'pustaka\' && <PustakaView />}\\n      </main>\\n\\n      {/* Footer Disclaimer */}\\n      <FooterDisclaimer onOpenAbout={() => setIsAboutOpen(true)} />\\n\\n      {/* Mobile Bottom Navigation (5 Tabs) */}\\n      <BottomNav\\n        currentTab={currentTab}\\n        onNavigate={(tab) => {\\n          setCurrentTab(tab);\\n          window.scrollTo({ top: 0, behavior: \'smooth\' });\\n        }}\\n        expiringCount={expiringCount}\\n      />\\n\\n      {/* Modals */}\\n      <TentangModal\\n        isOpen={isAboutOpen}\\n        onClose={() => setIsAboutOpen(false)}\\n      />\\n\\n      <KamusModal\\n        isOpen={isKamusOpen}\\n        onClose={() => setIsKamusOpen(false)}\\n      />\\n\\n      <PanduanSimpanBuangModal\\n        isOpen={panduanState.isOpen}\\n        initialTab={panduanState.mode}\\n        onClose={() => setPanduanState({ isOpen: false, mode: \'simpan\' })}\\n      />\\n\\n      {SHOW_REVIEWER_TOOLS && (\\n        <TinjauDosenModal\\n          isOpen={isTinjauOpen}\\n          onClose={() => setIsTinjauOpen(false)}\\n        />\\n      )}\\n\\n      {/* Global Gemini Chatbot Widget (Website + .zip Books) */}\\n      <ChatbotWidget currentTab={currentTab} />\\n    </div>\\n  );\\n}\\n\", \"Description\":\"Gate TinjauDosenModal and reviewer actions behind SHOW_REVIEWER_TOOLS in App.tsx\", \"Overwrite\":true, \"TargetFile\":\"/src/App.tsx\", \"toolAction\":\"Updating App.tsx reviewer gating\", \"toolSummary\":\"Update App.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_2908930543094037777"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState } from \'react\';\\nimport { ModalShell } from \'./ui\';\\nimport {\\n  Copy,\\n  Check,\\n  Share2,\\n  GraduationCap,\\n  ExternalLink,\\n  Printer,\\n  CheckCircle2,\\n  FileText,\\n  FileDown,\\n  Download,\\n} from \'lucide-react\';\\nimport { generateAndDownloadPdf } from \'../utils/generatePdfClient\';\\nimport { IDENTITAS_PROYEK } from \'../data/identitasProyek\';\\n\\ninterface TinjauDosenModalProps {\\n  isOpen: boolean;\\n  onClose: () => void;\\n  defaultTab?: \'pdf\' | \'link\' | \'dosen\';\\n}\\n\\nexport const TinjauDosenModal: React.FC<TinjauDosenModalProps> = ({\\n  isOpen,\\n  onClose,\\n  defaultTab = \'pdf\',\\n}) => {\\n  const [activeTab, setActiveTab] = useState<\'pdf\' | \'link\' | \'dosen\'>(defaultTab);\\n  const [copiedLink, setCopiedLink] = useState(false);\\n  const [copiedFullDoc, setCopiedFullDoc] = useState(false);\\n  const [isGenerating, setIsGenerating] = useState(false);\\n\\n  const currentOrigin =\\n    typeof window !== \'undefined\'\\n      ? window.location.origin\\n      : \'https://ais-pre-i6cmepgnonm4mfj7yg2xyk-74888050060.asia-east1.run.app\';\\n  const sharedUrl =\\n    \'https://ais-pre-i6cmepgnonm4mfj7yg2xyk-74888050060.asia-east1.run.app\';\\n  const bestUrlToShare = currentOrigin.includes(\'localhost\')\\n    ? sharedUrl\\n    : currentOrigin;\\n\\n  const timDenganNim = IDENTITAS_PROYEK.timPengembang\\n    .map((a) => `${a.nama} (NIM ${a.nim})`)\\n    .join(\'; \');\\n\\n  const handleCopyLink = () => {\\n    navigator.clipboard.writeText(bestUrlToShare).then(() => {\\n      setCopiedLink(true);\\n      setTimeout(() => setCopiedLink(false), 2500);\\n    });\\n  };\\n\\n  const handlePrintValidationSheet = () => {\\n    window.print();\\n  };\\n\\n  return (\\n    <ModalShell\\n      isOpen={isOpen}\\n      onClose={onClose}\\n      title=\\\"Berkas Dokumen & Tinjauan Pengembangan\\\"\\n      subtitle=\\\"Dokumen PDF Resmi untuk Dosen Pembimbing dan Penguji\\\"\\n      maxWidth=\\\"2xl\\\"\\n      headerIcon={<FileText className=\\\"w-5 h-5\\\" />}\\n      footer={\\n        <div className=\\\"flex items-center justify-between text-xs text-ink-muted\\\">\\n          <span className=\\\"truncate max-w-[240px] sm:max-w-sm\\\">\\n            {IDENTITAS_PROYEK.namaAplikasi} \302\267 {IDENTITAS_PROYEK.jenisKarya} {IDENTITAS_PROYEK.programStudi}\\n          </span>\\n          <button\\n            type=\\\"button\\\"\\n            onClick={onClose}\\n            className=\\\"min-h-[44px] px-5 py-2 font-semibold text-forest bg-surface border border-line hover:bg-surface-muted rounded-xl transition-colors cursor-pointer\\\"\\n          >\\n            Tutup\\n          </button>\\n        </div>\\n      }\\n    >\\n      <div className=\\\"space-y-5\\\">\\n        {/* Tab Switcher (3 Tab untuk Dosen Pembimbing dan Penguji) */}\\n        <div className=\\\"grid grid-cols-3 gap-1 bg-surface-muted p-1.5 rounded-2xl border border-line text-xs\\\">\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => setActiveTab(\'pdf\')}\\n            className={`min-h-[44px] px-2 py-1.5 rounded-xl font-semibold transition-all flex items-center justify-center gap-1.5 cursor-pointer ${\\n              activeTab === \'pdf\'\\n                ? \'bg-surface text-forest shadow-xs\'\\n                : \'text-ink-muted hover:text-forest\'\\n            }`}\\n          >\\n            <FileDown className=\\\"w-3.5 h-3.5 text-brand shrink-0\\\" />\\n            <span>File PDF</span>\\n          </button>\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => setActiveTab(\'link\')}\\n            className={`min-h-[44px] px-2 py-1.5 rounded-xl font-semibold transition-all flex items-center justify-center gap-1.5 cursor-pointer ${\\n              activeTab === \'link\'\\n                ? \'bg-surface text-forest shadow-xs\'\\n                : \'text-ink-muted hover:text-forest\'\\n            }`}\\n          >\\n            <Share2 className=\\\"w-3.5 h-3.5 text-brand shrink-0\\\" />\\n            <span>Link Web</span>\\n          </button>\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => setActiveTab(\'dosen\')}\\n            className={`min-h-[44px] px-2 py-1.5 rounded-xl font-semibold transition-all flex items-center justify-center gap-1.5 cursor-pointer ${\\n              activeTab === \'dosen\'\\n                ? \'bg-surface text-forest shadow-xs\'\\n                : \'text-ink-muted hover:text-forest\'\\n            }`}\\n          >\\n            <GraduationCap className=\\\"w-3.5 h-3.5 text-brand shrink-0\\\" />\\n            <span className=\\\"hidden sm:inline\\\">Untuk Dosen</span>\\n            <span className=\\\"sm:hidden\\\">Dosen</span>\\n          </button>\\n        </div>\\n\\n        {/* TAB 1: FILE PDF PENGEMBANGAN */}\\n        {activeTab === \'pdf\' && (\\n          <div className=\\\"space-y-4\\\">\\n            <div className=\\\"space-y-1\\\">\\n              <p className=\\\"text-xs font-semibold uppercase tracking-wider text-brand\\\">\\n                Dokumen Pengembangan Siap Diberikan\\n              </p>\\n              <h3 className=\\\"font-display text-lg font-semibold text-forest\\\">\\n                Dokumen PDF Pengembangan {IDENTITAS_PROYEK.jenisKarya} &ldquo;{IDENTITAS_PROYEK.namaAplikasi}&rdquo;\\n              </h3>\\n              <p className=\\\"text-xs sm:text-sm text-ink-muted leading-relaxed\\\">\\n                Berkas PDF ini disusun formal (4 halaman A4 standar akademik) untuk dosen pembimbing dan penguji, berisi rancangan pengembangan, batasan etika farmasi, tabel 6 titik kemasan, serta lembar validasi dosen.\\n              </p>\\n            </div>\\n\\n            <div className=\\\"p-4 sm:p-5 bg-surface-warm rounded-2xl border border-line space-y-4\\\">\\n              <div className=\\\"flex items-center gap-3.5\\\">\\n                <div className=\\\"w-12 h-12 rounded-xl bg-forest text-sand flex items-center justify-center shrink-0\\\">\\n                  <FileText className=\\\"w-6 h-6\\\" />\\n                </div>\\n                <div className=\\\"min-w-0\\\">\\n                  <h4 className=\\\"font-bold text-forest text-sm sm:text-base font-mono truncate\\\">\\n                    Dokumen_Pengembangan_Ruang_Obat.pdf\\n                  </h4>\\n                  <p className=\\\"text-xs text-ink-muted font-medium\\\">\\n                    4 Halaman Lengkap \302\267 Format Cetak A4 \302\267 {IDENTITAS_PROYEK.statusVersi}\\n                  </p>\\n                </div>\\n              </div>\\n\\n              <div className=\\\"space-y-2.5 pt-2 border-t border-line\\\">\\n                <div className=\\\"flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5\\\">\\n                  <button\\n                    type=\\\"button\\\"\\n                    disabled={isGenerating}\\n                    onClick={() => {\\n                      setIsGenerating(true);\\n                      try {\\n                        generateAndDownloadPdf();\\n                      } catch (err) {\\n                        console.error(err);\\n                      } finally {\\n                        setTimeout(() => setIsGenerating(false), 800);\\n                      }\\n                    }}\\n                    className=\\\"flex-1 min-h-[46px] px-5 py-2.5 rounded-xl bg-brand hover:bg-forest text-on-brand font-semibold text-xs sm:text-sm flex items-center justify-center gap-2 transition-colors cursor-pointer text-center\\\"\\n                  >\\n                    <Download className=\\\"w-4 h-4 text-sand\\\" />\\n                    <span>\\n                      {isGenerating\\n                        ? \'Membuat File PDF...\'\\n                        : \'Unduh File PDF Sekarang (Di Perangkat)\'}\\n                    </span>\\n                  </button>\\n\\n                  <button\\n                    type=\\\"button\\\"\\n                    onClick={() => {\\n                      const fullDoc = `# DOKUMEN SPESIFIKASI PENGEMBANGAN MEDIA EDUKASI DIGITAL\\n# ${IDENTITAS_PROYEK.namaAplikasi.toUpperCase()} (\\\"${IDENTITAS_PROYEK.tagline}\\\")\\n\\nIDENTITAS PROYEK:\\n- Aplikasi Web: ${IDENTITAS_PROYEK.namaAplikasi} (Mobile-First Web App)\\n- Kategori Proyek: ${IDENTITAS_PROYEK.kategoriProyek}\\n- Jenis Karya: ${IDENTITAS_PROYEK.jenisKarya}\\n- Program Studi: ${IDENTITAS_PROYEK.programStudi}\\n- Institusi: ${IDENTITAS_PROYEK.institusi}\\n- Tim Pengembang: ${timDenganNim}\\n- Tahun: ${IDENTITAS_PROYEK.tahun}\\n- Status: ${IDENTITAS_PROYEK.statusVersi}\\n\\nBAB I: LATAR BELAKANG & BATASAN ETIKA\\n1. Urgensi: Mengatasi ketidaktepatan swamedikasi, ketidakpahaman membedakan Expired Date pabrik vs Beyond Use Date (BUD), penyalahgunaan antibiotik sisa teman, dan pembuangan obat rusak yang berbahaya.\\n2. Batasan Etika Farmasi (Patient Safety):\\n   - TANPA kalkulator dosis & TANPA diagnosis mandiri\\n   - TANPA klaim berlebihan (\\\"ditinjau apoteker\\\", testimoni)\\n   - Seluruh materi menggunakan rujukan resmi Kemenkes RI, BPOM RI, dan Farmakope\\n   - Data lemari obat 100% tersimpan lokal di browser (localStorage)\\n   - Batasan wajib: \\\"${IDENTITAS_PROYEK.kalimatBatasan}\\\"\\n\\nBAB II: SPESIFIKASI PENGEMBANGAN\\n1. Simulasi Kemasan Interaktif (Tablet, Sirup, Salep) dengan 6 Titik Kritis:\\n   - Titik 1: Logo Golongan Obat (Bebas Hijau, Bebas Terbatas Biru P1-P6, Keras Merah K)\\n   - Titik 2: Nama & Komposisi Zat Aktif (Generik vs Dagang, kekuatan dosis)\\n   - Titik 3: Indikasi Medis Terdaftar\\n   - Titik 4: Aturan Pakai, Waktu Makan & Peringatan Khusus\\n   - Titik 5: Tanggal Kedaluwarsa (Exp Date) & Nomor Bets Produksi\\n   - Titik 6: Nomor Izin Edar (NIE BPOM 15 digit resmi)\\n2. Lemari Obat Saya:\\n   - Status otomatis dengan IKON & TEKS:\\n     * Aman (> 30 hari)\\n     * Segera Kedaluwarsa (<= 30 hari)\\n     * Kedaluwarsa (lewat tanggal)\\n   - Tautan langsung ke Panduan Simpan & Buang (Dagusibu)\\n3. Kamus Label Obat:\\n   - Glosarium 17+ istilah resmi (NIE, BUD, ED, Rekonstitusi, Suhu Simpan, dll.)\\n\\nBAB III: LEMBAR PENILAIAN & VALIDASI DOSEN PEMBIMBING DAN PENGUJI\\n- Tabel 7 Indikator Kelayakan Media/Materi (Skala 1-5)\\n- Kolom catatan asistensi & rekomendasi perbaikan\\n- Kolom persetujuan dan tanda tangan Dosen Pembimbing dan Penguji`;\\n\\n                      navigator.clipboard.writeText(fullDoc).then(() => {\\n                        setCopiedFullDoc(true);\\n                        setTimeout(() => setCopiedFullDoc(false), 2500);\\n                      });\\n                    }}\\n                    className=\\\"min-h-[46px] px-4 py-2.5 rounded-xl bg-surface hover:bg-surface-muted border border-line text-forest font-semibold text-xs flex items-center justify-center gap-1.5 transition-colors cursor-pointer\\\"\\n                  >\\n                    {copiedFullDoc ? (\\n                      <>\\n                        <Check className=\\\"w-4 h-4 text-status-aman-text\\\" />\\n                        <span className=\\\"text-status-aman-text\\\">Teks Tersalin!</span>\\n                      </>\\n                    ) : (\\n                      <>\\n                        <Copy className=\\\"w-4 h-4 text-brand\\\" />\\n                        <span>Salin Naskah (.txt/.md)</span>\\n                      </>\\n                    )}\\n                  </button>\\n                </div>\\n\\n                <p className=\\\"text-[11px] text-ink-muted italic\\\">\\n                  * Tombol unduh memproses file PDF langsung di memori perangkat Anda tanpa kendala jaringan.\\n                </p>\\n              </div>\\n            </div>\\n\\n            <div className=\\\"space-y-2\\\">\\n              <span className=\\\"text-xs font-bold text-forest uppercase tracking-wider block\\\">\\n                Struktur 4 Halaman Dokumen PDF\\n              </span>\\n              <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-2.5 text-xs\\\">\\n                {[\\n                  {\\n                    num: 1,\\n                    title: \'Halaman Judul (Cover)\',\\n                    desc: \'Judul Tugas Akhir Berbasis Proyek, tagline, identitas tim pengembang, tautan web aktif, dan kepatuhan etika.\',\\n                  },\\n                  {\\n                    num: 2,\\n                    title: \'Bab I: Latar Belakang & Etika\',\\n                    desc: \'Urgensi swamedikasi awam, tujuan Dagusibu, 5 batasan etika ketat, & peta navigasi.\',\\n                  },\\n                  {\\n                    num: 3,\\n                    title: \'Bab II: Spesifikasi Pengembangan\',\\n                    desc: \'Tabel spesifikasi 6 titik kemasan (Tablet, Sirup, Salep), algoritma status lemari, & Dagusibu.\',\\n                  },\\n                  {\\n                    num: 4,\\n                    title: \'Bab III: Lembar Penilaian Dosen\',\\n                    desc: \'Tabel evaluasi 7 indikator kelayakan (skala 1-5) untuk dosen pembimbing dan penguji, catatan revisi, & kolom tanda tangan.\',\\n                  },\\n                ].map((pg) => (\\n                  <div\\n                    key={pg.num}\\n                    className=\\\"p-3.5 bg-surface rounded-xl border border-line space-y-1\\\"\\n                  >\\n                    <div className=\\\"font-bold text-forest flex items-center gap-2\\\">\\n                      <span className=\\\"w-5 h-5 rounded-full bg-secondary text-forest flex items-center justify-center text-[10px] font-mono font-bold\\\">\\n                        {pg.num}\\n                      </span>\\n                      <span>{pg.title}</span>\\n                    </div>\\n                    <p className=\\\"text-ink-muted text-[11px] leading-relaxed\\\">\\n                      {pg.desc}\\n                    </p>\\n                  </div>\\n                ))}\\n              </div>\\n            </div>\\n          </div>\\n        )}\\n\\n        {/* TAB 2: Tautan Web & QR Code */}\\n        {activeTab === \'link\' && (\\n          <div className=\\\"space-y-4\\\">\\n            <div className=\\\"space-y-1\\\">\\n              <h3 className=\\\"font-display text-lg font-semibold text-forest\\\">\\n                Tautan Akses Publik Web App\\n              </h3>\\n              <p className=\\\"text-xs sm:text-sm text-ink-muted leading-relaxed\\\">\\n                Bagikan tautan ini kepada dosen pembimbing dan penguji, atau partisipan uji coba agar aplikasi dapat dibuka langsung di peramban ponsel maupun laptop.\\n              </p>\\n            </div>\\n\\n            <div className=\\\"p-4 bg-surface-warm rounded-2xl border border-line space-y-2.5\\\">\\n              <span className=\\\"text-xs font-bold text-forest block\\\">\\n                Tautan Bersama (Shared Preview URL)\\n              </span>\\n              <div className=\\\"flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5\\\">\\n                <div className=\\\"flex-1 p-3 bg-surface border border-line rounded-xl text-xs font-mono text-forest break-all select-all\\\">\\n                  {bestUrlToShare}\\n                </div>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={handleCopyLink}\\n                  className={`min-h-[44px] px-4 py-2 rounded-xl font-semibold text-xs flex items-center justify-center gap-1.5 transition-colors cursor-pointer shrink-0 ${\\n                    copiedLink\\n                      ? \'bg-status-aman-text text-white\'\\n                      : \'bg-brand hover:bg-forest text-on-brand\'\\n                  }`}\\n                >\\n                  {copiedLink ? (\\n                    <>\\n                      <Check className=\\\"w-4 h-4\\\" />\\n                      <span>Tersalin!</span>\\n                    </>\\n                  ) : (\\n                    <>\\n                      <Copy className=\\\"w-4 h-4\\\" />\\n                      <span>Salin Tautan</span>\\n                    </>\\n                  )}\\n                </button>\\n              </div>\\n            </div>\\n\\n            <div className=\\\"p-4 bg-secondary/45 rounded-2xl border border-line flex flex-col sm:flex-row items-center gap-4\\\">\\n              <div className=\\\"w-24 h-24 bg-surface p-2 rounded-xl border border-line flex items-center justify-center shrink-0\\\">\\n                <svg\\n                  viewBox=\\\"0 0 100 100\\\"\\n                  className=\\\"w-full h-full text-forest\\\"\\n                  fill=\\\"currentColor\\\"\\n                >\\n                  <rect x=\\\"5\\\" y=\\\"5\\\" width=\\\"28\\\" height=\\\"28\\\" rx=\\\"4\\\" fill=\\\"currentColor\\\" />\\n                  <rect x=\\\"9\\\" y=\\\"9\\\" width=\\\"20\\\" height=\\\"20\\\" rx=\\\"2\\\" fill=\\\"white\\\" />\\n                  <rect x=\\\"14\\\" y=\\\"14\\\" width=\\\"10\\\" height=\\\"10\\\" fill=\\\"currentColor\\\" />\\n                  <rect x=\\\"67\\\" y=\\\"5\\\" width=\\\"28\\\" height=\\\"28\\\" rx=\\\"4\\\" fill=\\\"currentColor\\\" />\\n                  <rect x=\\\"71\\\" y=\\\"9\\\" width=\\\"20\\\" height=\\\"20\\\" rx=\\\"2\\\" fill=\\\"white\\\" />\\n                  <rect x=\\\"76\\\" y=\\\"14\\\" width=\\\"10\\\" height=\\\"10\\\" fill=\\\"currentColor\\\" />\\n                  <rect x=\\\"5\\\" y=\\\"67\\\" width=\\\"28\\\" height=\\\"28\\\" rx=\\\"4\\\" fill=\\\"currentColor\\\" />\\n                  <rect x=\\\"9\\\" y=\\\"71\\\" width=\\\"20\\\" height=\\\"20\\\" rx=\\\"2\\\" fill=\\\"white\\\" />\\n                  <rect x=\\\"14\\\" y=\\\"76\\\" width=\\\"10\\\" height=\\\"10\\\" fill=\\\"currentColor\\\" />\\n                  <rect x=\\\"38\\\" y=\\\"10\\\" width=\\\"8\\\" height=\\\"8\\\" fill=\\\"currentColor\\\" />\\n                  <rect x=\\\"50\\\" y=\\\"10\\\" width=\\\"8\\\" height=\\\"8\\\" fill=\\\"currentColor\\\" />\\n                  <rect x=\\\"44\\\" y=\\\"24\\\" width=\\\"8\\\" height=\\\"8\\\" fill=\\\"currentColor\\\" />\\n                  <rect x=\\\"10\\\" y=\\\"44\\\" width=\\\"8\\\" height=\\\"8\\\" fill=\\\"currentColor\\\" />\\n                  <rect x=\\\"24\\\" y=\\\"44\\\" width=\\\"8\\\" height=\\\"8\\\" fill=\\\"currentColor\\\" />\\n                  <rect x=\\\"38\\\" y=\\\"38\\\" width=\\\"8\\\" height=\\\"8\\\" fill=\\\"currentColor\\\" />\\n                  <rect x=\\\"52\\\" y=\\\"38\\\" width=\\\"8\\\" height=\\\"8\\\" fill=\\\"currentColor\\\" />\\n                  <rect x=\\\"66\\\" y=\\\"44\\\" width=\\\"8\\\" height=\\\"8\\\" fill=\\\"currentColor\\\" />\\n                  <rect x=\\\"80\\\" y=\\\"44\\\" width=\\\"8\\\" height=\\\"8\\\" fill=\\\"currentColor\\\" />\\n                  <rect x=\\\"44\\\" y=\\\"52\\\" width=\\\"8\\\" height=\\\"8\\\" fill=\\\"currentColor\\\" />\\n                  <rect x=\\\"38\\\" y=\\\"66\\\" width=\\\"8\\\" height=\\\"8\\\" fill=\\\"currentColor\\\" />\\n                  <rect x=\\\"52\\\" y=\\\"66\\\" width=\\\"8\\\" height=\\\"8\\\" fill=\\\"currentColor\\\" />\\n                  <rect x=\\\"66\\\" y=\\\"66\\\" width=\\\"8\\\" height=\\\"8\\\" fill=\\\"currentColor\\\" />\\n                  <rect x=\\\"80\\\" y=\\\"66\\\" width=\\\"8\\\" height=\\\"8\\\" fill=\\\"currentColor\\\" />\\n                  <rect x=\\\"44\\\" y=\\\"80\\\" width=\\\"8\\\" height=\\\"8\\\" fill=\\\"currentColor\\\" />\\n                  <rect x=\\\"66\\\" y=\\\"80\\\" width=\\\"8\\\" height=\\\"8\\\" fill=\\\"currentColor\\\" />\\n                  <rect x=\\\"80\\\" y=\\\"80\\\" width=\\\"8\\\" height=\\\"8\\\" fill=\\\"currentColor\\\" />\\n                </svg>\\n              </div>\\n              <div className=\\\"space-y-1 text-center sm:text-left\\\">\\n                <span className=\\\"text-xs font-bold text-forest block\\\">\\n                  Uji Coba Langsung di Smartphone\\n                </span>\\n                <p className=\\\"text-xs text-ink-muted leading-relaxed\\\">\\n                  Aplikasi ini dirancang dengan ergonomi sentuh yang nyaman di layar ponsel maupun layar lebar desktop.\\n                </p>\\n              </div>\\n            </div>\\n\\n            <div className=\\\"flex justify-end\\\">\\n              <a\\n                href={bestUrlToShare}\\n                target=\\\"_blank\\\"\\n                rel=\\\"noopener noreferrer\\\"\\n                className=\\\"min-h-[44px] px-4 py-2 rounded-xl border border-line hover:bg-surface-muted text-forest font-semibold text-xs flex items-center gap-1.5 transition-colors cursor-pointer\\\"\\n              >\\n                <ExternalLink className=\\\"w-4 h-4 text-brand\\\" />\\n                <span>Buka di Tab Baru Peramban</span>\\n              </a>\\n            </div>\\n          </div>\\n        )}\\n\\n        {/* TAB 3: Untuk Dosen Pembimbing dan Penguji */}\\n        {activeTab === \'dosen\' && (\\n          <div className=\\\"space-y-4\\\">\\n            <div className=\\\"space-y-1\\\">\\n              <h3 className=\\\"font-display text-lg font-semibold text-forest\\\">\\n                Panduan Validasi &amp; Tinjauan Dosen Pembimbing dan Penguji\\n              </h3>\\n              <p className=\\\"text-xs sm:text-sm text-ink-muted leading-relaxed\\\">\\n                Gunakan daftar periksa berikut saat asistensi atau peninjauan {IDENTITAS_PROYEK.jenisKarya} bersama dosen pembimbing dan penguji.\\n              </p>\\n            </div>\\n\\n            <div className=\\\"p-3.5 bg-surface rounded-xl border border-line text-xs space-y-1 text-ink-muted\\\">\\n              <div className=\\\"font-bold text-forest\\\">\\n                {IDENTITAS_PROYEK.programStudi} \302\267 {IDENTITAS_PROYEK.institusi} ({IDENTITAS_PROYEK.tahun})\\n              </div>\\n              <div>Tim Pengembang: {timDenganNim}</div>\\n            </div>\\n\\n            <div className=\\\"space-y-2.5\\\">\\n              {[\\n                {\\n                  title: \'1. Validasi 6 Titik Kritis Kemasan Obat\',\\n                  desc: \'Memastikan titik ketuk pada kemasan Tablet, Sirup, dan Salep mencakup Logo Golongan, Zat Aktif, Indikasi, Aturan Pakai, ED/Bets, dan NIE BPOM sesuai rujukan resmi.\',\\n                },\\n                {\\n                  title: \'2. Kepatuhan Batasan Etika Farmasi (Patient Safety)\',\\n                  desc: \'Aplikasi bebas dari kalkulator dosis, bebas alat diagnosis mandiri, dan bebas rekomendasi terapi pribadi untuk menjaga keselamatan pasien.\',\\n                },\\n                {\\n                  title: \'3. Prinsip Dagusibu & Pengelolaan Obat Rumah Tangga\',\\n                  desc: \'Tersedia panduan penyimpanan dan pemusnahan obat kedaluwarsa/rusak agar tidak disalahgunakan atau mencemari lingkungan.\',\\n                },\\n                {\\n                  title: \'4. Integritas Data & Kerahasiaan (Data On-Device)\',\\n                  desc: \'Semua pencatatan lemari obat hanya tersimpan di memori perangkat responden tanpa mengirim riwayat obat ke server luar.\',\\n                },\\n              ].map((item, idx) => (\\n                <div\\n                  key={idx}\\n                  className=\\\"p-3.5 bg-surface-warm rounded-xl border border-line flex items-start gap-2.5\\\"\\n                >\\n                  <CheckCircle2 className=\\\"w-4 h-4 text-brand shrink-0 mt-0.5\\\" />\\n                  <div className=\\\"text-xs text-ink-muted leading-relaxed\\\">\\n                    <strong className=\\\"text-forest block mb-0.5\\\">{item.title}</strong>\\n                    {item.desc}\\n                  </div>\\n                </div>\\n              ))}\\n            </div>\\n\\n            <div className=\\\"p-4 bg-status-segera-bg/70 rounded-2xl border border-status-segera-text/20 flex flex-col sm:flex-row sm:items-center justify-between gap-3\\\">\\n              <div className=\\\"text-xs text-ink\\\">\\n                <span className=\\\"font-bold text-status-segera-text block\\\">\\n                  Butuh Lembar Cetak untuk Bimbingan?\\n                </span>\\n                <span className=\\\"text-ink-muted\\\">\\n                  Anda dapat mencetak rangkuman checklist ini langsung untuk tatap muka bersama dosen pembimbing dan penguji.\\n                </span>\\n              </div>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={handlePrintValidationSheet}\\n                className=\\\"min-h-[44px] px-4 py-2 bg-status-segera-text hover:opacity-90 text-white font-semibold text-xs rounded-xl flex items-center justify-center gap-1.5 shrink-0 cursor-pointer\\\"\\n              >\\n                <Printer className=\\\"w-3.5 h-3.5\\\" />\\n                <span>Cetak Lembar</span>\\n              </button>\\n            </div>\\n          </div>\\n        )}\\n      </div>\\n    </ModalShell>\\n  );\\n};\\n\", \"Description\":\"Update TinjauDosenModal.tsx to remove Claude tab/references, replace prototipe with pengembangan, and integrate IDENTITAS_PROYEK\", \"Overwrite\":true, \"TargetFile\":\"/src/components/TinjauDosenModal.tsx\", \"toolAction\":\"Updating TinjauDosenModal.tsx\", \"toolSummary\":\"Update TinjauDosenModal.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_2908930543094037684"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { jsPDF } from \'jspdf\';\\nimport { IDENTITAS_PROYEK } from \'../data/identitasProyek\';\\n\\nexport const generateAndDownloadPdf = (options?: {\\n  researcherName?: string;\\n  nim?: string;\\n  university?: string;\\n}) => {\\n  const doc = new jsPDF({\\n    orientation: \'portrait\',\\n    unit: \'mm\',\\n    format: \'a4\',\\n  });\\n\\n  const TEAL_DARK: [number, number, number] = [36, 60, 54]; // #243C36\\n  const TEAL_LIGHT: [number, number, number] = [220, 234, 229]; // #DCEAE5\\n  const SLATE_DARK: [number, number, number] = [34, 49, 44]; // #22312C\\n  const SLATE_MUTED: [number, number, number] = [83, 100, 94]; // #53645E\\n  const AMBER_DARK: [number, number, number] = [124, 75, 12]; // #7C4B0C\\n  const BORDER_COLOR: [number, number, number] = [226, 228, 220]; // #E2E4DC\\n\\n  const timListString =\\n    options?.researcherName ||\\n    IDENTITAS_PROYEK.timPengembang\\n      .map((anggota) => `${anggota.nama} (NIM ${anggota.nim})`)\\n      .join(\', \');\\n\\n  let pageNum = 1;\\n\\n  function drawHeaderFooter(title: string) {\\n    // Top Header Line\\n    doc.setDrawColor(...BORDER_COLOR);\\n    doc.setLineWidth(0.3);\\n    doc.line(15, 14, 195, 14);\\n\\n    doc.setFont(\'helvetica\', \'normal\');\\n    doc.setFontSize(8);\\n    doc.setTextColor(...SLATE_MUTED);\\n    doc.text(\\n      `RUANG OBAT \302\267 MEDIA EDUKASI ${IDENTITAS_PROYEK.jenisKarya.toUpperCase()}`,\\n      15,\\n      11\\n    );\\n    doc.text(title, 195, 11, { align: \'right\' });\\n\\n    // Bottom Footer Line\\n    doc.line(15, 282, 195, 282);\\n    doc.text(\\n      \'Ruang Obat adalah media edukasi informasi obat dan tidak menggantikan saran apoteker atau dokter.\',\\n      15,\\n      286\\n    );\\n    doc.text(`Halaman ${pageNum}`, 195, 286, { align: \'right\' });\\n  }\\n\\n  // ==========================================\\n  // HALAMAN 1: COVER / HALAMAN JUDUL\\n  // ==========================================\\n  doc.setFillColor(...TEAL_DARK);\\n  doc.rect(0, 0, 210, 22, \'F\');\\n\\n  doc.setFont(\'helvetica\', \'bold\');\\n  doc.setFontSize(10.5);\\n  doc.setTextColor(255, 255, 255);\\n  doc.text(\\n    `${IDENTITAS_PROYEK.jenisKarya.toUpperCase()} \302\267 ${IDENTITAS_PROYEK.programStudi.toUpperCase()}`,\\n    105,\\n    14,\\n    { align: \'center\' }\\n  );\\n\\n  // Main Card Box\\n  doc.setFillColor(251, 249, 245);\\n  doc.setDrawColor(...TEAL_DARK);\\n  doc.setLineWidth(0.8);\\n  doc.roundedRect(15, 34, 180, 108, 4, 4, \'FD\');\\n\\n  // Subtitle badge\\n  doc.setFillColor(...TEAL_LIGHT);\\n  doc.setDrawColor(94, 126, 116);\\n  doc.roundedRect(22, 43, 166, 10, 2, 2, \'FD\');\\n  doc.setFont(\'helvetica\', \'bold\');\\n  doc.setFontSize(8.5);\\n  doc.setTextColor(...TEAL_DARK);\\n  doc.text(\\n    \'DOKUMEN SPESIFIKASI PENGEMBANGAN MEDIA EDUKASI DIGITAL\',\\n    105,\\n    49.5,\\n    { align: \'center\' }\\n  );\\n\\n  // Big Title\\n  doc.setFont(\'helvetica\', \'bold\');\\n  doc.setFontSize(26);\\n  doc.setTextColor(...SLATE_DARK);\\n  doc.text(\'RUANG OBAT\', 105, 68, { align: \'center\' });\\n\\n  // Tagline\\n  doc.setFont(\'helvetica\', \'normal\');\\n  doc.setFontSize(13);\\n  doc.setTextColor(...TEAL_DARK);\\n  doc.text(`\\\"${IDENTITAS_PROYEK.tagline}\\\"`, 105, 78, { align: \'center\' });\\n\\n  doc.setDrawColor(...BORDER_COLOR);\\n  doc.setLineWidth(0.4);\\n  doc.line(40, 86, 170, 86);\\n\\n  // Description paragraph\\n  doc.setFont(\'helvetica\', \'normal\');\\n  doc.setFontSize(9.5);\\n  doc.setTextColor(...SLATE_MUTED);\\n  const coverDesc =\\n    \'Dokumen pengembangan media edukasi interaktif untuk pengenalan informasi etiket/kemasan obat dan pengelolaan obat rumah tangga (Dagusibu). Disiapkan untuk peninjauan Dosen Pembimbing dan Dosen Penguji.\';\\n  const splitCoverDesc = doc.splitTextToSize(coverDesc, 150);\\n  doc.text(splitCoverDesc, 105, 95, { align: \'center\' });\\n\\n  // Information Grid Box\\n  doc.setFillColor(255, 255, 255);\\n  doc.setDrawColor(...BORDER_COLOR);\\n  doc.roundedRect(15, 150, 180, 90, 3, 3, \'FD\');\\n\\n  doc.setFont(\'helvetica\', \'bold\');\\n  doc.setFontSize(10.5);\\n  doc.setTextColor(...SLATE_DARK);\\n  doc.text(\'INFORMASI IDENTITAS PROYEK\', 22, 161);\\n\\n  doc.setFont(\'helvetica\', \'normal\');\\n  doc.setFontSize(8.8);\\n  doc.setTextColor(...SLATE_DARK);\\n\\n  const metaRows: [string, string][] = [\\n    [\'Nama Aplikasi\', `: ${IDENTITAS_PROYEK.namaAplikasi} (Media Edukasi Web Responsif)`],\\n    [\'Kategori Proyek\', `: ${IDENTITAS_PROYEK.kategoriProyek}`],\\n    [\'Program Studi\', `: ${IDENTITAS_PROYEK.programStudi}`],\\n    [\'Institusi\', `: ${options?.university || IDENTITAS_PROYEK.institusi}`],\\n    [\'Jenis Karya\', `: ${IDENTITAS_PROYEK.jenisKarya}`],\\n    [\'Tim Pengembang\', `: ${timListString}`],\\n    [\'Tahun & Status\', `: ${IDENTITAS_PROYEK.tahun} \302\267 ${IDENTITAS_PROYEK.statusVersi}`],\\n    [\\n      \'Status Pengembangan\',\\n      \': Beranda, Cek Label 3 Sediaan, Lemari Obat, Kamus, Latihan, & Pustaka\',\\n    ],\\n  ];\\n\\n  let curY = 170;\\n  metaRows.forEach(([label, val]) => {\\n    doc.setFont(\'helvetica\', \'bold\');\\n    doc.setTextColor(...SLATE_MUTED);\\n    doc.text(label, 22, curY);\\n    doc.setFont(\'helvetica\', \'normal\');\\n    doc.setTextColor(...SLATE_DARK);\\n    const wrappedVal = doc.splitTextToSize(val, 122);\\n    doc.text(wrappedVal, 66, curY);\\n    curY += wrappedVal.length > 1 ? wrappedVal.length * 4.8 + 2.5 : 7;\\n  });\\n\\n  // Bottom Notice\\n  doc.setFillColor(247, 234, 210);\\n  doc.setDrawColor(216, 185, 154);\\n  doc.roundedRect(15, 248, 180, 26, 2, 2, \'FD\');\\n  doc.setFont(\'helvetica\', \'bold\');\\n  doc.setFontSize(8.8);\\n  doc.setTextColor(...AMBER_DARK);\\n  doc.text(\'BATASAN EDUKASI & KESELAMATAN PASIEN (PATIENT SAFETY):\', 22, 255);\\n  doc.setFont(\'helvetica\', \'normal\');\\n  doc.setFontSize(8.3);\\n  doc.text(IDENTITAS_PROYEK.kalimatBatasan, 22, 261, { maxWidth: 166 });\\n\\n  // ==========================================\\n  // HALAMAN 2: LATAR BELAKANG & ATURAN KETAT\\n  // ==========================================\\n  doc.addPage();\\n  pageNum++;\\n  drawHeaderFooter(\'Bab I: Latar Belakang & Batasan\');\\n\\n  doc.setFont(\'helvetica\', \'bold\');\\n  doc.setFontSize(16);\\n  doc.setTextColor(...SLATE_DARK);\\n  doc.text(\'BAB I: LATAR BELAKANG & BATASAN ETIKA\', 15, 26);\\n\\n  doc.setFont(\'helvetica\', \'bold\');\\n  doc.setFontSize(11);\\n  doc.setTextColor(...TEAL_DARK);\\n  doc.text(\'1.1 Masalah dan Urgensi Pengembangan\', 15, 36);\\n\\n  doc.setFont(\'helvetica\', \'normal\');\\n  doc.setFontSize(9.5);\\n  doc.setTextColor(...SLATE_DARK);\\n  const p1 =\\n    \'Tingkat literasi masyarakat umum dan mahasiswa non-kesehatan dalam membaca etiket atau label obat jadi masih relatif rendah. Fenomena swamedikasi yang sering dijumpai meliputi: ketidakmampuan membedakan golongan obat (bebas, bebas terbatas, dan keras), ketidakpahaman membedakan Tanggal Kedaluwarsa pabrik (Expired Date) dengan Beyond Use Date (BUD) pada sediaan yang telah dibuka, penggunaan antibiotik sisa teman tanpa resep dokter, serta cara pembuangan obat rusak yang berpotensi disalahgunakan atau mencemari lingkungan.\';\\n  doc.text(doc.splitTextToSize(p1, 180), 15, 43);\\n\\n  doc.setFont(\'helvetica\', \'bold\');\\n  doc.setFontSize(11);\\n  doc.setTextColor(...TEAL_DARK);\\n  doc.text(\'1.2 Tujuan Media Edukasi \\\"Ruang Obat\\\"\', 15, 72);\\n\\n  doc.setFont(\'helvetica\', \'normal\');\\n  doc.setFontSize(9.5);\\n  doc.setTextColor(...SLATE_DARK);\\n  const p2 = `Aplikasi \\\"Ruang Obat\\\" dirancang sebagai media edukasi ${IDENTITAS_PROYEK.jenisKarya} untuk menjembatani komunikasi informasi kefarmasian dalam format yang ramah pengguna, interaktif, dan mudah diakses melalui peramban web ponsel pintar maupun desktop. Fokus edukasi diarahkan pada pengenalan 6 titik informasi label kemasan dan penerapan prinsip DAGUSIBU (Dapatkan, Gunakan, Simpan, Buang) di lingkungan rumah tangga.`;\\n  doc.text(doc.splitTextToSize(p2, 180), 15, 79);\\n\\n  doc.setFont(\'helvetica\', \'bold\');\\n  doc.setFontSize(11);\\n  doc.setTextColor(...TEAL_DARK);\\n  doc.text(\'1.3 Aturan Ketat & Batasan Produk (Ethical Safeguards)\', 15, 108);\\n\\n  const rules = [\\n    [\\n      \'A. Tanpa Kalkulator Dosis & Diagnosis\',\\n      \'Aplikasi dengan tegas TIDAK menyediakan alat kalkulasi dosis atau sistem penegakan diagnosis penyakit, guna mencegah terjadinya bahaya swamedikasi berisiko tinggi.\',\\n    ],\\n    [\\n      \'B. Tanpa Klaim Berlebihan & Testimoni Palsu\',\\n      \'Aplikasi tidak memuat klaim sepihak seperti \\\"pasti sembuh\\\", \\\"terverifikasi apoteker\\\", atau testimoni buatan untuk menjaga netralitas media edukasi akademik.\',\\n    ],\\n    [\\n      \'C. Berbasis Sitasi Resmi (BPOM, Kemenkes, Farmakope)\',\\n      \'Semua uraian medis mengacu pada rujukan resmi BPOM RI, Kemenkes RI, dan Farmakope Indonesia yang masih dalam proses validasi pakar.\',\\n    ],\\n    [\\n      \'D. Kerahasiaan Data Lemari Obat (100% On-Device)\',\\n      \'Daftar persediaan obat di rumah yang dimasukkan pengguna hanya tersimpan secara lokal di memori peramban (localStorage) tanpa transmisi ke server luar.\',\\n    ],\\n    [\\n      \'E. Batasan Edukasi Wajib Terpampang\',\\n      `Footer aplikasi secara konsisten menampilkan peringatan: \\\"${IDENTITAS_PROYEK.kalimatBatasan}\\\"`,\\n    ],\\n  ];\\n\\n  let ruleY = 116;\\n  rules.forEach(([head, desc]) => {\\n    doc.setFillColor(...TEAL_LIGHT);\\n    doc.setDrawColor(...BORDER_COLOR);\\n    doc.roundedRect(15, ruleY, 180, 19, 2, 2, \'FD\');\\n\\n    doc.setFont(\'helvetica\', \'bold\');\\n    doc.setFontSize(9);\\n    doc.setTextColor(...TEAL_DARK);\\n    doc.text(head, 20, ruleY + 5.5);\\n\\n    doc.setFont(\'helvetica\', \'normal\');\\n    doc.setFontSize(8.2);\\n    doc.setTextColor(...SLATE_DARK);\\n    doc.text(desc, 20, ruleY + 11, { maxWidth: 170 });\\n\\n    ruleY += 22;\\n  });\\n\\n  // Architecture Tree Box\\n  doc.setFillColor(251, 249, 245);\\n  doc.setDrawColor(...BORDER_COLOR);\\n  doc.roundedRect(15, ruleY + 3, 180, 48, 2, 2, \'FD\');\\n\\n  doc.setFont(\'helvetica\', \'bold\');\\n  doc.setFontSize(9.5);\\n  doc.setTextColor(...SLATE_DARK);\\n  doc.text(\'PETA ARSITEKTUR NAVIGASI RUANG OBAT:\', 20, ruleY + 10);\\n\\n  doc.setFont(\'courier\', \'normal\');\\n  doc.setFontSize(8.5);\\n  doc.setTextColor(...SLATE_MUTED);\\n  const treeText = [\\n    \'Ruang Obat\',\\n    \'  \342\224\234\342\224\200\342\224\200 Beranda             (2 Aksi Utama, Grafik Stok, Panduan Fitur, Skenario)\',\\n    \'  \342\224\234\342\224\200\342\224\200 Cek Label           (Simulasi Kemasan Tablet, Sirup, Salep + 6 Hotspots)\',\\n    \'  \342\224\202     \342\224\224\342\224\200\342\224\200 Kamus Label   (17+ Istilah & Simbol Resmi BPOM / Kemenkes)\',\\n    \'  \342\224\234\342\224\200\342\224\200 Lemari Obat Saya    (Inventaris, Pencarian, Status Aman/Segera/ED, Dagusibu)\',\\n    \'  \342\224\234\342\224\200\342\224\200 Latihan             (Skenario Bercabang, Flashcard 3D, Uji Pemahaman/Kuis)\',\\n    \'  \342\224\224\342\224\200\342\224\200 Pustaka & Tentang   (Daftar Regulasi Resmi, Tim Pengembang, Batasan)\',\\n  ];\\n  let treeY = ruleY + 16;\\n  treeText.forEach((t) => {\\n    doc.text(t, 20, treeY);\\n    treeY += 4.5;\\n  });\\n\\n  // ==========================================\\n  // HALAMAN 3: SPESIFIKASI PENGEMBANGAN DETAIL\\n  // ==========================================\\n  doc.addPage();\\n  pageNum++;\\n  drawHeaderFooter(\'Bab II: Spesifikasi Fitur Pengembangan\');\\n\\n  doc.setFont(\'helvetica\', \'bold\');\\n  doc.setFontSize(16);\\n  doc.setTextColor(...SLATE_DARK);\\n  doc.text(\'BAB II: SPESIFIKASI PENGEMBANGAN FITUR AKTIF\', 15, 26);\\n\\n  // Fitur 1: Cek Label\\n  doc.setFont(\'helvetica\', \'bold\');\\n  doc.setFontSize(11);\\n  doc.setTextColor(...TEAL_DARK);\\n  doc.text(\'2.1 Modul Cek Label: 6 Titik Kritis Kemasan Obat\', 15, 36);\\n\\n  doc.setFont(\'helvetica\', \'normal\');\\n  doc.setFontSize(9);\\n  doc.setTextColor(...SLATE_DARK);\\n  doc.text(\\n    \'Menyajikan visualisasi SVG interaktif untuk 3 bentuk sediaan obat yang paling umum di rumah: Tablet (Strip Foil), Sirup (Botol Cair & Sendok Takar), dan Salep (Tube Semipadat). Masing-masing dilengkapi 6 titik ketuk terstandar:\',\\n    15,\\n    42,\\n    { maxWidth: 180 }\\n  );\\n\\n  const hotspotsTable = [\\n    [\'No\', \'Titik Informasi Label\', \'Rincian Penjelasan Edukatif & Rujukan Resmi\'],\\n    [\\n      \'1\',\\n      \'Logo Golongan Obat\',\\n      \'Identifikasi lingkaran hijau (bebas), biru (bebas terbatas P1-P6), dan merah K (obat keras). [Rujukan: BPOM - Pedoman Tanda Khusus Obat Jadi]\',\\n    ],\\n    [\\n      \'2\',\\n      \'Nama & Komposisi Zat\',\\n      \'Membedakan merk dagang vs zat generik aktif, dosis per tablet/5 mL, pencegahan duplikasi dosis. [Rujukan: Farmakope Indonesia]\',\\n    ],\\n    [\\n      \'3\',\\n      \'Indikasi Medis\',\\n      \'Kesesuaian gejala penyakit dengan indikasi resmi yang disetujui BPOM. [Rujukan: Informasi Produk BPOM]\',\\n    ],\\n    [\\n      \'4\',\\n      \'Aturan Pakai & Peringatan\',\\n      \'Frekuensi konsumsi, jarak waktu, hubungan dengan makan, dan tanda peringatan khusus. [Rujukan: Posologi Kemenkes]\',\\n    ],\\n    [\\n      \'5\',\\n      \'Tanggal Kedaluwarsa & Bets\',\\n      \'Letak cetak emboss/tinta Exp. Date, nomor bets penelusuran mutu, dan batas Beyond Use Date (BUD). [Rujukan: USP & BPOM]\',\\n    ],\\n    [\\n      \'6\',\\n      \'Nomor Izin Edar (NIE)\',\\n      \'15 digit verifikasi keaslian obat (DBL, DTL, DKL) melalui aplikasi BPOM Mobile. [Rujukan: BPOM RI]\',\\n    ],\\n  ];\\n\\n  let tableY = 53;\\n  hotspotsTable.forEach(([no, title, desc], idx) => {\\n    const isHead = idx === 0;\\n    doc.setFillColor(\\n      isHead ? TEAL_DARK[0] : idx % 2 === 0 ? 255 : 251,\\n      isHead ? TEAL_DARK[1] : idx % 2 === 0 ? 255 : 249,\\n      isHead ? TEAL_DARK[2] : idx % 2 === 0 ? 255 : 245\\n    );\\n    doc.setDrawColor(...BORDER_COLOR);\\n    doc.rect(15, tableY, 180, isHead ? 8 : 13, \'FD\');\\n\\n    doc.setFont(\'helvetica\', isHead ? \'bold\' : \'normal\');\\n    doc.setFontSize(8);\\n    doc.setTextColor(\\n      isHead ? 255 : SLATE_DARK[0],\\n      isHead ? 255 : SLATE_DARK[1],\\n      isHead ? 255 : SLATE_DARK[2]\\n    );\\n\\n    doc.text(no, 18, tableY + (isHead ? 5.5 : 5));\\n    doc.text(title, 27, tableY + (isHead ? 5.5 : 5), { maxWidth: 45 });\\n    doc.text(desc, 76, tableY + (isHead ? 5.5 : 4.5), { maxWidth: 115 });\\n\\n    tableY += isHead ? 8 : 13;\\n  });\\n\\n  // Fitur 2: Lemari Obat\\n  doc.setFont(\'helvetica\', \'bold\');\\n  doc.setFontSize(11);\\n  doc.setTextColor(...TEAL_DARK);\\n  doc.text(\'2.2 Modul Lemari Obat Saya & Algoritma Status Kedaluwarsa\', 15, tableY + 10);\\n\\n  doc.setFont(\'helvetica\', \'normal\');\\n  doc.setFontSize(9);\\n  doc.setTextColor(...SLATE_DARK);\\n  const lemariDesc =\\n    \'Pengguna dapat mengelola persediaan obat keluarga dengan pencarian langsung, input tanggal kedaluwarsa, dan tanggal dibuka. Sistem otomatis mengklasifikasikan status obat secara objektif dengan indikator ganda (IKON + TEKS, bukan warna semata):\';\\n  doc.text(doc.splitTextToSize(lemariDesc, 180), 15, tableY + 16);\\n\\n  let lemariY = tableY + 26;\\n  const statusCards = [\\n    [\'AMAN (> 30 Hari)\', \'Masa simpan masih panjang, obat layak disimpan sesuai suhu kemasan.\'],\\n    [\'SEGERA KEDALUWARSA (<= 30 Hari)\', \'Memasuki batas kritis, perlu segera diperiksa atau dipisahkan.\'],\\n    [\'KEDALUWARSA (< 0 Hari)\', \'Telah melewati batas aman pabrik. Tautan otomatis membuka Panduan Pemusnahan Obat Rusak.\'],\\n  ];\\n\\n  statusCards.forEach(([st, exp]) => {\\n    doc.setFillColor(255, 255, 255);\\n    doc.setDrawColor(...BORDER_COLOR);\\n    doc.roundedRect(15, lemariY, 180, 11, 2, 2, \'FD\');\\n\\n    doc.setFont(\'helvetica\', \'bold\');\\n    doc.setFontSize(8.5);\\n    doc.setTextColor(...SLATE_DARK);\\n    doc.text(st, 20, lemariY + 7);\\n\\n    doc.setFont(\'helvetica\', \'normal\');\\n    doc.setFontSize(8);\\n    doc.setTextColor(...SLATE_MUTED);\\n    doc.text(exp, 85, lemariY + 7, { maxWidth: 105 });\\n\\n    lemariY += 13;\\n  });\\n\\n  // Fitur 3: Dagusibu\\n  doc.setFont(\'helvetica\', \'bold\');\\n  doc.setFontSize(11);\\n  doc.setTextColor(...TEAL_DARK);\\n  doc.text(\'2.3 Panduan Simpan & Buang (Prinsip Dagusibu)\', 15, lemariY + 6);\\n\\n  doc.setFont(\'helvetica\', \'normal\');\\n  doc.setFontSize(9);\\n  doc.setTextColor(...SLATE_DARK);\\n  const daguDesc =\\n    \'Memuat tata cara merusak sediaan obat sebelum dibuang (misal: menggerus tablet, mencampur dengan ampas kopi/tanah, merusak botol sirup, memotong label) agar tidak dipungut oknum pemalsu obat.\';\\n  doc.text(doc.splitTextToSize(daguDesc, 180), 15, lemariY + 12);\\n\\n  // ==========================================\\n  // HALAMAN 4: LEMBAR VALIDASI DOSEN PEMBIMBING DAN PENGUJI\\n  // ==========================================\\n  doc.addPage();\\n  pageNum++;\\n  drawHeaderFooter(\'Bab III: Instrumen Uji Kelayakan Dosen\');\\n\\n  doc.setFont(\'helvetica\', \'bold\');\\n  doc.setFontSize(16);\\n  doc.setTextColor(...SLATE_DARK);\\n  doc.text(\'BAB III: LEMBAR PENILAIAN & VALIDASI AHLI\', 15, 26);\\n\\n  doc.setFont(\'helvetica\', \'normal\');\\n  doc.setFontSize(9);\\n  doc.setTextColor(...SLATE_MUTED);\\n  doc.text(\\n    \'Instrumen penilaian kelayakan media edukasi oleh Dosen Pembimbing dan Dosen Penguji Ahli Materi & Media Farmasi:\',\\n    15,\\n    33\\n  );\\n\\n  const valItems = [\\n    [\'No\', \'Indikator Penilaian Kelayakan Media\', \'Skor (1-5)\', \'Catatan / Rekomendasi Revisi\'],\\n    [\'1\', \'Kebenaran 6 titik informasi label kemasan (NIE, ED, Logo, dll)\', \'[   ]\', \'...................................................\'],\\n    [\'2\', \'Kepatuhan aspek Patient Safety (Bebas kalkulator/diagnosis liar)\', \'[   ]\', \'...................................................\'],\\n    [\'3\', \'Ketepatan panduan Dagusibu (Penyimpanan & pemusnahan)\', \'[   ]\', \'...................................................\'],\\n    [\'4\', \'Kejelasan bahasa awam untuk mahasiswa non-kesehatan\', \'[   ]\', \'...................................................\'],\\n    [\'5\', \'Kemudahan navigasi responsif dan kecepatan respon UI\', \'[   ]\', \'...................................................\'],\\n    [\'6\', \'Kesesuaian fitur Lemari Obat dengan masa simpan nyata\', \'[   ]\', \'...................................................\'],\\n    [\'7\', \'Kelengkapan glosarium Kamus Label Obat resmi\', \'[   ]\', \'...................................................\'],\\n  ];\\n\\n  let valY = 38;\\n  valItems.forEach(([no, ind, sk, cat], idx) => {\\n    const isHead = idx === 0;\\n    doc.setFillColor(\\n      isHead ? TEAL_DARK[0] : idx % 2 === 0 ? 255 : 251,\\n      isHead ? TEAL_DARK[1] : idx % 2 === 0 ? 255 : 249,\\n      isHead ? TEAL_DARK[2] : idx % 2 === 0 ? 255 : 245\\n    );\\n    doc.setDrawColor(...BORDER_COLOR);\\n    doc.rect(15, valY, 180, isHead ? 8 : 12, \'FD\');\\n\\n    doc.setFont(\'helvetica\', isHead ? \'bold\' : \'normal\');\\n    doc.setFontSize(8);\\n    doc.setTextColor(\\n      isHead ? 255 : SLATE_DARK[0],\\n      isHead ? 255 : SLATE_DARK[1],\\n      isHead ? 255 : SLATE_DARK[2]\\n    );\\n\\n    doc.text(no, 18, valY + (isHead ? 5.5 : 7));\\n    doc.text(ind, 26, valY + (isHead ? 5.5 : 7), { maxWidth: 85 });\\n    doc.text(sk, 115, valY + (isHead ? 5.5 : 7), { align: \'center\' });\\n    doc.text(cat, 130, valY + (isHead ? 5.5 : 7));\\n\\n    valY += isHead ? 8 : 12;\\n  });\\n\\n  // Scoring Guide Box\\n  doc.setFillColor(251, 249, 245);\\n  doc.setDrawColor(...BORDER_COLOR);\\n  doc.roundedRect(15, valY + 6, 180, 22, 2, 2, \'FD\');\\n  doc.setFont(\'helvetica\', \'bold\');\\n  doc.setFontSize(8.5);\\n  doc.setTextColor(...SLATE_DARK);\\n  doc.text(\\n    \'Keterangan Skala Nilai:  1 = Sangat Kurang  |  2 = Kurang  |  3 = Cukup  |  4 = Baik  |  5 = Sangat Baik\',\\n    20,\\n    valY + 13\\n  );\\n  doc.setFont(\'helvetica\', \'normal\');\\n  doc.setFontSize(8);\\n  doc.text(\\n    \'Kesimpulan: [  ] Layak Tanpa Revisi    [  ] Layak dengan Revisi Kecil    [  ] Belum Layak Diuji Lapangan\',\\n    20,\\n    valY + 21\\n  );\\n\\n  // Signature Section\\n  const sigY = valY + 36;\\n  doc.setFont(\'helvetica\', \'normal\');\\n  doc.setFontSize(9);\\n  doc.setTextColor(...SLATE_DARK);\\n\\n  doc.text(\'Tangerang, ........................................... 2026\', 120, sigY);\\n  doc.text(\'Dosen Pembimbing / Penguji,\', 120, sigY + 6);\\n\\n  doc.line(120, sigY + 30, 190, sigY + 30);\\n  doc.text(\'( .................................................................... )\', 120, sigY + 34);\\n  doc.text(\'NIDN / NIP: .......................................................\', 120, sigY + 39);\\n\\n  // Trigger client-side browser native download\\n  doc.save(\'Dokumen_Pengembangan_Ruang_Obat.pdf\');\\n};\\n\", \"Description\":\"Update generatePdfClient.ts to use IDENTITAS_PROYEK, remove Bab IV Claude AI, replace prototipe with pengembangan and skripsi with Tugas Akhir Berbasis Proyek\", \"Overwrite\":true, \"TargetFile\":\"/src/utils/generatePdfClient.ts\", \"toolAction\":\"Updating generatePdfClient.ts\", \"toolSummary\":\"Update generatePdfClient.ts\"}"
