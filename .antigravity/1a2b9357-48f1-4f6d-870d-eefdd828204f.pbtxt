              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                    Aplikasi terbukti bebas dari kalkulator dosis, bebas alat diagnosis mandiri, dan bebas rekomendasi terapi liar untuk menjamin keselamatan pasien."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
