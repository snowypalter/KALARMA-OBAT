    content: "import React, { useState } from \'react\';\nimport { PackagingType } from \'../types\';\nimport { PACKAGING_ITEMS } from \'../data/labelHotspots\';\nimport { PackagingSvg } from \'../components/PackagingSvg\';\nimport { \n  Pill, \n  FlaskConical, \n  Pipette, \n  ChevronLeft, \n  ChevronRight, \n  BookA, \n  AlertCircle,\n  HelpCircle\n} from \'lucide-react\';\n\ninterface CekLabelViewProps {\n  onOpenKamus: () => void;\n}\n\nexport const CekLabelView: React.FC<CekLabelViewProps> = ({ onOpenKamus }) => {\n  const [selectedType, setSelectedType] = useState<PackagingType>(\'tablet\');\n  const [activeHotspotId, setActiveHotspotId] = useState<number>(1);\n\n  const currentPackaging = PACKAGING_ITEMS[selectedType];\n  const activeHotspot = currentPackaging.hotspots.find((h) => h.id === activeHotspotId) || currentPackaging.hotspots[0];\n\n  const handleNext = () => {\n    const currentIndex = currentPackaging.hotspots.findIndex((h) => h.id === activeHotspotId);\n    if (currentIndex < currentPackaging.hotspots.length - 1) {\n      setActiveHotspotId(currentPackaging.hotspots[currentIndex + 1].id);\n    } else {\n      setActiveHotspotId(currentPackaging.hotspots[0].id); // loop back\n    }\n  };\n\n  const handlePrev = () => {\n    const currentIndex = currentPackaging.hotspots.findIndex((h) => h.id === activeHotspotId);\n    if (currentIndex > 0) {\n      setActiveHotspotId(currentPackaging.hotspots[currentIndex - 1].id);\n    } else {\n      setActiveHotspotId(currentPackaging.hotspots[currentPackaging.hotspots.length - 1].id); // loop to end\n    }\n  };\n\n  return (\n    <div className=\"space-y-5 pb-12 animate-in fade-in duration-150\">\n      {/* Title & Description */}\n      <div className=\"space-y-1\">\n        <h1 className=\"text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight\">\n          Cek Label Kemasan Obat\n        </h1>\n        <p className=\"text-slate-600 text-sm sm:text-base leading-relaxed\">\n          Simulasi visual label obat interaktif. Pilih jenis kemasan, lalu ketuk salah satu dari 6 titik angka untuk mempelajari artinya.\n        </p>\n      </div>\n\n      {/* Pemilih Jenis Kemasan: Tablet, Sirup, Salep */}\n      <div className=\"p-1.5 bg-slate-200/80 rounded-2xl grid grid-cols-3 gap-1\">\n        <button\n          type=\"button\"\n          onClick={() => {\n            setSelectedType(\'tablet\');\n            setActiveHotspotId(1);\n          }}\n          className={`min-h-[46px] flex items-center justify-center gap-1.5 py-2 px-3 rounded-xl text-xs sm:text-sm font-bold transition-all cursor-pointer ${\n            selectedType === \'tablet\'\n              ? \'bg-white text-teal-900 shadow-sm\'\n              : \'text-slate-600 hover:text-slate-900\'\n          }`}\n        >\n          <Pill className=\"w-4 h-4 text-teal-700\" />\n          <span>Tablet</span>\n        </button>\n\n        <button\n          type=\"button\"\n          onClick={() => {\n            setSelectedType(\'sirup\');\n            setActiveHotspotId(1);\n          }}\n          className={`min-h-[46px] flex items-center justify-center gap-1.5 py-2 px-3 rounded-xl text-xs sm:text-sm font-bold transition-all cursor-pointer ${\n            selectedType === \'sirup\'\n              ? \'bg-white text-teal-900 shadow-sm\'\n              : \'text-slate-600 hover:text-slate-900\'\n          }`}\n        >\n          <FlaskConical className=\"w-4 h-4 text-teal-700\" />\n          <span>Sirup</span>\n        </button>\n\n        <button\n          type=\"button\"\n          onClick={() => {\n            setSelectedType(\'salep\');\n            setActiveHotspotId(1);\n          }}\n          className={`min-h-[46px] flex items-center justify-center gap-1.5 py-2 px-3 rounded-xl text-xs sm:text-sm font-bold transition-all cursor-pointer ${\n            selectedType === \'salep\'\n              ? \'bg-white text-teal-900 shadow-sm\'\n              : \'text-slate-600 hover:text-slate-900\'\n          }`}\n        >\n          <Pipette className=\"w-4 h-4 text-teal-700\" />\n          <span>Salep</span>\n        </button>\n      </div>\n\n      {/* Packaging Info & Interactive Graphic */}\n      <div className=\"space-y-2\">\n        <div className=\"flex items-center justify-between text-xs text-slate-500 px-1\">\n          <span className=\"font-semibold text-teal-800\">{currentPackaging.title}</span>\n          <span>Ketuk angka 1\342\200\2236 pada gambar di bawah:</span>\n        </div>\n\n        {/* SVG Container */}\n        <PackagingSvg\n          type={selectedType}\n          hotspots={currentPackaging.hotspots}\n          activeHotspotId={activeHotspotId}\n          onSelectHotspot={(id) => setActiveHotspotId(id)}\n        />\n      </div>\n\n      {/* Quick hotspot pill selector for direct access */}\n      <div className=\"flex items-center gap-1.5 overflow-x-auto pb-1 no-scrollbar\">\n        {currentPackaging.hotspots.map((h) => {\n          const isCurrent = h.id === activeHotspotId;\n          return (\n            <button\n              key={h.id}\n              type=\"button\"\n              onClick={() => setActiveHotspotId(h.id)}\n              className={`min-h-[40px] px-3 py-1.5 rounded-xl text-xs font-semibold whitespace-nowrap transition-colors flex items-center gap-1.5 cursor-pointer ${\n                isCurrent\n                  ? \'bg-teal-700 text-white shadow-xs\'\n                  : \'bg-white text-slate-700 border border-slate-200 hover:bg-slate-50\'\n              }`}\n            >\n              <span className={`w-5 h-5 rounded-full flex items-center justify-center text-[10px] font-bold ${\n                isCurrent ? \'bg-white text-teal-800\' : \'bg-slate-100 text-slate-700\'\n              }`}>\n                {h.number}\n              </span>\n              <span>{h.title}</span>\n            </button>\n          );\n        })}\n      </div>\n\n      {/* Bottom Sheet / Interactive Educational Detail Card */}\n      <div className=\"bg-white rounded-2xl border-2 border-teal-600/30 p-5 shadow-sm space-y-4\">\n        {/* Top bar of card */}\n        <div className=\"flex items-start justify-between gap-3 pb-3 border-b border-slate-100\">\n          <div className=\"flex items-center gap-2.5\">\n            <span className=\"w-8 h-8 rounded-full bg-teal-700 text-white font-extrabold text-sm flex items-center justify-center shrink-0 shadow-xs\">\n              {activeHotspot.number}\n            </span>\n            <div>\n              <span className=\"text-xs font-semibold text-teal-700 block\">\n                Titik {activeHotspot.number} dari 6 \302\267 {currentPackaging.title}\n              </span>\n              <h2 className=\"text-base sm:text-lg font-bold text-slate-900 leading-tight\">\n                {activeHotspot.title}\n              </h2>\n            </div>\n          </div>\n          <button\n            type=\"button\"\n            onClick={onOpenKamus}\n            className=\"text-xs font-semibold text-teal-700 hover:text-teal-900 flex items-center gap-1 shrink-0 p-1 cursor-pointer\"\n          >\n            <BookA className=\"w-4 h-4\" />\n            <span className=\"hidden sm:inline\">Lihat di Kamus</span>\n          </button>\n        </div>\n\n        {/* Short description */}\n        <p className=\"text-xs sm:text-sm text-slate-600 font-medium\">\n          {activeHotspot.shortDescription}\n        </p>\n\n        {/* 3 Structured educational content boxes with strict citations */}\n        <div className=\"space-y-3\">\n          {/* Meaning / Arti */}\n          <div className=\"p-3.5 bg-slate-50 rounded-xl border border-slate-200 space-y-1\">\n            <div className=\"flex items-center gap-1.5 text-xs font-bold text-slate-800\">\n              <HelpCircle className=\"w-4 h-4 text-teal-700\" />\n              <span>Fungsi & Informasi Resmi Label:</span>\n            </div>\n            <p className=\"text-xs sm:text-sm text-slate-700 leading-relaxed font-mono text-[13px] bg-white p-2 rounded-lg border border-slate-200/80\">\n              {activeHotspot.content.meaning}\n            </p>\n          </div>\n\n          {/* Tips membaca */}\n          <div className=\"p-3.5 bg-teal-50/60 rounded-xl border border-teal-100 space-y-1\">\n            <div className=\"flex items-center gap-1.5 text-xs font-bold text-teal-900\">\n              <span>\360\237\222\241 Tips Membaca & Memahami:</span>\n            </div>\n            <p className=\"text-xs sm:text-sm text-teal-950 leading-relaxed font-mono text-[13px] bg-white p-2 rounded-lg border border-teal-200/60\">\n              {activeHotspot.content.tips}\n            </p>\n          </div>\n\n          {/* Warning */}\n          <div className=\"p-3.5 bg-amber-50/60 rounded-xl border border-amber-200/80 space-y-1\">\n            <div className=\"flex items-center gap-1.5 text-xs font-bold text-amber-900\">\n              <AlertCircle className=\"w-4 h-4 text-amber-700\" />\n              <span>Peringatan Keamanan Penggunaan:</span>\n            </div>\n            <p className=\"text-xs sm:text-sm text-amber-950 leading-relaxed font-mono text-[13px] bg-white p-2 rounded-lg border border-amber-200/60\">\n              {activeHotspot.content.warning}\n            </p>\n          </div>\n        </div>\n\n        {/* Prev / Next Nav Buttons */}\n        <div className=\"pt-3 border-t border-slate-100 flex items-center justify-between gap-3\">\n          <button\n            type=\"button\"\n            onClick={handlePrev}\n            className=\"min-h-[44px] px-4 py-2 rounded-xl border border-slate-200 hover:bg-slate-100 text-slate-700 font-semibold text-xs sm:text-sm flex items-center gap-1 transition-colors cursor-pointer\"\n          >\n            <ChevronLeft className=\"w-4 h-4\" />\n            <span>Sebelumnya</span>\n          </button>\n\n          <span className=\"text-xs text-slate-500 font-medium\">\n            {activeHotspot.number} / {currentPackaging.hotspots.length}\n          </span>\n\n          <button\n            type=\"button\"\n            onClick={handleNext}\n            className=\"min-h-[44px] px-4 py-2 rounded-xl bg-teal-700 hover:bg-teal-800 text-white font-semibold text-xs sm:text-sm flex items-center gap-1 transition-colors cursor-pointer\"\n          >\n            <span>Lanjut</span>\n            <ChevronRight className=\"w-4 h-4\" />\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    num_lines: 245
    num_bytes: 10069
    line_range_bytes: 10069
  }
}
