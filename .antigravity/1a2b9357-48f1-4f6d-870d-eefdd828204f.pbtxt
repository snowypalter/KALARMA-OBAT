    end_line: 93
    content: "import React from \'react\';\nimport { ModalShell } from \'./ui\';\nimport { ShieldCheck, BookMarked, UserCheck, Lock, Info } from \'lucide-react\';\n\ninterface TentangModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n}\n\nexport const TentangModal: React.FC<TentangModalProps> = ({ isOpen, onClose }) => {\n  return (\n    <ModalShell\n      isOpen={isOpen}\n      onClose={onClose}\n      title=\"Tentang Ruang Obat\"\n      subtitle=\"Media Edukasi Skripsi S1 Farmasi Klinis & Komunitas\"\n      maxWidth=\"lg\"\n      headerIcon={<Info className=\"w-5 h-5\" />}\n      footer={\n        <div className=\"flex justify-end\">\n          <button\n            type=\"button\"\n            onClick={onClose}\n            className=\"min-h-[44px] px-5 py-2 text-sm font-semibold text-on-brand bg-forest hover:bg-brand rounded-xl transition-colors cursor-pointer\"\n          >\n            Tutup\n          </button>\n        </div>\n      }\n    >\n      <div className=\"space-y-6 text-ink text-sm leading-relaxed\">\n        {/* Section 1: Tujuan */}\n        <div className=\"space-y-2\">\n          <div className=\"flex items-center gap-2 text-forest font-bold\">\n            <BookMarked className=\"w-4 h-4 text-brand\" />\n            <h3 className=\"text-xs uppercase tracking-wider\">Tujuan Media Edukasi</h3>\n          </div>\n          <p className=\"text-ink-muted text-sm leading-relaxed\">\n            Ruang Obat dikembangkan sebagai instrumen media edukasi interaktif dalam penelitian skripsi S1 Farmasi Klinis dan Komunitas. Sasaran utamanya adalah mahasiswa non-kesehatan dan masyarakat umum untuk meningkatkan kecakapan literasi membaca label obat serta menumbuhkan kebiasaan pengelolaan obat rumah tangga yang aman (Dagusibu: Dapatkan, Gunakan, Simpan, Buang).\n          </p>\n        </div>\n\n        {/* Section 2: Peneliti & Institusi */}\n        <div className=\"space-y-2.5 p-4 bg-surface-warm rounded-2xl border border-line\">\n          <div className=\"flex items-center gap-2 text-forest font-bold\">\n            <UserCheck className=\"w-4 h-4 text-brand\" />\n            <h3 className=\"text-sm\">Identitas Pengembang &amp; Penelitian</h3>\n          </div>\n          <ul className=\"text-xs space-y-1.5 text-ink-muted\">\n            <li>\n              <strong className=\"text-ink\">Peneliti:</strong> [ISI NAMA PENGEMBANG / PENELITI SKRIPSI]\n            </li>\n            <li>\n              <strong className=\"text-ink\">NIM / Program Studi:</strong> [ISI NIM &amp; PRODI S1 FARMASI]\n            </li>\n            <li>\n              <strong className=\"text-ink\">Fakultas / Universitas:</strong> [ISI FAKULTAS &amp; UNIVERSITAS]\n            </li>\n            <li>\n              <strong className=\"text-ink\">Tahun Penyusunan:</strong>{\' \'}\n              <span className=\"font-mono\">2026</span>\n            </li>\n          </ul>\n        </div>\n\n        {/* Section 3: Batasan Produk */}\n        <div className=\"space-y-2\">\n          <div className=\"flex items-center gap-2 text-status-segera-text font-bold\">\n            <ShieldCheck className=\"w-4 h-4\" />\n            <h3 className=\"text-xs uppercase tracking-wider\">Batasan Produk</h3>\n          </div>\n          <p className=\"text-ink-muted text-xs sm:text-sm leading-relaxed\">\n            Aplikasi ini murni bersifat media edukasi umum. Aplikasi ini{\' \'}\n            <strong className=\"text-ink\">TIDAK</strong> menyediakan kalkulator dosis, diagnosis penyakit, atau rekomendasi pemilihan obat tertentu untuk kondisi medis pribadi. Segala keluhan kesehatan dan pertimbangan dosis obat harus selalu dikonsultasikan secara langsung kepada dokter atau apoteker.\n          </p>\n        </div>\n\n        {/* Section 4: Kebijakan Privasi */}\n        <div className=\"space-y-2\">\n          <div className=\"flex items-center gap-2 text-forest font-bold\">\n            <Lock className=\"w-4 h-4 text-brand\" />\n            <h3 className=\"text-xs uppercase tracking-wider\">\n              Kebijakan Privasi (Data On-Device)\n            </h3>\n          </div>\n          <p className=\"text-ink-muted text-xs sm:text-sm leading-relaxed\">\n            Daftar obat yang Anda catat pada menu <em>Lemari Obat</em> disimpan secara eksklusif di memori lokal peramban (<span className=\"font-mono\">localStorage</span>) perangkat Anda. Tidak ada data pribadi, nama obat, atau tanggal yang diunggah ke peladen eksternal mana pun.\n          </p>\n        </div>\n      </div>\n    </ModalShell>\n  );\n};\n"
    num_lines: 94
    num_bytes: 4374
    line_range_bytes: 4374
  }
}
