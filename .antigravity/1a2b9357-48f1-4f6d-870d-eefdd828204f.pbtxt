    end_line: 61
    content: "export type TabType = \'beranda\' | \'cek-label\' | \'lemari\' | \'latihan\' | \'pustaka\';\n\nexport type PackagingType = \'tablet\' | \'sirup\' | \'salep\';\n\nexport interface LabelHotspot {\n  id: number;\n  number: number;\n  title: string;\n  shortDescription: string;\n  xPercent: number; // for SVG pin positioning\n  yPercent: number;\n  content: {\n    meaning: string;\n    tips: string;\n    warning: string;\n  };\n}\n\nexport interface PackagingData {\n  type: PackagingType;\n  title: string;\n  subtitle: string;\n  hotspots: LabelHotspot[];\n}\n\nexport type MedicineStatus = \'aman\' | \'segera\' | \'kedaluwarsa\';\n\nexport type SediaanType = \n  | \'Tablet\' \n  | \'Kapsul\' \n  | \'Sirup / Cair\' \n  | \'Salep / Krim / Gel\' \n  | \'Tetes Mata / Telinga\'\n  | \'Inhaler / Semprot\'\n  | \'Lainnya\';\n\nexport interface MedicineItem {\n  id: string;\n  name: string;\n  sediaan: SediaanType;\n  expiryDate: string; // YYYY-MM-DD\n  openedDate?: string; // YYYY-MM-DD (optional)\n  notes?: string;\n  createdAt: number;\n}\n\nexport interface KamusItem {\n  id: string;\n  term: string;\n  category: string;\n  definition: string;\n  referenceSource: string;\n}\n\nexport interface StorageGuideItem {\n  sediaan: SediaanType;\n  title: string;\n  simpanRules: string[];\n  buangRules: string[];\n  catatanPenting: string;\n}\n"
    num_lines: 62
    num_bytes: 1253
    line_range_bytes: 1253
  }
}
