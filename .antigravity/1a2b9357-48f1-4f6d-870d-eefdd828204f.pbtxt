    end_line: 63
    content: "export interface PustakaItem {\n  id: string;\n  penulis: string;\n  tahun: string;\n  judul: string;\n  penerbit: string;\n  kategori: string;\n  tautanPlaceholder: string;\n  catatan: string;\n}\n\nexport const PUSTAKA_ITEMS: PustakaItem[] = [\n  {\n    id: \'ref-1\',\n    penulis: \'Badan Pengawas Obat dan Makanan (BPOM RI)\',\n    tahun: \'2022\',\n    judul: \'[ISI DARI RUJUKAN: Peraturan BPOM tentang Pedoman Kriteria dan Tata Laksana Registrasi Obat & Penandaan Label Kemasan]\',\n    penerbit: \'BPOM RI, Jakarta\',\n    kategori: \'Regulasi & Legalitas\',\n    tautanPlaceholder: \'[ISI DARI RUJUKAN: https://jdih.pom.go.id/]\',\n    catatan: \'Rujukan standar ketentuan nomor izin edar (NIE), logo lingkaran obat, dan informasi wajib pada etiket.\'\n  },\n  {\n    id: \'ref-2\',\n    penulis: \'Kementerian Kesehatan Republik Indonesia (Kemenkes RI)\',\n    tahun: \'2021\',\n    judul: \'[ISI DARI RUJUKAN: Pedoman Pengelolaan Obat Rusak dan Kedaluwarsa di Fasilitas Pelayanan Kefarmasian dan Rumah Tangga (Dagusibu)]\',\n    penerbit: \'Direktorat Jenderal Kefarmasian dan Alat Kesehatan Kemenkes RI\',\n    kategori: \'Pedoman Komunitas\',\n    tautanPlaceholder: \'[ISI DARI RUJUKAN: https://farmalkes.kemkes.go.id/]\',\n    catatan: \'Prinsip Dapatkan, Gunakan, Simpan, dan Buang obat secara bertanggung jawab di lingkungan rumah.\'\n  },\n  {\n    id: \'ref-3\',\n    penulis: \'Kementerian Kesehatan Republik Indonesia\',\n    tahun: \'2020\',\n    judul: \'[ISI DARI RUJUKAN: Farmakope Indonesia Edisi VI]\',\n    penerbit: \'Kementerian Kesehatan RI, Jakarta\',\n    kategori: \'Standar Mutu Farmasi\',\n    tautanPlaceholder: \'[ISI DARI RUJUKAN: Farmakope Indonesia VI]\',\n    catatan: \'Baku mutu resmi sediaan obat, batas Beyond Use Date (BUD), dan spesifikasi suhu penyimpanan.\'\n  },\n  {\n    id: \'ref-4\',\n    penulis: \'World Health Organization (WHO)\',\n    tahun: \'2019\',\n    judul: \'[ISI DARI RUJUKAN: Guidelines for the Regulatory Assessment of Medicinal Products for use in Self-Medication]\',\n    penerbit: \'WHO Guidelines Approved by the Guidelines Review Committee, Geneva\',\n    kategori: \'Kesehatan Global\',\n    tautanPlaceholder: \'[ISI DARI RUJUKAN: https://www.who.int/publications/]\',\n    catatan: \'Panduan internasional literasi kesehatan dalam perilaku swamedikasi masyarakat umum.\'\n  },\n  {\n    id: \'ref-5\',\n    penulis: \'United States Pharmacopeia (USP)\',\n    tahun: \'2023\',\n    judul: \'[ISI DARI RUJUKAN: General Chapter <795> & <797> Beyond-Use Date Determination in Nonsterile and Sterile Preparations]\',\n    penerbit: \'The United States Pharmacopeial Convention\',\n    kategori: \'Standar Internasional\',\n    tautanPlaceholder: \'[ISI DARI RUJUKAN: https://www.uspnf.com/]\',\n    catatan: \'Standar penentuan batas simpan obat cair dan topikal setelah kemasan primer pertama kali dibuka.\'\n  }\n];\n"
