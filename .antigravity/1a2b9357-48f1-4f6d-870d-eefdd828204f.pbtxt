      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Load Fraunces editorial display font alongside DM Sans, Plus Jakarta Sans, and DM Mono in index.html\", \"EndLine\":19, \"Instruction\":\"Update Google Fonts link in index.html to include Fraunces display serif font\", \"ReplacementContent\":\"    <link rel=\\\"preconnect\\\" href=\\\"https://fonts.googleapis.com\\\">\\n    <link rel=\\\"preconnect\\\" href=\\\"https://fonts.gstatic.com\\\" crossorigin>\\n    <link href=\\\"https://fonts.googleapis.com/css2?family=DM+Mono:ital,wght@0,400;0,500;1,400&family=DM+Sans:ital,opsz,wght@0,9..40,400..700;1,9..40,400..700&family=Fraunces:ital,opsz,wght@0,9..144,500..700;1,9..144,400..600&family=Plus+Jakarta+Sans:ital,wght@0,500..800;1,500..800&display=swap\\\" rel=\\\"stylesheet\\\">\\n  </head>\", \"StartLine\":14, \"TargetContent\":\"    <link rel=\\\"preconnect\\\" href=\\\"https://fonts.googleapis.com\\\">\\n    <link rel=\\\"preconnect\\\" href=\\\"https://fonts.gstatic.com\\\" crossorigin>\\n    <link href=\\\"https://fonts.googleapis.com/css2?family=DM+Mono:ital,wght@0,400;0,500;1,400&family=DM+Sans:ital,opsz,wght@0,9..40,400..700;1,9..40,400..700&family=Plus+Jakarta+Sans:ital,wght@0,400..800;1,400..800&display=swap\\\" rel=\\\"stylesheet\\\">\\n  </head>\", \"TargetFile\":\"/index.html\", \"toolAction\":\"Updating typography fonts in index.html\", \"toolSummary\":\"Update index.html fonts\"}"
      original_name: "replace_file_content"
