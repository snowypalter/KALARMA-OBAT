    content: "import React, { useState } from \'react\';\nimport { \n  X, \n  Copy, \n  Check, \n  Share2, \n  GraduationCap, \n  Bot, \n  ExternalLink, \n  Printer, \n  CheckCircle2, \n  FileText,\n  FileDown,\n  Eye,\n  BookOpen,\n  Sparkles,\n  Download\n} from \'lucide-react\';\nimport { generateAndDownloadPdf } from \'../utils/generatePdfClient\';\n\ninterface TinjauDosenModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  defaultTab?: \'pdf\' | \'link\' | \'dosen\' | \'claude\';\n}\n\nexport const TinjauDosenModal: React.FC<TinjauDosenModalProps> = ({ \n  isOpen, \n  onClose,\n  defaultTab = \'pdf\'\n}) => {\n  const [activeTab, setActiveTab] = useState<\'pdf\' | \'link\' | \'dosen\' | \'claude\'>(defaultTab);\n  const [copiedLink, setCopiedLink] = useState(false);\n  const [copiedClaudePrompt, setCopiedClaudePrompt] = useState(false);\n  const [copiedFullDoc, setCopiedFullDoc] = useState(false);\n  const [isGenerating, setIsGenerating] = useState(false);\n\n  if (!isOpen) return null;\n\n  // Real App URLs\n  const currentOrigin = typeof window !== \'undefined\' ? window.location.origin : \'https://ais-pre-i6cmepgnonm4mfj7yg2xyk-74888050060.asia-east1.run.app\';\n  const sharedUrl = \'https://ais-pre-i6cmepgnonm4mfj7yg2xyk-74888050060.asia-east1.run.app\';\n  const bestUrlToShare = currentOrigin.includes(\'localhost\') ? sharedUrl : currentOrigin;\n  const pdfUrl = \'/Dokumen_Prototipe_Ruang_Obat.pdf\';\n\n  const handleCopyLink = () => {\n    navigator.clipboard.writeText(bestUrlToShare).then(() => {\n      setCopiedLink(true);\n      setTimeout(() => setCopiedLink(false), 2500);\n    });\n  };\n\n  const claudeReviewPrompt = `# Permohonan Review Media Edukasi Skripsi S1 Farmasi: \"Ruang Obat\"\n\nHalo Claude, saya mahasiswa S1 Farmasi Klinis dan Komunitas yang sedang menyusun skripsi media edukasi interaktif bernama \"Ruang Obat\" (Tagline: \"Kenali label obatmu, kelola obat di rumahmu\").\n\nTautan Web Media Prototipe Aktif:\n${bestUrlToShare}\n\nSasaran Pengguna:\nMahasiswa non-kesehatan dan masyarakat umum.\n\nAturan Ketat & Batasan Skripsi (Ethical Safeguards):\n1. Murni edukasi umum; TIDAK ADA kalkulator dosis, diagnosis mandiri, atau rekomendasi obat/dosis tertentu.\n2. Tidak mencantumkan klaim \"ditinjau apoteker\", \"terverifikasi\", atau testimoni apa pun.\n3. Seluruh konten edukasi menggunakan acuan resmi BPOM RI, Kemenkes RI (Dagusibu), dan Farmakope Indonesia.\n4. Data lemari obat 100% tersimpan lokal di browser pengguna (localStorage).\n5. Disclaimer wajib di footer: \"Edukasi umum, bukan diagnosis atau saran dosis pribadi. Tanyakan ke apoteker atau dokter.\"\n\nFitur yang Telah Aktif untuk Dicek:\n1. Beranda: Banner peringatan obat kedaluwarsa dinamis, 2 kartu aksi utama, kartu skenario swamedikasi hari ini, akses cepat Kamus & Flashcard.\n2. Cek Label: Simulasi kemasan interaktif (Tablet strip foil, Sirup botol cair, Salep tube kulit) dengan 6 titik ketuk resmi (Logo golongan obat, Nama/komposisi, Indikasi, Aturan pakai, Tanggal kedaluwarsa/bets, Nomor Izin Edar NIE BPOM).\n3. Lemari Obat Saya: Inventaris mandiri, deteksi status otomatis (Aman, Segera kedaluwarsa <=30 hari, Kedaluwarsa) dengan ikon & teks, filter chip, tambah/edit obat, tautan langsung ke panduan pemusnahan obat rusak/kedaluwarsa.\n4. Panduan Simpan & Buang (Dagusibu): Petunjuk penyimpanan dan pemusnahan per bentuk sediaan.\n5. Kamus Label Obat: Glosarium istilah obat resmi dengan pencarian langsung dan filter abjad A-Z.\n6. Modul Latihan & Uji Evaluasi (Tahap 2):\n   - Skenario Swamedikasi Cerita Bercabang (4 kasus nyata: bahaya sisa antibiotik & AMR, presisi sendok obat 5 mL vs sendok dapur, bahaya salep steroid keras pada mikosis, dan waktu optimal antasida; dilengkapi red flags kapan wajib ke dokter/apoteker).\n   - Flashcard Interaktif 3D Flip (12 kartu terstandar: logo golongan, peringatan P.1-P.6, ED vs BUD, masa simpan sirup kering & tetes mata, kode NIE 15 digit, dan cara pembuangan obat Dagusibu).\n   - Kuis Evaluasi Pre-Test & Post-Test (10 soal terstandar skripsi, kalkulasi skor /100, komparasi peningkatan nilai delta Pre-Post, pembahasan ilmiah lengkap berdasar regulasi BPOM & Kemenkes, serta fitur salin rekap skor untuk kuesioner penelitian).\n7. Tentang & Berkas PDF Skripsi: Lembar penilaian dosen pembimbing dan dokumen akademik A4 siap cetak.\n\nPertanyaan untuk Claude AI:\n1. Menurut Anda, apakah tata letak informasi dan simulasi 6 titik label obat sudah komunikatif untuk masyarakat umum yang awam istilah medis?\n2. Bagaimana evaluasi Anda terkait kepatuhan aspek etika farmasi dan patient safety pada modul Skenario Swamedikasi Bercabang dan Kuis Evaluasi?\n3. Apakah instrumen kuis Pre-Test dan Post-Test ini sudah representatif untuk mengukur peningkatan literasi obat pada responden penelitian skripsi S1 Farmasi?`;\n\n  const handleCopyClaudePrompt = () => {\n    navigator.clipboard.writeText(claudeReviewPrompt).then(() => {\n      setCopiedClaudePrompt(true);\n      setTimeout(() => setCopiedClaudePrompt(false), 2500);\n    });\n  };\n\n  const handlePrintValidationSheet = () => {\n    window.print();\n  };\n\n  return (\n    <div\n      className=\"fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-4 bg-slate-900/60 backdrop-blur-xs animate-in fade-in duration-200\"\n      role=\"dialog\"\n      aria-modal=\"true\"\n      aria-labelledby=\"tinjau-title\"\n    >\n      <div className=\"bg-white rounded-2xl max-w-2xl w-full max-h-[92vh] flex flex-col shadow-2xl border border-slate-200 overflow-hidden\">\n        {/* Header */}\n        <div className=\"flex items-center justify-between px-5 py-4 border-b border-slate-100 bg-teal-800 text-white\">\n          <div className=\"flex items-center gap-2.5\">\n            <div className=\"w-8 h-8 rounded-lg bg-teal-700 flex items-center justify-center shadow-xs\">\n              <FileText className=\"w-4 h-4 text-teal-100\" />\n            </div>\n            <div>\n              <h2 id=\"tinjau-title\" className=\"text-base sm:text-lg font-bold leading-tight\">\n                Berkas Dokumen & Tinjauan Prototipe Skripsi\n              </h2>\n              <p className=\"text-xs text-teal-100\">\n                Dokumen PDF Resmi untuk Dosen Pembimbing, Penguji, dan Claude AI\n              </p>\n            </div>\n          </div>\n          <button\n            type=\"button\"\n            onClick={onClose}\n            className=\"min-h-[44px] min-w-[44px] rounded-lg text-teal-100 hover:text-white hover:bg-teal-700/50 flex items-center justify-center transition-colors cursor-pointer\"\n            aria-label=\"Tutup jendela tinjauan\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Tab Buttons */}\n        <div className=\"p-3 bg-slate-100 border-b border-slate-200\">\n          <div className=\"grid grid-cols-4 gap-1 bg-slate-200/80 p-1 rounded-xl text-xs\">\n            <button\n              type=\"button\"\n              onClick={() => setActiveTab(\'pdf\')}\n              className={`min-h-[40px] px-2 py-1 rounded-lg font-bold transition-all flex items-center justify-center gap-1.5 cursor-pointer ${\n                activeTab === \'pdf\'\n                  ? \'bg-white text-teal-900 shadow-xs\'\n                  : \'text-slate-600 hover:text-slate-900\'\n              }`}\n            >\n              <FileDown className=\"w-3.5 h-3.5 text-teal-700 shrink-0\" />\n              <span>File PDF</span>\n            </button>\n            <button\n              type=\"button\"\n              onClick={() => setActiveTab(\'link\')}\n              className={`min-h-[40px] px-2 py-1 rounded-lg font-bold transition-all flex items-center justify-center gap-1.5 cursor-pointer ${\n                activeTab === \'link\'\n                  ? \'bg-white text-teal-900 shadow-xs\'\n                  : \'text-slate-600 hover:text-slate-900\'\n              }`}\n            >\n              <Share2 className=\"w-3.5 h-3.5 text-teal-700 shrink-0\" />\n              <span>Link Web</span>\n            </button>\n            <button\n              type=\"button\"\n              onClick={() => setActiveTab(\'dosen\')}\n              className={`min-h-[40px] px-2 py-1 rounded-lg font-bold transition-all flex items-center justify-center gap-1.5 cursor-pointer ${\n                activeTab === \'dosen\'\n                  ? \'bg-white text-teal-900 shadow-xs\'\n                  : \'text-slate-600 hover:text-slate-900\'\n              }`}\n            >\n              <GraduationCap className=\"w-3.5 h-3.5 text-teal-700 shrink-0\" />\n              <span className=\"hidden sm:inline\">Untuk Dosen</span>\n              <span className=\"sm:hidden\">Dosen</span>\n            </button>\n            <button\n              type=\"button\"\n              onClick={() => setActiveTab(\'claude\')}\n              className={`min-h-[40px] px-2 py-1 rounded-lg font-bold transition-all flex items-center justify-center gap-1.5 cursor-pointer ${\n                activeTab === \'claude\'\n                  ? \'bg-white text-teal-900 shadow-xs\'\n                  : \'text-slate-600 hover:text-slate-900\'\n              }`}\n            >\n              <Bot className=\"w-3.5 h-3.5 text-indigo-700 shrink-0\" />\n              <span className=\"hidden sm:inline\">Untuk Claude</span>\n              <span className=\"sm:hidden\">Claude</span>\n            </button>\n          </div>\n        </div>\n\n        {/* Content Area */}\n        <div className=\"p-5 overflow-y-auto space-y-4 flex-1\">\n          {/* TAB: FILE PDF PROTOTIPE */}\n          {activeTab === \'pdf\' && (\n            <div className=\"space-y-4\">\n              <div>\n                <div className=\"inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-teal-50 border border-teal-200 text-teal-800 text-[11px] font-bold mb-1\">\n                  <Sparkles className=\"w-3.5 h-3.5 text-teal-600\" />\n                  <span>Dokumen Prototipe Siap Diberikan</span>\n                </div>\n                <h3 className=\"text-base font-bold text-slate-900\">\n                  Dokumen PDF Prototipe Skripsi \"Ruang Obat\"\n                </h3>\n                <p className=\"text-xs sm:text-sm text-slate-600 leading-relaxed mt-0.5\">\n                  File PDF ini telah disusun secara formal (5 halaman A4 standar akademik) berisi seluruh rancangan prototipe, batasan etika farmasi, tabel 6 titik kemasan, lembar validasi dosen, dan prompt Claude AI.\n                </p>\n              </div>\n\n              {/* Big Download & Preview Box */}\n              <div className=\"p-4 sm:p-5 bg-gradient-to-br from-slate-50 to-teal-50/50 rounded-2xl border-2 border-teal-600/30 shadow-xs space-y-4\">\n                <div className=\"flex items-start justify-between gap-3\">\n                  <div className=\"flex items-center gap-3\">\n                    <div className=\"w-12 h-12 rounded-xl bg-teal-700 text-white flex items-center justify-center shrink-0 shadow-xs\">\n                      <FileText className=\"w-6 h-6\" />\n                    </div>\n                    <div>\n                      <h4 className=\"font-extrabold text-slate-900 text-sm sm:text-base\">\n                        Dokumen_Prototipe_Ruang_Obat.pdf\n                      </h4>\n                      <p className=\"text-xs text-slate-500 font-medium\">\n                        Ukuran: ~48 KB \302\267 5 Halaman Lengkap \302\267 Format Cetak A4 Standar Skripsi\n                      </p>\n                    </div>\n                  </div>\n                </div>\n\n                {/* Action Buttons */}\n                <div className=\"space-y-2 pt-1 border-t border-slate-200/80\">\n                  <div className=\"flex flex-col sm:flex-row items-stretch sm:items-center gap-2\">\n                    <button\n                      type=\"button\"\n                      disabled={isGenerating}\n                      onClick={() => {\n                        setIsGenerating(true);\n                        try {\n                          generateAndDownloadPdf();\n                        } catch (err) {\n                          console.error(err);\n                        } finally {\n                          setTimeout(() => setIsGenerating(false), 800);\n                        }\n                      }}\n                      className=\"flex-1 min-h-[46px] px-5 py-2.5 rounded-xl bg-teal-700 hover:bg-teal-800 text-white font-bold text-xs sm:text-sm flex items-center justify-center gap-2 shadow-sm transition-transform active:scale-95 cursor-pointer text-center\"\n                    >\n                      <Download className=\"w-4 h-4\" />\n                      <span>{isGenerating ? \'Membuat File PDF...\' : \'Unduh File PDF Sekarang (Langsung di Perangkat)\'}</span>\n                    </button>\n\n                    <button\n                      type=\"button\"\n                      onClick={() => {\n                        const fullDoc = `# DOKUMEN PROTOTIPE MEDIA EDUKASI SKRIPSI S1 FARMASI\n# RUANG OBAT (\"Kenali label obatmu, kelola obat di rumahmu\")\n\nIDENTITAS PENELITIAN:\n- Aplikasi Web: Ruang Obat (Mobile-First Web App)\n- Bidang: Farmasi Klinis dan Komunitas\n- Sasaran: Mahasiswa Non-Kesehatan dan Masyarakat Umum\n- Tahun: 2026\n\nBAB I: LATAR BELAKANG & BATASAN ETIKA\n1. Urgensi: Mengatasi ketidaktepatan swamedikasi, ketidakpahaman membedakan Expired Date pabrik vs Beyond Use Date (BUD), penyalahgunaan antibiotik sisa teman, dan pembuangan obat rusak yang berbahaya.\n2. Batasan Etika Farmasi (Patient Safety):\n   - TANPA kalkulator dosis & TANPA diagnosis mandiri\n   - TANPA klaim berlebihan (\"ditinjau apoteker\", testimoni)\n   - Seluruh materi menggunakan rujukan resmi Kemenkes RI, BPOM RI, dan Farmakope\n   - Data lemari obat 100% tersimpan lokal di browser (localStorage)\n   - Disclaimer wajib di footer: \"Edukasi umum, bukan diagnosis atau saran dosis pribadi. Tanyakan ke apoteker atau dokter.\"\n\nBAB II: SPESIFIKASI PROTOTIPE\n1. Simulasi Kemasan Interaktif (Tablet, Sirup, Salep) dengan 6 Titik Kritis:\n   - Titik 1: Logo Golongan Obat (Bebas Hijau, Bebas Terbatas Biru P1-P6, Keras Merah K)\n   - Titik 2: Nama & Komposisi Zat Aktif (Generik vs Dagang, kekuatan dosis)\n   - Titik 3: Indikasi Medis Terdaftar\n   - Titik 4: Aturan Pakai, Waktu Makan & Peringatan Khusus\n   - Titik 5: Tanggal Kedaluwarsa (Exp Date) & Nomor Bets Produksi\n   - Titik 6: Nomor Izin Edar (NIE BPOM 15 digit resmi)\n2. Lemari Obat Saya:\n   - Status otomatis dengan IKON & TEKS:\n     * Aman (> 30 hari)\n     * Segera Kedaluwarsa (<= 30 hari)\n     * Kedaluwarsa (lewat tanggal)\n   - Tautan langsung ke Panduan Simpan & Buang (Dagusibu)\n3. Kamus Label Obat:\n   - Glosarium 17+ istilah resmi (NIE, BUD, ED, Rekonstitusi, Suhu Simpan, dll.)\n\nBAB III: LEMBAR PENILAIAN & VALIDASI DOSEN\n- Tabel 7 Indikator Kelayakan Media/Materi (Skala 1-5)\n- Kolom catatan asistensi & rekomendasi perbaikan\n- Kolom persetujuan dan tanda tangan Dosen Pembimbing\n\nBAB IV: PERTANYAAN EVALUASI UNTUK CLAUDE AI\n1. Apakah visualisasi 6 titik label obat sudah komunikatif untuk masyarakat awam?\n2. Apakah batasan etika farmasi dan keamanan pasien sudah kuat untuk skripsi S1?\n3. Saran perbaikan untuk modul latihan (skenario bercabang, flashcard, dan kuis).`;\n\n                        navigator.clipboard.writeText(fullDoc).then(() => {\n                          setCopiedFullDoc(true);\n                          setTimeout(() => setCopiedFullDoc(false), 2500);\n                        });\n                      }}\n                      className=\"min-h-[46px] px-4 py-2.5 rounded-xl bg-indigo-50 hover:bg-indigo-100 border border-indigo-200 text-indigo-900 font-bold text-xs flex items-center justify-center gap-1.5 transition-colors cursor-pointer\"\n                    >\n                      {copiedFullDoc ? (\n                        <>\n                          <Check className=\"w-4 h-4 text-emerald-600\" />\n                          <span className=\"text-emerald-700\">Teks Tersalin!</span>\n                        </>\n                      ) : (\n                        <>\n                          <Copy className=\"w-4 h-4 text-indigo-700\" />\n                          <span>Salin Seluruh Naskah Teks (.txt/.md)</span>\n                        </>\n                      )}\n                    </button>\n                  </div>\n\n                  <p className=\"text-[11px] text-slate-500 italic text-center sm:text-left\">\n                    * Tombol unduh di atas memproses file PDF langsung di memori perangkat Anda sehingga 100% bebas kendala jaringan atau batasan login server.\n                  </p>\n                </div>\n              </div>\n\n              {/* PDF Content Structure Breakdown */}\n              <div className=\"space-y-2\">\n                <span className=\"text-xs font-bold text-slate-700 uppercase tracking-wide block\">\n                  Struktur 5 Halaman Dokumen PDF Ini:\n                </span>\n                <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs\">\n                  <div className=\"p-3 bg-white rounded-xl border border-slate-200 space-y-1\">\n                    <div className=\"font-bold text-teal-800 flex items-center gap-1.5\">\n                      <span className=\"w-5 h-5 rounded-full bg-teal-100 text-teal-800 flex items-center justify-center text-[10px] font-bold\">1</span>\n                      <span>Halaman Judul (Cover)</span>\n                    </div>\n                    <p className=\"text-slate-600 text-[11px] leading-relaxed\">\n                      Judul skripsi, tagline, identitas peneliti, status prototipe, tautan web aktif, dan peringatan kepatuhan etika farmasi.\n                    </p>\n                  </div>\n\n                  <div className=\"p-3 bg-white rounded-xl border border-slate-200 space-y-1\">\n                    <div className=\"font-bold text-teal-800 flex items-center gap-1.5\">\n                      <span className=\"w-5 h-5 rounded-full bg-teal-100 text-teal-800 flex items-center justify-center text-[10px] font-bold\">2</span>\n                      <span>Bab I: Latar Belakang & Etika</span>\n                    </div>\n                    <p className=\"text-slate-600 text-[11px] leading-relaxed\">\n                      Urgensi swamedikasi awam, tujuan Dagusibu, 5 batasan etika ketat (*no dosage calculator/diagnosis*), & peta navigasi.\n                    </p>\n                  </div>\n\n                  <div className=\"p-3 bg-white rounded-xl border border-slate-200 space-y-1\">\n                    <div className=\"font-bold text-teal-800 flex items-center gap-1.5\">\n                      <span className=\"w-5 h-5 rounded-full bg-teal-100 text-teal-800 flex items-center justify-center text-[10px] font-bold\">3</span>\n                      <span>Bab II: Spesifikasi Prototipe</span>\n                    </div>\n                    <p className=\"text-slate-600 text-[11px] leading-relaxed\">\n                      Tabel spesifikasi 6 titik informasi kemasan obat (Tablet, Sirup, Salep), algoritma status lemari obat, dan Dagusibu.\n                    </p>\n                  </div>\n\n                  <div className=\"p-3 bg-white rounded-xl border border-slate-200 space-y-1\">\n                    <div className=\"font-bold text-teal-800 flex items-center gap-1.5\">\n                      <span className=\"w-5 h-5 rounded-full bg-teal-100 text-teal-800 flex items-center justify-center text-[10px] font-bold\">4</span>\n                      <span>Bab III: Lembar Penilaian Dosen</span>\n                    </div>\n                    <p className=\"text-slate-600 text-[11px] leading-relaxed\">\n                      Tabel evaluasi 7 indikator kelayakan materi/media (skala 1-5), catatan revisi, dan kolom tanda tangan Dosen Pembimbing.\n                    </p>\n                  </div>\n\n                  <div className=\"p-3 bg-white rounded-xl border border-slate-200 space-y-1 sm:col-span-2\">\n                    <div className=\"font-bold text-indigo-800 flex items-center gap-1.5\">\n                      <span className=\"w-5 h-5 rounded-full bg-indigo-100 text-indigo-800 flex items-center justify-center text-[10px] font-bold\">5</span>\n                      <span>Bab IV: Panduan Evaluasi Claude AI</span>\n                    </div>\n                    <p className=\"text-slate-600 text-[11px] leading-relaxed\">\n                      Teks prompt terstruktur siap salin atau dapat langsung diunggah (*upload PDF*) ke Claude AI untuk analisis desain instruksional.\n                    </p>\n                  </div>\n                </div>\n              </div>\n\n              {/* Usage Guide */}\n              <div className=\"p-3.5 bg-slate-50 rounded-xl border border-slate-200 text-xs text-slate-700 space-y-1.5\">\n                <span className=\"font-bold text-slate-900 block\">Cara Penggunaan:</span>\n                <ul className=\"list-disc list-inside space-y-1 text-slate-600 text-[11px]\">\n                  <li><strong>Kepada Dosen Pembimbing:</strong> Kirimkan file PDF ini via WhatsApp atau email, atau cetak Halaman 4 saat asistensi bimbingan skripsi.</li>\n                  <li><strong>Kepada Claude AI:</strong> Unggah (*attach file*) PDF ini langsung ke percakapan Claude AI dan mintalah evaluasi komprehensif.</li>\n                </ul>\n              </div>\n            </div>\n          )}\n\n          {/* TAB 2: Tautan Web & QR Code */}\n          {activeTab === \'link\' && (\n            <div className=\"space-y-4\">\n              <div>\n                <h3 className=\"text-base font-bold text-slate-900\">\n                  Tautan Akses Publik Web App\n                </h3>\n                <p className=\"text-xs sm:text-sm text-slate-600 leading-relaxed mt-0.5\">\n                  Bagikan tautan ini ke dosen pembimbing, penguji, atau partisipan uji coba agar web app dapat langsung dibuka di peramban ponsel maupun laptop tanpa perlu instalasi.\n                </p>\n              </div>\n\n              {/* URL Box */}\n              <div className=\"p-3.5 bg-slate-50 rounded-xl border border-slate-200 space-y-2\">\n                <span className=\"text-xs font-bold text-slate-700 block\">\n                  Tautan Bersama (Shared Preview URL):\n                </span>\n                <div className=\"flex flex-col sm:flex-row items-stretch sm:items-center gap-2\">\n                  <div className=\"flex-1 p-2.5 bg-white border border-slate-300 rounded-lg text-xs font-mono text-teal-900 break-all select-all\">\n                    {bestUrlToShare}\n                  </div>\n                  <button\n                    type=\"button\"\n                    onClick={handleCopyLink}\n                    className={`min-h-[44px] px-4 py-2 rounded-lg font-bold text-xs flex items-center justify-center gap-1.5 transition-all cursor-pointer shrink-0 ${\n                      copiedLink\n                        ? \'bg-emerald-600 text-white\'\n                        : \'bg-teal-700 hover:bg-teal-800 text-white shadow-xs\'\n                    }`}\n                  >\n                    {copiedLink ? (\n                      <>\n                        <Check className=\"w-4 h-4\" />\n                        <span>Tersalin!</span>\n                      </>\n                    ) : (\n                      <>\n                        <Copy className=\"w-4 h-4\" />\n                        <span>Salin Tautan</span>\n                      </>\n                    )}\n                  </button>\n                </div>\n              </div>\n\n              {/* QR Code Section */}\n              <div className=\"p-4 bg-teal-50/60 rounded-xl border border-teal-200/80 flex flex-col sm:flex-row items-center gap-4\">\n                <div className=\"w-24 h-24 bg-white p-2 rounded-xl border border-teal-300 shadow-xs flex items-center justify-center shrink-0\">\n                  <svg viewBox=\"0 0 100 100\" className=\"w-full h-full text-teal-900\" fill=\"currentColor\">\n                    <rect x=\"5\" y=\"5\" width=\"28\" height=\"28\" rx=\"4\" fill=\"currentColor\" />\n                    <rect x=\"9\" y=\"9\" width=\"20\" height=\"20\" rx=\"2\" fill=\"white\" />\n                    <rect x=\"14\" y=\"14\" width=\"10\" height=\"10\" fill=\"currentColor\" />\n\n                    <rect x=\"67\" y=\"5\" width=\"28\" height=\"28\" rx=\"4\" fill=\"currentColor\" />\n                    <rect x=\"71\" y=\"9\" width=\"20\" height=\"20\" rx=\"2\" fill=\"white\" />\n                    <rect x=\"76\" y=\"14\" width=\"10\" height=\"10\" fill=\"currentColor\" />\n\n                    <rect x=\"5\" y=\"67\" width=\"28\" height=\"28\" rx=\"4\" fill=\"currentColor\" />\n                    <rect x=\"9\" y=\"71\" width=\"20\" height=\"20\" rx=\"2\" fill=\"white\" />\n                    <rect x=\"14\" y=\"76\" width=\"10\" height=\"10\" fill=\"currentColor\" />\n\n                    <rect x=\"38\" y=\"10\" width=\"8\" height=\"8\" fill=\"currentColor\" />\n                    <rect x=\"50\" y=\"10\" width=\"8\" height=\"8\" fill=\"currentColor\" />\n                    <rect x=\"44\" y=\"24\" width=\"8\" height=\"8\" fill=\"currentColor\" />\n                    <rect x=\"10\" y=\"44\" width=\"8\" height=\"8\" fill=\"currentColor\" />\n                    <rect x=\"24\" y=\"44\" width=\"8\" height=\"8\" fill=\"currentColor\" />\n                    <rect x=\"38\" y=\"38\" width=\"8\" height=\"8\" fill=\"currentColor\" />\n                    <rect x=\"52\" y=\"38\" width=\"8\" height=\"8\" fill=\"currentColor\" />\n                    <rect x=\"66\" y=\"44\" width=\"8\" height=\"8\" fill=\"currentColor\" />\n                    <rect x=\"80\" y=\"44\" width=\"8\" height=\"8\" fill=\"currentColor\" />\n                    <rect x=\"44\" y=\"52\" width=\"8\" height=\"8\" fill=\"currentColor\" />\n                    <rect x=\"38\" y=\"66\" width=\"8\" height=\"8\" fill=\"currentColor\" />\n                    <rect x=\"52\" y=\"66\" width=\"8\" height=\"8\" fill=\"currentColor\" />\n                    <rect x=\"66\" y=\"66\" width=\"8\" height=\"8\" fill=\"currentColor\" />\n                    <rect x=\"80\" y=\"66\" width=\"8\" height=\"8\" fill=\"currentColor\" />\n                    <rect x=\"44\" y=\"80\" width=\"8\" height=\"8\" fill=\"currentColor\" />\n                    <rect x=\"66\" y=\"80\" width=\"8\" height=\"8\" fill=\"currentColor\" />\n                    <rect x=\"80\" y=\"80\" width=\"8\" height=\"8\" fill=\"currentColor\" />\n                  </svg>\n                </div>\n                <div className=\"space-y-1 text-center sm:text-left\">\n                  <span className=\"text-xs font-bold text-teal-900 block\">\n                    Uji Coba Langsung di Smartphone (Mobile-First)\n                  </span>\n                  <p className=\"text-xs text-slate-600 leading-relaxed\">\n                    Aplikasi ini dirancang khusus dengan ergonomi sentuhan jempol (thumb-friendly). Dosen atau partisipan dapat langsung membuka tautan di browser Safari, Chrome, atau Firefox di HP.\n                  </p>\n                </div>\n              </div>\n\n              {/* Direct Open in New Tab Button */}\n              <div className=\"flex justify-end pt-1\">\n                <a\n                  href={bestUrlToShare}\n                  target=\"_blank\"\n                  rel=\"noopener noreferrer\"\n                  className=\"min-h-[44px] px-4 py-2 rounded-xl border border-slate-300 hover:bg-slate-100 text-slate-700 font-semibold text-xs flex items-center gap-1.5 transition-colors cursor-pointer\"\n                >\n                  <ExternalLink className=\"w-4 h-4 text-slate-600\" />\n                  <span>Buka di Tab Baru Peramban</span>\n                </a>\n              </div>\n            </div>\n          )}\n\n          {/* TAB 3: Untuk Dosen Pembimbing / Penguji */}\n          {activeTab === \'dosen\' && (\n            <div className=\"space-y-4\">\n              <div>\n                <h3 className=\"text-base font-bold text-slate-900\">\n                  Panduan Validasi & Tinjauan Dosen Skripsi\n                </h3>\n                <p className=\"text-xs sm:text-sm text-slate-600 leading-relaxed mt-0.5\">\n                  Gunakan daftar periksa (checklist) berikut saat asistensi atau bimbingan skripsi bersama Dosen Pembimbing.\n                </p>\n              </div>\n\n              {/* Checklist Validasi */}\n              <div className=\"space-y-2.5\">\n                <div className=\"p-3 bg-slate-50 rounded-xl border border-slate-200 flex items-start gap-2.5\">\n                  <CheckCircle2 className=\"w-4 h-4 text-teal-700 shrink-0 mt-0.5\" />\n                  <div className=\"text-xs text-slate-700 leading-relaxed\">\n                    <strong className=\"text-slate-900 block\">1. Validasi 6 Titik Kritis Kemasan Obat:</strong>\n                    Memastikan titik ketuk pada kemasan Tablet, Sirup, dan Salep telah mencakup Logo Golongan, Zat Aktif, Indikasi, Aturan Pakai, ED/Bets, dan NIE BPOM sesuai rujukan resmi.\n                  </div>\n                </div>\n\n                <div className=\"p-3 bg-slate-50 rounded-xl border border-slate-200 flex items-start gap-2.5\">\n                  <CheckCircle2 className=\"w-4 h-4 text-teal-700 shrink-0 mt-0.5\" />\n                  <div className=\"text-xs text-slate-700 leading-relaxed\">\n                    <strong className=\"text-slate-900 block\">2. Kepatuhan Batasan Etika Farmasi (Patient Safety):</strong>\n                    Aplikasi terbukti bebas dari kalkulator dosis, bebas alat diagnosis mandiri, dan bebas rekomendasi terapi liar untuk menjamin keselamatan pasien.\n                  </div>\n                </div>\n\n                <div className=\"p-3 bg-slate-50 rounded-xl border border-slate-200 flex items-start gap-2.5\">\n                  <CheckCircle2 className=\"w-4 h-4 text-teal-700 shrink-0 mt-0.5\" />\n                  <div className=\"text-xs text-slate-700 leading-relaxed\">\n                    <strong className=\"text-slate-900 block\">3. Prinsip Dagusibu & Pengelolaan Obat Rumah Tangga:</strong>\n                    Tersedianya panduan penyimpanan dan cara pemusnahan obat kedaluwarsa/rusak agar tidak disalahgunakan atau mencemari lingkungan.\n                  </div>\n                </div>\n\n                <div className=\"p-3 bg-slate-50 rounded-xl border border-slate-200 flex items-start gap-2.5\">\n                  <CheckCircle2 className=\"w-4 h-4 text-teal-700 shrink-0 mt-0.5\" />\n                  <div className=\"text-xs text-slate-700 leading-relaxed\">\n                    <strong className=\"text-slate-900 block\">4. Integritas Data & Kerahasiaan (Data On-Device):</strong>\n                    Semua pencatatan lemari obat hanya tersimpan di memori perangkat mahasiswa/responden, tanpa mengirim riwayat obat ke server luar.\n                  </div>\n                </div>\n              </div>\n\n              {/* Action: Print validation sheet */}\n              <div className=\"p-3 bg-amber-50 rounded-xl border border-amber-200 flex items-center justify-between gap-3\">\n                <div className=\"text-xs text-amber-900\">\n                  <span className=\"font-bold block\">Butuh Lembar Cetak untuk Bimbingan?</span>\n                  <span>Anda dapat mencetak rangkuman checklist ini langsung untuk dibawa saat tatap muka.</span>\n                </div>\n                <button\n                  type=\"button\"\n                  onClick={handlePrintValidationSheet}\n                  className=\"min-h-[40px] px-3 py-1.5 bg-amber-700 hover:bg-amber-800 text-white font-semibold text-xs rounded-lg flex items-center gap-1.5 shrink-0 cursor-pointer\"\n                >\n                  <Printer className=\"w-3.5 h-3.5\" />\n                  <span>Cetak Lembar</span>\n                </button>\n              </div>\n            </div>\n          )}\n\n          {/* TAB 4: Untuk Claude AI */}\n          {activeTab === \'claude\' && (\n            <div className=\"space-y-4\">\n              <div>\n                <h3 className=\"text-base font-bold text-slate-900\">\n                  Salin Prompt Lengkap untuk Divalidasi oleh Claude AI\n                </h3>\n                <p className=\"text-xs sm:text-sm text-slate-600 leading-relaxed mt-0.5\">\n                  Klik tombol di bawah untuk menyalin seluruh ringkasan teknis, aturan ketat skripsi, daftar fitur, dan pertanyaan evaluasi ke papan klip (clipboard). Kemudian tempelkan langsung di Claude AI, atau unggah file PDF yang telah diunduh.\n                </p>\n              </div>\n\n              {/* Big Copy Button */}\n              <button\n                type=\"button\"\n                onClick={handleCopyClaudePrompt}\n                className={`w-full min-h-[48px] p-3 rounded-xl font-bold text-sm flex items-center justify-center gap-2 transition-all cursor-pointer shadow-sm ${\n                  copiedClaudePrompt\n                    ? \'bg-emerald-600 text-white\'\n                    : \'bg-indigo-700 hover:bg-indigo-800 text-white\'\n                }`}\n              >\n                {copiedClaudePrompt ? (\n                  <>\n                    <Check className=\"w-5 h-5\" />\n                    <span>Prompt untuk Claude AI Berhasil Disalin!</span>\n                  </>\n                ) : (\n                  <>\n                    <Copy className=\"w-5 h-5\" />\n                    <span>Salin Prompt Ringkasan Skripsi untuk Claude AI</span>\n                  </>\n                )}\n              </button>\n\n              {/* Prompt Preview Box */}\n              <div className=\"space-y-1\">\n                <span className=\"text-xs font-bold text-slate-600 block\">\n                  Pratinjau Teks yang Disalin:\n                </span>\n                <div className=\"max-h-48 overflow-y-auto p-3 bg-slate-50 border border-slate-200 rounded-xl text-xs font-mono text-slate-700 whitespace-pre-wrap leading-relaxed\">\n                  {claudeReviewPrompt}\n                </div>\n              </div>\n\n              <div className=\"text-[11px] text-slate-500 italic\">\n                * Claude AI dapat memberikan analisis desain instruksional, kejelasan bahasa awam, dan kesiapan sebelum uji lapangan kepada mahasiswa non-kesehatan.\n              </div>\n            </div>\n          )}\n        </div>\n\n        {/* Footer */}\n        <div className=\"px-5 py-3 bg-slate-50 border-t border-slate-200 flex items-center justify-between text-xs text-slate-500\">\n          <span className=\"truncate max-w-[200px] sm:max-w-xs\">\n            Ruang Obat \302\267 Skripsi S1 Farmasi\n          </span>\n          <button\n            type=\"button\"\n            onClick={onClose}\n            className=\"min-h-[44px] px-5 py-2 font-semibold text-slate-700 bg-white border border-slate-300 hover:bg-slate-50 rounded-xl transition-colors cursor-pointer\"\n          >\n            Tutup\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    num_lines: 628
    num_bytes: 34025
    line_range_bytes: 34025
  }
}
