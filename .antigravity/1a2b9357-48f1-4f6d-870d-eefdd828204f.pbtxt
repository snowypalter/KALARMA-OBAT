              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                    Memastikan titik ketuk pada kemasan Tablet, Sirup, dan Salep telah mencakup Logo Golongan, Zat Aktif, Indikasi, Aturan Pakai, ED/Bets, dan NIE BPOM sesuai rujukan resmi."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
