      arguments_json: "{\"Description\":\"Replace skripsi copy with Tugas Akhir Berbasis Proyek, update buttons to bg-brand, and enforce >=44px touch targets in KuisModule.tsx\", \"Instruction\":\"Update terminology, button color tokens, and min-h-[44px] in KuisModule.tsx\", \"ReplacementChunks\":[{\"AllowMultiple\":false, \"EndLine\":107, \"ReplacementContent\":\"    const text = `--- HASIL EVALUASI LITERASI OBAT (RUANG OBAT) ---\\nMedia Edukasi Tugas Akhir Berbasis Proyek S1 Farmasi Klinik dan Komunitas\\nMode: ${modeLabel}\", \"StartLine\":103, \"TargetContent\":\"    const text = `--- HASIL EVALUASI LITERASI OBAT (RUANG OBAT) ---\\nInstrumen Penelitian Skripsi S1 Farmasi\\nMode: ${modeLabel}\"}, {\"AllowMultiple\":false, \"EndLine\":166, \"ReplacementContent\":\"            <p className=\\\"text-xs font-semibold uppercase tracking-wider text-brand\\\">\\n              Instrumen Evaluasi Tugas Akhir Berbasis Proyek \302\267 {totalQuestions} Butir Soal Terstandar\\n            </p>\\n            <h2 className=\\\"font-display text-xl sm:text-2xl font-semibold text-forest\\\">\\n              Uji Pemahaman Literasi Obat\\n            </h2>\\n          </div>\\n\\n          <div className=\\\"flex items-center gap-1.5 p-1 bg-surface-muted rounded-xl border border-line self-start sm:self-auto\\\">\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => handleReset(\'pretest\')}\\n              className={`min-h-[44px] px-3.5 py-1.5 rounded-lg text-xs font-semibold transition-all cursor-pointer ${\\n                mode === \'pretest\'\\n                  ? \'bg-status-segera-text text-white shadow-xs\'\\n                  : \'text-ink-muted hover:text-forest\'\\n              }`}\\n            >\\n              Mode Pre-Test\\n            </button>\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => handleReset(\'posttest\')}\\n              className={`min-h-[44px] px-3.5 py-1.5 rounded-lg text-xs font-semibold transition-all cursor-pointer ${\\n                mode === \'posttest\'\\n                  ? \'bg-forest text-white shadow-xs\'\\n                  : \'text-ink-muted hover:text-forest\'\\n              }`}\\n            >\\n              Mode Post-Test\\n            </button>\\n          </div>\", \"StartLine\":135, \"TargetContent\":\"            <p className=\\\"text-xs font-semibold uppercase tracking-wider text-brand\\\">\\n              Instrumen Evaluasi Skripsi \302\267 {totalQuestions} Butir Soal Terstandar\\n            </p>\\n            <h2 className=\\\"font-display text-xl sm:text-2xl font-semibold text-forest\\\">\\n              Uji Pemahaman Literasi Obat\\n            </h2>\\n          </div>\\n\\n          <div className=\\\"flex items-center gap-1.5 p-1 bg-surface-muted rounded-xl border border-line self-start sm:self-auto\\\">\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => handleReset(\'pretest\')}\\n              className={`min-h-[38px] px-3.5 py-1.5 rounded-lg text-xs font-semibold transition-all cursor-pointer ${\\n                mode === \'pretest\'\\n                  ? \'bg-status-segera-text text-white shadow-xs\'\\n                  : \'text-ink-muted hover:text-forest\'\\n              }`}\\n            >\\n              Mode Pre-Test\\n            </button>\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => handleReset(\'posttest\')}\\n              className={`min-h-[38px] px-3.5 py-1.5 rounded-lg text-xs font-semibold transition-all cursor-pointer ${\\n                mode === \'posttest\'\\n                  ? \'bg-forest text-white shadow-xs\'\\n                  : \'text-ink-muted hover:text-forest\'\\n              }`}\\n            >\\n              Mode Post-Test\\n            </button>\\n          </div>\"}, {\"AllowMultiple\":false, \"EndLine\":215, \"ReplacementContent\":\"                    className={`min-h-[44px] min-w-[44px] rounded-lg text-xs font-mono font-bold flex items-center justify-center shrink-0 transition-all cursor-pointer ${\\n                      isCurrent\\n                        ? \'bg-forest text-sand ring-2 ring-brand/40\'\\n                        : isAnswered\\n                        ? \'bg-secondary text-forest\'\\n                        : \'bg-surface-muted text-ink-muted hover:bg-secondary/60\'\\n                    }`}\", \"StartLine\":204, \"TargetContent\":\"                    className={`w-8 h-8 rounded-lg text-xs font-mono font-bold flex items-center justify-center shrink-0 transition-all cursor-pointer ${\\n                      isCurrent\\n                        ? \'bg-forest text-sand ring-2 ring-brand/40\'\\n                        : isAnswered\\n                        ? \'bg-secondary text-forest\'\\n                        : \'bg-surface-muted text-ink-muted hover:bg-secondary/60\'\\n                    }`}\"}, {\"AllowMultiple\":false, \"EndLine\":278, \"ReplacementContent\":\"                  className=\\\"min-h-[44px] px-5 py-2 rounded-xl bg-brand hover:bg-forest text-on-brand text-xs sm:text-sm font-semibold flex items-center gap-1.5 cursor-pointer\\\"\", \"StartLine\":272, \"TargetContent\":\"                  className=\\\"min-h-[44px] px-5 py-2 rounded-xl bg-forest hover:bg-brand text-on-brand text-xs sm:text-sm font-semibold flex items-center gap-1.5 cursor-pointer\\\"\"}, {\"AllowMultiple\":false, \"EndLine\":380, \"ReplacementContent\":\"                    <span>Salin Rekap Evaluasi</span>\\n                  </>\\n                )}\\n              </button>\\n\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => handleReset()}\\n                className=\\\"min-h-[44px] px-4 py-2 rounded-xl bg-white/10 hover:bg-white/20 border border-white/20 text-white text-xs sm:text-sm font-semibold flex items-center gap-2 cursor-pointer transition-colors\\\"\\n              >\\n                <Rotate