            lines {
              text: "        onNext={() =>"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          setWalkthroughStepIndex((prev) =>"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            Math.min(prev + 1, WALKTHROUGH_STEPS.length - 1)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
