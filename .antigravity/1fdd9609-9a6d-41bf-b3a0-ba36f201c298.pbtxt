            }
            lines {
              text: "    definition: \'[ISI DARI RUJUKAN: Farmakope Indonesia - Proses Penambahan Air Matang Dingin Sesuai Batas Garis Botol Sebelum Pertama Kali Diminum]\',"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    referenceSource: \'Farmakope Indonesia\'"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    definition: \'Proses melarutkan serbuk/granul obat kering (umumnya antibiotik anak) dengan air matang bersuhu ruang tepat hingga batas tanda garis pada botol sebelum pertama kali diminum, lalu dikocok merata. Setelah direkonstitusi, botol wajib ditandai tanggal dan dihabiskan dalam batas BUD.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
