            lines {
              text: "          meaning: \'[ISI DARI RUJUKAN: BPOM - Tanda Khusus pada Label Kemasan Sirup]\',"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          tips: \'[ISI DARI RUJUKAN: Kemenkes RI - Cara Mengenali Obat Bebas Terbatas pada Sirup Batuk/Flu]\',"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          warning: \'[ISI DARI RUJUKAN: BPOM - Pengawasan Ketat Sirup Anak dan Bahan Pelarut Aman]\'"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          meaning: \'Lingkaran berwarna pada label badan botol sirup menunjukkan status legalitas perolehan obat: Hijau untuk Obat Bebas, Biru untuk Obat Bebas Terbatas (Daftar W dengan kotak peringatan hitam P.No. 1\342\200\2236), dan Merah huruf K untuk Obat Keras seperti sirup kering antibiotik (HKI 2022, Bab VII: Penggolongan Jenis Obat).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          tips: \'Sirup batuk/flu bebas terbatas sering membawa peringatan P.No. 1 (\"Awas! Obat Keras. Bacalah aturan memakainya\"). Pastikan melihat logo golongan dan baca aturan pakai pada label botol maupun dus.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          warning: \'Sirup kering antibiotik berlogo lingkaran merah huruf K hanya boleh digunakan sesuai resep dokter dan wajib dihabiskan sesuai durasi terapi untuk mencegah resistensi bakteri (Farmakologi dan Terapi Ed. 4 FKUI, Bab 39: Pengantar Antimikroba).\'"
