ts:50:    tautanPlaceholder: \'[ISI DARI RUJUKAN: https://www.who.int/publications/]\',src/data/pustakaData.ts:57:    judul: \'[ISI DARI RUJUKAN: General Chapter <795> & <797> Beyond-Use Date Determination in Nonsterile and Sterile Preparations]\',src/data/pustakaData.ts:60:    tautanPlaceholder: \'[ISI DARI RUJUKAN: https://www.uspnf.com/]\',src/views/CekLabelView.tsx:5:import { RujukanText } from \'../components/ui\';src/views/CekLabelView.tsx:217:                <RujukanText text={activeHotspot.content.meaning} block />src/views/CekLabelView.tsx:227:                <RujukanText text={activeHotspot.content.tips} block />src/views/CekLabelView.tsx:237:                <RujukanText text={activeHotspot.content.warning} block />src/views/LemariView.tsx:249:            placeholder=\"Cari nama obat, bentuk sediaan, atau catatan (misal: Parasetamol)...\"src/views/LemariView.tsx:251:            className=\"w-full min-h-[46px] pl-10 pr-10 py-2.5 text-sm bg-surface border border-line rounded-xl text-ink placeholder:text-ink-muted/70 focus:outline-none focus:ring-2 focus:ring-focus focus:border-transparent\"src/views/LemariView.tsx:566:              placeholder=\"Misal: Parasetamol 500 mg, Sirup Batuk...\"src/views/LemariView.tsx:650:              placeholder=\"Misal: Simpan di kotak P3K ruang tamu, jauhkan dari anak...\"src/views/PustakaView.tsx:3:import { RujukanText } from \'../components/ui\';src/views/PustakaView.tsx:41:          placeholder=\"Cari penulis, regulasi, BPOM, Kemenkes, Dagusibu...\"src/views/PustakaView.tsx:43:          className=\"w-full min-h-[46px] pl-10 pr-12 py-2.5 text-sm bg-surface border border-line rounded-xl text-ink placeholder:text-ink-muted/70 focus:outline-none focus:ring-2 focus:ring-focus focus:border-transparent\"src/views/PustakaView.tsx:76:                  <RujukanTextsrc/views/PustakaView.tsx:96:                <RujukanTextsrc/views/BerandaView.tsx:285:                  placeholder=\"Cari istilah (BUD, NIE) atau nama obat di lemari...\"