            }
            lines {
              text: "          meaning: \'[ISI DARI RUJUKAN: BPOM - Indikasi dan Batas Usia Konsumsi Sirup]\',"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          tips: \'[ISI DARI RUJUKAN: Kemenkes RI - Menyesuaikan Dosis dengan Kelompok Umur atau Berat Badan]\',"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          warning: \'[ISI DARI RUJUKAN: IDAI / BPOM - Larangan Memberikan Sirup Tertentu pada Bayi di Bawah Umur Tanpa Resep]\'"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          meaning: \'Menjelaskan gejala yang ditangani oleh sirup serta rentang usia atau berat badan sasaran. Anak-anak bukan \"orang dewasa mini\" karena fungsi metabolisme hati, ekskresi ginjal, dan distribusi cairan tubuhnya berbeda (Farmakologi dan Terapi Ed. 4 FKUI, Bab 56: Faktor-Faktor yang Mempengaruhi Respons Penderita Terhadap Obat).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          tips: \'Cocokkan usia pasien dengan tabel aturan pakai di kemasan dan perhatikan apakah sediaan ditujukan khusus untuk bayi (drops/guttae), anak, atau dewasa. Jika berat badan anak jauh di luar rata-rata usianya, konsultasikan kepada apoteker atau dokter.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          warning: \'Pemberian obat bebas atau bebas terbatas pada bayi di bawah usia 2 tahun tidak boleh dilakukan sembarangan tanpa konsultasi dokter karena risiko toksisitas organ yang belum matang (Farmakologi dan Terapi Ed. 4 FKUI, Bab 56 & HKI 2022, Bab V).\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
