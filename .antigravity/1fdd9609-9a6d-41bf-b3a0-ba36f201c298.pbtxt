              text: "        content: {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          meaning: \'[ISI DARI RUJUKAN: BPOM - Pedoman Tanda Khusus Obat Jadi]\',"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          tips: \'[ISI DARI RUJUKAN: Kemenkes RI - Mengenali Lingkaran Hijau, Biru, dan Merah Huruf K]\',"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          warning: \'[ISI DARI RUJUKAN: BPOM - Bahaya Membeli Obat Keras Tanpa Resep Dokter]\'"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          meaning: \'Penandaan resmi golongan obat pada kemasan sesuai Permenkes RI: lingkaran hijau bergaris tepi hitam menandakan Obat Bebas (dapat dibeli tanpa resep untuk keluhan ringan); lingkaran biru menandakan Obat Bebas Terbatas / Daftar W (disertai tanda peringatan P.No. 1\342\200\2236); dan lingkaran merah bertuliskan huruf K hitam menandakan Obat Keras / Daftar G (Buku Ajar Farmakologi HKI 2022, Bab VII: Penggolongan Jenis Obat).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          tips: \'Sebelum membeli obat di apotek atau toko obat berizin, periksa warna lingkaran pada pojok kemasan. Obat Bebas Terbatas wajib dibeli dalam kemasan asli pabrik beserta kotak peringatan hitam berukuran 5 x 2 cm.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          warning: \'Obat Keras berlogo lingkaran merah huruf K (seperti antibiotik, antihipertensi, antidiabetik, atau kortikosteroid) hanya boleh diperoleh dengan resep dokter di apotek\342\200\224kecuali obat tertentu dalam daftar Obat Wajib Apotek (OWA) yang diserahkan langsung oleh apoteker (HKI 2022, Bab VII).\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
