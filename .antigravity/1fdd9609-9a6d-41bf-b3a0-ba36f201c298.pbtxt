            }
            lines {
              text: "          meaning: \'[ISI DARI RUJUKAN: USP / Kemenkes RI - Perbedaan Expired Date Pabrik vs Beyond Use Date]\',"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          tips: \'[ISI DARI RUJUKAN: Kemenkes RI - Kebiasaan Menulis Tanggal Pertama Buka Botol pada Label]\',"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          warning: \'[ISI DARI RUJUKAN: BPOM - Tanda Kerusakan Sirup: Berubah Warna, Keruh, Berbau Asam, atau Ada Kristal]\'"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          meaning: \'Expired Date (ED) hanya berlaku selama segel botol belum dibuka. Setelah dibuka atau direkonstitusi dengan air (sirup kering), masa simpan aman turun menjadi Beyond Use Date (BUD)\342\200\224misalnya sirup kering antibiotik umumnya hanya stabil 7\342\200\22314 hari setelah dilarutkan (USP <795>; Kemenkes RI; HKI 2022, Bab VIII).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          tips: \'Biasakan menulis tanggal pertama kali botol dibuka atau tanggal pencampuran air menggunakan spidol permanen langsung pada label botol, lalu pantau di fitur Lemari Obat Saya.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          warning: \'Segera hentikan pemakaian dan buang sesuai prosedur DAGUSIBU apabila cairan berubah warna, menjadi keruh tidak wajar, berbau asam/menyimpang, menggumpal yang tak terdispersi saat dikocok, atau muncul kristal/jamur (HKI 2022, Bab IX & BPOM RI).\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        }"
