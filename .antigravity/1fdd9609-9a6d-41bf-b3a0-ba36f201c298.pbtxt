            lines {
              text: "        title: \'Aturan Pakai & Peringatan\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        shortDescription: \'Frekuensi minum, hubungan dengan waktu makan, dan kontraindikasi.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        xPercent: 50,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
