            }
            lines {
              text: "    definition: \'Jumlah atau takaran obat yang diberikan pada satu kali pemakaian atau dalam rentang waktu tertentu untuk menghasilkan efek terapi yang diinginkan tanpa melampaui batas aman toksisitas (dosis menentukan apakah suatu zat bekerja sebagai obat atau racun).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
