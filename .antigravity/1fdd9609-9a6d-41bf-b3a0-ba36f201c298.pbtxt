    command_line: "npx tsx -e \"\n(async () => {\n  const fs = await import(\'fs/promises\');\n  const { getDocumentProxy } = await import(\'unpdf\');\n  const buf = await fs.readFile(\'public/assets/aistudio/kupdf.net_farmakologi-dan-terapi-edisi-4_991d8e3d.pdf\');\n  const pdf = await getDocumentProxy(new Uint8Array(buf));\n  console.log(\'FKUI Ed4 numPages:\', pdf.numPages);\n  for (let i = 1; i <= Math.min(20, pdf.numPages); i++) {\n    const page = await pdf.getPage(i);\n    const content = await page.getTextContent();\n    const txt = content.items.map((it: any) => it.str).join(\' \');\n    console.log(\'=== PAGE\', i, \'===\\n\', txt.slice(0, 1500));\n  }\n})();\n\""
    proposed_command_line: "npx tsx -e \"\n(async () => {\n  const fs = await import(\'fs/promises\');\n  const { getDocumentProxy } = await import(\'unpdf\');\n  const buf = await fs.readFile(\'public/assets/aistudio/kupdf.net_farmakologi-dan-terapi-edisi-4_991d8e3d.pdf\');\n  const pdf = await getDocumentProxy(new Uint8Array(buf));\n  console.log(\'FKUI Ed4 numPages:\', pdf.numPages);\n  for (let i = 1; i <= Math.min(20, pdf.numPages); i++) {\n    const page = await pdf.getPage(i);\n    const content = await page.getTextContent();\n    const txt = content.items.map((it: any) => it.str).join(\' \');\n    console.log(\'=== PAGE\', i, \'===\\n\', txt.slice(0, 1500));\n  }\n})();\n\""
