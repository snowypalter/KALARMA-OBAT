            lines {
              text: "          meaning: \'[ISI DARI RUJUKAN: BPOM - Standar Penulisan Kekuatan Sediaan Cair]\',"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          tips: \'[ISI DARI RUJUKAN: Kemenkes RI - Wajib Menggunakan Sendok Takar Resmi Bawaan Obat, Bukan Sendok Makan Dapur]\',"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          warning: \'[ISI DARI RUJUKAN: Farmasi Klinis - Risiko Ketidaktepatan Volume jika Menggunakan Sendok Makan Biasa]\'"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          meaning: \'Menyatakan kekuatan kadar zat berkhasiat yang terlarut atau terdispersi dalam setiap 5 mililiter cairan (satu sendok takar obat standar), sebagaimana dijelaskan pada pengelompokan sediaan cair seperti sirup, eliksir, dan suspensi (HKI 2022, Bab IX: Bentuk Sediaan Obat).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          tips: \'Selalu ukur obat cair menggunakan sendok takar berskala, gelas takar, atau pipet/spuit oral bawaan kemasan. Pegang wadah takar sejajar pandangan mata dan pastikan permukaan cairan berada tepat pada garis dasar meniskus sesuai takaran (HKI 2022, Bab XI: Cara Pemberian Obat).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          warning: \'Jangan menggunakan sendok makan atau sendok teh dapur karena volumenya tidak seragam (sendok makan dapur berkisar 10\342\200\22315 mL) sehingga berisiko menyebabkan kekurangan dosis atau kelebihan dosis berbahaya, terutama pada anak-anak (HKI 2022, Bab VIII & Bab XI).\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
