  view_file {
    absolute_path_uri: "file:///server/knowledgeBase.ts"
    end_line: 461
    content: "import fs from \'node:fs/promises\';\nimport path from \'node:path\';\nimport JSZip from \'jszip\';\nimport { extractText } from \'unpdf\';\n\nexport interface KnowledgeChunk {\n  id: string;\n  sourceType: \'website\' | \'book\';\n  sourceName: string;\n  sectionTitle: string;\n  text: string;\n  tokens: Set<string>;\n}\n\nexport interface BookSourceMeta {\n  id: string;\n  fileName: string;\n  origin: \'folder\' | \'upload\';\n  fileType: \'zip\' | \'pdf\' | \'text\';\n  innerFiles: string[];\n  chunkCount: number;\n  totalChars: number;\n  addedAt: string;\n}\n\nexport interface KnowledgeSummary {\n  websiteChunks: number;\n  websiteModules: string[];\n  books: BookSourceMeta[];\n  totalBookChunks: number;\n}\n\nconst ROOT_DIR = process.cwd();\nconst KNOWLEDGE_DIR = path.join(ROOT_DIR, \'knowledge_books\');\nconst UPLOADS_DIR = path.join(KNOWLEDGE_DIR, \'uploads\');\n\nconst STOPWORDS = new Set([\n  \'yang\', \'dan\', \'di\', \'ke\', \'dari\', \'untuk\', \'pada\', \'dengan\', \'adalah\', \'ini\', \'itu\',\n  \'atau\', \'juga\', \'bisa\', \'dapat\', \'apa\', \'bagaimana\', \'kenapa\', \'mengapa\', \'kapan\',\n  \'siapa\', \'mana\', \'saja\', \'ada\', \'tidak\', \'bukan\', \'ya\', \'oleh\', \'dalam\', \'akan\',\n  \'seperti\', \'tentang\', \'seputar\', \'isi\', \'website\', \'aplikasi\', \'ruang\', \'obat\',\n  \'saya\', \'aku\', \'kamu\', \'anda\', \'kita\', \'mereka\', \'tolong\', \'jelaskan\', \'sebutkan\',\n  \'caranya\', \'jika\', \'kalau\', \'bila\', \'saat\', \'ketika\', \'agar\', \'supaya\', \'karena\',\n  \'the\', \'and\', \'for\', \'with\', \'that\', \'this\', \'from\', \'are\', \'was\', \'what\', \'how\'\n]);\n\nfunction tokenize(text: string): string[] {\n  return text\n    .toLowerCase()\n    .replace(/[^\\p{L}\\p{N}\\s]/gu, \' \')\n    .split(/\\s+/)\n    .filter((w) => w.length >= 2 && !STOPWORDS.has(w));\n}\n\nfunction createChunksFromText(\n  text: string,\n  sourceType: \'website\' | \'book\',\n  sourceName: string,\n  sectionTitle: string,\n  maxChunkChars = 1200,\n  overlapChars = 180\n): KnowledgeChunk[] {\n  const cleaned = text.replace(/\\r\\n/g, \'\\n\').replace(/[ \\t]+/g, \' \').replace(/\\n{3,}/g, \'\\n\\n\').trim();\n  if (!cleaned) return [];\n\n  const chunks: KnowledgeChunk[] = [];\n  let start = 0;\n  let part = 1;\n\n  while (start < cleaned.length) {\n    let end = Math.min(start + maxChunkChars, cleaned.length);\n    if (end < cleaned.length) {\n      const lastBreak = Math.max(\n        cleaned.lastIndexOf(\'\\n\\n\', end),\n        cleaned.lastIndexOf(\'. \', end),\n        cleaned.lastIndexOf(\'\\n\', end)\n      );\n      if (lastBreak > start + Math.floor(maxChunkChars * 0.45)) {\n        end = lastBreak + 1;\n      }\n    }\n\n    const slice = cleaned.slice(start, end).trim();\n    if (slice.length >= 20) {\n      const label = cleaned.length > maxChunkChars ? `${sectionTitle} (Bagian ${part})` : sectionTitle;\n      chunks.push({\n        id: `${sourceType}:${sourceName}:${part}:${start}`,\n        sourceType,\n        sourceName,\n        sectionTitle: label,\n        text: slice,\n        tokens: new Set(tokenize(`${sourceName} ${label} ${slice}`)),\n      });\n      part++;\n    }\n\n    if (end >= cleaned.length) break;\n    start = Math.max(end - overlapChars, start + 1);\n  }\n\n  return chunks;\n}\n\nfunction cleanTypeScriptDataForIndex(raw: string): string {\n  // Turn TypeScript data arrays into clean readable text for retrieval\n  return raw\n    .replace(/^import\\s+.*?;\\s*$/gm, \'\')\n    .replace(/export\\s+(const|interface|type)\\s+/g, \'\')\n    .replace(/[{}\\[\\]]/g, \' \')\n    .replace(/[\'\"`]/g, \'\')\n    .replace(/,\\s*$/gm, \'\')\n    .replace(/\\s+/g, \' \')\n    .trim();\n}\n\nfunction stripHtml(html: string): string {\n  return html\n    .replace(/<script[\\s\\S]*?<\\/script>/gi, \' \')\n    .replace(/<style[\\s\\S]*?<\\/style>/gi, \' \')\n    .replace(/<[^>]+>/g, \' \')\n    .replace(/&nbsp;/g, \' \')\n    .replace(/&amp;/g, \'&\')\n    .replace(/&lt;/g, \'<\')\n    .replace(/&gt;/g, \'>\')\n    .replace(/\\s+/g, \' \')\n    .trim();\n}\n\nasync function extractTextFromBuffer(fileName: string, buffer: Buffer): Promise<{ text: string; pages?: string[] }> {\n  const ext = path.extname(fileName).toLowerCase();\n  if (ext === \'.pdf\') {\n    const result = await extractText(new Uint8Array(buffer), { mergePages: false });\n    const pages = Array.isArray(result.text) ? result.text : [String(result.text ?? \'\')];\n    return { text: pages.join(\'\\n\\n\'), pages };\n  }\n  if (ext === \'.html\' || ext === \'.htm\') {\n    return { text: stripHtml(buffer.toString(\'utf8\')) };\n  }\n  if ([\'.txt\', \'.md\', \'.csv\', \'.json\', \'.tsv\'].includes(ext)) {\n    return { text: buffer.toString(\'utf8\') };\n  }\n  return { text: \'\' };\n}\n\nclass KnowledgeBaseManager {\n  private websiteChunks: KnowledgeChunk[] = [];\n  private bookChunks: KnowledgeChunk[] = [];\n  private booksMeta: BookSourceMeta[] = [];\n  private websiteModules: string[] = [];\n  private initialized = false;\n\n  async ensureInitialized(): Promise<void> {\n    if (!this.initialized) {\n      await this.reload();\n    }\n  }\n\n  async reload(): Promise<KnowledgeSummary> {\n    await fs.mkdir(KNOWLEDGE_DIR, { recursive: true });\n    await fs.mkdir(UPLOADS_DIR, { recursive: true });\n\n    await this.loadWebsiteContent();\n    await this.loadBookSources();\n    this.initialized = true;\n    return this.getSummary();\n  }\n\n  private async loadWebsiteContent(): Promise<void> {\n    const chunks: KnowledgeChunk[] = [];\n    const modules: string[] = [];\n\n    // 1. Overview & Thesis Spec\n    try {\n      const docMd = await fs.readFile(path.join(ROOT_DIR, \'DOKUMEN_PROTOTIPE_SKRIPSI.md\'), \'utf8\');\n      chunks.push(...createChunksFromText(docMd, \'website\', \'Website: Ruang Obat\', \'Dokumen & Spesifikasi Fitur\'));\n      modules.push(\'Beranda & Spesifikasi Prototipe\');\n    } catch {\n      // optional\n    }\n\n    // 2. Website data modules\n    const dataFiles: Array<{ file: string; label: string }> = [\n      { file: \'src/data/labelHotspots.ts\', label: \'Cek Label (6 Titik Kemasan Tablet, Sirup, Salep)\' },\n      { file: \'src/data/kamusData.ts\', label: \'Kamus Label Obat (Glosarium Resmi)\' },\n      { file: \'src/data/panduanSimpanBuang.ts\', label: \'Panduan Simpan & Buang (Prinsip DAGUSIBU)\' },\n      { file: \'src/data/latihanData.ts\', label: \'Modul Latihan (Skenario Swamedikasi, Flashcard, Kuis)\' },\n      { file: \'src/data/pustakaData.ts\', label: \'Pustaka Rujukan Farmasi (BPOM, Kemenkes, Farmakope)\' },\n      { file: \'src/data/initialMedicines.ts\', label: \'Lemari Obat Saya (Contoh Inventaris & Status)\' },\n    ];\n\n    for (const item of dataFiles) {\n      try {\n        const raw = await fs.readFile(path.join(ROOT_DIR, item.file), \'utf8\');\n        const cleaned = cleanTypeScriptDataForIndex(raw);\n        chunks.push(...createChunksFromText(cleaned, \'website\', `Website: ${item.label}`, item.label));\n        modules.push(item.label);\n      } catch {\n        // ignore missing file\n      }\n    }\n\n    // 3. Summary of website navigation & interactive tools\n    const navSummary = `\nNavigasi dan Fitur Utama Website Ruang Obat:\n1. Beranda: Menampilkan ringkasan status obat di rumah (grafik Donut/Batang Recharts: Aman >30 hari, Segera Kedaluwarsa <=30 hari, Kedaluwarsa <0 hari), peringatan obat mendekati kedaluwarsa, skenario hari ini, akses cepat Kamus & Flashcard, serta Panduan Pengguna Baru (Walkthrough).\n2. Cek Label: Simulasi interaktif 3 bentuk sediaan (Tablet strip/blister, Sirup botol cair 5 mL, Salep tube kulit) dengan 6 titik kritis ketuk: (1) Logo Golongan Obat (Hijau Bebas, Biru Bebas Terbatas P1-P6, Merah K Obat Keras), (2) Nama & Komposisi Zat Aktif, (3) Indikasi Medis, (4) Aturan Pakai & Peringatan, (5) Tanggal Kedaluwarsa (ED) & Nomor Bets / BUD, (6) Nomor Izin Edar (NIE BPOM 15 digit seperti DBL, DTL, DKL).\n3. Lemari Obat Saya: Manajemen stok obat pribadi tersimpan 100% lokal di perangkat (localStorage), dilengkapi fitur pencarian obat, filter status (Semua, Aman, Segera, Kedaluwarsa), tanggal kedaluwarsa, tanggal dibuka untuk pantauan Beyond Use Date (BUD), serta tautan ke Panduan Simpan & Buang.\n4. Latihan: Terdiri dari 3 modul aktif: (a) Skenario Swamedikasi Bercabang (4 kasus: sisa antibiotik/AMR, sendok makan dapur vs sendok takar 5 mL, salep steroid pada jamur, waktu minum antasida + Red Flags), (b) Flashcard Interaktif 3D Flip (12 kartu), (c) Kuis Evaluasi Pre-Test & Post-Test (10 soal dengan pembahasan ilmiah dan fitur salin rekap skor).\n5. Pustaka: Daftar rujukan resmi BPOM RI, Kemenkes RI (DAGUSIBU / GeMa CerMO), Farmakope Indonesia VI, WHO, dan USP.\nBatasan Etika Mutlak: Aplikasi ini murni edukasi umum, TIDAK menyediakan kalkulator dosis, TIDAK mendiagnosis penyakit, dan selalu menganjurkan konsultasi ke apoteker atau dokter untuk kondisi pribadi.\n`.trim();\n\n    chunks.push(...createChunksFromText(navSummary, \'website\', \'Website: Gambaran Umum Ruang Obat\', \'Panduan Fitur & Batasan Etika\'));\n\n    this.websiteChunks = chunks;\n    this.websiteModules = modules;\n  }\n\n  private async indexSingleFile(filePath: string, fileName: string, origin: \'folder\' | \'upload\'): Promise<void> {\n    const ext = path.extname(fileName).toLowerCase();\n    const stat = await fs.stat(filePath);\n    const buffer = await fs.readFile(filePath);\n\n    if (ext === \'.zip\') {\n      const zip = await JSZip.loadAsync(buffer);\n      const innerFiles: string[] = [];\n      let totalChars = 0;\n      const beforeCount = this.bookChunks.length;\n\n      const entries = Object.values(zip.files).filter(\n        (entry) => !entry.dir && !entry.name.startsWith(\'__MACOSX\') && !path.basename(entry.name).startsWith(\'.\')\n      );\n\n      for (const entry of entries) {\n        const innerExt = path.extname(entry.name).toLowerCase();\n        if (![\'.pdf\', \'.txt\', \'.md\', \'.csv\', \'.json\', \'.html\', \'.htm\'].includes(innerExt)) {\n          continue;\n        }\n        try {\n          const innerBuf = await entry.async(\'nodebuffer\');\n          const extracted = await extractTextFromBuffer(entry.name, innerBuf);\n          if (extracted.pages && extracted.pages.length > 0) {\n            innerFiles.push(entry.name);\n            extracted.pages.forEach((pageText, idx) => {\n              const cleanedPage = pageText.trim();\n              if (cleanedPage.length >= 20) {\n                totalChars += cleanedPage.length;\n                this.bookChunks.push(\n                  ...createChunksFromText(\n                    cleanedPage,\n                    \'book\',\n                    `${fileName} -> ${entry.name}`,\n                    `${path.basename(entry.name)} (Halaman ${idx + 1})`\n                  )\n                );\n              }\n            });\n          } else if (extracted.text.trim().length >= 20) {\n            innerFiles.push(entry.name);\n            totalChars += extracted.text.length;\n            this.bookChunks.push(\n              ...createChunksFromText(\n                extracted.text,\n                \'book\',\n                `${fileName} -> ${entry.name}`,\n                path.basename(entry.name)\n              )\n            );\n          }\n        } catch (err) {\n          console.warn(`Gagal membaca entry zip ${entry.name}:`, err);\n        }\n      }\n\n      this.booksMeta.push({\n        id: `${origin}:${fileName}`,\n        fileName,\n        origin,\n        fileType: \'zip\',\n        innerFiles,\n        chunkCount: this.bookChunks.length - beforeCount,\n        totalChars,\n        addedAt: stat.mtime.toISOString(),\n      });\n      return;\n    }\n\n    if ([\'.pdf\', \'.txt\', \'.md\', \'.csv\', \'.json\', \'.html\', \'.htm\'].includes(ext)) {\n      const beforeCount = this.bookChunks.length;\n      const extracted = await extractTextFromBuffer(fileName, buffer);\n      let totalChars = 0;\n\n      if (extracted.pages && extracted.pages.length > 0) {\n        extracted.pages.forEach((pageText, idx) => {\n          const cleanedPage = pageText.trim();\n          if (cleanedPage.length >= 20) {\n            totalChars += cleanedPage.length;\n            this.bookChunks.push(\n              ...createChunksFromText(\n                cleanedPage,\n                \'book\',\n                fileName,\n                `${fileName} (Halaman ${idx + 1})`\n              )\n            );\n          }\n        });\n      } else if (extracted.text.trim().length >= 20) {\n        totalChars += extracted.text.length;\n        this.bookChunks.push(\n          ...createChunksFromText(extracted.text, \'book\', fileName, fileName)\n        );\n      }\n\n      this.booksMeta.push({\n        id: `${origin}:${fileName}`,\n        fileName,\n        origin,\n        fileType: ext === \'.pdf\' ? \'pdf\' : \'text\',\n        innerFiles: [fileName],\n        chunkCount: this.bookChunks.length - beforeCount,\n        totalChars,\n        addedAt: stat.mtime.toISOString(),\n      });\n    }\n  }\n\n  private async loadBookSources(): Promise<void> {\n    this.bookChunks = [];\n    this.booksMeta = [];\n\n    // Scan root knowledge_books folder\n    try {\n      const entries = await fs.readdir(KNOWLEDGE_DIR, { withFileTypes: true });\n      for (const entry of entries) {\n        if (!entry.isFile()) continue;\n        if (entry.name.toLowerCase() === \'readme.txt\' || entry.name.startsWith(\'.\')) continue;\n        await this.indexSingleFile(path.join(KNOWLEDGE_DIR, entry.name), entry.name, \'folder\');\n      }\n    } catch (err) {\n      console.warn(\'Gagal memindai folder knowledge_books:\', err);\n    }\n\n    // Scan uploaded books folder\n    try {\n      const uploadEntries = await fs.readdir(UPLOADS_DIR, { withFileTypes: true });\n      for (const entry of uploadEntries) {\n        if (!entry.isFile() || entry.name.startsWith(\'.\')) continue;\n        await this.indexSingleFile(path.join(UPLOADS_DIR, entry.name), entry.name, \'upload\');\n      }\n    } catch (err) {\n      console.warn(\'Gagal memindai folder uploads:\', err);\n    }\n  }\n\n  async ingestUploadedFile(fileName: string, buffer: Buffer): Promise<KnowledgeSummary> {\n    await fs.mkdir(UPLOADS_DIR, { recursive: true });\n    const safeName = path.basename(fileName).replace(/[^a-zA-Z0-9._-]/g, \'_\');\n    const targetPath = path.join(UPLOADS_DIR, safeName);\n    await fs.writeFile(targetPath, buffer);\n    await this.reload();\n    return this.getSummary();\n  }\n\n  async deleteUploadedBook(fileName: string): Promise<KnowledgeSummary> {\n    const safeName = path.basename(fileName);\n    const targetPath = path.join(UPLOADS_DIR, safeName);\n    try {\n      await fs.unlink(targetPath);\n    } catch {\n      // ignore if missing\n    }\n    await this.reload();\n    return this.getSummary();\n  }\n\n  getSummary(): KnowledgeSummary {\n    return {\n      websiteChunks: this.websiteChunks.length,\n      websiteModules: this.websiteModules,\n      books: this.booksMeta,\n      totalBookChunks: this.bookChunks.length,\n    };\n  }\n\n  retrieveRelevantChunks(query: string, maxTotal = 8): KnowledgeChunk[] {\n    const queryTokens = tokenize(query);\n    const lowerQuery = query.toLowerCase().trim();\n\n    const scoreChunk = (chunk: KnowledgeChunk): number => {\n      if (queryTokens.length === 0) return chunk.sourceType === \'book\' ? 1 : 0.5;\n      let score = 0;\n      const lowerText = chunk.text.toLowerCase();\n      const lowerTitle = `${chunk.sourceName} ${chunk.sectionTitle}`.toLowerCase();\n\n      for (const token of queryTokens) {\n        if (chunk.tokens.has(token)) {\n          score += 2;\n          if (lowerTitle.includes(token)) score += 2.5;\n          // Frequency bonus (capped)\n          const matches = lowerText.split(token).length - 1;\n          score += Math.min(matches, 4) * 0.6;\n        } else {\n          // Substring match fallback for Indonesian affixed words (e.g. kedaluwarsa / kadaluarsa / obat)\n          if (token.length >= 4 && lowerText.includes(token)) {\n            score += 1.2;\n          }\n        }\n      }\n\n      if (lowerQuery.length >= 5 && lowerText.includes(lowerQuery)) {\n        score += 5;\n      }\n\n      return score;\n    };\n\n    const scoredBooks = this.bookChunks\n      .map((chunk) => ({ chunk, score: scoreChunk(chunk) }))\n      .sort((a, b) => b.score - a.score);\n\n    const scoredWeb = this.websiteChunks\n      .map((chunk) => ({ chunk, score: scoreChunk(chunk) }))\n      .sort((a, b) => b.score - a.score);\n\n    const selected: KnowledgeChunk[] = [];\n    const seenIds = new Set<string>();\n\n    const addChunk = (c: KnowledgeChunk) => {\n      if (!seenIds.has(c.id)) {\n        seenIds.add(c.id);\n        selected.push(c);\n      }\n    };\n\n    // Prioritize top matching book chunks when books exist, balanced with website chunks\n    const bookQuota = this.bookChunks.length > 0 ? Math.min(4, maxTotal) : 0;\n    for (const item of scoredBooks.slice(0, bookQuota)) {\n      if (item.score > 0 || selected.length < 2) {\n        addChunk(item.chunk);\n      }\n    }\n\n    for (const item of scoredWeb) {\n      if (selected.length >= maxTotal) break;\n      if (item.score > 0 || selected.length < 4) {\n        addChunk(item.chunk);\n      }\n    }\n\n    // Fill remaining slots from top books if still available\n    for (const item of scoredBooks) {\n      if (selected.length >= maxTotal) break;\n      addChunk(item.chunk);\n    }\n\n    return selected;\n  }\n}\n\nexport const knowledgeBase = new KnowledgeBaseManager();\n"
    num_lines: 462
    num_bytes: 16798
    line_range_bytes: 16798
  }
}
