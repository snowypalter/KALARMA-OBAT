      thinking_signature: "\022\360\a\n\355\a\001i\024}\023-\303\345+8\231\333\264o\270\354\327\206\242+p<_\"\322fFl\301\3165\264\357\247\000v\"\223\357\366\301\240I\364s\337\370\002\255\355\006i\303\310=\237\000\226\271\311\264\213\224u\002\245\305\373\316\270\300\303\b#\332\311{\330\315<\356\266\202\337?\363*faV\327e\231J\023\275\215;\251\037{\347\000D\222S\350\233\300\003\335\3512\237n1\352\310L4y\246Q/\200B\346&\311\262\206\000\212\031\000n\363V\263\356\327W\235\000\017b\352\312\330\262\355l\3202\315\317G\376\314hx\337W\352F\352<\000\372y\334\t\334N\ng]@y\216\254\017\320\340\"\230\002v\023(S\027\230\201\245\326\a\322\324\302\2504\035z\220F\200\200Gq\274\016\3054\340\325\226d\3347\035)\372\212\375\032TB*\224m\234\036n8\357z\223\365\307\335\310\316\310$cP\\k\324\377?\333\031\314\345\260\357\277\263\272\230\021\225-c[8\356\203\241\274Ns\331\364\343\342\304K)n\325wE\030D+\347\247\267\266\334H6\003/\347\260\300S\241\b\271\331.n\033\204\"\244\236<\366\247\254\241rM\265\016\311g\220\345\006\002\206\302\353D\023\247\204C\036\315\302\024\277\337f\\\367\002\374\227\320\017\303\325a\017\227\237\363\227n\277KJD\035\364\017C]0\361\022L\031\2207\324\024F\200m\371\312\364\343\360\037w\2755E\v\272\257\003*\304-\303\2127=B\000\r\302#\260\030\003\346\177-\357\3274\203\033\004\363\251\322\274D\371\251r\215[\033d\255\237\210\241\227\372\273i\252\037\221|\177\263\324\244/_\321\355\350\200\242~!\334d\037\004\262Iy\325N\230\302\022\220K\370h\367\030\351!\275d\ra\224\235F\306\345\361\f\204\v\334Q4b\251b\b\265\243cZ\3400^@\3359\0175\270 T\322D\027\025\017\261D\227\230\307\310\3526\t\246\337jF:.\372\233\360g\311k\023>\223\326\262Rdyj\034\021k\n\326\324\375\355\334\3458\317J\023\224\253\0271\r\306\217I\212\314\246d$\030\324\221\026\355\tr\025\337y\372\177\314\230\325m}<6\030@\310q(g\250[\230\024~\350\376\351\207\221\326\350\204\361\332\250\332s\232\362\200\204\314\003\273\0249\307\341\034\004\304\302ZS\205\2372\204\266\246\016]i\313\356\027\223e\376\252\311\004]\367d\034\a\317\264\307\254