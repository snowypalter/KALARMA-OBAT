      arguments_json: "{\"CodeContent\":\"import \'dotenv/config\';\\nimport express from \'express\';\\nimport path from \'node:path\';\\nimport { GoogleGenAI, ThinkingLevel, type Content, type GenerateContentResponse } from \'@google/genai\';\\nimport { knowledgeBase } from \'./server/knowledgeBase.ts\';\\n\\nconst PORT = Number(process.env.PORT) || 3000;\\nconst IS_PROD = process.env.NODE_ENV === \'production\';\\n\\nfunction getGeminiClient(): GoogleGenAI {\\n  const apiKey = process.env.GEMINI_API_KEY;\\n  if (!apiKey) {\\n    throw new Error(\'GEMINI_API_KEY_MISSING\');\\n  }\\n  return new GoogleGenAI({\\n    apiKey,\\n    httpOptions: {\\n      headers: {\\n        \'User-Agent\': \'aistudio-build\',\\n      },\\n    },\\n  });\\n}\\n\\ninterface IncomingMessage {\\n  role: \'user\' | \'model\';\\n  text: string;\\n}\\n\\nfunction buildSanitizedHistory(messages: IncomingMessage[]): Content[] {\\n  const cleaned: Content[] = [];\\n  for (const msg of messages) {\\n    const text = (msg.text || \'\').trim();\\n    if (!text) continue;\\n    if (cleaned.length === 0 && msg.role !== \'user\') continue;\\n\\n    const lastRole = cleaned.length > 0 ? cleaned[cleaned.length - 1].role : null;\\n    if (lastRole === msg.role) {\\n      const prevParts = cleaned[cleaned.length - 1].parts ?? [];\\n      const prevText = prevParts[0]?.text ?? \'\';\\n      cleaned[cleaned.length - 1] = {\\n        role: msg.role,\\n        parts: [{ text: `${prevText}\\\\n\\\\n${text}` }],\\n      };\\n    } else {\\n      cleaned.push({\\n        role: msg.role,\\n        parts: [{ text }],\\n      });\\n    }\\n  }\\n\\n  if (cleaned.length > 0 && cleaned[cleaned.length - 1].role === \'user\') {\\n    cleaned.pop();\\n  }\\n  return cleaned;\\n}\\n\\nfunction formatGeminiError(err: unknown): { status: number; message: string } {\\n  const raw = err instanceof Error ? err.message : String(err);\\n  if (raw.includes(\'GEMINI_API_KEY_MISSING\')) {\\n    return {\\n      status: 500,\\n      message: \'API key Gemini belum dikonfigurasi pada server. Silakan periksa panel Settings > Secrets.\',\\n    };\\n  }\\n  if (raw.includes(\'PERMISSION_DENIED\') || raw.includes(\'API_KEY_INVALID\') || raw.includes(\'403\') || raw.includes(\'400\')) {\\n    return {\\n      status: 400,\\n      message: \'Kunci API Gemini tidak valid atau izin ditolak. Periksa API key pada panel Settings > Secrets.\',\\n    };\\n  }\\n  if (raw.includes(\'RESOURCE_EXHAUSTED\') || raw.includes(\'429\')) {\\n    return {\\n      status: 429,\\n      message: \'Batas kuota permintaan Gemini sementara tercapai. Silakan coba beberapa saat lagi.\',\\n    };\\n  }\\n  if (raw.includes(\'NOT_FOUND\') || raw.includes(\'404\')) {\\n    return {\\n      status: 404,\\n      message: \'Model Gemini yang diminta tidak ditemukan atau tidak didukung.\',\\n    };\\n  }\\n  return {\\n    status: 500,\\n    message: `Terjadi kendala saat memproses jawaban AI: ${raw}`,\\n  };\\n}\\n\\nasync function startServer() {\\n  const app = express();\\n\\n  app.use(express.json({ limit: \'50mb\' }));\\n\\n  await knowledgeBase.ensureInitialized();\\n\\n  app.get(\'/api/health\', (_req, res) => {\\n    res.json({ ok: true, summary: knowledgeBase.getSummary() });\\n  });\\n\\n  app.get(\'/api/knowledge\', async (_req, res) => {\\n    try {\\n      await knowledgeBase.ensureInitialized();\\n      res.json(knowledgeBase.getSummary());\\n    } catch (err) {\\n      res.status(500).json({\\n        error: err instanceof Error ? err.message : \'Gagal memuat ringkasan sumber pengetahuan.\',\\n      });\\n    }\\n  });\\n\\n  app.post(\'/api/knowledge/reload\', async (_req, res) => {\\n    try {\\n      const summary = await knowledgeBase.reload();\\n      res.json(summary);\\n    } catch (err) {\\n      res.status(500).json({\\n        error: err instanceof Error ? err.message : \'Gagal memuat ulang folder sumber buku.\',\\n      });\\n    }\\n  });\\n\\n  app.post(\'/api/knowledge/upload\', async (req, res) => {\\n    try {\\n      const { fileName, base64Data } = req.body as { fileName?: string; base64Data?: string };\\n      if (!fileName || !base64Data) {\\n        res.status(400).json({ error: \'fileName dan base64Data wajib disertakan.\' });\\n        return;\\n      }\\n\\n      const ext = path.extname(fileName).toLowerCase();\\n      if (![\'.zip\', \'.pdf\', \'.txt\', \'.md\', \'.csv\', \'.json\', \'.html\', \'.htm\'].includes(ext)) {\\n        res.status(400).json({\\n          error: \'Format file tidak didukung. Gunakan file .zip, .pdf, .txt, atau .md.\',\\n        });\\n        return;\\n      }\\n\\n      const buffer = Buffer.from(base64Data, \'base64\');\\n      if (buffer.length === 0) {\\n        res.status(400).json({ error: \'File kosong atau rusak.\' });\\n        return;\\n      }\\n\\n      const summary = await knowledgeBase.ingestUploadedFile(fileName, buffer);\\n      res.json(summary);\\n    } catch (err) {\\n      res.status(500).json({\\n        error: err instanceof Error ? err.message : \'Gagal memproses file sumber buku.\',\\n      });\\n    }\\n  });\\n\\n  app.delete(\'/api/knowledge/:fileName\', async (req, res) => {\\n    try {\\n      const summary = await knowledgeBase.deleteUploadedBook(req.params.fileName);\\n      res.json(summary);\\n    } catch (err) {\\n      res.status(500).json({\\n        error: err instanceof Error ? err.message : \'Gagal menghapus file buku.\',\\n      });\\n    }\\n  });\\n\\n  app.post(\'/api/chat\', async (req, res) => {\\n    try {\\n      await knowledgeBase.ensureInitialized();\\n\\n      const {\\n        messages = [],\\n        activeTab = \'beranda\',\\n        speedMode = \'standar\',\\n      } = req.body as {\\n        messages?: IncomingMessage[];\\n        activeTab?: string;\\n        speedMode?: \'standar\' | \'cepat\';\\n      };\\n\\n      const latestUserMessage = [...messages].reverse().find((m) => m.role === \'user\')?.text?.trim();\\n      if (!latestUserMessage) {\\n        res.status(400).json({ error: \'Pesan pertanyaan tidak boleh kosong.\' });\\n        return;\\n      }\\n\\n      const ai = getGeminiClient();\\n      const summary = knowledgeBase.getSummary();\\n      const retrievedChunks = knowledgeBase.retrieveRelevantChunks(latestUserMessage, 10);\\n\\n      const booksOverview =\\n        summary.books.length > 0\\n          ? summary.books\\n              .map(\\n                (b, i) =>\\n                  `${i + 1}. [${b.bookName}] (${b.fileName}) \342\200\224 Bab: ${b.chapters.join(\'; \')}`\\n              )\\n              .join(\'\\\\n\')\\n          : \'- Belum ada file buku yang dimuat di knowledge_books.\';\\n\\n      const contextBlock = retrievedChunks\\n        .map(\\n          (chunk, idx) =>\\n            `[Kutipan ${idx + 1} | Jenis: ${\\n              chunk.sourceType === \'book\' ? \'BUKU REFERENSI UTAMA\' : \'Isi Website Ruang Obat\'\\n            } | Nama Buku: ${chunk.bookName || chunk.sourceName} | Bab Buku: ${\\n              chunk.chapterTitle || chunk.sectionTitle\\n            } | Berkas: ${chunk.fileName || chunk.sourceName}]\\\\n${chunk.text}`\\n        )\\n        .join(\'\\\\n\\\\n---\\\\n\\\\n\');\\n\\n      const systemInstruction = `Kamu adalah \\\"Asisten Ruang Obat\\\", chatbot edukasi farmasi klinis dan komunitas untuk website \\\"Ruang Obat\\\" (\\\"Kenali label obatmu, kelola obat di rumahmu\\\").\\n\\nATURAN PENGUNCIAN SUMBER & SITASI KETAT (PRIORITAS TERTINGGI \342\200\224 WAJIB DIPATUHI):\\n1. PRIORITAS MUTLAK BUKU REFERENSI: Kamu TERKUNCI untuk mengutamakan dan mengutip materi secara ketat dari ${summary.books.length} berkas buku referensi resmi di folder \\\\`knowledge_books\\\\` (terutama *Buku Ajar Farmakologi (HKI, 2022)* \342\200\224 11 bab dan *Farmakologi dan Terapi Edisi 4 (FKUI)* \342\200\224 24 berkas / 56 bab) yang diberikan pada blok \\\"KONTEKS SUMBER\\\" di bawah.\\n2. Konteks website Ruang Obat hanya digunakan sebagai pelengkap bila pengguna bertanya tentang cara menggunakan fitur/menu website (Beranda, Cek Label, Lemari Obat, Latihan, Pustaka).\\n3. DILARANG KERAS MENGARANG / HALUSINASI: Jangan pernah mengarang fakta farmakologi, angka regulasi, atau mengutip buku/pedoman luar yang tidak ada di dalam \\\"KONTEKS SUMBER\\\".\\n4. WAJIB MENAMPILKAN NAMA BUKU & BAB BUKU DI SETIAP JAWABAN:\\n   - Sebutkan secara jelas nama buku dan bab saat menjelaskan materi di dalam paragraf/poin jawaban (contoh: *\\\"Menurut **Buku Ajar Farmakologi (HKI, 2022)** pada **Bab VII: Penggolongan Jenis Obat**...\\\"* atau *\\\"Berdasarkan **Farmakologi dan Terapi Edisi 4 (FKUI)** pada **Bab 39: Pengantar Antimikroba**...\\\"*).\\n   - Akhiri **SETIAP** jawaban dengan bagian khusus berformat persis seperti ini:\\n     **Sumber Buku & Bab yang Dikutip:**\\n     - **[Nama Buku Persis dari Konteks]** \342\200\224 [Nama Bab Buku Persis dari Konteks]\\n5. KEJUJURAN JIKA TIDAK ADA DI SUMBER: Jika topik pertanyaan sama sekali tidak ditemukan pada kutipan dari ${summary.books.length} berkas buku di ` + \'`knowledge_books`\' + `, nyatakan secara jujur bahwa informasi tersebut belum tercakup pada kutipan buku referensi yang sedang dimuat, sebutkan bab terdekat yang tersedia jika relevan, dan sarankan berkonsultasi dengan apoteker atau dokter.\\n\\nATURAN ETIKA & KESELAMATAN PASIEN (WAJIB DIPATUHI):\\n- Edukasi umum saja: DILARANG memberikan diagnosis penyakit pribadi, resep obat, atau menghitung/menyarankan dosis obat personal untuk pasien tertentu.\\n- Jika pengguna menanyakan keluhan penyakit berat, gejala tanda bahaya (red flags), atau dosis personal anak/dewasa, ingatkan dengan sopan untuk segera berkonsultasi langsung dengan apoteker atau dokter.\\n\\nGAYA KOMUNIKASI:\\n- Bahasa Indonesia yang ramah, jelas, terstruktur dengan poin-poin singkat agar nyaman dibaca di layar ponsel maupun desktop.\\n- Pengguna saat ini membuka tab: \\\"${activeTab}\\\".\\n\\nDAFTAR LENGKAP ${summary.books.length} BERKAS BUKU REFERENSI DI \\\\`knowledge_books/\\\\`:\\n${booksOverview}`;\\n\\n      const priorMessages = messages.slice(0, -1);\\n      const history = buildSanitizedHistory(priorMessages);\\n\\n      const model = speedMode === \'cepat\' ? \'gemini-3.1-flash-lite\' : \'gemini-4-hydrogen\';\\n      const thinkingConfig =\\n        model === \'gemini-4-hydrogen\'\\n          ? { thinkingLevel: ThinkingLevel.MEDIUM }\\n          : { thinkingLevel: ThinkingLevel.MINIMAL };\\n\\n      const chat = ai.chats.create({\\n        model,\\n        history,\\n        config: {\\n          systemInstruction,\\n          thinkingConfig,\\n        },\\n      });\\n\\n      const enrichedPrompt = `KONTEKS SUMBER (PRIORITAS UTAMA: 35 BERKAS BUKU KNOWLEDGE_BOOKS):\\n${contextBlock || \'Belum ada potongan konteks yang cocok.\'}\\n\\nPERTANYAAN PENGGUNA:\\n${latestUserMessage}\\n\\nINSTRUKSI AKHIR: Jawab dengan mengutip ketat isi buku pada KONTEKS SUMBER di atas dan WAJIB menutup jawaban dengan bagian \\\"**Sumber Buku & Bab yang Dikutip:**\\\" berisi Nama Buku dan Bab Buku yang digunakan.`;\\n\\n      res.setHeader(\'Content-Type\', \'text/event-stream; charset=utf-8\');\\n      res.setHeader(\'Cache-Control\', \'no-cache, no-transform\');\\n      res.setHeader(\'Connection\', \'keep-alive\');\\n\\n      // Prioritize book sources in returned citation badges, deduplicated by bookName + chapterTitle\\n      const sortedForCitations = [...retrievedChunks].sort((a, b) => {\\n        if (a.sourceType === b.sourceType) return 0;\\n        return a.sourceType === \'book\' ? -1 : 1;\\n      });\\n\\n      const sources = Array.from(\\n        new Map(\\n          sortedForCitations.map((c) => {\\n            const book = c.bookName || c.sourceName;\\n            const chapter = c.chapterTitle || c.sectionTitle.replace(/\\\\s*\\\\(Bagian \\\\d+\\\\)$/i, \'\');\\n            return [\\n              `${book}::${chapter}`,\\n              {\\n                sourceType: c.sourceType,\\n                sourceName: book,\\n                sectionTitle: chapter,\\n                bookName: book,\\n                chapterTitle: chapter,\\n              },\\n            ];\\n          })\\n        ).values()\\n      ).slice(0, 6);\\n\\n      const stream = await chat.sendMessageStream({ message: enrichedPrompt });\\n\\n      for await (const chunk of stream) {\\n        const c = chunk as GenerateContentResponse;\\n        const delta = c.text;\\n        if (delta) {\\n          res.write(`data: ${JSON.stringify({ type: \'chunk\', text: delta })}\\\\n\\\\n`);\\n        }\\n      }\\n\\n      res.write(`data: ${JSON.stringify({ type: \'done\', sources, model })}\\\\n\\\\n`);\\n      res.end();\\n    } catch (err) {\\n      const formatted = formatGeminiError(err);\\n      if (!res.headersSent) {\\n        res.status(formatted.status).json({ error: formatted.message });\\n      } else {\\n        res.write(`data: ${JSON.stringify({ type: \'error\', error: formatted.message })}\\\\n\\\\n`);\\n        res.end();\\n      }\\n    }\\n  });\\n\\n  if (!IS_PROD) {\\n    const { createServer: createViteServer } = await import(\'vite\');\\n    const vite = await createViteServer({\\n      server: { middlewareMode: true },\\n      appType: \'spa\',\\n    });\\n    app.use(vite.middlewares);\\n  } else {\\n    const distDir = path.join(process.cwd(), \'dist\');\\n    app.use(express.static(distDir));\\n    app.get(\'*\', (_req, res) => {\\n      res.sendFile(path.join(distDir, \'index.html\'));\\n    });\\n  }\\n\\n  app.listen(PORT, \'0.0.0.0\', () => {\\n    console.log(`Ruang Obat server running at http://0.0.0.0:${PORT}`);\\n  });\\n}\\n\\nstartServer().catch((err) => {\\n  console.error(\'Failed to start Ruang Obat server:\', err);\\n  process.exit(1);\\n});\\n\", \"Description\":\"Lock server.ts AI Chat system instruction to strictly prioritize and cite the 35 book files in knowledge_books with mandatory Book Name and Chapter Title in every response\", \"Overwrite\":true, \"TargetFile\":\"/server.ts\", \"toolAction\":\"Updating server.ts AI system instructions\", \"toolSummary\":\"Update server.ts\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_13129140237530845388"
      name: "multi_replace_file_content"
      arguments_json: "{\"Description\":\"Update ChatbotWidget.tsx to reflect the 35 locked knowledge_books files and display full Book Name and Chapter Title citations under every AI answer\", \"Instruction\":\"Update ChatSourceRef interface, initial message, starter questions, header copy, citation badge rendering, and knowledge source panel in ChatbotWidget.tsx.\", \"ReplacementChunks\":[{\"AllowMultiple\":false, \"EndLine\":56, \"ReplacementContent\":\"interface ChatSourceRef {\\n  sourceType: \'website\' | \'book\';\\n  sourceName: string;\\n  sectionTitle: string;\\n  bookName?: string;\\n  chapterTitle?: string;\\n}\\n\\ninterface ChatMessage {\\n  id: string;\\n  role: \'user\' | \'model\';\\n  text: string;\\n  sources?: ChatSourceRef[];\\n  modelUsed?: string;\\n  isError?: boolean;\\n}\\n\\ninterface BookSourceMeta {\\n  id: string;\\n  fileName: string;\\n  bookName?: string;\\n  chapters?: string[];\\n  origin: \'folder\' | \'upload\';\\n  fileType: \'zip\' | \'pdf\' | \'text\';\\n  innerFiles: string[];\\n  chunkCount: number;\\n  totalChars: number;\\n  addedAt: string;\\n}\\n\\ninterface KnowledgeSummary {\\n  websiteChunks: number;\\n  websiteModules: string[];\\n  books: BookSourceMeta[];\\n  totalBookChunks: number;\\n}\", \"StartLine\":24, \"TargetContent\":\"interface ChatSourceRef {\\n  sourceType: \'website\' | \'book\';\\n  sourceName: string;\\n  sectionTitle: string;\\n}\\n\\ninterface ChatMessage {\\n  id: string;\\n  role: \'user\' | \'model\';\\n  text: string;\\n  sources?: ChatSourceRef[];\\n  modelUsed?: string;\\n  isError?: boolean;\\n}\\n\\ninterface BookSourceMeta {\\n  id: string;\\n  fileName: string;\\n  origin: \'folder\' | \'upload\';\\n  fileType: \'zip\' | \'pdf\' | \'text\';\\n  innerFiles: string[];\\n  chunkCount: number;\\n  totalChars: number;\\n  addedAt: string;\\n}\\n\\ninterface KnowledgeSummary {\\n  websiteChunks: number;\\n  websiteModules: string[];\\n  books: BookSourceMeta[];\\n  totalBookChunks: number;\\n}\"}, {\"AllowMultiple\":false, \"EndLine\":97, \"ReplacementContent\":\"const INITIAL_BOT_MESSAGE: ChatMessage = {\\n  id: \'welcome-1\',\\n  role: \'model\',\\n  text: \'Halo! Saya **Asisten Ruang Obat**. Jawaban saya terkunci memprioritaskan dan mengutip langsung dari **35 berkas buku referensi** (*Buku Ajar Farmakologi HKI 2022* \342\200\224 11 bab & *Farmakologi dan Terapi Edisi 4 FKUI* \342\200\224 24 berkas / 56 bab) di folder pustaka, disertai pencantuman nama dan bab buku di setiap jawaban.\\\\n\\\\nSilakan pilih pertanyaan cepat di bawah atau ketik pertanyaanmu!\',\\n};\\n\\nconst TAB_STARTER_QUESTIONS: Record<TabType, string[]> = {\\n  beranda: [\\n    \'Jelaskan penggolongan obat Bebas, Bebas Terbatas, dan Obat Keras menurut HKI 2022.\',\\n    \'Apa perbedaan Expired Date (ED) dan Beyond Use Date (BUD)?\',\\n    \'Apa saja prinsip 7 Benar pemberian obat menurut buku ajar farmakologi?\',\\n  ],\\n  \'cek-label\': [\\n    \'Bagaimana penggolongan bentuk sediaan padat, cair (suspensi/emulsi), dan semipadat (salep/krim)?\',\\n    \'Kenapa sediaan suspensi wajib dikocok perlahan dan diukur pada dasar meniskus?\',\\n    \'Apa risiko duplikasi dosis dan interaksi obat menurut Farmakologi & Terapi FKUI?\',\\n  ],\\n  lemari: [\\n    \'Bagaimana cara membuang tablet dan sirup kedaluwarsa sesuai prinsip DAGUSIBU?\',\\n    \'Mengapa obat kedaluwarsa seperti tetrasiklin berbahaya menurut Dasar Toksikologi FKUI?\',\\n    \'Bagaimana aturan suhu simpan sediaan cair, salep, dan tetes mata agar mutu tetap stabil?\',\\n  ],\\n  latihan: [\\n    \'Mengapa penggunaan antibiotik yang tidak tepat memicu resistensi mikroba menurut Bab 39 FKUI?\',\\n    \'Kenapa sendok makan dapur tidak boleh dipakai untuk takaran sirup obat?\',\\n    \'Bagaimana mekanisme kerja antasida dan risiko penggunaan kortikosteroid topikal pada jamur?\',\\n  ],\\n  pustaka: [\\n    \'Cakupan materi apa saja yang dibahas dalam Buku Ajar Farmakologi HKI 2022?\',\\n    \'Apa perbedaan Farmakokinetik dan Farmakodinamik pada Bab 1 Farmakologi & Terapi Ed. 4?\',\\n    \'Jelaskan tanda peringatan P.No 1 sampai P.No 6 pada Obat Bebas Terbatas Daftar W.\',\\n  ],\\n};\", \"StartLine\":64, \"TargetContent\":\"const INITIAL_BOT_MESSAGE: ChatMessage = {\\n  id: \'welcome-1\',\\n  role: \'model\',\\n  text: \'Halo! Saya **Asisten Ruang Obat**. Kamu bisa bertanya seputar seluruh materi di website ini (6 titik label kemasan, Lemari Obat, DAGUSIBU, Kamus, Skenario, Kuis) maupun isi dari **buku referensi (.zip)** yang sudah ditambahkan.\\\\n\\\\nSilakan pilih pertanyaan cepat di bawah atau ketik pertanyaanmu!\',\\n};\\n\\nconst TAB_STARTER_QUESTIONS: Record<TabType, string[]> = {\\n  beranda: [\\n    \'Apa saja fitur utama di website Ruang Obat?\',\\n    \'Apa perbedaan Expired Date (ED) dan Beyond Use Date (BUD)?\',\\n    \'Jelaskan arti lingkaran hijau, biru, dan merah K pada kemasan obat.\',\\n  ],\\n  \'cek-label\': [\\n    \'Apa saja 6 titik informasi penting pada label kemasan obat?\',\\n    \'Bagaimana cara membaca kode 15 digit NIE BPOM (DBL, DTL, DKL)?\',\\n    \'Kenapa sirup tertentu wajib dikocok dahulu sebelum diminum?\',\\n  ],\\n  lemari: [\\n    \'Bagaimana cara membuang tablet dan sirup kedaluwarsa sesuai prinsip DAGUSIBU?\',\\n    \'Di mana tempat yang salah untuk menyimpan obat di rumah?\',\\n    \'Berapa lama batas aman (BUD) tetes mata dan sirup kering setelah dibuka?\',\\n  ],\\n  latihan: [\\n    \'Mengapa meminum sisa antibiotik teman sangat berbahaya?\',\\n    \'Kenapa sendok makan dapur tidak boleh dipakai untuk takaran sirup obat?\',\\n    \'Kapan waktu terbaik minum tablet kunyah antasida?\',\\n  ],\\n  pustaka: [\\n    \'Sumber resmi apa saja yang menjadi rujukan aplikasi Ruang Obat?\',\\n    \'Apa isi buku referensi .zip yang sedang dimuat saat ini?\',\\n    \'Jelaskan arti tanda peringatan P.No 1 sampai P.No 6.\',\\n  ],\\n};\"}, {\"AllowMultiple\":false, \"EndLine\":525, \"ReplacementContent\":\"            <span className=\\\"text-[10px] text-secondary/85 block leading-tight\\\">\\n              35 Berkas Buku Farmakologi\\n            </span>\\n          </div>\\n        </button>\\n      )}\\n\\n      {/* Chatbot Slide-over Panel */}\\n      {isOpen && (\\n        <div\\n          className=\\\"no-print fixed inset-0 z-50 flex items-end sm:items-center justify-end p-0 sm:p-4 bg-forest/55 backdrop-blur-xs\\\"\\n          role=\\\"dialog\\\"\\n          aria-modal=\\\"true\\\"\\n          aria-labelledby=\\\"chatbot-title\\\"\\n        >\\n          <div className=\\\"bg-surface w-full sm:max-w-lg h-[90vh] sm:h-[670px] sm:max-h-[90vh] rounded-t-3xl sm:rounded-3xl shadow-2xl border border-line flex flex-col overflow-hidden ro-sheet-in\\\">\\n            {/* Top Header */}\\n            <div className=\\\"bg-forest text-white px-5 py-4 flex items-center justify-between gap-2 shrink-0\\\">\\n              <div className=\\\"flex items-center gap-3 min-w-0\\\">\\n                <div className=\\\"w-9 h-9 rounded-xl bg-white/10 border border-white/15 flex items-center justify-center shrink-0\\\">\\n                  <Bot className=\\\"w-5 h-5 text-sand\\\" />\\n                </div>\\n                <div className=\\\"min-w-0\\\">\\n                  <h2\\n                    id=\\\"chatbot-title\\\"\\n                    className=\\\"font-display text-base font-semibold text-white truncate\\\"\\n                  >\\n                    Asisten Ruang Obat\\n                  </h2>\\n                  <p className=\\\"text-[11px] text-secondary/85 truncate\\\">\\n                    {bookCount > 0\\n                      ? `Terkunci: ${bookCount} Berkas Buku (HKI 2022 & FKUI Ed. 4)`\\n                      : \'Memuat sumber buku referensi...\'}\\n                  </p>\\n                </div>\\n              </div>\", \"StartLine\":491, \"TargetContent\":\"            <span className=\\\"text-[10px] text-secondary/85 block leading-tight\\\">\\n              Materi Web &amp; Buku (.zip)\\n            </span>\\n