            }
            lines {
              text: "    definition: \'Kondisi klinis, riwayat penyakit, atau status pasien tertentu (misalnya alergi zat aktif, tukak lambung aktif, kehamilan, atau gagal ginjal berat) di mana obat sama sekali tidak boleh diberikan karena risiko bahaya serius atau fatal.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
