  view_file {
    absolute_path_uri: "file:///src/components/Header.tsx"
    end_line: 143
    content: "import React, { useState } from \'react\';\nimport { TabType } from \'../types\';\nimport { SHOW_REVIEWER_TOOLS } from \'../config/appConfig\';\nimport { Pill, FileText, Share2, Check } from \'lucide-react\';\n\ninterface HeaderProps {\n  currentTab: TabType;\n  onNavigate: (tab: TabType) => void;\n  onOpenTinjau: () => void;\n}\n\nexport const Header: React.FC<HeaderProps> = ({\n  currentTab,\n  onNavigate,\n  onOpenTinjau,\n}) => {\n  const [copiedPublicLink, setCopiedPublicLink] = useState(false);\n\n  const navItems: { id: TabType; label: string }[] = [\n    { id: \'beranda\', label: \'Beranda\' },\n    { id: \'cek-label\', label: \'Cek Label\' },\n    { id: \'lemari\', label: \'Lemari Obat\' },\n    { id: \'latihan\', label: \'Latihan\' },\n    { id: \'pustaka\', label: \'Pustaka\' },\n  ];\n\n  const handlePublicShare = async () => {\n    const shareUrl =\n      typeof window !== \'undefined\'\n        ? window.location.href\n        : \'https://ais-pre-i6cmepgnonm4mfj7yg2xyk-74888050060.asia-east1.run.app\';\n    const shareData = {\n      title: \'Ruang Obat \342\200\223 Kenali Label Obatmu, Kelola Obat di Rumahmu\',\n      text: \'Media edukasi informasi label obat dan pengelolaan obat rumah tangga.\',\n      url: shareUrl,\n    };\n\n    try {\n      if (typeof navigator !== \'undefined\' && navigator.share) {\n        await navigator.share(shareData);\n        return;\n      }\n    } catch {\n      // Fallback ke salin tautan jika share dibatalkan atau tidak didukung\n    }\n\n    try {\n      await navigator.clipboard.writeText(shareUrl);\n      setCopiedPublicLink(true);\n      setTimeout(() => setCopiedPublicLink(false), 2500);\n    } catch {\n      // ignore clipboard errors\n    }\n  };\n\n  return (\n    <header className=\"sticky top-0 z-30 bg-bg/92 backdrop-blur-md border-b border-line\">\n      <div className=\"max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 md:h-[68px] flex items-center justify-between gap-4 sm:gap-8\">\n        {/* Zone 1: Single-element Wordmark */}\n        <button\n          type=\"button\"\n          onClick={() => onNavigate(\'beranda\')}\n          className=\"min-h-[44px] flex items-center gap-2.5 text-left cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-focus rounded-xl py-1 shrink-0 group\"\n          aria-label=\"Kembali ke Beranda Ruang Obat\"\n        >\n          <span className=\"w-8 h-8 rounded-xl bg-forest text-on-brand flex items-center justify-center transition-transform duration-200 group-hover:scale-105\">\n            <Pill className=\"w-4 h-4 -rotate-45\" />\n          </span>\n          <span className=\"font-display text-lg sm:text-xl font-semibold text-forest tracking-tight whitespace-nowrap\">\n            Ruang Obat\n          </span>\n        </button>\n\n        {/* Zone 2: Desktop Single-Line Navigation Links */}\n        <nav className=\"hidden md:flex items-center gap-7 text-sm\" aria-label=\"Navigasi Desktop\">\n          {navItems.map((item) => {\n            const isActive = currentTab === item.id;\n            return (\n              <button\n                key={item.id}\n                type=\"button\"\n                onClick={() => onNavigate(item.id)}\n                className={`relative min-h-[44px] whitespace-nowrap shrink-0 py-2 transition-colors cursor-pointer ${\n                  isActive\n                    ? \'text-forest font-semibold\'\n                    : \'text-ink-muted hover:text-forest font-medium\'\n                }`}\n                aria-current={isActive ? \'page\' : undefined}\n              >\n                <span>{item.label}</span>\n                {isActive && (\n                  <span\n                    className=\"absolute left-0 right-0 -bottom-[1px] h-0.5 bg-brand rounded-full\"\n                    aria-hidden=\"true\"\n                  />\n                )}\n              </button>\n            );\n          })}\n        </nav>\n\n        {/* Zone 3: Reviewer CTA (if enabled) or Public Share CTA */}\n        <div className=\"flex items-center shrink-0\">\n          {SHOW_REVIEWER_TOOLS ? (\n            <button\n              type=\"button\"\n              onClick={onOpenTinjau}\n              className=\"min-h-[44px] px-4 py-2 text-xs sm:text-sm font-semibold text-on-brand bg-brand hover:bg-forest rounded-xl flex items-center gap-2 transition-colors cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-focus whitespace-nowrap\"\n              aria-label=\"Buka berkas dokumen dan tinjauan Tugas Akhir Berbasis Proyek\"\n            >\n              <FileText className=\"w-4 h-4 text-sand shrink-0\" />\n              <span className=\"hidden sm:inline\">Tinjau / Bagikan</span>\n              <span className=\"sm:hidden\">Tinjau</span>\n            </button>\n          ) : (\n            <button\n              type=\"button\"\n              onClick={handlePublicShare}\n              className={`min-h-[44px] px-4 py-2 text-xs sm:text-sm font-semibold rounded-xl flex items-center gap-2 transition-colors cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-focus whitespace-nowrap ${\n                copiedPublicLink\n                  ? \'bg-status-aman-text text-on-brand\'\n                  : \'bg-brand hover:bg-forest text-on-brand\'\n              }`}\n              aria-label=\"Bagikan tautan Ruang Obat\"\n            >\n              {copiedPublicLink ? (\n                <>\n                  <Check className=\"w-4 h-4 shrink-0\" />\n                  <span>Tersalin!</span>\n                </>\n              ) : (\n                <>\n                  <Share2 className=\"w-4 h-4 shrink-0\" />\n                  <span>Bagikan</span>\n                </>\n              )}\n            </button>\n          )}\n        </div>\n      </div>\n    </header>\n  );\n};\n"
    num_lines: 144
    num_bytes: 5604
    line_range_bytes: 5604
  }
}
