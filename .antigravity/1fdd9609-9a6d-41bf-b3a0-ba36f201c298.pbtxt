    command_line: "node -e \"\nconst fs = require(\'fs\');\nconst fkui = JSON.parse(fs.readFileSync(\'/tmp/fkui_ed4.json\', \'utf8\'));\n// Find all chapter starts by matching pattern like \'34. OBAT LOKAL\' or \'1. PENGANTAR FARMAKOLOGI\' at start of page\nfor (let i = 20; i < fkui.length; i++) {\n  const head = fkui[i].slice(0, 220).replace(/\\s+/g, \' \');\n  const m = head.match(/\\b([1-9]|[1-4][0-9]|5[0-6])\\.\\s+[A-Z][A-Z\\s,\\-\\/\\(\\)]{3,}/);\n  if (m) {\n    console.log(\'PDF_Page\', i+1, \'->\', m[0]);\n  }\n}\n\""
    proposed_command_line: "node -e \"\nconst fs = require(\'fs\');\nconst fkui = JSON.parse(fs.readFileSync(\'/tmp/fkui_ed4.json\', \'utf8\'));\n// Find all chapter starts by matching pattern like \'34. OBAT LOKAL\' or \'1. PENGANTAR FARMAKOLOGI\' at start of page\nfor (let i = 20; i < fkui.length; i++) {\n  const head = fkui[i].slice(0, 220).replace(/\\s+/g, \' \');\n  const m = head.match(/\\b([1-9]|[1-4][0-9]|5[0-6])\\.\\s+[A-Z][A-Z\\s,\\-\\/\\(\\)]{3,}/);\n  if (m) {\n    console.log(\'PDF_Page\', i+1, \'->\', m[0]);\n  }\n}\n\""
    shell_name: "bash"
  }
