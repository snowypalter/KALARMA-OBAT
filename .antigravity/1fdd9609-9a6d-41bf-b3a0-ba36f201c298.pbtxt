    command_line: "node -e \'\nconst fs = require(\"fs\");\nconst hki = JSON.parse(fs.readFileSync(\"/tmp/hki2022.json\", \"utf8\"));\nconst fkui = JSON.parse(fs.readFileSync(\"/tmp/fkui_ed4.json\", \"utf8\"));\nconsole.log(\"HKI type:\", Array.isArray(hki) ? \"array\" : typeof hki, \"len:\", Array.isArray(hki) ? hki.length : Object.keys(hki));\nconsole.log(\"HKI sample 0:\", JSON.stringify(hki[0]).slice(0, 200));\nconsole.log(\"FKUI type:\", Array.isArray(fkui) ? \"array\" : typeof fkui, \"len:\", Array.isArray(fkui) ? fkui.length : Object.keys(fkui));\nconsole.log(\"FKUI sample 17-21:\");\nfor (let i = 16; i <= 21; i++) {\n  console.log(\"--- PAGE\", i+1, \"---\");\n  console.log(String(fkui[i]).slice(0, 1200));\n}\n\'"
