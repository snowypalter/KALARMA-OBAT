    proposed_command_line: "node -e \'\nconst fs = require(\"fs\");\nconst path = require(\"path\");\n\nconst hki = JSON.parse(fs.readFileSync(\"/tmp/hki2022.json\", \"utf8\"));\nconst fkui = JSON.parse(fs.readFileSync(\"/tmp/fkui_ed4.json\", \"utf8\"));\nconst outDir = path.join(process.cwd(), \"knowledge_books\");\nfs.mkdirSync(outDir, { recursive: true });\n\nfunction cleanPageText(raw) {\n  return String(raw || \"\")\n    .replace(/\\r\\n/g, \"\\n\")\n    .replace(/(\\w)-\\s*\\n\\s*(\\w)/g, \"$1$2\")\n    .replace(/[ \\t]{2,}/g, \" \")\n    .replace(/\\n{3,}/g, \"\\n\\n\")\n    .trim();\n}\n\nconst hkiChapters = [\n  { file: \"HKI_2022_Bab_01_Konsep_Dasar_Farmakologi.md\", bab: \"Bab I: Konsep Dasar Farmakologi\", start: 9, end: 24 },\n  { file: \"HKI_2022_Bab_02_Farmakokinetik.md\", bab: \"Bab II: Farmakokinetik\", start: 25, end: 34 },\n  { file: \"HKI_2022_Bab_03_Farmakodinamika.md\", bab: \"Bab III: Farmakodinamika\", start: 35, end: 54 },\n  { file: \"HKI_2022_Bab_04_Farmakoterapi.md\", bab: \"Bab IV: Farmakoterapi\", start: 55, end: 72 },\n  { file: \"HKI_2022_Bab_05_Toksikologi.md\", bab: \"Bab V: Toksikologi\", start: 73, end: 100 },\n  { file: \"HKI_2022_Bab_06_Peran_Obat.md\", bab: \"Bab VI: Peran Obat\", start: 101, end: 116 },\n  { file: \"HKI_2022_Bab_07_Penggolongan_Jenis_Obat.md\", bab: \"Bab VII: Penggolongan Jenis Obat\", start: 117, end: 132 },\n  { file: \"HKI_2022_Bab_08_Prinsip_Pemberian_Obat_Dengan_Benar.md\", bab: \"Bab VIII: Prinsip Pemberian Obat Dengan Benar\", start: 133, end: 174 },\n  { file: \"HKI_2022_Bab_09_Bentuk_Sediaan_Obat.md\", bab: \"Bab IX: Bentuk Sediaan Obat\", start: 175, end: 192 },\n  { file: \"HKI_2022_Bab_10_Peran_Perawat_Dalam_Pemberian_Obat.md\", bab: \"Bab X: Peran Perawat Dalam Pemberian Obat\", start: 193, end: 212 },\n  { file: \"HKI_2022_Bab_11_Cara_Pemberian_Obat.md\", bab: \"Bab XI: Cara Pemberian Obat\", start: 213, end: 270 },\n];\n\nfor (const ch of hkiChapters) {\n  const parts = [\n    `# Buku Ajar Farmakologi (HKI, 2022)`,\n    ``,\n    `**Referensi:** Buku Ajar Farmakologi \342\200\224 Dr. Siti Maemonah, dkk. (Zahir Publishing, Cetakan I, Agustus 2022, ISBN 978-623-466-100-2)`,\n    `**Cakupan:** ${ch.bab}`,\n    ``,\n    `## ${ch.bab}`,\n    ``\n  ];\n  for (let p = ch.start; p <= ch.end; p++) {\n    const txt = cleanPageText(hki[p - 1]);\n    if (txt) {\n      parts.push(`[Halaman PDF ${p}]`);\n      parts.push(txt);\n      parts.push(\"\");\n    }\n  }\n  fs.writeFileSync(path.join(outDir, ch.file), parts.join(\"\\n\"), \"utf8\");\n}\n\nconst fkuiFiles = [\n  {\n    file: \"FKUI_Ed4_01_Pengantar_Farmakologi_Bab_1.md\",\n    title: \"Seksi I \342\200\224 Bab 1: Pengantar Farmakologi\",\n    sections: [\n      { heading: \"Bab 1: Pengantar Farmakologi (Seksi I)\", start: 22, end: 44 }\n    ]\n  },\n  {\n    file: \"FKUI_Ed4_02_Obat_Otonom_Bab_2_sd_5.md\",\n    title: \"Seksi II \342\200\224 Bab 2\342\200\2235: Obat Otonom\",\n    sections: [\n      { heading: \"Bab 2: Susunan Saraf Otonom dan Transmisi Neurohumoral (Seksi II)\", start: 45, end: 60 },\n      { heading: \"Bab 3: Kolinergik (Seksi II)\", start: 61, end: 70 },\n      { heading: \"Bab 4: Antimuskarinik (Seksi II)\", start: 71, end: 77 },\n      { heading: \"Bab 5: Adrenergik (Seksi II)\", start: 78, end: 97 }\n    ]\n  },\n  {\n    file: \"FKUI_Ed4_03_Obat_Otonom_Bab_6_sd_8.md\",\n    title: \"Seksi II \342\200\224 Bab 6\342\200\2238: Penghambat Adrenergik, Pelumpuh Otot, Obat Ganglion\",\n    sections: [\n      { heading: \"Bab 6: Penghambat Adrenergik (Seksi II)\", start: 98, end: 116 },\n      { heading: \"Bab 7: Pelumpuh Otot (Seksi II)\", start: 117, end: 124 },\n      { heading: \"Bab 8: Obat Ganglion (Seksi II)\", start: 125, end: 130 }\n    ]\n  },\n  {\n    file: \"FKUI_Ed4_04_Obat_SSP_Bab_9_sd_11.md\",\n    title: \"Seksi III \342\200\224 Bab 9\342\200\22311: Anestetik Umum, Hipnotik-Sedatif, Psikotropik\",\n    sections: [\n      { heading: \"Bab 9: Anestetik Umum (Seksi III)\", start: 13