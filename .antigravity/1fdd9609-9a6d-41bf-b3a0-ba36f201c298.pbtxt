            lines {
              text: "          meaning: \'[ISI DARI RUJUKAN: BPOM - Ketentuan NIE pada Label Botol Kaca atau Plastik]\',"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          tips: \'[ISI DARI RUJUKAN: BPOM - Verifikasi NIE Kemasan Cair Melalui Aplikasi Cek BPOM]\',"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          warning: \'[ISI DARI RUJUKAN: BPOM - Kewaspadaan Terhadap Kemasan Sirup Tanpa Segel atau Tanpa NIE]\'"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          meaning: \'Nomor registrasi 15 digit dari BPOM RI pada label botol yang memastikan formula, pelarut, takaran zat aktif, dan mutu sediaan cair telah memenuhi persyaratan izin edar resmi di Indonesia (BPOM RI).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          tips: \'Pastikan segel tutup botol masih utuh saat dibeli, kemudian cek kode NIE 15 digit dan nomor bets melalui aplikasi Cek BPOM untuk memastikan produk asli dan tidak termasuk dalam daftar penarikan (recall).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          warning: \'Waspadai produk sirup tanpa NIE resmi, tanpa segel pelindung, atau berlabel kabur yang tidak mencantumkan komposisi pelarut dan zat aktif secara jelas karena berisiko tinggi menimbulkan keracunan (Farmakologi dan Terapi Ed. 4 FKUI, Bab 52 & HKI 2022, Bab V).\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
