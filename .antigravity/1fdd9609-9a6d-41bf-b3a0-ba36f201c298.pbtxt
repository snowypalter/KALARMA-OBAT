            lines {
              text: "          meaning: \'[ISI DARI RUJUKAN: BPOM - Standar Pencetakan Kedaluwarsa pada Tube Logam/Aluminium/Plastik]\',"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          tips: \'[ISI DARI RUJUKAN: Kemenkes RI - Menemukan Angka Cetak Timbul pada Ujung Lipatan Salep]\',"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          warning: \'[ISI DARI RUJUKAN: BPOM - Jangan Gunakan Salep jika Minyak Terpisah dari Dasar Krim atau Berbau Tengik]\'"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          meaning: \'Pada kemasan tube logam aluminium maupun plastik, Tanggal Kedaluwarsa (ED) dan Nomor Bets umumnya dicetak tekan (crimping/emboss) pada ujung lipatan belakang tube. Masa pakai setelah segel dibuka (BUD) sediaan semipadat umumnya lebih singkat daripada ED (BPOM RI; USP <795>).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          tips: \'Biasakan memeriksa ujung lipatan belakang tube dan pastikan tutupan ulir selalu tertutup rapat setelah dipakai agar basis krim/salep tidak teroksidasi atau mengering (HKI 2022, Bab IX).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          warning: \'Jangan gunakan salep atau krim apabila terjadi pemisahan fase air dan minyak (pecah emulsi), berubah warna menjadi kecokelatan, berbau tengik, atau bertekstur kasar/berpasir karena stabilitas sediaan sudah rusak (HKI 2022, Bab IX & BPOM RI).\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
