      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Remove validation placeholder wording in generatePdfClient.ts\", \"EndLine\":224, \"Instruction\":\"Update item C in rules array to cite HKI 2022, Farmakologi & Terapi Ed. 4 FKUI, BPOM RI, Kemenkes RI, and Farmakope Indonesia without placeholder wording.\", \"ReplacementContent\":\"    [\\n      \'C. Berbasis Sitasi Buku Ajar & Regulasi Resmi\',\\n      \'Semua uraian medis mengacu langsung pada Buku Ajar Farmakologi (HKI 2022), Farmakologi dan Terapi Edisi 4 (FKUI), BPOM RI, Kemenkes RI (DAGUSIBU), dan Farmakope Indonesia Edisi VI.\',\\n    ],\", \"StartLine\":218, \"TargetContent\":\"    [\\n      \'C. Berbasis Sitasi Resmi (BPOM, Kemenkes, Farmakope)\',\\n      \'Semua uraian medis mengacu pada rujukan resmi BPOM RI, Kemenkes RI, dan Farmakope Indonesia yang masih dalam proses validasi pakar.\',\\n    ],\", \"TargetFile\":\"/src/utils/generatePdfClient.ts\", \"toolAction\":\"Updating citation text in generatePdfClient.ts\", \"toolSummary\":\"Update generatePdfClient.ts\"}"
