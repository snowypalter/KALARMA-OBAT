            }
            lines {
              text: "          meaning: \'[ISI DARI RUJUKAN: BPOM - Batas Waktu Expired Date dan Nomor Batch]\',"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          tips: \'[ISI DARI RUJUKAN: Kemenkes RI - Cara Menemukan Tanggal Cetak Emboss pada Ujung Strip Tablet]\',"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          warning: \'[ISI DARI RUJUKAN: BPOM - Larangan Mengonsumsi Obat yang Telah Melewati Tanggal Kedaluwarsa]\'"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          meaning: \'Expired Date (ED) adalah batas waktu terakhir jaminan stabilitas, potensi, dan keamanan obat dalam kemasan asli pabrik yang belum rusak/terbuka, sedangkan Nomor Bets adalah kode identitas siklus produksi untuk penelusuran mutu atau penarikan produk (HKI 2022, Bab VIII & Bab XI; BPOM RI).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          tips: \'Periksa cetakan tekan (emboss) atau tinta pada ujung lipatan strip atau blister tablet sebelum menelan obat. Jika kemasan strip tergunting dan tanggal ED terpotong tidak terbaca, jangan ragu menanyakan kepada apoteker atau memisahkan obat.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          warning: \'Jangan pernah mengonsumsi obat yang telah melewati tanggal kedaluwarsa karena kadar zat aktif dapat menurun atau terurai menjadi senyawa toksik\342\200\224seperti produk degradasi tetrasiklin berwarna cokelat yang berbahaya bagi ginjal (Farmakologi dan Terapi Ed. 4 FKUI, Bab 52: Dasar Toksikologi).\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
