              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    definition: \'[ISI DARI RUJUKAN: BPOM - Kondisi Tertentu di Mana Pasien Sama Sekali Tidak Boleh Mengonsumsi Obat Karena Risiko Bahaya Fatal]\',"
