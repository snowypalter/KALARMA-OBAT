              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          meaning: \'[ISI DARI RUJUKAN: BPOM - Definisi dan Ruang Lingkup Indikasi Terdaftar]\',"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          tips: \'[ISI DARI RUJUKAN: Kemenkes RI - Cara Membaca Gejala yang Cocok dengan Indikasi Obat]\',"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          warning: \'[ISI DARI RUJUKAN: BPOM - Hindari Menggunakan Obat di Luar Indikasi Resmi Tanpa Arahan Dokter]\'"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          meaning: \'Keterangan khasiat farmakoterapi obat yang telah dibuktikan secara ilmiah melalui uji klinis untuk meredakan, mengobati, atau mencegah gejala tertentu\342\200\224misalnya analgesik-antipiretik untuk nyeri ringan dan demam (HKI 2022, Bab I & Bab IV; Farmakologi dan Terapi Ed. 4 FKUI, Bab 1 & Bab 15).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          tips: \'Cocokkan gejala yang dialami dengan indikasi resmi pada etiket atau brosur obat. Jika obat ditujukan hanya untuk gejala tertentu (misalnya penurun demam), jangan diminum untuk keluhan lain yang tidak sesuai.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          warning: \'Pemakaian obat di luar indikasi resmi\342\200\224terutama penggunaan antibiotik pada infeksi virus seperti flu biasa\342\200\224tidak akan menyembuhkan dan justru memicu kegagalan terapi serta resistensi mikroba (Farmakologi dan Terapi Ed. 4 FKUI, Bab 39: Pengantar Antimikroba).\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
