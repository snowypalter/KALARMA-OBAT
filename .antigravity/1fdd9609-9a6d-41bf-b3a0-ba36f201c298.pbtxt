  view_file {
    absolute_path_uri: "file:///src/components/FooterDisclaimer.tsx"
    end_line: 51
    content: "import React from \'react\';\nimport { AlertCircle, Info } from \'lucide-react\';\nimport { IDENTITAS_PROYEK } from \'../data/identitasProyek\';\n\ninterface FooterDisclaimerProps {\n  onOpenAbout?: () => void;\n}\n\nexport const FooterDisclaimer: React.FC<FooterDisclaimerProps> = ({ onOpenAbout }) => {\n  const daftarNamaTim = IDENTITAS_PROYEK.timPengembang\n    .map((anggota) => anggota.nama)\n    .join(\' \302\267 \');\n\n  return (\n    <footer className=\"w-full bg-surface-muted/75 border-t border-line py-7 px-4 sm:px-6 mb-20 md:mb-0\">\n      <div className=\"max-w-3xl mx-auto flex flex-col items-center text-center gap-2.5\">\n        <div className=\"flex items-center gap-1.5 text-forest font-semibold text-xs sm:text-sm\">\n          <AlertCircle className=\"w-4 h-4 text-status-segera-text shrink-0\" />\n          <span>Pemberitahuan Edukasi</span>\n        </div>\n\n        <p className=\"text-xs sm:text-sm text-ink-muted leading-relaxed max-w-2xl\">\n          {IDENTITAS_PROYEK.kalimatBatasan}\n        </p>\n\n        <div className=\"pt-3 border-t border-line w-full max-w-2xl flex flex-col items-center gap-1.5 text-xs text-ink-muted\">\n          <span className=\"font-medium text-ink\">\n            {IDENTITAS_PROYEK.taglineFooter}\n          </span>\n          <span>\n            Tim Pengembang: {daftarNamaTim}\n          </span>\n          <span>\n            {IDENTITAS_PROYEK.programStudi} \302\267 {IDENTITAS_PROYEK.institusi} \302\267 {IDENTITAS_PROYEK.statusVersi}\n          </span>\n\n          {onOpenAbout && (\n            <button\n              type=\"button\"\n              onClick={onOpenAbout}\n              className=\"mt-1 min-h-[44px] inline-flex items-center gap-1.5 text-brand hover:text-forest font-semibold underline-offset-4 hover:underline cursor-pointer py-2 px-3 rounded-xl focus-visible:ring-2 focus-visible:ring-focus\"\n            >\n              <Info className=\"w-3.5 h-3.5\" />\n              <span>Tentang &amp; Batasan Etika</span>\n            </button>\n          )}\n        </div>\n      </div>\n    </footer>\n  );\n};\n"
    num_lines: 52
    num_bytes: 2001
    line_range_bytes: 2001
  }
}
