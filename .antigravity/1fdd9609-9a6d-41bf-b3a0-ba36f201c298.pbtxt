        value: "npx tsx -e \"\n(async () => {\n  const fs = await import(\'fs/promises\');\n  const { extractText } = await import(\'unpdf\');\n  const buf1 = await fs.readFile(\'public/assets/aistudio/005._HKI_Buku_Ajar_Farmakologi_2022_4237e242.pdf\');\n  const res1 = await extractText(new Uint8Array(buf1), { mergePages: false });\n  const pages1 = Array.isArray(res1.text) ? res1.text : [String(res1.text)];\n  console.log(\'=== HKI TOC (pages 4-10) ===\');\n  console.log(pages1.slice(4, 10).join(\'\\n---PAGE---\\n\'));\n\n  const buf2 = await fs.readFile(\'public/assets/aistudio/kupdf.net_farmakologi-dan-terapi-edisi-4_991d8e3d.pdf\');\n  const res2 = await extractText(new Uint8Array(buf2), { mergePages: false });\n  const pages2 = Array.isArray(res2.text) ? res2.text : [String(res2.text)];\n  console.log(\'=== FKUI ED 4 TOC (pages 4-20) ===\');\n  console.log(pages2.slice(4, 20).join(\'\\n---PAGE---\\n\'));\n})();\n\""
