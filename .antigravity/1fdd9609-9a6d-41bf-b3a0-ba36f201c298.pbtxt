    command_line: "node -e \'\nconst fs = require(\"fs\");\nconst fkui = JSON.parse(fs.readFileSync(\"/tmp/fkui_ed4.json\", \"utf8\"));\nconst map = [];\nfor (let i = 0; i < fkui.length; i++) {\n  const txt = fkui[i].replace(/\\s+/g, \" \").trim();\n  const head = txt.slice(0, 140);\n  // Look for printed page number near start: e.g. \"24 Farmakologi dan Terapi\" or \"Title 247\"\n  let pnum = null;\n  const m1 = head.match(/^(\\d{1,3})\\s+Farmakologi/i);\n  const m2 = head.match(/\\b(\\d{1,3})\\b/);\n  if (m1) pnum = parseInt(m1[1], 10);\n  else if (m2 && head.indexOf(m2[1]) < 60) pnum = parseInt(m2[1], 10);\n  map.push({ pdf: i+1, pnum, head: head.slice(0, 85) });\n}\n// Print transitions or every 20 pages, plus any chapter/seksi markers\nfor (let i = 0; i < map.length; i++) {\n  const m = map[i];\n  const prev = i > 0 ? map[i-1] : null;\n  const jump = prev && m.pnum && prev.pnum && Math.abs(m.pnum - prev.pnum) > 2;\n  const isChap = /(SEKSI\\s+[IVX]+|\\b[IVX]{1,4}\\.\\s+[A-Z]{4,}|\\b\\d{1,2}\\.\\s+[A-Z]{4,}|Indeks\\b|Daftar\\s+lsi)/i.test(m.head);\n  if (i < 25 || jump || isChap || i === 884 || i === 885) {\n    console.log(`PDF ${String(m.pdf).padStart(4)} | p.${String(m.pnum||\"?\").padStart(3)} | ${m.head}`);\n  }\n}\n\'"
    proposed_command_line: "node -e \'\nconst fs = require(\"fs\");\nconst fkui = JSON.parse(fs.readFileSync(\"/tmp/fkui_ed4.json\", \"utf8\"));\nconst map = [];\nfor (let i = 0; i < fkui.length; i++) {\n  const txt = fkui[i].replace(/\\s+/g, \" \").trim();\n  const head = txt.slice(0, 140);\n  // Look for printed page number near start: e.g. \"24 Farmakologi dan Terapi\" or \"Title 247\"\n  let pnum = null;\n  const m1 = head.match(/^(\\d{1,3})\\s+Farmakologi/i);\n  const m2 = head.match(/\\b(\\d{1,3})\\b/);\n  if (m1) pnum = parseInt(m1[1], 10);\n  else if (m2 && head.indexOf(m2[1]) < 60) pnum = parseInt(m2[1], 10);\n  map.push({ pdf: i+1, pnum, head: head.slice(0, 85) });\n}\n// Print transitions or every 20 pages, plus any chapter/seksi markers\nfor (let i = 0; i < map.length; i++) {\n  const m = map[i];\n  const prev = i > 0 ? map[i-1] : null;\n  const jump = prev && m.pnum && prev.pnum && Math.abs(m.pnum - prev.pnum) > 2;\n  const isChap = /(SEKSI\\s+[IVX]+|\\b[IVX]{1,4}\\.\\s+[A-Z]{4,}|\\b\\d{1,2}\\.\\s+[A-Z]{4,}|Indeks\\b|Daftar\\s+lsi)/i.test(m.head);\n  if (i < 25 || jump || isChap || i === 884 || i === 885) {\n    console.log(`PDF ${String(m.pdf).padStart(4)} | p.${String(m.pnum||\"?\").padStart(3)} | ${m.head}`);\n  }\n}\n\'"
    shell_name: "bash"
  }
}
