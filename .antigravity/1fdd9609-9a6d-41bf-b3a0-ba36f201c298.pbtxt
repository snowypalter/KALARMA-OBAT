            }
            lines {
              text: "          meaning: \'[ISI DARI RUJUKAN: Farmakope Indonesia - Prinsip Homogenitas Sediaan Suspensi]\',"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          tips: \'[ISI DARI RUJUKAN: Kemenkes RI - Cara Mengocok Botol dengan Benar Sebelum Dituang]\',"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          warning: \'[ISI DARI RUJUKAN: Farmakologi - Risiko Mengendapnya Zat Aktif jika Tidak Dikocok]\'"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          meaning: \'Pada sediaan suspensi dan emulsi, bahan obat padat halus yang tidak larut terdispersi di dalam cairan pembawa dan cenderung mengendap saat disimpan. Mengocok botol secara perlahan bertujuan mendispersikan kembali endapan agar campuran kembali seragam/homogen sebelum dituang (HKI 2022, Bab IX: Bentuk Sediaan Obat & Bab XI).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          tips: \'Kocok botol secara perlahan selama beberapa detik sebelum membuka tutup, pegang label botol menghadap telapak tangan saat menuang agar label tidak kotor, lalu bersihkan bibir botol sebelum menutup kembali (HKI 2022, Bab XI: Cara Pemberian Obat).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          warning: \'Jika suspensi tidak dikocok dahulu, takaran pertama dari bagian atas botol hanya berisi cairan pembawa dengan dosis terlalu rendah (terapi gagal), sedangkan sisa cairan di dasar botol menjadi sangat pekat dan berisiko overdosis (HKI 2022, Bab IX).\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
