:254:          warning: \'[ISI DARI RUJUKAN: BPOM - Waspada Krim/Salep Racikan Ilegal yang Beredar Tanpa NIE]\'src/data/kamusData.ts:8:    definition: \'[ISI DARI RUJUKAN: BPOM - Petunjuk Frekuensi, Jumlah, dan Waktu Konsumsi Obat Sesuai Bentuk Sediaan]\',src/data/kamusData.ts:15:    definition: \'[ISI DARI RUJUKAN: Farmakope Indonesia - Klasifikasi Wujud Fisik Obat Seperti Tablet, Kapsul, Sirup, dan Salep]\',src/data/kamusData.ts:22:    definition: \'[ISI DARI RUJUKAN: USP / Kemenkes RI - Batas Waktu Penggunaan Obat Setelah Wadah Primer Dibuka atau Direkonstitusi]\',src/data/kamusData.ts:29:    definition: \'[ISI DARI RUJUKAN: Farmakologi Dasar - Jumlah atau Takaran Obat yang Diberikan untuk Menghasilkan Efek Terapi]\',src/data/kamusData.ts:36:    definition: \'[ISI DARI RUJUKAN: BPOM / WHO - Respon Obat yang Tidak Diinginkan yang Terjadi pada Dosis Lazim Manusia]\',src/data/kamusData.ts:43:    definition: \'[ISI DARI RUJUKAN: BPOM - Batas Tanggal Terakhir yang Diberikan Pabrik Selama Obat Masih Memenuhi Syarat Mutu dalam Kemasan Asli Belum Terbuka]\',src/data/kamusData.ts:50:    definition: \'[ISI DARI RUJUKAN: BPOM - Penyakit atau Gejala Tertentu yang Secara Ilmiah Terbukti Dapat Diringankan atau Disembuhkan oleh Obat Tersebut]\',src/data/kamusData.ts:57:    definition: \'[ISI DARI RUJUKAN: BPOM - Kondisi Tertentu di Mana Pasien Sama Sekali Tidak Boleh Mengonsumsi Obat Karena Risiko Bahaya Fatal]\',src/data/kamusData.ts:64:    definition: \'[ISI DARI RUJUKAN: Permenkes RI - Obat yang Dapat Dibeli Bebas di Apotek Maupun Toko Obat Berizin Tanpa Resep Dokter]\',src/data/kamusData.ts:71:    definition: \'[ISI DARI RUJUKAN: Permenkes RI - Obat Keras yang Masih Dapat Dibeli Tanpa Resep Namun Wajib Disertai Tanda Peringatan Khusus (P1-P6)]\',src/data/kamusData.ts:78:    definition: \'[ISI DARI RUJUKAN: Permenkes RI - Obat Berbahaya yang Hanya Boleh Diperoleh dengan Resep Dokter di Apotek]\',src/data/kamusData.ts:85:    definition: \'[ISI DARI RUJUKAN: BPOM - Penandaan U