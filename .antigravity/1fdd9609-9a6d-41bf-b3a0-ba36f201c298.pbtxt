    tool_calls {
      id: "call_16299666786277551946"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState } from \'react\';\\nimport { PUSTAKA_ITEMS } from \'../data/pustakaData\';\\nimport { RujukanText } from \'../components/ui\';\\nimport { Search, BookmarkCheck, ExternalLink, BookOpen, X } from \'lucide-react\';\\n\\nexport const PustakaView: React.FC = () => {\\n  const [searchQuery, setSearchQuery] = useState(\'\');\\n\\n  const filteredReferences = PUSTAKA_ITEMS.filter((item) => {\\n    const q = searchQuery.toLowerCase();\\n    return (\\n      item.penulis.toLowerCase().includes(q) ||\\n      item.judul.toLowerCase().includes(q) ||\\n      item.penerbit.toLowerCase().includes(q) ||\\n      item.kategori.toLowerCase().includes(q) ||\\n      item.catatan.toLowerCase().includes(q)\\n    );\\n  });\\n\\n  return (\\n    <div className=\\\"space-y-6 pb-12 ro-fade-in\\\">\\n      {/* Editorial Page Header */}\\n      <div className=\\\"space-y-1.5\\\">\\n        <p className=\\\"text-xs font-semibold uppercase tracking-[0.12em] text-brand\\\">\\n          Sumber Ilmiah &amp; Regulasi Resmi\\n        </p>\\n        <h1 className=\\\"font-display text-2xl sm:text-3xl lg:text-4xl font-semibold text-forest tracking-tight\\\">\\n          Pustaka Rujukan Farmasi\\n        </h1>\\n        <p className=\\\"text-ink-muted text-sm sm:text-base max-w-2xl leading-relaxed\\\">\\n          Daftar buku ajar farmakologi (HKI 2022 &amp; Farmakologi dan Terapi Ed. 4 FKUI) serta pedoman resmi Kemenkes RI, BPOM RI, dan Farmakope Indonesia yang menjadi landasan seluruh materi.\\n        </p>\\n      </div>\\n\\n      {/* Info Banner: 35 Bab Terindeks di Asisten AI */}\\n      <div className=\\\"p-4 sm:p-5 rounded-2xl bg-sand-soft/70 border border-sand flex items-start gap-3\\\">\\n        <div className=\\\"w-9 h-9 rounded-xl bg-forest text-sand flex items-center justify-center shrink-0 mt-0.5\\\">\\n          <BookOpen className=\\\"w-4 h-4\\\" />\\n        </div>\\n        <div className=\\\"space-y-1 text-xs sm:text-sm\\\">\\n          <div className=\\\"font-bold text-forest\\\">\\n            35 Berkas Bab Buku Terintegrasi ke Asisten Ruang Obat\\n          </div>\\n          <p className=\\\"text-ink-muted leading-relaxed\\\">\\n            Seluruh uraian materi pada aplikasi ini bersumber langsung dari <strong className=\\\"text-forest\\\">11 Bab Buku Ajar Farmakologi (HKI, 2022)</strong> dan <strong className=\\\"text-forest\\\">24 Berkas Seksi/Bab Farmakologi dan Terapi Edisi 4 (FKUI)</strong>, yang juga dikunci sebagai rujukan utama jawaban chatbot beserta kutipan nama dan bab bukunya.\\n          </p>\\n        </div>\\n      </div>\\n\\n      {/* Search Input */}\\n      <div className=\\\"relative max-w-2xl\\\">\\n        <Search className=\\\"w-4 h-4 text-ink-muted absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none\\\" />\\n        <input\\n          type=\\\"text\\\"\\n          value={searchQuery}\\n          onChange={(e) => setSearchQuery(e.target.value)}\\n          placeholder=\\\"Cari penulis, HKI 2022, FKUI, BPOM, Kemenkes, Dagusibu...\\\"\\n          aria-label=\\\"Cari dokumen pustaka farmasi\\\"\\n          className=\\\"w-full min-h-[46px] pl-10 pr-12 py-2.5 text-sm bg-surface border border-line rounded-xl text-ink placeholder:text-ink-muted/70 focus:outline-none focus:ring-2 focus:ring-focus focus:border-transparent\\\"\\n        />\\n        {searchQuery && (\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => setSearchQuery(\'\')}\\n            aria-label=\\\"Hapus pencarian pustaka\\\"\\n            className=\\\"absolute right-1.5 top-1/2 -translate-y-1/2 min-h-[44px] min-w-[44px] rounded-lg text-ink-muted hover:text-ink hover:bg-surface-muted flex items-center justify-center cursor-pointer\\\"\\n          >\\n            <X className=\\\"w-4 h-4\\\" />\\n          </button>\\n        )}\\n      </div>\\n\\n      {/* Rujukan Cards Grid */}\\n      <div className=\\\"grid grid-cols-1 md:grid-cols-2 gap-4\\\">\\n        {filteredReferences.map((ref) => {\\n          const isUrl = ref.tautanPlaceholder.startsWith(\'http\');\\n          return (\\n            <article\\n              key={ref.id}\\n              className=\\\"p-5 sm:p-6 bg-surface rounded-2xl border border-line hover:border-line-strong transition-colors flex flex-col justify-between space-y-4\\\"\\n            >\\n              <div className=\\\"space-y-3\\\">\\n                <div className=\\\"flex items-center justify-between gap-2 text-xs\\\">\\n                  <span className=\\\"font-semibold uppercase tracking-wider text-brand\\\">\\n                    {ref.kategori}\\n                  </span>\\n                  <span className=\\\"text-ink-muted font-mono tabular-nums\\\">\\n                    Tahun {ref.tahun}\\n                  </span>\\n                </div>\\n\\n                <div className=\\\"space-y-1.5\\\">\\n                  <h2 className=\\\"font-display text-base sm:text-lg font-semibold text-forest leading-snug\\\">\\n                    <RujukanText\\n                      text={ref.judul}\\n                      className=\\\"font-semibold text-forest text-base sm:text-lg\\\"\\n                    />\\n                  </h2>\\n                  <div className=\\\"text-xs text-ink-muted\\\">\\n                    <strong className=\\\"text-ink\\\">Penulis:</strong> {ref.penulis}\\n                  </div>\\n                  <div className=\\\"text-xs text-ink-muted\\\">\\n                    <strong className=\\\"text-ink\\\">Penerbit:</strong> {ref.penerbit}\\n                  </div>\\n                </div>\\n\\n                <p className=\\\"text-xs text-ink-muted italic bg-surface-warm p-3 rounded-xl border border-line/80 leading-relaxed\\\">\\n                  {ref.catatan}\\n                </p>\\n              </div>\\n\\n              <div className=\\\"pt-3 border-t border-line flex items-center justify-between gap-2 text-xs text-brand\\\">\\n                <div className=\\\"min-w-0 flex-1 truncate\\\">\\n                  {isUrl ? (\\n                    <a\\n                      href={ref.tautanPlaceholder}\\n                      target=\\\"_blank\\\"\\n                      rel=\\\"noopener noreferrer\\\"\\n                      className=\\\"inline-flex items-center gap-1.5 font-semibold text-brand hover:text-forest underline underline-offset-2\\\"\\n                    >\\n                      <span>{ref.tautanPlaceholder}</span>\\n                      <ExternalLink className=\\\"w-3.5 h-3.5 shrink-0\\\" />\\n                    </a>\\n                  ) : (\\n                    <RujukanText\\n                      text={ref.tautanPlaceholder}\\n                      className=\\\"text-xs font-medium text-brand\\\"\\n                    />\\n                  )}\\n                </div>\\n                <BookmarkCheck className=\\\"w-4 h-4 shrink-0\\\" />\\n              </div>\\n            </article>\\n          );\\n        })}\\n      </div>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Update PustakaView.tsx to display HKI 2022 & FKUI Ed. 4 book integration info and render URLs cleanly\", \"Overwrite\":true, \"TargetFile\":\"/src/views/PustakaView.tsx\", \"toolAction\":\"Updating PustakaView.tsx\", \"toolSummary\":\"Update PustakaView.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_16299666786277551977"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React from \'react\';\\n\\nexport interface RujukanTextProps {\\n  text: string;\\n  className?: string;\\n  block?: boolean;\\n}\\n\\nexport const RujukanText: React.FC<RujukanTextProps> = ({\\n  text,\\n  className = \'\',\\n  block = false,\\n}) => {\\n  return (\\n    <span\\n      className={`text-sm text-ink leading-relaxed ${\\n        block ? \'block\' : \'inline\'\\n      } ${className}`}\\n    >\\n      {text}\\n    </span>\\n  );\\n};\\n\", \"Description\":\"Remove placeholder validation fallback from RujukanText.tsx so validated textbook content always renders directly\", \"Overwrite\":true, \"TargetFile\":\"/src/components/ui/RujukanText.tsx\", \"toolAction\":\"Updating RujukanText.tsx\", \"toolSummary\":\"Update RujukanText.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_16299666786277552008"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { PackagingData } from \'../types\';\\n\\nexport const PACKAGING_ITEMS: Record<string, PackagingData> = {\\n  tablet: {\\n    type: \'tablet\',\\n    title: \'Strip / Blister Tablet\',\\n    subtitle: \'Simulasi kemasan primer & sekunder sediaan padat\',\\n    hotspots: [\\n      {\\n        id: 1,\\n        number: 1,\\n        title: \'Logo Golongan Obat\',\\n        shortDescription: \'Tanda lingkaran penanda tingkat keamanan dan izin perolehan obat.\',\\n        xPercent: 18,\\n        yPercent: 18,\\n        content: {\\n          meaning: \'Penandaan resmi golongan obat pada kemasan sesuai Permenkes RI: lingkaran hijau bergaris tepi hitam menandakan Obat Bebas (dapat dibeli tanpa resep untuk keluhan ringan); lingkaran biru menandakan Obat Bebas Terbatas / Daftar W (disertai tanda peringatan P.No. 1\342\200\2236); dan lingkaran merah bertuliskan huruf K hitam menandakan Obat Keras / Daftar G (Buku Ajar Farmakologi HKI 2022, Bab VII: Penggolongan Jenis Obat).\',\\n          tips: \'Sebelum membeli obat di apotek atau toko obat berizin, periksa warna lingkaran pada pojok kemasan. Obat Bebas Terbatas wajib dibeli dalam kemasan asli pabrik beserta kotak peringatan hitam berukuran 5 x 2 cm.\',\\n          warning: \'Obat Keras berlogo lingkaran merah huruf K (seperti antibiotik, antihipertensi, antidiabetik, atau kortikosteroid) hanya boleh diperoleh dengan resep dokter di apotek\342\200\224kecuali obat tertentu dalam daftar Obat Wajib Apotek (OWA) yang diserahkan langsung oleh apoteker (HKI 2022, Bab VII).\'\\n        }\\n      },\\n      {\\n        id: 2,\\n        number: 2,\\n        title: \'Nama & Komposisi Zat Aktif\',\\n        shortDescription: \'Nama dagang/generik dan jumlah zat aktif per tablet.\',\\n        xPercent: 50,\\n        yPercent: 28,\\n        content: {\\n          meaning: \'Menunjukkan identitas kimia zat berkhasiat (nama generik/INN) beserta takaran kekuatannya per satuan tablet (misalnya Parasetamol 500 mg) dan bahan tambahan pengisi, pengikat, atau penghancur tablet (HKI 2022, Bab IX: Bentuk Sediaan Obat & Bab XI: Cara Pemberian Obat).\',\\n          tips: \'Selalu baca nama zat aktif di bawah nama merek dagang! Obat dengan merek berbeda sering kali mengandung zat aktif generik yang sama persis. Pastikan juga melihat bobot per tablet (misalnya 250 mg vs 500 mg) sebelum diminum.\',\\n          warning: \'Mengonsumsi dua obat bermerek berbeda yang ternyata sama-sama mengandung parasetamol atau AINS berisiko menyebabkan duplikasi dosis dan toksisitas organ hati maupun ginjal (Farmakologi dan Terapi Ed. 4 FKUI, Bab 52: Dasar Toksikologi & Bab 54: Interaksi Obat).\'\\n        }\\n      },\\n      {\\n        id: 3,\\n        number: 3,\\n        title: \'Indikasi (Kegunaan)\',\\n        shortDescription: \'Kondisi atau gejala medis yang telah disetujui untuk diobati.\',\\n        xPercent: 50,\\n        yPercent: 46,\\n        content: {\\n          meaning: \'Keterangan khasiat farmakoterapi obat yang telah dibuktikan secara ilmiah melalui uji klinis untuk meredakan, mengobati, atau mencegah gejala tertentu\342\200\224misalnya analgesik-antipiretik untuk nyeri ringan dan demam (HKI 2022, Bab I & Bab IV; Farmakologi dan Terapi Ed. 4 FKUI, Bab 1 & Bab 15).\',\\n          tips: \'Cocokkan gejala yang dialami dengan indikasi resmi pada etiket atau brosur obat. Jika obat ditujukan hanya untuk gejala tertentu (misalnya penurun demam), jangan diminum untuk keluhan lain yang tidak sesuai.\',\\n          warning: \'Pemakaian obat di luar indikasi resmi\342\200\224terutama penggunaan antibiotik pada infeksi virus seperti flu biasa\342\200\224tidak akan menyembuhkan dan justru memicu kegagalan terapi serta resistensi mikroba (Farmakologi dan Terapi Ed. 4 FKUI, Bab 39: Pengantar Antimikroba).\'\\n        }\\n      },\\n      {\\n        id: 4,\\n        number: 4,\\n        title: \'Aturan Pakai & Peringatan\',\\n        shortDescription: \'Frekuensi minum, hubungan dengan waktu makan, dan kontraindikasi.\',\\n        xPercent: 50,\\n        yPercent: 64,\\n        content: {\\n          meaning: \'Pedoman posologi mencakup dosis sekali pakai, frekuensi/interval jam (misalnya 3 kali sehari = setiap 8 jam untuk menjaga kadar obat stabil di plasma), rute pemberian (oral ditelan, sublingual di bawah lidah, bukal di pipi), serta hubungan dengan makanan (HKI 2022, Bab VIII & Bab XI).\',\\n          tips: \'Perhatikan apakah tablet harus diminum sebelum makan (1 jam sebelum makan agar absorpsi optimal, misalnya antasida atau antibiotik tertentu) atau sesudah makan untuk mencegah iritasi lambung (seperti asam mefenamat/AINS). Minumlah tablet dengan air putih, bukan susu jika terdapat peringatan interaksi kalsium (HKI 2022, Bab XI).\',\\n          warning: \'Jangan menggerus atau membelah tablet salut selaput/lepas lambat tanpa arahan apoteker, dan perhatikan peringatan kontraindikasi bagi penderita tukak lambung, ibu hamil, gangguan hati, atau gangguan ginjal (Farmakologi dan Terapi Ed. 4 FKUI, Bab 1, Bab 54, & Bab 56).\'\\n        }\\n      },\\n      {\\n        id: 5,\\n        number: 5,\\n        title: \'Tanggal Kedaluwarsa & No. Bets\',\\n        shortDescription: \'Batas akhir obat dijamin mutu dan keamanannya (Exp. Date).\',\\n        xPercent: 82,\\n        yPercent: 82,\\n        content: {\\n          meaning: \'Expired Date (ED) adalah batas waktu terakhir jaminan stabilitas, potensi, dan keamanan obat dalam kemasan asli pabrik yang belum rusak/terbuka, sedangkan Nomor Bets adalah kode identitas siklus produksi untuk penelusuran mutu atau penarikan produk (HKI 2022, Bab VIII & Bab XI; BPOM RI).\',\\n          tips: \'Periksa cetakan tekan (emboss) atau tinta pada ujung lipatan strip atau blister tablet sebelum menelan obat. Jika kemasan strip tergunting dan tanggal ED terpotong tidak terbaca, jangan ragu menanyakan kepada apoteker atau memisahkan obat.\',\\n          warning: \'Jangan pernah mengonsumsi obat yang telah melewati tanggal kedaluwarsa karena kadar zat aktif dapat menurun atau terurai menjadi senyawa toksik\342\200\224seperti produk degradasi tetrasiklin berwarna cokelat yang berbahaya bagi ginjal (Farmakologi dan Terapi Ed. 4 FKUI, Bab 52: Dasar Toksikologi).\'\\n        }\\n      },\\n      {\\n        id: 6,\\n        number: 6,\\n        title: \'Nomor Izin Edar (NIE BPOM)\',\\n        shortDescription: \'Kode resmi 15 digit bukti obat terdaftar di BPOM RI.\',\\n        xPercent: 25,\\n        yPercent: 82,\\n        content: {\\n          meaning: \'Kode registrasi 15 digit (huruf dan angka) dari BPOM RI yang menjamin obat telah dinilai mutu, khasiat, dan keamanannya. Tiga huruf awal menunjukkan kategori: DBL (Dagang Bebas Lokal), DTL (Dagang Bebas Terbatas Lokal), DKL (Dagang Keras Lokal), atau GBL/GTL/GKL untuk obat generik (BPOM RI; HKI 2022, Bab I).\',\\n          tips: \'Verifikasi keaslian 15 digit NIE beserta nama produk dan pabrik pembuatnya melalui aplikasi resmi BPOM Mobile atau laman Cek BPOM sebelum digunakan.\',\\n          warning: \'Hindari membeli atau mengonsumsi obat yang tidak mencantumkan Nomor Izin Edar BPOM maupun kemasan yang segelnya rusak karena berisiko merupakan produk ilegal, palsu, atau mengandung bahan kimia berbahaya tanpa pengawasan (HKI 2022, Bab I & Farmakologi dan Terapi Ed. 4 FKUI, Bab 52).\'\\n        }\\n      }\\n    ]\\n  },\\n  sirup: {\\n    type: \'sirup\',\\n    title: \'Botol Sirup / Suspensi\',\\n    subtitle: \'Simulasi kemasan sediaan cair obat minum\',\\n    hotspots: [\\n      {\\n        id: 1,\\n        number: 1,\\n        title: \'Logo Golongan Obat\',\\n        shortDescription: \'Tanda lingkaran golongan obat pada label badan botol.\',\\n        xPercent: 28,\\n        yPercent: 32,\\n        content: {\\n          meaning: \'Lingkaran berwarna pada label badan botol sirup menunjukkan status legalitas perolehan obat: Hijau untuk Obat Bebas, Biru untuk Obat Bebas Terbatas (Daftar W dengan kotak peringatan hitam P.No. 1\342\200\2236), dan Merah huruf K untuk Obat Keras seperti sirup kering antibiotik (HKI 2022, Bab VII: Penggolongan Jenis Obat).\',\\n          tips: \'Sirup batuk/flu bebas terbatas sering membawa peringatan P.No. 1 (\\\"Awas! Obat Keras. Bacalah aturan memakainya\\\"). Pastikan melihat logo golongan dan baca aturan pakai pada label botol maupun dus.\',\\n          warning: \'Sirup kering antibiotik berlogo lingkaran merah huruf K hanya boleh digunakan sesuai resep dokter dan wajib dihabiskan sesuai durasi terapi untuk mencegah resistensi bakteri (Farmakologi dan Terapi Ed. 4 FKUI, Bab 39: Pengantar Antimikroba).\'\\n        }\\n      },\\n      {\\n        id: 2,\\n        number: 2,\\n        title: \'Nama & Konsentrasi per Sendok (5 mL)\',\\n        shortDescription: \'Contoh: Tiap 5 mL mengandung zat aktif ... mg.\',\\n        xPercent: 52,\\n        yPercent: 42,\\n        content: {\\n          meaning: \'Menyatakan kekuatan kadar zat berkhasiat yang terlarut atau terdispersi dalam setiap 5 mililiter cairan (satu sendok takar obat standar), sebagaimana dijelaskan pada pengelompokan sediaan cair seperti sirup, eliksir, dan suspensi (HKI 2022, Bab IX: Bentuk Sediaan Obat).\',\\n          tips: \'Selalu ukur obat cair menggunakan sendok takar berskala, gelas takar, atau pipet/spuit oral bawaan kemasan. Pegang wadah takar sejajar pandangan mata dan pastikan permukaan cairan berada tepat pada garis dasar meniskus sesuai takaran (HKI 2022, Bab XI: Cara Pemberian Obat).\',\\n          warning: \'Jangan menggunakan sendok makan atau sendok teh dapur karena volumenya tidak seragam (sendok makan dapur berkisar 10\342\200\22315 mL) sehingga berisiko menyebabkan kekurangan dosis atau kelebihan dosis berbahaya, terutama pada anak-anak (HKI 2022, Bab VIII & Bab XI).\'\\n        }\\n      },\\n      {\\n        id: 3,\\n        number: 3,\\n        title: \'Indikasi & Peruntukan Usia\',\\n        shortDescription: \'Kegunaan obat dan batasan usia yang diperbolehkan.\',\\n        xPercent: 52,\\n        yPercent: 54,\\n        content: {\\n          meaning: \'Menjelaskan gejala yang ditangani oleh sirup serta rentang usia atau berat badan sasaran. Anak-anak bukan \\\"orang dewasa mini\\\" karena fungsi metabolisme hati, ekskresi ginjal, dan distribusi cairan tubuhnya berbeda (Farmakologi dan Terapi Ed. 4 FKUI, Bab 56: Faktor-Faktor yang Mempengaruhi Respons Penderita Terhadap Obat).\',\\n          tips: \'Cocokkan usia pasien dengan tabel aturan pakai di kemasan dan perhatikan apakah sediaan ditujukan khusus untuk bayi (drops/guttae), anak, atau dewasa. Jika berat badan anak jauh di luar rata-rata usianya, konsultasikan kepada apoteker atau dokter.\',\\n          warning: \'Pemberian obat bebas atau bebas terbatas pada bayi di bawah usia 2 tahun tidak boleh dilakukan sembarangan tanpa konsultasi dokter karena risiko toksisitas organ yang belum matang (Farmakologi dan Terapi Ed. 4 FKUI, Bab 56 & HKI 2022, Bab V).\'\\n        }\\n      },\\n      {\\n        id: 4,\\n        number: 4,\\n        title: \'Instruksi Khusus: \\\"Kocok Dahulu\\\"\',\\n        shortDescription: \'Pentingnya homogenisasi larutan sebelum diminum.\',\\n        xPercent: 52,\\n        yPercent: 66,\\n        content: {\\n          meaning: \'Pada sediaan suspensi dan emulsi, bahan obat padat halus yang tidak larut terdispersi di dalam cairan pembawa dan cenderung mengendap saat disimpan. Mengocok botol secara perlahan bertujuan mendispersikan kembali endapan agar campuran kembali seragam/homogen sebelum dituang (HKI 2022, Bab IX: Bentuk Sediaan Obat & Bab XI).\',\\n          tips: \'Kocok botol secara perlahan selama beberapa detik sebelum membuka tutup, pegang label botol menghadap telapak tangan saat menuang agar label tidak kotor, lalu bersihkan bibir botol sebelum menutup kembali (HKI 2022, Bab XI: Cara Pemberian Obat).\',\\n          warning: \'Jika suspensi tidak dikocok dahulu, takaran pertama dari bagian atas botol hanya berisi cairan pembawa dengan dosis terlalu rendah (terapi gagal), sedangkan sisa cairan di dasar botol menjadi sangat pekat dan berisiko overdosis (HKI 2022, Bab IX).\'\\n        }\\n      },\\n      {\\n        id: 5,\\n        number: 5,\\n        title: \'Batas Simpan Setelah Dibuka (BUD)\',\\n        shortDescription: \'Beyond Use Date: batas waktu pakai setelah segel botol dibuka.\',\\n        xPercent: 72,\\n        yPercent: 78,\\n        content: {\\n          meaning: \'Expired Date (ED) hanya berlaku selama segel botol belum dibuka. Setelah dibuka atau direkonstitusi dengan air (sirup kering), masa simpan aman turun menjadi Beyond Use Date (BUD)\342\200\224misalnya sirup kering antibiotik umumnya hanya stabil 7\342\200\22314 hari setelah dilarutkan (USP <795>; Kemenkes RI; HKI 2022, Bab VIII).\',\\n          tips: \'Biasakan menulis tanggal pertama kali botol dibuka atau tanggal pencampuran air menggunakan spidol permanen langsung pada label botol, lalu pantau di fitur Lemari Obat Saya.\',\\n          warning: \'Segera hentikan pemakaian dan buang sesuai prosedur DAGUSIBU apabila cairan berubah warna, menjadi keruh tidak wajar, berbau asam/menyimpang, menggumpal yang tak terdispersi saat dikocok, atau muncul kristal/jamur (HKI 2022, Bab IX & BPOM RI).\'\\n        }\\n      },\\n      {\\n        id: 6,\\n        number: 6,\\n        title: \'Nomor Izin Edar (NIE BPOM)\',\\n        shortDescription: \'Kode registrasi resmi izin edar cairan obat dalam negeri.\',\\n        xPercent: 32,\\n        yPercent: 78,\\n        content: {\\n          meaning: \'Nomor registrasi 15 digit dari BPOM RI pada label botol yang memastikan formula, pelarut, takaran zat aktif, dan mutu sediaan cair telah memenuhi persyaratan izin edar resmi di Indonesia (BPOM RI).\',\\n          tips: \'Pastikan segel tutup botol masih utuh saat dibeli, kemudian cek kode NIE 15 digit dan nomor bets melalui aplikasi Cek BPOM untuk memastikan produk asli dan tidak termasuk dalam daftar penarikan (recall).\',\\n          warning: \'Waspadai produk sirup tanpa NIE resmi, tanpa segel pelindung, atau berlabel kabur yang tidak mencantumkan komposisi pelarut dan zat aktif secara jelas karena berisiko tinggi menimbulkan keracunan (Farmakologi dan Terapi Ed. 4 FKUI, Bab 52 & HKI 2022, Bab V).\'\\n        }\\n      }\\n    ]\\n  },\\n  salep: {\\n    type: \'salep\',\\n    title: \'Tube Salep / Krim\',\\n    subtitle: \'Simulasi kemasan sediaan semipadat obat luar\',\\n    hotspots: [\\n      {\\n        id: 1,\\n        number: 1,\\n        title: \'Peringatan: \\\"Obat Luar - Tidak Untuk Ditelan\\\"\',\\n        shortDescription: \'Tanda khusus dan rute pemberian topikal/kulit.\',\\n        xPercent: 20,\\n        yPercent: 42,\\n        content: {\\n          meaning: \'Salep, krim, pasta, dan gel adalah sediaan semipadat untuk pemakaian topikal pada kulit atau membran mukosa. Kemasan obat luar wajib mencantumkan peringatan \\\"OBAT LUAR\\\" dan sering disertai kotak peringatan hitam P.No. 3 (\\\"Awas! Obat Keras. Hanya untuk bagian luar dari badan\\\") (HKI 2022, Bab VII & Bab IX).\',\\n          tips: \'Bedakan sediaan topikal kulit dari salep mata steril atau obat oral. Simpan tube salep terpisah dari obat minum agar tidak tertukar di rumah tangga.\',\\n          warning: \'Jangan pernah menelan sediaan topikal atau mengoleskannya ke area selaput lendir (mata, mulut, hidung, luka terbuka dalam) kecuali produk tersebut memang diformulasikan dan diindikasikan khusus untuk area tersebut (HKI 2022, Bab XI; Farmakologi dan Terapi Ed. 4 FKUI, Bab 34: Obat Lokal).\'\\n        }\\n      },\\n      {\\n        id: 2,\\n        number: 2,\\n        title: \'Nama Zat Aktif & Persentase (%)\',\\n        shortDescription: \'Contoh: Hidrokortison 1% atau Ketokonazol 2%.\',\\n        xPercent: 44,\\n        yPercent: 42,\\n        content: {\\n          meaning: \'Menunjukkan jenis bahan obat yang larut atau terdispersi homogen dalam dasar salep/krim beserta persentase kekuatannya\342\200\224misalnya salep Hidrokortison 1% untuk peradangan kulit atau antijamur topikal untuk infeksi dermatofit (HKI 2022, Bab IX; Farmakologi dan Terapi Ed. 4 FKUI, Bab 33 & Bab 38).\',\\n          tips: \'Perhatikan kadar persentase (%) dan jenis basisnya: salep (berbasis lemak/vaselin) lebih oklusif untuk kulit kering bersisik, sedangkan krim (emulsi dengan kadar air \342\211\245 60%) lebih ringan dan mudah dicuci untuk area lembap (HKI 2022, Bab IX).\',\\n          warning: \'Kortikosteroid topikal (seperti hidrokortison, betametason, atau klobetasol) memiliki potensi berbeda-beda; pemakaian jangka panjang atau penutupan plastik oklusif dapat memperbesar absorpsi sistemik dan memicu efek samping lokal maupun sistemik (Farmakologi dan Terapi Ed. 4 FKUI, Bab 33).\'\\n        }\\n      },\\n      {\\n        id: 3,\\n        number: 3,\\n        title: \'Indikasi Masalah Kulit\',\\n        shortDescription: \'Kondisi kulit spesifik: gatal alergi, infeksi jamur, atau luka luar.\',\\n        xPercent: 62,\\n        yPercent: 42,\\n        content: {\\n          meaning: \'Penyakit kulit memiliki penyebab yang berbeda: radang/alergi non-infeksi (diatasi antiinflamasi/kortikosteroid ringan), infeksi jamur kulit/kurap (memerlukan antijamur seperti ketokonazol atau mikonazol), dan infeksi bakteri (memerlukan antibakteri topikal) (Farmakologi dan Terapi Ed. 4 FKUI, Bab 33, Bab 34, & Bab 38: Obat Jamur).\',\\n          tips: \'Jangan menyamaratakan semua \\\"gatal kulit\\\". Bila gatal berupa ruam melingkar berbatas tegas di lipatan tubuh yang lembap (dugaan infeksi jamur), konsultasikan ke apoteker atau dokter sebelum memilih salep.\',\\n          warning: \'Mengoleskan salep kortikosteroid pada infeksi jamur kulit justru menekan sistem imun lokal, memperluas infeksi jamur (tinea incognito), serta berisiko menyebabkan penipisan kulit (atrofi) dan iritasi bila digunakan berkepanjangan (Farmakologi dan Terapi Ed. 4 FKUI, Bab 33 & Bab 38).\'\\n        }\\n      },\\n      {\\n        id: 4,\\n        number: 4,\\n        title: \'Cara Pengolesan & Higienitas\',\\n        shortDescription: \'Cuci tangan sebelum & sesudah, oleskan tipis merata.\',\\n        xPercent: 78,\\n        yPercent: 42,\\n        content: {\\n          meaning: \'Prosedur aplikasi obat topikal yang benar meliputi mencuci tangan sebelum dan sesudah mengoles, membersihkan area kulit yang sakit dari kotoran/kerak lalu mengeringkannya, kemudian mengoleskan salep atau krim tipis merata sesuai petunjuk (HKI 2022, Bab XI: Cara Pemberian Obat).\',\\n          tips: \'Gunakan ujung jari bersih atau aplikator berujung kapas/kasa steril saat mengoleskan obat, lalu segera bersihkan ujung leher tube sebelum menutupnya rapat kembali.\',\\n          warning: \'Hindari menyentuhkan ujung mulut tube langsung ke permukaan kulit yang luka, bernanah, atau terinfeksi agar bakteri/jamur tidak masuk mengontaminasi isi salep di dalam tube (HKI 2022, Bab XI).\'\\n        }\\n      },\\n      {\\n        id: 5,\\n        number: 5,\\n        title: \'Kedaluwarsa & Segel Lipatan Tube\',\\n        shortDescription: \'Tanggal kedaluwarsa sering dicetak tekan pada lipatan belakang tube.\',\\n        xPercent: 92,\\n        yPercent: 42,\\n        content: {\\n          meaning: \'Pada kemasan tube logam aluminium maupun plastik, Tanggal Kedaluwarsa (ED) dan Nomor Bets umumnya dicetak tekan (crimping/emboss) pada ujung lipatan belakang tube. Masa pakai setelah segel dibuka (BUD) sediaan semipadat umumnya lebih singkat daripada ED (BPOM RI; USP <795>).\',\\n          tips: \'Biasakan memeriksa ujung lipatan belakang tube dan pastikan tutupan ulir selalu tertutup rapat setelah dipakai agar basis krim/salep tidak teroksidasi atau mengering (HKI 2022, Bab IX).\',\\n          warning: \'Jangan gunakan salep atau krim apabila terjadi pemisahan fase air dan minyak (pecah emulsi), berubah warna menjadi kecokelatan, berbau tengik, atau bertekstur kasar/berpasir karena stabilitas sediaan sudah rusak (HKI 2022, Bab IX & BPOM RI).\'\\n        }\\n      },\\n      {\\n        id: 6,\\n        number: 6,\\n        title: \'Nomor Izin Edar & Logo Golongan\',\\n        shortDescription: \'Kode NIE dan tanda lingkaran (Hijau, Biru, atau Merah K).\',\\n        xPercent: 32,\\n        yPercent: 65,\\n        content: {\\n          meaning: \'Menunjukkan apakah sediaan topikal termasuk Obat Bebas, Bebas Terbatas (misalnya antiseptik/antijamur tertentu), atau Obat Keras (misalnya salep antibiotik dan kortikosteroid potensi sedang-tinggi), lengkap dengan 15 digit Nomor Izin Edar resmi BPOM RI (HKI 2022, Bab VII; BPOM RI).\',\\n          tips: \'Cocokkan 15 digit NIE pada badan tube dan dus luar melalui aplikasi Cek BPOM agar terhindar dari produk palsu.\',\\n          warning: \'Waspadai krim atau salep racikan tanpa label jelas, tanpa komposisi zat aktif, dan tanpa NIE BPOM\342\200\224sering kali produk ilegal mengandung kortikosteroid keras tersembunyi atau logam berat berbahaya yang merusak kulit dan organ tubuh (Farmakologi dan Terapi Ed. 4 FKUI, Bab 52 & Bab 53).\'\\n        }\\n      }\\n    ]\\n  }\\n};\\n\", \"Description\":\"Replace all 54 [ISI DARI RUJUKAN] placeholders in labelHotspots.ts with verified educational content from HKI 2022, Farmakologi & Terapi Ed. 4 FKUI, BPOM RI, and Kemenkes RI\", \"Overwrite\":true, \"TargetFile\":\"/src/data/labelHotspots.ts\", \"toolAction\":\"Filling labelHotspots.ts from reference books\", \"toolSummary\":\"Update labelHotspots.ts\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_16299666786277552039"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { KamusItem } from \'../types\';\\n\\nexport const KAMUS_ITEMS: KamusItem[] = [\\n  {\\n    id: \'aturan-pakai\',\\n    term: \'Aturan Pakai\',\\n    category: \'Petunjuk Penggunaan\',\\n    definition: \'Petunjuk resmi mengenai takaran dosis sekali minum, frekuensi dan selang waktu pemberian (misalnya 3 kali sehari = tiap 8 jam), rute pemakaian, serta kaitannya dengan waktu makan agar kadar obat di dalam plasma tetap efektif dan aman.\',\\n    referenceSource: \'HKI 2022 (Bab VIII & XI) \302\267 BPOM RI\'\\n  },\\n  {\\n    id: \'bentuk-sediaan\',\\n    term: \'Bentuk Sediaan Obat (BSO)\',\\n    category: \'Karakteristik Fisik\',\\n    definition: \'Wujud fisik formulasi obat yang dirancang sesuai stabilitas dan rute pemakaiannya, meliputi sediaan padat (tablet, kapsul, pil, serbuk), cair (larutan, sirup, eliksir, suspensi, emulsi, guttae/tetes), dan semipadat (salep, krim, pasta, gel).\',\\n    referenceSource: \'HKI 2022 (Bab IX: Bentuk Sediaan Obat) \302\267 Farmakope Indonesia VI\'\\n  },\\n  {\\n    id: \'beyond-use-date\',\\n    term: \'Beyond Use Date (BUD)\',\\n    category: \'Masa Simpan\',\\n    definition: \'Batas waktu aman penggunaan obat setelah segel kemasan primer dibuka atau setelah sediaan diracik/direkonstitusi dengan air (misalnya sirup kering antibiotik umumnya 7\342\200\22314 hari dan tetes mata multidose maksimal 28 hari), yang waktunya lebih pendek daripada Expired Date pabrik.\',\\n    referenceSource: \'USP <795>/<797> \302\267 Kemenkes RI \302\267 HKI 2022 (Bab VIII)\'\\n  },\\n  {\\n    id: \'dosis\',\\n    term: \'Dosis Obat\',\\n    category: \'Petunjuk Penggunaan\',\\n    definition: \'Jumlah atau takaran obat yang diberikan pada satu kali pemakaian atau dalam rentang waktu tertentu untuk menghasilkan efek terapi yang diinginkan tanpa melampaui batas aman toksisitas (dosis menentukan apakah suatu zat bekerja sebagai obat atau racun).\',\\n    referenceSource: \'HKI 2022 (Bab I & X) \302\267 Farmakologi & Terapi Ed. 4 FKUI (Bab 1 & 52)\'\\n  },\\n  {\\n    id: \'efek-samping\',\\n    term: \'Efek Samping Obat (ESO)\',\\n    category: \'Keamanan Pasien\',\\n    definition: \'Setiap efek fisiologis atau respons yang tidak diinginkan dari suatu obat yang timbul pada dosis lazim terapeutik manusia\342\200\224sifatnya umumnya dapat diprediksi dari mekanisme kerja obat tetapi tidak dapat dihindari sepenuhnya.\',\\n    referenceSource: \'HKI 2022 (Bab I) \302\267 Farmakologi & Terapi Ed. 4 FKUI (Bab 1) \302\267 BPOM RI\'\\n  },\\n  {\\n    id: \'expired-date\',\\n    term: \'Expired Date (ED / Tanggal Kedaluwarsa)\',\\n    category: \'Masa Simpan\',\\n    definition: \'Batas tanggal terakhir produsen menjamin stabilitas mutu, potensi zat aktif, dan keamanan obat selama disimpan dalam kemasan asli yang masih tersegel rapat sesuai suhu anjuran. Obat lewat ED berisiko kehilangan khasiat atau terurai menjadi senyawa toksik.\',\\n    referenceSource: \'BPOM RI \302\267 HKI 2022 (Bab VIII & XI) \302\267 FKUI Ed. 4 (Bab 52)\'\\n  },\\n  {\\n    id: \'indikasi\',\\n    term: \'Indikasi Medis\',\\n    category: \'Informasi Terapi\',\\n    definition: \'Daftar kondisi penyakit atau gejala spesifik yang secara ilmiah dan regulasi telah disetujui untuk diobati, diredakan, atau dicegah menggunakan obat tersebut sesuai mekanisme farmakodinamik zat aktifnya.\',\\n    referenceSource: \'BPOM RI \302\267 HKI 2022 (Bab IV: Farmakoterapi)\'\\n  },\\n  {\\n    id: \'kontraindikasi\',\\n    term: \'Kontraindikasi\',\\n    category: \'Keamanan Pasien\',\\n    definition: \'Kondisi klinis, riwayat penyakit, atau status pasien tertentu (misalnya alergi zat aktif, tukak lambung aktif, kehamilan, atau gagal ginjal berat) di mana obat sama sekali tidak boleh diberikan karena risiko bahaya serius atau fatal.\',\\n    referenceSource: \'Farmakologi & Terapi Ed. 4 FKUI (Bab 56) \302\267 HKI 2022 (Bab XI) \302\267 BPOM RI\'\\n  },\\n  {\\n    id: \'logo-obat-bebas\',\\n    term: \'Logo Obat Bebas (Lingkaran Hijau)\',\\n    category: \'Golongan Obat\',\\n    definition: \'Tanda khusus berupa lingkaran berwarna hijau dengan garis tepi hitam yang menandakan obat relatif paling aman untuk swamedikasi keluhan ringan dan dapat dibeli bebas di apotek maupun toko obat berizin tanpa resep dokter (contoh: parasetamol tablet, vitamin C).\',\\n    referenceSource: \'HKI 2022 (Bab VII: Penggolongan Jenis Obat) \302\267 Permenkes RI\'\\n  },\\n  {\\n    id: \'logo-obat-bebas-terbatas\',\\n    term: \'Logo Obat Bebas Terbatas (Lingkaran Biru)\',\\n    category: \'Golongan Obat\',\\n    definition: \'Tanda lingkaran berwarna biru dengan garis tepi hitam untuk obat Daftar W (\\\"Waarschuwing\\\"), yaitu obat keras yang masih boleh diserahkan tanpa resep dokter asalkan dijual dalam bungkus asli pabrik dan wajib mencantumkan kotak tanda peringatan khusus P.No. 1 hingga P.No. 6.\',\\n    referenceSource: \'HKI 2022 (Bab VII: Penggolongan Jenis Obat) \302\267 Kepmenkes RI\'\\n  },\\n  {\\n    id: \'logo-obat-keras\',\\n    term: \'Logo Obat Keras (Lingkaran Merah Huruf K)\',\\n    category: \'Golongan Obat\',\\n    definition: \'Tanda lingkaran berwarna merah bergaris tepi hitam dengan huruf K hitam menyentuh tepi lingkaran untuk obat Daftar G (\\\"Gevaarlijk\\\"/berbahaya) dan psikotropika. Hanya boleh diperoleh dengan resep dokter di apotek/faskes, kecuali item tertentu dalam daftar Obat Wajib Apotek (OWA).\',\\n    referenceSource: \'HKI 2022 (Bab VII: Penggolongan Jenis Obat) \302\267 Permenkes RI\'\\n  },\\n  {\\n    id: \'nomor-bets\',\\n    term: \'Nomor Bets / Batch Number\',\\n    category: \'Identifikasi Produk\',\\n    definition: \'Kode identitas unik yang diberikan pabrik untuk menandai satu siklus atau kelompok produksi obat tertentu yang memiliki keseragaman mutu, sehingga memudahkan pelacakan apabila diperlukan audit atau penarikan produk (recall).\',\\n    referenceSource: \'BPOM RI \302\267 Farmakope Indonesia VI\'\\n  },\\n  {\\n    id: \'nomor-izin-edar\',\\n    term: \'Nomor Izin Edar (NIE BPOM)\',\\n    category: \'Legalitas\',\\n    definition: \'Kode persetujuan resmi pendaftaran obat jadi dari BPOM RI terdiri atas 15 digit kombinasi huruf dan angka. Tiga huruf awal menunjukkan golongan dan status produksi (misalnya DBL: Dagang Bebas Lokal, DTL: Dagang Bebas Terbatas Lokal, DKL: Dagang Keras Lokal).\',\\n    referenceSource: \'BPOM RI \302\267 HKI 2022 (Bab I)\'\\n  },\\n  {\\n    id: \'obat-generik\',\\n    term: \'Obat Generik\',\\n    category: \'Nama Obat\',\\n    definition: \'Obat yang penamaannya menggunakan nama resmi zat berkhasiat yang ditetapkan dalam Farmakope Indonesia maupun International Nonproprietary Names (INN) dari WHO\342\200\224mengandung zat aktif, kekuatan dosis, dan khasiat yang setara dengan obat merek dagang.\',\\n    referenceSource: \'HKI 2022 (Bab XI) \302\267 Kemenkes RI \302\267 Farmakope Indonesia VI\'\\n  },\\n  {\\n    id: \'peringatan-khusus\',\\n    term: \'Peringatan Khusus (Tanda P. No. 1 s/d P. No. 6)\',\\n    category: \'Petunjuk Penggunaan\',\\n    definition: \'Kotak berwarna hitam berukuran panjang 5 cm dan lebar 2 cm berisi tulisan putih pada kemasan Obat Bebas Terbatas (Daftar W): P.No.1 (Awas! Obat Keras, bacalah aturan memakainya), P.No.2 (hanya untuk kumur), P.No.3 (hanya untuk bagian luar), P.No.4 (hanya untuk dibakar), P.No.5 (tidak boleh ditelan), dan P.No.6 (obat wasir, jangan ditelan).\',\\n    referenceSource: \'HKI 2022 (Bab VII: Penggolongan Jenis Obat) \302\267 Kepmenkes RI\'\\n  },\\n  {\\n    id: \'rekonstitusi\',\\n    term: \'Rekonstitusi (Sirup Kering)\',\\n    category: \'Petunjuk Penggunaan\',\\n    definition: \'Proses melarutkan serbuk/granul obat kering (umumnya antibiotik anak) dengan air matang bersuhu ruang tepat hingga batas tanda garis pada botol sebelum pertama kali diminum, lalu dikocok merata. Setelah direkonstitusi, botol wajib ditandai tanggal dan dihabiskan dalam batas BUD.\',\\n    referenceSource: \'HKI 2022 (Bab IX) \302\267 Farmakope Indonesia VI\'\\n  },\\n  {\\n    id: \'suhu-simpan\',\\n    term: \'Suhu Penyimpanan Obat\',\\n    category: \'Masa Simpan\',\\n    definition: \'Ketentuan suhu lingkungan guna menjaga kestabilan fisika dan kimia obat menurut Farmakope Indonesia: suhu kamar/ruang terkendali (15\342\200\22330\302\260C), suhu sejuk (8\342\200\22315\302\260C), dan suhu dingin lemari es bukan freezer (2\342\200\2238\302\260C). Kelembapan berlebih dan paparan sinar matahari langsung mempercepat kerusakan obat.\',\\n    referenceSource: \'Farmakope Indonesia VI \302\267 HKI 2022 (Bab VIII)\'\\n  },\\n  {\\n    id: \'swamedikasi\',\\n    term: \'Swamedikasi (Self-Medication)\',\\n    category: \'Perilaku Pasien\',\\n    definition: \'Upaya pengobatan mandiri oleh masyarakat untuk keluhan ringan menggunakan obat golongan Obat Bebas dan Obat Bebas Terbatas secara rasional sesuai informasi label, tanpa melampaui kewenangan diagnosis serta tetap berkonsultasi ke apoteker atau dokter bila gejala menetap atau muncul tanda bahaya.\',\\n    referenceSource: \'WHO \302\267 Kemenkes RI \302\267 HKI 2022 (Bab IV & VII)\'\\n  }\\n];\\n\", \"Description\":\"Replace all 18 [ISI DARI RUJUKAN] definitions in kamusData.ts with accurate textbook-grounded definitions\", \"Overwrite\":true, \"TargetFile\":\"/src/data/kamusData.ts\", \"toolAction\":\"Filling kamusData.ts from reference books\", \"toolSummary\":\"Update kamusData.ts\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_16299666786277552070"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { StorageGuideItem } from \'../types\';\\n\\nexport const PANDUAN_SIMPAN_BUANG: StorageGuideItem[] = [\\n  {\\n    sediaan: \'Tablet\',\\n    title: \'Tablet & Kapsul\',\\n    simpanRules: [\\n      \'Simpan di tempat kering, sejuk, dan terlindung dari cahaya matahari langsung pada suhu ruang terkendali (15\342\200\22330\302\260C) sesuai anjuran kemasan (Farmakope Indonesia VI; HKI 2022, Bab VIII).\',\\n      \'Pertahankan tablet dan kapsul tetap di dalam kemasan strip, blister, atau botol asli lengkap dengan etiketnya hingga sesaat sebelum diminum agar terlindung dari udara lembap dan tanggal kedaluwarsa tetap terbaca (HKI 2022, Bab IX & XI).\',\\n      \'Hindari menyimpan obat di kamar mandi, dekat wastafel, di atas kompor dapur, atau di dasbor mobil karena panas dan kelembapan mempercepat tablet hancur serta melunakkan cangkang kapsul gelatin (Kemenkes RI DAGUSIBU; BPOM RI).\'\\n    ],\\n    buangRules: [\\n      \'Keluarkan seluruh tablet atau isi kapsul dari kemasan strip, blister, atau botol aslinya agar kemasan utuh tidak disalahgunakan kembali (Kemenkes RI DAGUSIBU; BPOM RI).\',\\n      \'Gerus/hancurkan tablet atau buka cangkang kapsul, lalu campurkan ke dalam kantong plastik bersama bahan tidak menarik seperti ampas kopi, tanah, atau pasir kotor sebelum dibuang ke tempat sampah domestik (Kemenkes RI DAGUSIBU).\',\\n      \'Gunting atau rusak strip/blister serta coret/rusak informasi pribadi dan label obat pada dus atau botol sebelum dibuang ke wadah sampah tertutup (BPOM RI).\'\\n    ],\\n    catatanPenting: \'Segera hentikan pemakaian dan musnahkan tablet atau kapsul apabila berubah warna, muncul bintik jamur, rapuh/hancur, berbau menyengat (seperti bau cuka/tengik), atau cangkang kapsul menjadi lembek dan saling menempel (FKUI Ed. 4, Bab 52; BPOM RI).\'\\n  },\\n  {\\n    sediaan: \'Sirup / Cair\',\\n    title: \'Sirup, Suspensi & Emulsi\',\\n    simpanRules: [\\n      \'Bersihkan bibir botol setelah menuang dan tutup ulir botol rapat-rapat agar cairan tidak menguap, mengkristal di leher botol, atau terkontaminasi mikroba (HKI 2022, Bab XI: Cara Pemberian Obat).\',\\n      \'Simpan pada suhu ruang terkendali (15\342\200\22330\302\260C) dan terhindar dari sinar matahari langsung; jangan dimasukkan ke dalam freezer karena pembekuan dapat memecah kestabilan emulsi atau suspensi (HKI 2022, Bab IX; Farmakope Indonesia VI).\',\\n      \'Catat tanggal pertama kali botol dibuka atau tanggal pencampuran air (sirup kering) pada label untuk memantau batas Beyond Use Date (BUD), misalnya sirup kering antibiotik umumnya hanya stabil 7\342\200\22314 hari setelah direkonstitusi (USP <795>; Kemenkes RI).\'\\n    ],\\n    buangRules: [\\n      \'Untuk sisa cairan antibiotik atau obat khusus, JANGAN langsung dibuang ke wastafel/saluran air agar tidak mencemari lingkungan dan memicu resistensi bakteri; campurkan cairan dengan serbuk penyerap (ampas kopi/tanah/pasir) dalam wadah tertutup lalu buang ke sampah, atau kembalikan ke program pengumpulan di apotek/faskes (Kemenkes RI DAGUSIBU; FKUI Ed. 4, Bab 39).\',\\n      \'Untuk sirup obat bebas biasa yang tidak berbahaya terhadap lingkungan perairan, encerkan cairan dengan air secukupnya lalu tuang ke saluran pembuangan sesuai panduan pembuangan obat rumah tangga Kemenkes RI.\',\\n      \'Lepaskan atau rusak label pada botol serta pecahkan/rusak tutup botol sebelum membuang botol kosong agar tidak dipakai ulang oleh oknum pemalsu obat (BPOM RI).\'\\n    ],\\n    catatanPenting: \'Jangan gunakan sirup, suspensi, atau emulsi apabila cairan berubah warna, keruh tidak normal, berbau asam/fermentasi, atau terbentuk endapan keras/gumpalan yang tidak mau menyebar kembali meski sudah dikocok perlahan (HKI 2022, Bab IX).\'\\n  },\\n  {\\n    sediaan: \'Salep / Krim / Gel\',\\n    title: \'Salep, Krim & Gel Kulit\',\\n    simpanRules: [\\n      \'Simpan pada suhu ruang yang sejuk dan kering serta jauhkan dari paparan panas atau sinar matahari langsung; jangan dibekukan karena suhu beku dapat memisahkan fase air dan lemak pada krim/emulsi (HKI 2022, Bab IX; Farmakope Indonesia VI).\',\\n      \'Setelah pemakaian, bersihkan sisa salep di sekitar ulir mulut tube dengan tisu bersih tanpa menyentuhkan ujung tube ke luka (HKI 2022, Bab XI).\',\\n      \'Pastikan tutup tube terpasang rapat guna mencegah oksidasi bahan dasar lemak serta penguapan kandungan air pada sediaan krim (\342\211\245 60% air) dan gel (HKI 2022, Bab IX).\'\\n    ],\\n    buangRules: [\\n      \'Keluarkan seluruh sisa salep, krim, atau gel dari dalam tube ke dalam kantong plastik atau wadah sekali pakai terpisah (BPOM RI; Kemenkes RI DAGUSIBU).\',\\n      \'Campurkan massa salep/krim dengan bahan tidak menarik (tanah, pasir kucing, atau ampas kopi) lalu ikat rapat kantong plastik sebelum dibuang ke tempat sampah.\',\\n      \'Gunting, lipat, atau pipihkan badan tube plastik/aluminium dan rusak label komposisi agar kemasan tidak dapat diisi ulang oleh pihak tidak bertanggung jawab (BPOM RI).\'\\n    ],\\n    catatanPenting: \'Waspadai tanda kerusakan sediaan semipadat seperti pemisahan lapisan minyak dan air, tekstur berair encer atau mengeras/mengerak, perubahan warna, maupun bau tengik akibat oksidasi dasar salep (HKI 2022, Bab IX).\'\\n  },\\n  {\\n    sediaan: \'Tetes Mata / Telinga\',\\n    title: \'Obat Tetes Mata & Telinga\',\\n    simpanRules: [\\n      \'Perhatikan batas Beyond Use Date (BUD) steril: sediaan tetes mata botol multidose umumnya hanya boleh dipakai maksimal 28 hari setelah segel pertama kali dibuka (atau sesuai petunjuk kemasan), meskipun tanggal Expired Date pabrik masih panjang (USP <797>; Kemenkes RI).\',\\n      \'Jaga sterilitas dengan tidak menyentuhkan ujung penetes (dropper) ke jari tangan, kelopak mata, bulu mata, atau liang telinga saat meneteskan obat (HKI 2022, Bab XI: Cara Pemberian Obat Tetes Mata & Telinga).\',\\n      \'Simpan botol dalam posisi tegak dengan tutup rapat sesuai suhu anjuran\342\200\224beberapa tetes mata tertentu wajib disimpan di lemari pendingin (2\342\200\2238\302\260C, bukan freezer) sebelum atau sesudah dibuka (Farmakope Indonesia VI; BPOM RI).\'\\n    ],\\n    buangRules: [\\n      \'Tuang sisa cairan tetes mata atau telinga ke saluran pembuangan atau campur dengan bahan penyerap inert dalam wadah tertutup sesuai kategori obatnya (BPOM RI; Kemenkes RI DAGUSIBU).\',\\n      \'Lepaskan bagian penetes, rusak botol plastik/kaca dan tutupnya, serta sobek label kemasan agar tidak dapat digunakan kembali (Kemenkes RI).\',\\n      \'Buang botol dan tutup yang telah dirusak ke tempat sampah rumah tangga dalam kondisi terbungkus aman.\'\\n    ],\\n    catatanPenting: \'Pemakaian tetes mata yang telah melewati masa BUD (> 28 hari setelah dibuka) berisiko tinggi terkontaminasi bakteri atau jamur sehingga dapat memicu infeksi mata serius hingga ancaman gangguan penglihatan (HKI 2022, Bab IX & XI; FKUI Ed. 4, Bab 39).\'\\n  }\\n];\\n\", \"Description\":\"Replace all 28 [ISI DARI RUJUKAN] strings in panduanSimpanBuang.ts with accurate DAGUSIBU and pharmacology textbook guidelines\", \"Overwrite\":true, \"TargetFile\":\"/src/data/panduanSimpanBuang.ts\", \"toolAction\":\"Filling panduanSimpanBuang.ts from references\", \"toolSummary\":\"Update panduanSimpanBuang.ts\"}"
      original_name: "write_to_file"
    }
