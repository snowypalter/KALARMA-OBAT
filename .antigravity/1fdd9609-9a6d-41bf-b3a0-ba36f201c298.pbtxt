              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      \'[ISI DARI RUJUKAN: BPOM - Keluarkan Isi Salep/Krim dari Dalam Tube ke Kantong Plastik Terpisah]\',"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      \'[ISI DARI RUJUKAN: Kemenkes RI - Campur dengan Tanah atau Pasir Kucing agar Tidak Dapat Digunakan Kembali]\',"
