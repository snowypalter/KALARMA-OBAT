            lines {
              text: "          tips: \'[ISI DARI RUJUKAN: Kemenkes RI - Bersihkan Area yang Akan Diobati dan Keringkan Dahulu]\',"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
