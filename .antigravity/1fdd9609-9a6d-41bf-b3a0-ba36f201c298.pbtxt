              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          meaning: \'[ISI DARI RUJUKAN: BPOM - Ketentuan Informasi Nama Zat Berkhasiat]\',"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          tips: \'[ISI DARI RUJUKAN: Farmakope Indonesia - Membedakan Nama Dagang dan Nama Generik]\',"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          warning: \'[ISI DARI RUJUKAN: Kemenkes RI - Waspada Mengonsumsi Obat Berbeda Merk dengan Zat Aktif yang Sama (Duplikasi Dosis)]\'"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          meaning: \'Menunjukkan identitas kimia zat berkhasiat (nama generik/INN) beserta takaran kekuatannya per satuan tablet (misalnya Parasetamol 500 mg) dan bahan tambahan pengisi, pengikat, atau penghancur tablet (HKI 2022, Bab IX: Bentuk Sediaan Obat & Bab XI: Cara Pemberian Obat).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          tips: \'Selalu baca nama zat aktif di bawah nama merek dagang! Obat dengan merek berbeda sering kali mengandung zat aktif generik yang sama persis. Pastikan juga melihat bobot per tablet (misalnya 250 mg vs 500 mg) sebelum diminum.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          warning: \'Mengonsumsi dua obat bermerek berbeda yang ternyata sama-sama mengandung parasetamol atau AINS berisiko menyebabkan duplikasi dosis dan toksisitas organ hati maupun ginjal (Farmakologi dan Terapi Ed. 4 FKUI, Bab 52: Dasar Toksikologi & Bab 54: Interaksi Obat).\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
