    command_line: "node -e \"\nconst fs = require(\'fs\');\nconst fkui = JSON.parse(fs.readFileSync(\'/tmp/fkui_ed4.json\', \'utf8\'));\n// Find Seksi / Bab headers across fkui\nfkui.forEach((p, idx) => {\n  const m = p.match(/(SEKSI\\s+[IVX]+[\\.\\s]+[A-Z][A-Za-z\\s,]+|\\b\\d{1,2}\\.\\s+[A-Z][A-Z\\s,\\-\\/]{4,50})/g);\n  if (m && idx > 20) {\n    const clean = m.map(s => s.replace(/\\s+/g, \' \').trim()).filter(s => s.length > 6 && !/^\\d+\\.\\s+(PENDAHULUAN|FARMAKOKINETIK|FARMAKODINAMIK|MEKANISME|EFEK|ABSORPSI|DISTRIBUSI|METABOLISME|EKSKRESI|SEDIAAN|POSOLOGI|INDIKASI|KONTRAINDIKASI)/.test(s));\n    if (clean.length > 0) console.log(\'P.\'+(idx+1)+\':\', clean.slice(0, 3).join(\' | \'));\n  }\n});\n\""
