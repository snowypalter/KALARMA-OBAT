            lines {
              text: "          meaning: \'[ISI DARI RUJUKAN: BPOM - Struktur Arti Huruf dan Digit Nomor Izin Edar]\',"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          tips: \'[ISI DARI RUJUKAN: BPOM - Cara Cek Keaslian Produk melalui Aplikasi BPOM Mobile]\',"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          warning: \'[ISI DARI RUJUKAN: BPOM - Bahaya Membeli Obat Tanpa Nomor Izin Edar Resmi]\'"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          meaning: \'Kode registrasi 15 digit (huruf dan angka) dari BPOM RI yang menjamin obat telah dinilai mutu, khasiat, dan keamanannya. Tiga huruf awal menunjukkan kategori: DBL (Dagang Bebas Lokal), DTL (Dagang Bebas Terbatas Lokal), DKL (Dagang Keras Lokal), atau GBL/GTL/GKL untuk obat generik (BPOM RI; HKI 2022, Bab I).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          tips: \'Verifikasi keaslian 15 digit NIE beserta nama produk dan pabrik pembuatnya melalui aplikasi resmi BPOM Mobile atau laman Cek BPOM sebelum digunakan.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          warning: \'Hindari membeli atau mengonsumsi obat yang tidak mencantumkan Nomor Izin Edar BPOM maupun kemasan yang segelnya rusak karena berisiko merupakan produk ilegal, palsu, atau mengandung bahan kimia berbahaya tanpa pengawasan (HKI 2022, Bab I & Farmakologi dan Terapi Ed. 4 FKUI, Bab 52).\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
