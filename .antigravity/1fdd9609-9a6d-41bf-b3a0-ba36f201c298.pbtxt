    content: "import { StorageGuideItem } from \'../types\';\n\nexport const PANDUAN_SIMPAN_BUANG: StorageGuideItem[] = [\n  {\n    sediaan: \'Tablet\',\n    title: \'Tablet & Kapsul\',\n    simpanRules: [\n      \'[ISI DARI RUJUKAN: Kemenkes RI - Simpan di Tempat Kering dan Terlindung dari Sinar Matahari Langsung]\',\n      \'[ISI DARI RUJUKAN: Farmakope - Jaga Tetap di Kemasan Asli (Strip/Blister) Sampai Waktu Diminum]\',\n      \'[ISI DARI RUJUKAN: BPOM - Hindari Menyimpan Obat di Tempat Lembap Seperti Kamar Mandi atau Dekat Wastafel]\'\n    ],\n    buangRules: [\n      \'[ISI DARI RUJUKAN: BPOM - Keluarkan Tablet dari Strip atau Blister Aslinya]\',\n      \'[ISI DARI RUJUKAN: Kemenkes RI - Hancurkan Tablet atau Campur dengan Bahan Tidak Menarik (Tanah/Bubuk Kopi)]\',\n      \'[ISI DARI RUJUKAN: BPOM - Rusak Kemasan Primer/Sekunder dan Gunting Label Sebelum Dibuang ke Tempat Sampah]\'\n    ],\n    catatanPenting: \'[ISI DARI RUJUKAN: BPOM - Perhatikan Perubahan Warna, Bintik Jamur, Bau Tak Sedap, atau Kapsul Lembek Lengket]\'\n  },\n  {\n    sediaan: \'Sirup / Cair\',\n    title: \'Sirup, Suspensi & Emulsi\',\n    simpanRules: [\n      \'[ISI DARI RUJUKAN: Kemenkes RI - Tutup Rapat Botol Setelah Digunakan]\',\n      \'[ISI DARI RUJUKAN: BPOM - Simpan pada Suhu Ruang Terkendali (Kecuali Petunjuk Tertentu Meminta Masuk Lemari Pendingin Bukan Freezer)]\',\n      \'[ISI DARI RUJUKAN: Farmasi Klinis - Catat Tanggal Pembukaan Pertama di Badan Botol untuk Menghitung BUD]\'\n    ],\n    buangRules: [\n      \'[ISI DARI RUJUKAN: BPOM - Jangan Membuang Cairan Obat Antibiotik Sembarangan ke Saluran Air]\',\n      \'[ISI DARI RUJUKAN: Kemenkes RI - Encerkan Sirup Biasa dengan Air dan Tuang ke Saluran Pembuangan]\',\n      \'[ISI DARI RUJUKAN: BPOM - Lepaskan dan Rusak Label Botol, Buang Botol dalam Keadaan Terbuka Tanpa Tutup]\'\n    ],\n    catatanPenting: \'[ISI DARI RUJUKAN: Farmasi - Jangan Gunakan Sirup yang Menggumpal, Berubah Bau, atau Keruh]\'\n  },\n  {\n    sediaan: \'Salep / Krim / Gel\',\n    title: \'Salep, Krim & Gel Kulit\',\n    simpanRules: [\n      \'[ISI DARI RUJUKAN: Kemenkes RI - Simpan di Tempat Sejuk dan Kering, Jangan Dibekukan]\',\n      \'[ISI DARI RUJUKAN: BPOM - Bersihkan Ujung Tube dengan Tisu Bersih Sebelum Menutup Kembali]\',\n      \'[ISI DARI RUJUKAN: Farmakope - Pastikan Tutup Ulir Tube Terpasang Rapat Mencegah Oksidasi]\'\n    ],\n    buangRules: [\n      \'[ISI DARI RUJUKAN: BPOM - Keluarkan Isi Salep/Krim dari Dalam Tube ke Kantong Plastik Terpisah]\',\n      \'[ISI DARI RUJUKAN: Kemenkes RI - Campur dengan Tanah atau Pasir Kucing agar Tidak Dapat Digunakan Kembali]\',\n      \'[ISI DARI RUJUKAN: BPOM - Gunting atau Pipihkan Tube Logam/Plastik dan Lepaskan Label Sebelum Dibuang]\'\n    ],\n    catatanPenting: \'[ISI DARI RUJUKAN: BPOM - Waspadai Pemisahan Fase Minyak dan Air atau Bau Tengik pada Salep]\'\n  },\n  {\n    sediaan: \'Tetes Mata / Telinga\',\n    title: \'Obat Tetes Mata & Telinga\',\n    simpanRules: [\n      \'[ISI DARI RUJUKAN: Kemenkes RI - Perhatikan Batas BUD Tetes Mata (Umumnya 28 Hari Setelah Dibuka)]\',\n      \'[ISI DARI RUJUKAN: Farmasi Klinis - Hindari Menyentuh Ujung Penetes (Dropper) dengan Jari atau Selaput Mata]\',\n      \'[ISI DARI RUJUKAN: BPOM - Simpan Sesuai Petunjuk (Beberapa Tetes Mata Wajib Masuk Lemari Es 2-8\302\260C Sebelum Dibuka)]\'\n    ],\n    buangRules: [\n      \'[ISI DARI RUJUKAN: BPOM - Kosongkan Cairan Sisa ke Saluran Pembuangan]\',\n      \'[ISI DARI RUJUKAN: Kemenkes RI - Rusak Botol Penetes agar Tidak Disalahgunakan Pihak Lain]\',\n      \'[ISI DARI RUJUKAN: BPOM - Pisahkan Tutup dan Buang ke Wadah Sampah Domestik]\'\n    ],\n    catatanPenting: \'[ISI DARI RUJUKAN: Farmakologi - Risiko Infeksi Bakteri Parah Akibat Pemakaian Tetes Mata Lewat Masa BUD]\'\n  }\n];\n"
