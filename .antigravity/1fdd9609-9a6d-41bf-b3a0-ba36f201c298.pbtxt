    command_line: "node -e \'\nconst fs = require(\"fs\");\nconst fkui = JSON.parse(fs.readFileSync(\"/tmp/fkui_ed4.json\", \"utf8\"));\nconst hki = JSON.parse(fs.readFileSync(\"/tmp/hki2022.json\", \"utf8\"));\n\nconsole.log(\"=== HKI FULL TOC (p.5-8) ===\");\nfor (let i = 4; i <= 7; i++) console.log(hki[i]);\n\nconsole.log(\"\\n=== FKUI CHAPTER STARTS ACROSS ALL 1146 PAGES ===\");\nfor (let i = 0; i < fkui.length; i++) {\n  const txt = fkui[i];\n  const lines = txt.split(\"\\n\").map(l => l.trim()).filter(Boolean);\n  const top = lines.slice(0, 4).join(\" | \");\n  // Check for chapter starts like \"12. ANTIKONVULSI\", \"SEKSI\", or number + uppercase title\n  if (/^\\s*(\\d{1,2}|[IVXLCDM]+)\\.\\s+[A-Z]{4,}/m.test(lines.slice(0, 6).join(\"\\n\")) || /SEKSI\\s+[IVXLCDM]+/i.test(top)) {\n    console.log(`PDF p.${i+1}: ${top.slice(0, 140)}`);\n  }\n}\n\'"
