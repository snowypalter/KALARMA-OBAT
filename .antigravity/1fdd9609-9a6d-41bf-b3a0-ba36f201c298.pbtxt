            }
            lines {
              text: "          meaning: \'[ISI DARI RUJUKAN: BPOM - Ketentuan Tanda Peringatan Sediaan Topikal/Luar]\',"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          tips: \'[ISI DARI RUJUKAN: Kemenkes RI - Mengidentifikasi Label Biru Obat Luar pada Kemasan]\',"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          warning: \'[ISI DARI RUJUKAN: BPOM - Bahaya Menelan atau Mengoleskan Dekat Selaput Lendir jika Tidak Diindikasikan]\'"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          meaning: \'Salep, krim, pasta, dan gel adalah sediaan semipadat untuk pemakaian topikal pada kulit atau membran mukosa. Kemasan obat luar wajib mencantumkan peringatan \"OBAT LUAR\" dan sering disertai kotak peringatan hitam P.No. 3 (\"Awas! Obat Keras. Hanya untuk bagian luar dari badan\") (HKI 2022, Bab VII & Bab IX).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          tips: \'Bedakan sediaan topikal kulit dari salep mata steril atau obat oral. Simpan tube salep terpisah dari obat minum agar tidak tertukar di rumah tangga.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          warning: \'Jangan pernah menelan sediaan topikal atau mengoleskannya ke area selaput lendir (mata, mulut, hidung, luka terbuka dalam) kecuali produk tersebut memang diformulasikan dan diindikasikan khusus untuk area tersebut (HKI 2022, Bab XI; Farmakologi dan Terapi Ed. 4 FKUI, Bab 34: Obat Lokal).\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
