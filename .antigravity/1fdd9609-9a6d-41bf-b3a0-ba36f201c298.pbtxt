              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          meaning: \'[ISI DARI RUJUKAN: BPOM - Informasi Posologi dan Cara Penggunaan Sediaan]\',"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          tips: \'[ISI DARI RUJUKAN: Kemenkes RI - Mengartikan Frekuensi Minum Obat (Misal: 3x1 hari = setiap 8 jam)]\',"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          warning: \'[ISI DARI RUJUKAN: Farmakologi Klinis - Peringatan Khusus untuk Pasien Maag, Ibu Hamil, atau Gangguan Ginjal]\'"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          meaning: \'Pedoman posologi mencakup dosis sekali pakai, frekuensi/interval jam (misalnya 3 kali sehari = setiap 8 jam untuk menjaga kadar obat stabil di plasma), rute pemberian (oral ditelan, sublingual di bawah lidah, bukal di pipi), serta hubungan dengan makanan (HKI 2022, Bab VIII & Bab XI).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          tips: \'Perhatikan apakah tablet harus diminum sebelum makan (1 jam sebelum makan agar absorpsi optimal, misalnya antasida atau antibiotik tertentu) atau sesudah makan untuk mencegah iritasi lambung (seperti asam mefenamat/AINS). Minumlah tablet dengan air putih, bukan susu jika terdapat peringatan interaksi kalsium (HKI 2022, Bab XI).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          warning: \'Jangan menggerus atau membelah tablet salut selaput/lepas lambat tanpa arahan apoteker, dan perhatikan peringatan kontraindikasi bagi penderita tukak lambung, ibu hamil, gangguan hati, atau gangguan ginjal (Farmakologi dan Terapi Ed. 4 FKUI, Bab 1, Bab 54, & Bab 56).\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
