            }
            lines {
              text: "        shortDescription: \'Kondisi atau gejala medis yang telah disetujui untuk diobati.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        xPercent: 50,"
