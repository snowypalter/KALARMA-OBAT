      full: "<truncated 23 bytes>\nCara Mengocok Botol dengan Benar Sebelum Dituang]\',src/data/labelHotspots.ts:143:          warning: \'[ISI DARI RUJUKAN: Farmakologi - Risiko Mengendapnya Zat Aktif jika Tidak Dikocok]\'src/data/labelHotspots.ts:154:          meaning: \'[ISI DARI RUJUKAN: USP / Kemenkes RI - Perbedaan Expired Date Pabrik vs Beyond Use Date]\',src/data/labelHotspots.ts:155:          tips: \'[ISI DARI RUJUKAN: Kemenkes RI - Kebiasaan Menulis Tanggal Pertama Buka Botol pada Label]\',src/data/labelHotspots.ts:156:          warning: \'[ISI DARI RUJUKAN: BPOM - Tanda Kerusakan Sirup: Berubah Warna, Keruh, Berbau Asam, atau Ada Kristal]\'src/data/labelHotspots.ts:167:          meaning: \'[ISI DARI RUJUKAN: BPOM - Ketentuan NIE pada Label Botol Kaca atau Plastik]\',src/data/labelHotspots.ts:168:          tips: \'[ISI DARI RUJUKAN: BPOM - Verifikasi NIE Kemasan Cair Melalui Aplikasi Cek BPOM]\',src/data/labelHotspots.ts:169:          warning: \'[ISI DARI RUJUKAN: BPOM - Kewaspadaan Terhadap Kemasan Sirup Tanpa Segel atau Tanpa NIE]\'src/data/labelHotspots.ts:187:          meaning: \'[ISI DARI RUJUKAN: BPOM - Ketentuan Tanda Peringatan Sediaan Topikal/Luar]\',src/data/labelHotspots.ts:188:          tips: \'[ISI DARI RUJUKAN: Kemenkes RI - Mengidentifikasi Label Biru Obat Luar pada Kemasan]\',src/data/labelHotspots.ts:189:          warning: \'[ISI DARI RUJUKAN: BPOM - Bahaya Menelan atau Mengoleskan Dekat Selaput Lendir jika Tidak Diindikasikan]\'src/data/labelHotspots.ts:200:          meaning: \'[ISI DARI RUJUKAN: Farmakope Indonesia - Kadar Zat Aktif Sediaan Semisolida]\',src/data/labelHotspots.ts:201:          tips: \'[ISI DARI RUJUKAN: Kemenkes RI - Memahami Kadar Persentase Kekuatan Krim/Salep]\',src/data/labelHotspots.ts:202:          warning: \'[ISI DARI RUJUKAN: BPOM - Peringatan Pemakaian Salep Kortikosteroid Tanpa Pengawasan Dokter]\'src/data/labelHotspots.ts:213:          meaning: \'[ISI DARI RUJUKAN: BPOM - Indikasi Resmi Terdaftar untuk Salep/Kr