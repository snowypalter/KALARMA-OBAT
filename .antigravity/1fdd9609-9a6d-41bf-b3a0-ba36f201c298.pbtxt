            lines {
              text: "          warning: \'[ISI DARI RUJUKAN: Farmasi Komunitas - Hindari Menyentuhkan Ujung Tube Langsung ke Luka Bernanah]\'"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          meaning: \'Prosedur aplikasi obat topikal yang benar meliputi mencuci tangan sebelum dan sesudah mengoles, membersihkan area kulit yang sakit dari kotoran/kerak lalu mengeringkannya, kemudian mengoleskan salep atau krim tipis merata sesuai petunjuk (HKI 2022, Bab XI: Cara Pemberian Obat).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          tips: \'Gunakan ujung jari bersih atau aplikator berujung kapas/kasa steril saat mengoleskan obat, lalu segera bersihkan ujung leher tube sebelum menutupnya rapat kembali.\',"
