    content: "import { KamusItem } from \'../types\';\n\nexport const KAMUS_ITEMS: KamusItem[] = [\n  {\n    id: \'aturan-pakai\',\n    term: \'Aturan Pakai\',\n    category: \'Petunjuk Penggunaan\',\n    definition: \'[ISI DARI RUJUKAN: BPOM - Petunjuk Frekuensi, Jumlah, dan Waktu Konsumsi Obat Sesuai Bentuk Sediaan]\',\n    referenceSource: \'BPOM & Kemenkes RI\'\n  },\n  {\n    id: \'bentuk-sediaan\',\n    term: \'Bentuk Sediaan Obat (BSO)\',\n    category: \'Karakteristik Fisik\',\n    definition: \'[ISI DARI RUJUKAN: Farmakope Indonesia - Klasifikasi Wujud Fisik Obat Seperti Tablet, Kapsul, Sirup, dan Salep]\',\n    referenceSource: \'Farmakope Indonesia\'\n  },\n  {\n    id: \'beyond-use-date\',\n    term: \'Beyond Use Date (BUD)\',\n    category: \'Masa Simpan\',\n    definition: \'[ISI DARI RUJUKAN: USP / Kemenkes RI - Batas Waktu Penggunaan Obat Setelah Wadah Primer Dibuka atau Direkonstitusi]\',\n    referenceSource: \'Kemenkes RI & USP\'\n  },\n  {\n    id: \'dosis\',\n    term: \'Dosis Obat\',\n    category: \'Petunjuk Penggunaan\',\n    definition: \'[ISI DARI RUJUKAN: Farmakologi Dasar - Jumlah atau Takaran Obat yang Diberikan untuk Menghasilkan Efek Terapi]\',\n    referenceSource: \'Farmakope Indonesia / Kemenkes\'\n  },\n  {\n    id: \'efek-samping\',\n    term: \'Efek Samping Obat (ESO)\',\n    category: \'Keamanan Pasien\',\n    definition: \'[ISI DARI RUJUKAN: BPOM / WHO - Respon Obat yang Tidak Diinginkan yang Terjadi pada Dosis Lazim Manusia]\',\n    referenceSource: \'BPOM RI - Farmakovigilans\'\n  },\n  {\n    id: \'expired-date\',\n    term: \'Expired Date (ED / Tanggal Kedaluwarsa)\',\n    category: \'Masa Simpan\',\n    definition: \'[ISI DARI RUJUKAN: BPOM - Batas Tanggal Terakhir yang Diberikan Pabrik Selama Obat Masih Memenuhi Syarat Mutu dalam Kemasan Asli Belum Terbuka]\',\n    referenceSource: \'BPOM RI\'\n  },\n  {\n    id: \'indikasi\',\n    term: \'Indikasi Medis\',\n    category: \'Informasi Terapi\',\n    definition: \'[ISI DARI RUJUKAN: BPOM - Penyakit atau Gejala Tertentu yang Secara Ilmiah Terbukti Dapat Diringankan atau Disembuhkan oleh Obat Tersebut]\',\n    referenceSource: \'BPOM RI\'\n  },\n  {\n    id: \'kontraindikasi\',\n    term: \'Kontraindikasi\',\n    category: \'Keamanan Pasien\',\n    definition: \'[ISI DARI RUJUKAN: BPOM - Kondisi Tertentu di Mana Pasien Sama Sekali Tidak Boleh Mengonsumsi Obat Karena Risiko Bahaya Fatal]\',\n    referenceSource: \'Kemenkes & BPOM RI\'\n  },\n  {\n    id: \'logo-obat-bebas\',\n    term: \'Logo Obat Bebas (Lingkaran Hijau)\',\n    category: \'Golongan Obat\',\n    definition: \'[ISI DARI RUJUKAN: Permenkes RI - Obat yang Dapat Dibeli Bebas di Apotek Maupun Toko Obat Berizin Tanpa Resep Dokter]\',\n    referenceSource: \'Permenkes RI\'\n  },\n  {\n    id: \'logo-obat-bebas-terbatas\',\n    term: \'Logo Obat Bebas Terbatas (Lingkaran Biru)\',\n    category: \'Golongan Obat\',\n    definition: \'[ISI DARI RUJUKAN: Permenkes RI - Obat Keras yang Masih Dapat Dibeli Tanpa Resep Namun Wajib Disertai Tanda Peringatan Khusus (P1-P6)]\',\n    referenceSource: \'Permenkes RI\'\n  },\n  {\n    id: \'logo-obat-keras\',\n    term: \'Logo Obat Keras (Lingkaran Merah Huruf K)\',\n    category: \'Golongan Obat\',\n    definition: \'[ISI DARI RUJUKAN: Permenkes RI - Obat Berbahaya yang Hanya Boleh Diperoleh dengan Resep Dokter di Apotek]\',\n    referenceSource: \'Permenkes RI\'\n  },\n  {\n    id: \'nomor-bets\',\n    term: \'Nomor Bets / Batch Number\',\n    category: \'Identifikasi Produk\',\n    definition: \'[ISI DARI RUJUKAN: BPOM - Penandaan Unik Satu Siklus Produksi Pabrik untuk Keperluan Penelusuran Mutu (Recall / Audit)]\',\n    referenceSource: \'BPOM RI\'\n  },\n  {\n    id: \'nomor-izin-edar\',\n    term: \'Nomor Izin Edar (NIE BPOM)\',\n    category: \'Legalitas\',\n    definition: \'[ISI DARI RUJUKAN: BPOM - Bentuk Persetujuan Pendaftaran Obat Jadi Berisi 15 Digit Kombinasi Huruf dan Angka]\',\n    referenceSource: \'BPOM RI\'\n  },\n  {\n    id: \'obat-generik\',\n    term: \'Obat Generik\',\n    category: \'Nama Obat\',\n    definition: \'[ISI DARI RUJUKAN: Kemenkes RI - Obat dengan Nama Resmi Sesuai Zat Berkhasiat Berdasarkan Farmakope Internasional (INN)]\',\n    referenceSource: \'Kemenkes RI\'\n  },\n  {\n    id: \'peringatan-khusus\',\n    term: \'Peringatan Khusus (Tanda P. No. 1 s/d P. No. 6)\',\n    category: \'Petunjuk Penggunaan\',\n    definition: \'[ISI DARI RUJUKAN: Kepmenkes RI - Kotak Berisi Kalimat Peringatan Standar pada Kemasan Obat Bebas Terbatas]\',\n    referenceSource: \'Kepmenkes RI\'\n  },\n  {\n    id: \'rekonstitusi\',\n    term: \'Rekonstitusi (Sirup Kering)\',\n    category: \'Petunjuk Penggunaan\',\n    definition: \'[ISI DARI RUJUKAN: Farmakope Indonesia - Proses Penambahan Air Matang Dingin Sesuai Batas Garis Botol Sebelum Pertama Kali Diminum]\',\n    referenceSource: \'Farmakope Indonesia\'\n  },\n  {\n    id: \'suhu-simpan\',\n    term: \'Suhu Penyimpanan Obat\',\n    category: \'Masa Simpan\',\n    definition: \'[ISI DARI RUJUKAN: Farmakope Indonesia - Rentang Suhu Dingin (2-8\302\260C), Suhu Sejuk (8-15\302\260C), dan Suhu Kamar/Ruang (15-30\302\260C)]\',\n    referenceSource: \'Farmakope Indonesia\'\n  },\n  {\n    id: \'swamedikasi\',\n    term: \'Swamedikasi (Self-Medication)\',\n    category: \'Perilaku Pasien\',\n    definition: \'[ISI DARI RUJUKAN: WHO / Kemenkes RI - Upaya Pengobatan Mandiri Menggunakan Obat Bebas dan Bebas Terbatas untuk Keluhan Ringan]\',\n    referenceSource: \'WHO & Kemenkes RI\'\n  }\n];\n"
