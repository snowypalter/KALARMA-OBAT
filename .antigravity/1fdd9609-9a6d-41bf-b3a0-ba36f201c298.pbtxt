    command_line: "node -e \'\nconst fs = require(\"fs\");\nconst fkui = JSON.parse(fs.readFileSync(\"/tmp/fkui_ed4.json\", \"utf8\"));\nconst ranges = [[244, 305], [390, 420], [545, 580], [585, 625], [800, 825]];\nfor (const [s, e] of ranges) {\n  console.log(`=== PDF ${s}..${e} ===`);\n  for (let p = s; p <= e; p++) {\n    const txt = fkui[p-1].replace(/\\s+/g, \" \").trim().slice(0, 95);\n    console.log(`PDF ${p}: ${txt}`);\n  }\n}\n\'"
