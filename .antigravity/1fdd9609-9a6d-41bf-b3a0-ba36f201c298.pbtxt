        target_content: "const INITIAL_BOT_MESSAGE: ChatMessage = {\n  id: \'welcome-1\',\n  role: \'model\',\n  text: \'Halo! Saya **Asisten Ruang Obat**. Kamu bisa bertanya seputar seluruh materi di website ini (6 titik label kemasan, Lemari Obat, DAGUSIBU, Kamus, Skenario, Kuis) maupun isi dari **buku referensi (.zip)** yang sudah ditambahkan.\\n\\nSilakan pilih pertanyaan cepat di bawah atau ketik pertanyaanmu!\',\n};\n\nconst TAB_STARTER_QUESTIONS: Record<TabType, string[]> = {\n  beranda: [\n    \'Apa saja fitur utama di website Ruang Obat?\',\n    \'Apa perbedaan Expired Date (ED) dan Beyond Use Date (BUD)?\',\n    \'Jelaskan arti lingkaran hijau, biru, dan merah K pada kemasan obat.\',\n  ],\n  \'cek-label\': [\n    \'Apa saja 6 titik informasi penting pada label kemasan obat?\',\n    \'Bagaimana cara membaca kode 15 digit NIE BPOM (DBL, DTL, DKL)?\',\n    \'Kenapa sirup tertentu wajib dikocok dahulu sebelum diminum?\',\n  ],\n  lemari: [\n    \'Bagaimana cara membuang tablet dan sirup kedaluwarsa sesuai prinsip DAGUSIBU?\',\n    \'Di mana tempat yang salah untuk menyimpan obat di rumah?\',\n    \'Berapa lama batas aman (BUD) tetes mata dan sirup kering setelah dibuka?\',\n  ],\n  latihan: [\n    \'Mengapa meminum sisa antibiotik teman sangat berbahaya?\',\n    \'Kenapa sendok makan dapur tidak boleh dipakai untuk takaran sirup obat?\',\n    \'Kapan waktu terbaik minum tablet kunyah antasida?\',\n  ],\n  pustaka: [\n    \'Sumber resmi apa saja yang menjadi rujukan aplikasi Ruang Obat?\',\n    \'Apa isi buku referensi .zip yang sedang dimuat saat ini?\',\n    \'Jelaskan arti tanda peringatan P.No 1 sampai P.No 6.\',\n  ],\n};"
        replacement_content: "const INITIAL_BOT_MESSAGE: ChatMessage = {\n  id: \'welcome-1\',\n  role: \'model\',\n  text: \'Halo! Saya **Asisten Ruang Obat**. Jawaban saya terkunci memprioritaskan dan mengutip langsung dari **35 berkas buku referensi** (*Buku Ajar Farmakologi HKI 2022* \342\200\224 11 bab & *Farmakologi dan Terapi Edisi 4 FKUI* \342\200\224 24 berkas / 56 bab) di folder pustaka, disertai pencantuman nama dan bab buku di setiap jawaban.\\n\\nSilakan pilih pertanyaan cepat di bawah atau ketik pertanyaanmu!\',\n};\n\nconst TAB_STARTER_QUESTIONS: Record<TabType, string[]> = {\n  beranda: [\n    \'Jelaskan penggolongan obat Bebas, Bebas Terbatas, dan Obat Keras menurut HKI 2022.\',\n    \'Apa perbedaan Expired Date (ED) dan Beyond Use Date (BUD)?\',\n    \'Apa saja prinsip 7 Benar pemberian obat menurut buku ajar farmakologi?\',\n  ],\n  \'cek-label\': [\n    \'Bagaimana penggolongan bentuk sediaan padat, cair (suspensi/emulsi), dan semipadat (salep/krim)?\',\n    \'Kenapa sediaan suspensi wajib dikocok perlahan dan diukur pada dasar meniskus?\',\n    \'Apa risiko duplikasi dosis dan interaksi obat menurut Farmakologi & Terapi FKUI?\',\n  ],\n  lemari: [\n    \'Bagaimana cara membuang tablet dan sirup kedaluwarsa sesuai prinsip DAGUSIBU?\',\n    \'Mengapa obat kedaluwarsa seperti tetrasiklin berbahaya menurut Dasar Toksikologi FKUI?\',\n    \'Bagaimana aturan suhu simpan sediaan cair, salep, dan tetes mata agar mutu tetap stabil?\',\n  ],\n  latihan: [\n    \'Mengapa penggunaan antibiotik yang tidak tepat memicu resistensi mikroba menurut Bab 39 FKUI?\',\n    \'Kenapa sendok makan dapur tidak boleh dipakai untuk takaran sirup obat?\',\n    \'Bagaimana mekanisme kerja antasida dan risiko penggunaan kortikosteroid topikal pada jamur?\',\n  ],\n  pustaka: [\n    \'Cakupan materi apa saja yang dibahas dalam Buku Ajar Farmakologi HKI 2022?\',\n    \'Apa perbedaan Farmakokinetik dan Farmakodinamik pada Bab 1 Farmakologi & Terapi Ed. 4?\',\n    \'Jelaskan tanda peringatan P.No 1 sampai P.No 6 pada Obat Bebas Terbatas Daftar W.\',\n  ],\n};"
