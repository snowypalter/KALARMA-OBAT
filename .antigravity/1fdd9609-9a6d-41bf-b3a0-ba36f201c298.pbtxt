            lines {
              text: "        title: \'Nama Zat Aktif & Persentase (%)\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        shortDescription: \'Contoh: Hidrokortison 1% atau Ketokonazol 2%.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        xPercent: 44,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        yPercent: 42,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        content: {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          meaning: \'[ISI DARI RUJUKAN: Farmakope Indonesia - Kadar Zat Aktif Sediaan Semisolida]\',"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          tips: \'[ISI DARI RUJUKAN: Kemenkes RI - Memahami Kadar Persentase Kekuatan Krim/Salep]\',"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          warning: \'[ISI DARI RUJUKAN: BPOM - Peringatan Pemakaian Salep Kortikosteroid Tanpa Pengawasan Dokter]\'"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          meaning: \'Menunjukkan jenis bahan obat yang larut atau terdispersi homogen dalam dasar salep/krim beserta persentase kekuatannya\342\200\224misalnya salep Hidrokortison 1% untuk peradangan kulit atau antijamur topikal untuk infeksi dermatofit (HKI 2022, Bab IX; Farmakologi dan Terapi Ed. 4 FKUI, Bab 33 & Bab 38).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          tips: \'Perhatikan kadar persentase (%) dan jenis basisnya: salep (berbasis lemak/vaselin) lebih oklusif untuk kulit kering bersisik, sedangkan krim (emulsi dengan kadar air \342\211\245 60%) lebih ringan dan mudah dicuci untuk area lembap (HKI 2022, Bab IX).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          warning: \'Kortikosteroid topikal (seperti hidrokortison, betametason, atau klobetasol) memiliki potensi berbeda-beda; pemakaian jangka panjang atau penutupan plastik oklusif dapat memperbesar absorpsi sistemik dan memicu efek samping lokal maupun sistemik (Farmakologi dan Terapi Ed. 4 FKUI, Bab 33).\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        id: 3,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        number: 3,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        title: \'Indikasi Masalah Kulit\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        shortDescription: \'Kondisi kulit spesifik: gatal alergi, infeksi jamur, atau luka luar.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        xPercent: 62,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        yPercent: 42,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        content: {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          meaning: \'[ISI DARI RUJUKAN: BPOM - Indikasi Resmi Terdaftar untuk Salep/Krim Kulit]\',"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          tips: \'[ISI DARI RUJUKAN: Kemenkes RI - Membedakan Salep Jamur vs Salep Alergi]\',"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          warning: \'[ISI DARI RUJUKAN: Dermatologi / Farmakologi - Efek Samping Penipisan Kulit Akibat Salah Salep]\'"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          meaning: \'Penyakit kulit memiliki penyebab yang berbeda: radang/alergi non-infeksi (diatasi antiinflamasi/kortikosteroid ringan), infeksi jamur kulit/kurap (memerlukan antijamur seperti ketokonazol atau mikonazol), dan infeksi bakteri (memerlukan antibakteri topikal) (Farmakologi dan Terapi Ed. 4 FKUI, Bab 33, Bab 34, & Bab 38: Obat Jamur).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          tips: \'Jangan menyamaratakan semua \"gatal kulit\". Bila gatal berupa ruam melingkar berbatas tegas di lipatan tubuh yang lembap (dugaan infeksi jamur), konsultasikan ke apoteker atau dokter sebelum memilih salep.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          warning: \'Mengoleskan salep kortikosteroid pada infeksi jamur kulit justru menekan sistem imun lokal, memperluas infeksi jamur (tinea incognito), serta berisiko menyebabkan penipisan kulit (atrofi) dan iritasi bila digunakan berkepanjangan (Farmakologi dan Terapi Ed. 4 FKUI, Bab 33 & Bab 38).\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
